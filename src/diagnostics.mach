# run the editor diagnostics slice and publish LSP diagnostics
#
# the diagnostics vertical slice end-to-end: feed a document's buffer to the
# editor surface (`editor.analyze`), translate every reported
# `diagnostic.Diagnostic` into an LSP `Diagnostic` - mapping its byte `span`
# through `positions.range_of` to a 0-based UTF-16 range and its severity
# to the LSP scale - and emit a `textDocument/publishDiagnostics` notification.
# clearing is the same notification with an empty array.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.allocator.Allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use std.allocator.page;

use mach.lang.build.outcome;
use diag: mach.lang.diagnostic;
use mach.lang.editor;
use ferr: mach.lang.fail;
use mach.lang.fe.token;
use src: mach.lang.source;

use mls.documents;
use mls.json;
use mls.notes;
use mls.positions;
use mls.project;
use mls.render;
use mls.trace;
use mls.transport;
use mls.uris;

# cap on diagnostics published per document, to bound message size
val MAX_DIAGNOSTICS: usize = 200;

# publish compiler-owned diagnostics for a document's exact snapshot, falling
# back to isolated editor diagnostics outside a project
#
# The analysis is DRIVEN here rather than merely read. Publishing used to take
# whatever snapshot a previous request happened to leave behind, so a file with
# a type error opened clean and only started reporting once some unrelated
# hover or definition request built the project - and stopped again when that
# snapshot was invalidated. Diagnostics are the one output that must not depend
# on what the user asked for, so they own the pipeline: `document_view` loads
# or refreshes the root, and the result is parse, resolve, and sema at the same
# fidelity `mach build` reports.
#
# While the root rebuilds, the snapshot describes earlier text (#251). What the
# buffer can say about itself - its parse - is current and always wins: a buffer
# with syntax errors shows exactly those. A buffer that parses cleanly keeps the
# snapshot's semantic diagnostics, carried into its current text, when the
# snapshot parsed this module cleanly too, so everything it reports for the file
# came from resolve and sema; one that touches the edited window is dropped,
# since the edit may be what fixed it. When the snapshot could not parse the
# module, its diagnostics describe text that is gone, and nothing is shown until
# the rebuild lands.
#
# `project.refresh_inputs` makes this a revision check once the snapshot is
# current, so republishing every open document after a change costs one
# comparison per document rather than one analysis.
# ---
# w:     project workspace
# es:    standalone editor fallback
# alloc: message allocator
# d:     live document and version
pub fun publish(w: *project.Workspace, es: *editor.EditorSession, alloc: *Allocator, d: *documents.Document) {
    var list:   *diag.DiagnosticStore = nil;
    var result: editor.AnalysisResult = editor.AnalysisResult{};
    result.alloc = nil;
    var at:  Locator                        = Locator{w: w, root: nil, sources: nil};
    var own: src.FileId                     = d.file_id;
    val vr:  res[project.DocumentView, str] = project.document_view(w, d);
    if (sel vr.ok) {
        val v: project.DocumentView = vr.ok;
        if (v.stale) {
            if (!standalone(es, d, editor.PHASE_PARSE, alloc, ?result)) { ret; }
            list       = result.diagnostics;
            at.sources = ?es.s.sources;
            if (count_for(list, own) == 0) {
                list = nil;
                if (v.parse_ok) {
                    list       = ?v.root.s.diags;
                    at.sources = ?v.root.s.sources;
                    at.root    = v.root;
                    own        = v.file_id;
                }
            }
        }
        or {
            list       = ?v.root.s.diags;
            at.sources = ?v.root.s.sources;
            at.root    = v.root;
            own        = v.file_id;
        }
    }
    or {
        # Fidelity is chosen by who the AUTHORITY is, not by what is available.
        # With no project, this analysis IS the answer, so it runs to sema. With
        # a loaded project it is an interim answer that a rebuild is already on
        # its way to replace, and running to sema would drag the whole import
        # closure through the analysis thread - the very cost moving the rebuild
        # off it was meant to remove. Parse is what the buffer can say about
        # itself instantly; the post-swap republish carries the rest.
        var phase: editor.AnalysisPhase = editor.PHASE_SEMA;
        if (project.root_for_loaded(w, d.uri) != nil)  { phase = editor.PHASE_PARSE; }
        if (!standalone(es, d, phase, alloc, ?result)) { ret; }
        list       = result.diagnostics;
        at.sources = ?es.s.sources;
    }

    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":");
    json.buf_push_quoted(?b, d.uri);
    if (d.version >= 0) {
        json.buf_push(?b, ",\"version\":");
        json.buf_push_i64(?b, d.version);
    }
    json.buf_push(?b, ",\"diagnostics\":[");
    var i:       usize = 0;
    var written: usize = 0;
    for (list != nil && i < list.items.len && written < MAX_DIAGNOSTICS) {
        if (list.items.data[i].loc.file_id == own) {
            if (push_entry(?b, ?at, ?list.items.data[i], alloc, written > 0)) { written = written + 1; }
        }
        i = i + 1;
    }
    json.buf_push(?b, "]}}");

    val msg: str = json.buf_str(?b);
    if (msg != nil) { transport.send_message(msg, alloc); }
    json.buf_dnit(?b);
    editor.analysis_dnit(?result);
}

# where a diagnostic's file ids resolve, and how their spans reach the client
# ---
# w:       the workspace
# root:    the root whose session the ids belong to, or nil for the editor's
# sources: the source map the ids index
rec Locator {
    w:       *project.Workspace;
    root:    *project.Root;
    sources: *src.SourceMap;
}

# the text a file id's spans are reported through
fun text_for(at: *Locator, fid: src.FileId) positions.Text {
    if (at.root != nil) { ret project.file_text(at.w, at.root, fid); }
    val so: opt[*src.SourceFile] = src.get(at.sources, fid);
    if (sel so.some) { ret positions.text_of(so.some); }
    ret positions.text_of(nil);
}

# run the editor frontend on the open buffer; on failure the client's list is
# cleared and false returned
fun standalone(es: *editor.EditorSession, d: *documents.Document, phase: editor.AnalysisPhase,
    alloc: *Allocator, out: *editor.AnalysisResult) bool {
    var req: editor.AnalysisRequest                   = editor.analysis_request(d.file_id, phase);
    val ar:  res[editor.AnalysisResult, outcome.Fail] = editor.analyze(es, ?req);
    if (sel ar.err) {
        var f: outcome.Fail = ar.err;
        trace.log("diagnostics: standalone analysis failed: ");
        trace.log(outcome.describe(f));
        trace.log("\n");
        editor.fail_dnit(es, ?f);
        clear(alloc, d.uri);
        ret false;
    }
    @out = ar.ok;
    ret true;
}

# how many diagnostics `list` holds for `fid`
fun count_for(list: *diag.DiagnosticStore, fid: src.FileId) usize {
    if (list == nil) { ret 0; }
    var n: usize = 0;
    var i: usize = 0;
    for (i < list.items.len) {
        if (list.items.data[i].loc.file_id == fid) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# publish an unversioned empty diagnostics array for `uri` on close; omitting a
# version prevents the client from rejecting the final clear as an older snapshot
# ---
# alloc: allocator for the message buffer
# uri:   document URI to clear
pub fun clear(alloc: *Allocator, uri: str) {
    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":");
    json.buf_push_quoted(?b, uri);
    json.buf_push(?b, ",\"diagnostics\":[]}}");

    val msg: str = json.buf_str(?b);
    if (msg != nil) { transport.send_message(msg, alloc); }
    json.buf_dnit(?b);
}

# append one diagnostic as an LSP Diagnostic object, or nothing when its
# primary span cannot be reported in the client's buffer
#
# a mach diagnostic is more than its primary message: the resolve and type stages
# attach a `= note:` line, a `= help:` suggestion, and secondary `related`
# locations (the earlier binding behind a duplicate definition, and its kin).
# `mach build` renders all four; dropping them in the editor throws away the half
# of the diagnostic that says what to DO about it. note and help ride the message
# as trailing lines - the shape a terminal reader already knows - and the
# secondary locations become `relatedInformation`, so the client can jump to them
fun push_entry(b: *json.Buf, at: *Locator, d: *diag.Diagnostic, alloc: *Allocator, comma: bool) bool {
    var r: positions.LspRange;
    if (!range_for(text_for(at, d.loc.file_id), d.loc.span, ?r)) { ret false; }
    if (comma)                                                   { json.buf_push_byte(b, ','); }
    json.buf_push(b, "{\"range\":");
    render.range(b, r);
    json.buf_push(b, ",\"severity\":");
    json.buf_push_i64(b, notes.lsp_severity(d.severity));
    json.buf_push(b, ",\"source\":\"mach\",\"message\":");
    push_message(b, d);
    push_related(b, at, d, alloc);
    json.buf_push_byte(b, '}');
    ret true;
}

# the client's range for a diagnostic span
#
# A diagnostic's claim is about the bytes it covers, so a span touching the
# edited window is not carried, even one that encloses it. An unresolvable file
# degrades to the start of the document rather than dropping the diagnostic.
fun range_for(t: positions.Text, span: token.Span, out: *positions.LspRange) bool {
    out.start_line = 0;
    out.start_char = 0;
    out.end_line   = 0;
    out.end_char   = 0;
    if (t.file == nil) { ret true; }
    val ro: opt[positions.LspRange] = positions.span_range(t, span);
    if (sel ro.none) { ret false; }
    @out = ro.some;
    ret true;
}

# append the quoted message, with the note and help lines appended when
# present. built through a scratch Buf so the three parts are escaped as one
# JSON string
fun push_message(b: *json.Buf, d: *diag.Diagnostic) {
    if (d.children.len == 0) {
        json.buf_push_quoted(b, d.message);
        ret;
    }
    var m: json.Buf = json.buf_init(b.a);
    json.buf_push(?m, d.message);
    var c: usize = 0;
    for (c < d.children.len) {
        val child: *diag.Child = ?d.children.data[c];
        if (child.text != nil) {
            if (child.kind == diag.CHILD_HELP) { json.buf_push(?m, "\nhelp: "); }
            or                                 { json.buf_push(?m, "\nnote: "); }
            json.buf_push(?m, child.text);
        }
        c = c + 1;
    }
    val text: str = json.buf_str(?m);
    if (text != nil) { json.buf_push_quoted(b, text); }
    or               { json.buf_push_quoted(b, d.message); }
    json.buf_dnit(?m);
}

# append `,"relatedInformation":[...]` when the diagnostic carries secondary
# locations. a secondary location may live in a different file than the primary
# one, so each entry resolves its own URI from its SourceFile's path. an entry
# whose file id or URI cannot be resolved is skipped rather than emitted with a
# wrong location; a nil label renders as an empty caption, which the protocol
# requires as a string
fun push_related(b: *json.Buf, at: *Locator, d: *diag.Diagnostic, alloc: *Allocator) {
    if (d.related.len == 0) { ret; }

    var written: usize = 0;
    var r:       usize = 0;
    for (r < d.related.len) {
        val rel: *diag.Related  = ?d.related.data[r];
        val t:   positions.Text = text_for(at, rel.loc.file_id);
        var rng: positions.LspRange;
        if (t.file != nil && range_for(t, rel.loc.span, ?rng)) {
            val u: str = uris.of_path(alloc, t.file.path);
            if (u != nil) {
                if (written == 0) { json.buf_push(b, ",\"relatedInformation\":["); }
                or                { json.buf_push_byte(b, ','); }
                json.buf_push(b, "{\"location\":{\"uri\":");
                json.buf_push_quoted(b, u);
                json.buf_push(b, ",\"range\":");
                render.range(b, rng);
                json.buf_push(b, "},\"message\":");
                json.buf_push_quoted(b, rel.label);
                json.buf_push_byte(b, '}');
                written = written + 1;
                json.free_str(u, alloc);
            }
        }
        r = r + 1;
    }
    if (written > 0) { json.buf_push_byte(b, ']'); }
}

# --- shaping ---

# an otherwise-empty error diagnostic over file 0 at [0,1)
fun stub_diag(message: str) diag.Diagnostic {
    var d: diag.Diagnostic;
    d.severity        = diag.SEVERITY_ERROR;
    d.loc.file_id     = 0::src.FileId;
    d.loc.span.offset = 0;
    d.loc.span.len    = 1;
    d.message         = message;
    d.children        = vector.init[diag.Child](nil);
    d.related         = vector.init[diag.Related](nil);
    d.fixes           = vector.init[diag.Fix](nil);
    ret d;
}

# borrow `items` as a diagnostic's child list without owning them
fun stub_children(items: *diag.Child, n: usize) Vector[diag.Child] {
    var v: Vector[diag.Child] = vector.init[diag.Child](nil);
    v.data = items;
    v.len  = n;
    v.cap  = n;
    ret v;
}

# borrow `items` as a diagnostic's related list without owning them
fun stub_related(items: *diag.Related, n: usize) Vector[diag.Related] {
    var v: Vector[diag.Related] = vector.init[diag.Related](nil);
    v.data = items;
    v.len  = n;
    v.cap  = n;
    ret v;
}

test a_diagnostic_with_no_note_or_help_renders_its_message_alone {
    var pa: Allocator;
    page.make(?pa);
    var b: json.Buf        = json.buf_init(?pa);
    var d: diag.Diagnostic = stub_diag("unresolved identifier `x`");
    push_message(?b, ?d);

    var fail: bool = false;
    if (!str_equals(json.buf_str(?b), "\"unresolved identifier `x`\"")) { fail = true; }
    json.buf_dnit(?b);
    if (fail) { ret 1; }
    ret 0;
}

# the help line is the half of a mach diagnostic that says what to DO; it rode
# nowhere before, so its presence in the rendered message is the regression pin
test note_and_help_ride_the_message_as_trailing_lines {
    var pa: Allocator;
    page.make(?pa);
    var b:    json.Buf        = json.buf_init(?pa);
    var d:    diag.Diagnostic = stub_diag("type mismatch");
    var kids: [2]diag.Child;
    kids[0].kind = diag.CHILD_NOTE;
    kids[0].text = "expected i32";
    kids[1].kind = diag.CHILD_HELP;
    kids[1].text = "cast with `v::i32`";
    d.children   = stub_children(?kids[0], 2);
    push_message(?b, ?d);

    var fail: bool = false;
    if (!str_equals(json.buf_str(?b),
        "\"type mismatch\\nnote: expected i32\\nhelp: cast with `v::i32`\"")) { fail = true; }
    json.buf_dnit(?b);
    if (fail) { ret 1; }
    ret 0;
}

test help_alone_still_renders_without_an_empty_note_line {
    var pa: Allocator;
    page.make(?pa);
    var b:    json.Buf        = json.buf_init(?pa);
    var d:    diag.Diagnostic = stub_diag("unknown key");
    var kids: [1]diag.Child;
    kids[0].kind = diag.CHILD_HELP;
    kids[0].text = "did you mean `simd`?";
    d.children   = stub_children(?kids[0], 1);
    push_message(?b, ?d);

    var fail: bool = false;
    if (!str_equals(json.buf_str(?b), "\"unknown key\\nhelp: did you mean `simd`?\"")) { fail = true; }
    json.buf_dnit(?b);
    if (fail) { ret 1; }
    ret 0;
}

test no_secondary_locations_emits_no_relatedinformation_key {
    var pa: Allocator;
    page.make(?pa);
    var b:  json.Buf        = json.buf_init(?pa);
    var d:  diag.Diagnostic = stub_diag("duplicate definition");
    var m:  src.SourceMap   = src.init(?pa);
    var at: Locator         = Locator{w: nil, root: nil, sources: ?m};
    push_related(?b, ?at, ?d, ?pa);

    var fail: bool = false;
    if (!str_equals(json.buf_str(?b), "")) { fail = true; }
    json.buf_dnit(?b);
    if (fail) { ret 1; }
    ret 0;
}

# a secondary location carries the file it points INTO, which need not be the
# primary's - so the entry resolves its own uri rather than reusing the request's
test a_secondary_location_renders_as_a_located_relatedinformation_entry {
    var pa: Allocator;
    page.make(?pa);

    # add builds the line index and issues the first FileId as 1, since slot 0 is
    # the FILE_NIL sentinel
    var m:     src.SourceMap              = src.init(?pa);
    val added: res[src.FileId, ferr.Fail] = src.add(?m, "file:///w/a.mach", "ab\ncd");
    if (sel added.err) { ret 1; }

    var rels: [1]diag.Related;
    rels[0].loc.file_id     = added.ok;
    rels[0].loc.span.offset = 0;
    rels[0].loc.span.len    = 2;
    rels[0].label           = "previous definition here";

    var d: diag.Diagnostic = stub_diag("duplicate definition");
    d.related = stub_related(?rels[0], 1);

    var b:  json.Buf = json.buf_init(?pa);
    var at: Locator  = Locator{w: nil, root: nil, sources: ?m};
    push_related(?b, ?at, ?d, ?pa);

    var fail: bool = false;
    if (!str_equals(json.buf_str(?b),
        ",\"relatedInformation\":[{\"location\":{\"uri\":\"file:///w/a.mach\",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":2}}},\"message\":\"previous definition here\"}]")) { fail = true; }
    json.buf_dnit(?b);
    if (fail) { ret 1; }
    ret 0;
}

# an unresolvable file id would otherwise render a well-formed entry pointing at
# the wrong place, which is worse than no entry at all
test a_secondary_location_with_an_unresolvable_file_is_skipped {
    var pa: Allocator;
    page.make(?pa);
    var m: src.SourceMap = src.init(?pa);

    var rels: [1]diag.Related;
    rels[0].loc.file_id     = 9::src.FileId;
    rels[0].loc.span.offset = 0;
    rels[0].loc.span.len    = 1;
    rels[0].label           = "elsewhere";

    var d: diag.Diagnostic = stub_diag("duplicate definition");
    d.related = stub_related(?rels[0], 1);

    var b:  json.Buf = json.buf_init(?pa);
    var at: Locator  = Locator{w: nil, root: nil, sources: ?m};
    push_related(?b, ?at, ?d, ?pa);

    var fail: bool = false;
    if (!str_equals(json.buf_str(?b), "")) { fail = true; }
    json.buf_dnit(?b);
    if (fail) { ret 1; }
    ret 0;
}
