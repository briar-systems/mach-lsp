# resolving a positional request to the document view that answers it
#
# Every feature that pivots on a cursor needs the same two things first: the
# compiler-owned analysis of the document the request names, and the byte offset
# its (line, character) position denotes. Both are shared here so a new feature
# binds to one contract rather than reaching into another feature's internals.
#
# A document inside a project resolves through its root's retained snapshot; one
# outside any project falls back to the single-buffer editor API, where cross
# module references are unresolved by construction. Callers that need project
# scope test `root` for nil rather than assuming it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;


use mach.lang.build.outcome;
use mach.lang.editor;
use mach.lang.fail;
use mach.lang.fe.ast;
use rslv: mach.lang.fe.resolve;
use mach.lang.fe.sema;
use mach.lang.intern;
use sess: mach.lang.session;
use src:  mach.lang.source;
use sj:   std.data.json;

use mls.documents;
use mls.json;
use mls.positions;
use mls.project;

# one document's analysis, as a request sees it
# ---
# interner: interner the symbol names resolve against
# text:     source file backing every span, paired with its length
# sr:       semantic result, or nil when the document has none
# a:        parsed Ast
# rr:       resolve side tables
# own:      the document's own module id
# own_fid:  the document's own source file id
# root:     the project root that governs it, or nil for a standalone buffer
# stale:    the snapshot predates this document's text; `text` maps between them
# current:  the root's snapshot covers every buffer it mirrors, or there is no root
pub rec Analyzed {
    interner: *intern.Interner;
    text:     positions.Text;
    sr:       *sema.SemaResult;
    a:        *ast.Ast;
    rr:       *rslv.ResolveResult;
    own:      sess.ModuleId;
    own_fid:  src.FileId;
    root:     *project.Root;
    stale:    bool;
    current:  bool;
}

# resolve `uri` to its current analysis
#
# Prefers the project snapshot, which is what makes cross-module references
# resolvable; falls back to the isolated editor analysis only for a document
# that belongs to no project, never as a way to paper over a failed load. A
# snapshot behind the document's text is still the answer, read through the
# mapping `project.document_view` attaches (#251); a caller that cannot answer
# from earlier semantics uses `locate_current`.
# ---
# ws:   the workspace
# es:   the standalone editor session
# docs: the open-document registry
# uri:  the requested document
# out:  receives the analysis on success
# ret:  true when the document could be analyzed
pub fun analyze(ws: *project.Workspace, es: *editor.EditorSession, docs: *documents.Store, uri: str, out: *Analyzed) bool {
    if (uri == nil) { ret false; }
    val doc: *documents.Document = documents.find(docs, uri);
    if (doc == nil) { ret false; }

    val vr: res[project.DocumentView, str] = project.document_view(ws, doc);
    if (sel vr.ok) {
        val v: project.DocumentView = vr.ok;
        out.rr       = v.rr;
        out.a        = v.a;
        out.sr       = v.sr;
        out.interner = v.interner;
        out.text     = v.text;
        out.root     = v.root;
        out.own      = v.module;
        out.own_fid  = v.file_id;
        out.stale    = v.stale;
        out.current  = project.root_current(v.root);
        ret true;
    }
    if (project.has_project(ws, uri)) { ret false; }

    if (!standalone(es, doc.file_id, editor.PHASE_SEMA, out)) { ret false; }
    if (out.rr == nil)                                        { ret false; }
    val fo: opt[*src.SourceFile] = src.get(?es.s.sources, doc.file_id);
    if (sel fo.none) { ret false; }
    out.interner = ?es.s.interner;
    out.text     = positions.text_of(fo.some);
    out.root     = nil;
    out.own      = doc.file_id::sess.ModuleId;
    out.own_fid  = doc.file_id;
    out.stale    = false;
    out.current  = true;
    ret true;
}

# resolve `uri` to its current analysis whether or not the document is open
#
# Every positional request names a buffer the editor has open, so `analyze` is
# written against the document store. A call-hierarchy item is not positional: it
# names a declaration the server itself reported, and that declaration usually
# lives in a module the editor has never opened. Resolving such an item through
# the store would stop the hierarchy at the first unopened file - which is the
# common case one step out from the cursor.
#
# An open document still wins, because its buffer carries unsaved edits that the
# project's module snapshot does not. A uri outside any loaded root has no
# analysis here; there is no standalone fallback, because an item is only ever
# minted from a project in the first place.
# ---
# ws:   the workspace
# es:   the standalone editor session
# docs: the open-document registry
# uri:  the document to analyze
# out:  receives the analysis on success
# ret:  true when the document could be analyzed
pub fun analyze_uri(ws: *project.Workspace, es: *editor.EditorSession, docs: *documents.Store, uri: str, out: *Analyzed) bool {
    if (uri == nil)                       { ret false; }
    if (documents.find(docs, uri) != nil) { ret analyze(ws, es, docs, uri, out); }

    val root: *project.Root = project.root_for_loaded(ws, uri);
    if (root == nil) { ret false; }
    val mo: opt[sess.ModuleId] = project.module_for_uri(ws, root, uri);
    if (sel mo.none) { ret false; }
    val mid:  sess.ModuleId           = mo.some;
    val mv_o: opt[project.ModuleView] = project.module_view(ws, root, mid);
    if (sel mv_o.none) { ret false; }
    val mv: project.ModuleView = mv_o.some;

    out.interner = project.interner(ws, root);
    out.text     = mv.text;
    out.sr       = mv.sr;
    out.a        = mv.a;
    out.rr       = mv.rr;
    out.own      = mid;
    out.own_fid  = mv.file_id;
    out.root     = root;
    out.stale    = false;
    out.current  = project.root_current(root);
    ret true;
}

# run the standalone frontend on one open buffer up to `phase`
#
# The envelope `editor.analyze` returns owns copies of the diagnostics and
# sources; the raw products it exposes are the buffer's own and stay valid until
# the next editor operation. A request never interleaves one, so the envelope is
# released here and the products are borrowed for the rest of the request.
# ---
# es:    the standalone editor session
# fid:   the open buffer
# phase: PHASE_PARSE, PHASE_RESOLVE or PHASE_SEMA
# out:   receives `a`, `rr` and `sr`; a product the phase did not reach is nil
# ret:   true when the frontend ran; the products may still be nil on a rejected phase
pub fun standalone(es: *editor.EditorSession, fid: src.FileId, phase: editor.AnalysisPhase, out: *Analyzed) bool {
    out.a  = nil;
    out.rr = nil;
    out.sr = nil;
    var req: editor.AnalysisRequest                   = editor.analysis_request(fid, phase);
    val ar:  res[editor.AnalysisResult, outcome.Fail] = editor.analyze(es, ?req);
    if (sel ar.err) {
        var f: outcome.Fail = ar.err;
        editor.fail_dnit(es, ?f);
        ret false;
    }
    var result: editor.AnalysisResult    = ar.ok;
    val a:      res[*ast.Ast, fail.Fail] = editor.ast_of(?result);
    if (sel a.ok) { out.a = a.ok; }
    if (phase >= editor.PHASE_RESOLVE) {
        val rr: res[*rslv.ResolveResult, fail.Fail] = editor.resolve_of(?result);
        if (sel rr.ok) { out.rr = rr.ok; }
    }
    if (phase == editor.PHASE_SEMA) {
        val sr: res[*sema.SemaResult, fail.Fail] = editor.sema_of(?result);
        if (sel sr.ok) { out.sr = sr.ok; }
    }
    editor.analysis_dnit(?result);
    ret true;
}

# the parsed tree for an open document, or nil when it cannot be parsed
# ---
# es:  the standalone editor session
# doc: the open document
pub fun syntax_tree(es: *editor.EditorSession, doc: *documents.Document) *ast.Ast {
    var an: Analyzed;
    if (!standalone(es, doc.file_id, editor.PHASE_PARSE, ?an)) { ret nil; }
    ret an.a;
}

# the syntax-only view of an open document: its parse and its text, nothing
# semantic
#
# A feature that needs only the shape of the buffer (documentSymbol, folding)
# answers from the buffer's own parse and never waits on, or pays for, a
# project snapshot. That is what makes it answer while a project's manifest
# cannot load, and in milliseconds while the snapshot is behind. `rr` and `sr`
# are nil by construction, and `text` is the buffer itself, so nothing maps.
# ---
# es:  the standalone editor session
# doc: the open document
# out: receives the view on success
# ret: true when the document parsed
pub fun syntax_of(es: *editor.EditorSession, doc: *documents.Document, out: *Analyzed) bool {
    val tree: *ast.Ast = syntax_tree(es, doc);
    if (tree == nil) { ret false; }
    val fo: opt[*src.SourceFile] = src.get(?es.s.sources, doc.file_id);
    if (sel fo.none) { ret false; }
    out.interner = nil;
    out.text     = positions.text_of(fo.some);
    out.sr       = nil;
    out.a        = tree;
    out.rr       = nil;
    out.own      = sess.MODULE_NIL;
    out.own_fid  = doc.file_id;
    out.root     = nil;
    out.stale    = false;
    out.current  = true;
    ret true;
}

# analyze the requested document and convert its cursor position to a byte
# offset, or none when the document is unknown, unanalyzable, or the position
# falls outside it
# ---
# ws:     the workspace
# es:     the standalone editor session
# docs:   the open-document registry
# params: the request's params object, holding `position`
# uri:    the requested document
# out:    receives the analysis on success
# ret:    the cursor's byte offset, or none
pub fun locate(ws: *project.Workspace, es: *editor.EditorSession, docs: *documents.Store,
    params: *sj.Value, uri: str, out: *Analyzed) opt[usize] {
    if (!analyze(ws, es, docs, uri, out)) { ret opt[usize].none{}; }
    ret offset_of(params, out.text);
}

# as `locate`, for a request that must not answer from a root that is behind
# its buffers: a reference list or a rename is wrong, not merely approximate,
# when built from earlier text. the server holds such a request while a rebuild
# is on its way, so reaching here behind means no rebuild will arrive
pub fun locate_current(ws: *project.Workspace, es: *editor.EditorSession, docs: *documents.Store,
    params: *sj.Value, uri: str, out: *Analyzed) opt[usize] {
    val o: opt[usize] = locate(ws, es, docs, params, uri, out);
    if (sel o.none)   { ret o; }
    if (!out.current) { ret opt[usize].none{}; }
    ret o;
}

# the byte offset denoted by a request's `position`, or none when it is absent
# or outside the file
# ---
# params: the request's params object
# t:      the file the position indexes, paired with its length
# ret:    the byte offset, or none
pub fun offset_of(params: *sj.Value, t: positions.Text) opt[usize] {
    val pos:  *sj.Value = json.member(params, "position");
    val line: i64       = json.number(json.member(pos, "line"), -1);
    val ch:   i64       = json.number(json.member(pos, "character"), -1);
    if (line < 0 || ch < 0) { ret opt[usize].none{}; }
    ret positions.offset_at(t, line::usize, ch::usize);
}

# the byte offsets denoted by a request's `range`, a filter over the document
# rather than a cursor: a bound inside an edit window widens to the window's
# edge (`positions.bound_at`), so a visible range that spans an edit still
# covers what the analysis can say on either side of it. `lo` and `hi` are
# left as the caller set them when the range is absent or does not map
# ---
# params: the request's params object
# t:      the file the range indexes, paired with its length
# lo:     receives the start offset
# hi:     receives the end offset, never below `lo`
# ret:    whether a range was read
pub fun request_range(params: *sj.Value, t: positions.Text, lo: *usize, hi: *usize) bool {
    val rng: *sj.Value = json.member(params, "range");
    if (rng == nil) { ret false; }
    val so: opt[usize] = bound_of(rng, "start", t, false);
    val eo: opt[usize] = bound_of(rng, "end", t, true);
    if (sel so.none) { ret false; }
    if (sel eo.none) { ret false; }
    @lo = so.some;
    @hi = eo.some;
    if (@hi < @lo) { @hi = @lo; }
    ret true;
}

fun bound_of(rng: *sj.Value, key: str, t: positions.Text, is_end: bool) opt[usize] {
    val p:    *sj.Value = json.member(rng, key);
    val line: i64       = json.number(json.member(p, "line"), -1);
    val ch:   i64       = json.number(json.member(p, "character"), -1);
    if (line < 0 || ch < 0) { ret positions.bound_at(t, 0, 0, is_end); }
    ret positions.bound_at(t, line::usize, ch::usize, is_end);
}
