# mach language server entry point
#
# initializes the server over a page-backed allocator and runs the JSON-RPC
# message loop over stdin/stdout until the client shuts the server down. all
# protocol diagnostics go to the trace log, never stdout, so the protocol
# stream stays clean.

use std.runtime;

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use std.allocator;
use std.allocator.Allocator;
use std.allocator.page;
use std.system.os;
use std.types.error.err;

use mls.server;
use mls.supervisor;
use mls.version;
use std.types.string.str_equals;
use std.types.string.str_len;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (os.ignore_sigpipe() != 0) { ret 1; }

    # answered before anything else starts: a user asking which binary they have
    # should not need a client, and must not start a server
    if (has_flag(argc, argv, "--version")) { ret print_version(); }

    var alloc: Allocator;
    val pe:    err[allocator.Error] = page.make(?alloc);
    if (sel pe.err) { ret 1; }

    # two roles, one executable. Without `--worker` this process is the
    # supervisor: it owns the client's stdio and runs no compiler code, so a
    # front-end fault in the worker is a child exit it survives and can explain
    # rather than a closed pipe the editor has to guess about.
    if (!is_worker(argc, argv)) {
        ret supervisor.run(?alloc, self_path(argc, argv));
    }

    var srv: server.Server;
    if (!server.init(?srv, ?alloc)) { ret 1; }

    val code: i64 = server.run(?srv);

    server.dnit(?srv);
    ret code;
}

# whether this process was started as the analysis worker
fun is_worker(argc: i64, argv: **u8) bool {
    ret has_flag(argc, argv, supervisor.WORKER_FLAG);
}

# whether `flag` is one of the arguments
fun has_flag(argc: i64, argv: **u8, flag: str) bool {
    var i: i64 = 1;
    for (i < argc) {
        if (argv[i] != nil && str_equals(argv[i]::str, flag)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# write `mls <version> (mach <compiler version>)` to stdout
fun print_version() i64 {
    if (!put("mls "))          { ret 1; }
    if (!put(version.VERSION)) { ret 1; }
    if (!put(" (mach "))       { ret 1; }
    if (!put(version.MACH))    { ret 1; }
    if (!put(")\n"))           { ret 1; }
    ret 0;
}

fun put(s: str) bool {
    ret os.write(os.stdout(), s::*u8, str_len(s)) >= 0;
}

# this executable's path, for re-spawning the worker
fun self_path(argc: i64, argv: **u8) str {
    if (argc > 0 && argv[0] != nil) { ret argv[0]::str; }
    ret "mls";
}
