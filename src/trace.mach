# the server's trace: notes about its own behaviour, and a record of messages
#
# The LSP speaks JSON-RPC on stdout, so a trace goes to a file, or to stderr,
# where an editor collects a server's own output. Where it goes and how much it
# records are decided by `settings`, from the client's options, the environment
# and the defaults, and applied here by `start` once `initialize` has said what
# it configures (#264).
#
# Nothing is written before that (#285). A line from before `initialize` is
# kept in memory, and written once the destination is known, or dropped when
# the trace turns out to be off. So a session is never split across two
# destinations, and an option that silences the trace silences all of it.
#
# What a trace may contain is a separate decision from whether it is on. A
# message body is the user's source code: every `didOpen` carries a whole file
# and every `didChange` carries whatever they just typed. So the default
# records only what a message IS - direction, method, id, size, timing - and
# the bodies need the `bodies` level, which is a deliberate second decision and
# still capped. A line kept from before `initialize` never carries a body,
# because the level that would allow one is not known yet.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use chrono: std.chrono.time;
use fmtstr: std.format;
use std.io.writer;
use std.sync.atomic;
use std.sync.mutex;
use std.system.os;

# how much a trace records: nothing, what each message is, or its body too
pub val LEVEL_OFF:      u8 = 0;
pub val LEVEL_MESSAGES: u8 = 1;
pub val LEVEL_BODIES:   u8 = 2;

# the longest trace file path, with its terminator
pub val MAX_PATH: usize = 512;

# most bytes of any one body written to the trace
#
# Enough to read a request and its arguments; far short of a source file.
val BODY_CAP: usize = 512;

# most bytes kept from before `initialize`
#
# A client sends `initialize` first, so this holds a few lines. It is bounded
# for the client that never does.
val EARLY_CAP: usize = 8192;

# whether this process records protocol frames
#
# Both halves of the server handle every frame - the worker reads and answers
# it, the supervisor relays it - so with both recording, each frame was written
# twice. That is not merely noise: two processes appending to one file race for
# the offset, and the loser's line is overwritten, which on windows lost whole
# frames from the middle of the log. The worker sees both directions, so it is
# the one that records; the supervisor keeps only its own status lines, which
# are few and far apart.
var FRAMES: bool = true;

# whether `start` has run; read without the lock, written under it
var SETTLED: i64 = 0;

# the level `start` chose, moved by `set_level`
var LEVEL: u8 = LEVEL_OFF;

# where the trace goes: the chosen file, or stderr when none was chosen
var CHOSEN_PATH: [MAX_PATH]u8;
var PATH_CHOSEN: bool = false;

# the open destination, or invalid while the trace is off or could not open.
# the handle is left open once opened, because another thread may be writing
# to it, and a closed number can be reused by an unrelated open
var LOG_FD: usize = os.INVALID_HANDLE;

# the lines from before `start`, and how many bytes did not fit
var EARLY:      [EARLY_CAP]u8;
var EARLY_LEN:  usize = 0;
var EARLY_LOST: usize = 0;

# guards the early lines and the switch to the destination; the writes after
# `start` do not take it
var MU: mutex.Mutex = 0;

# stop recording protocol frames in this process
pub fun mute_frames() {
    FRAMES = false;
}

# whether `start` has run
pub fun settled() bool {
    ret atomic.load(?SETTLED) != 0;
}

# apply the trace settings, and write or drop what was kept until now
# ---
# level: the effective level
# file:  the file to append to, or nil for stderr
pub fun start(level: u8, file: str) {
    mutex.lock(?MU);
    if (settled()) {
        mutex.unlock(?MU);
        ret;
    }
    if (file != nil && str_len(file) < MAX_PATH) {
        val n: usize = str_len(file);
        var i: usize = 0;
        for (i < n) {
            CHOSEN_PATH[i] = file[i];
            i              = i + 1;
        }
        CHOSEN_PATH[n] = 0;
        PATH_CHOSEN    = true;
    }
    LEVEL = level;
    if (LEVEL != LEVEL_OFF) { LOG_FD = open_destination(); }
    if (LEVEL != LEVEL_OFF && LOG_FD != os.INVALID_HANDLE) {
        if (EARLY_LEN > 0) { os.write(LOG_FD, ?EARLY[0], EARLY_LEN); }
        if (EARLY_LOST > 0) {
            atomic.store(?SETTLED, 1);
            logf("trace: {} bytes from before initialize did not fit and were dropped", EARLY_LOST);
        }
    }
    EARLY_LEN  = 0;
    EARLY_LOST = 0;
    atomic.store(?SETTLED, 1);
    mutex.unlock(?MU);
}

# move the level, as `$/setTrace` does. it overrides whatever `start` chose,
# and means nothing before it
pub fun set_level(level: u8) {
    if (!settled()) { ret; }
    mutex.lock(?MU);
    LEVEL = level;
    if (LEVEL != LEVEL_OFF && LOG_FD == os.INVALID_HANDLE) { LOG_FD = open_destination(); }
    mutex.unlock(?MU);
}

fun open_destination() usize {
    if (!PATH_CHOSEN) { ret os.stderr(); }
    var h:  usize = os.INVALID_HANDLE;
    val rc: i64   = os.open(os.working_dir(), ?CHOSEN_PATH[0], os.O_WRONLY | os.O_CREAT | os.O_APPEND, 420, ?h);
    if (rc < 0) { ret os.INVALID_HANDLE; }
    ret h;
}

# append a message to the trace, best-effort
# ---
# msg: null-terminated message to append; nil / empty is a no-op
pub fun log(msg: str) {
    if (msg == nil) { ret; }
    val len: usize = str_len(msg);
    if (len == 0) { ret; }
    if (!settled()) {
        mutex.lock(?MU);
        val kept: bool = keep(msg::*u8, len);
        mutex.unlock(?MU);
        if (kept) { ret; }
    }
    if (!enabled()) { ret; }
    os.write(LOG_FD, msg::*u8, len);
}

# keep bytes from before `start`, under the lock. false when `start` has run
# since the caller looked, so the caller writes them instead
fun keep(p: *u8, len: usize) bool {
    if (settled()) { ret false; }
    var n: usize = len;
    if (n > EARLY_CAP - EARLY_LEN) {
        EARLY_LOST = EARLY_LOST + (n - (EARLY_CAP - EARLY_LEN));
        n          = EARLY_CAP - EARLY_LEN;
    }
    var i: usize = 0;
    for (i < n) {
        EARLY[EARLY_LEN + i] = p[i];
        i                    = i + 1;
    }
    EARLY_LEN = EARLY_LEN + n;
    ret true;
}

# whether a line would be recorded, so a caller can skip building one it would
# drop. before `start` every line is kept, since the trace may turn out on
pub fun enabled() bool {
    if (!settled()) { ret true; }
    ret LEVEL != LEVEL_OFF && LOG_FD != os.INVALID_HANDLE;
}

# whether message bodies may be written to the trace
pub fun bodies() bool {
    if (!settled()) { ret false; }
    ret enabled() && LEVEL == LEVEL_BODIES;
}

# record one protocol frame
#
# `label` names the direction ("recv" / "send"). The size is always recorded
# because it is the part that is useful without being sensitive: it is how a
# truncated or oversized frame is recognised. The body follows only when it has
# been explicitly asked for, and only up to the cap - a truncated line says so
# rather than trailing off, so a reader is never left wondering whether the
# server sent something malformed or the log simply stopped.
# ---
# label: direction tag
# body:  the frame body
# len:   its length in bytes
pub fun frame(label: str, body: str, len: usize) {
    if (!FRAMES)    { ret; }
    if (!enabled()) { ret; }
    if (!bodies()) {
        logf("{} {} bytes", label, len);
        ret;
    }
    log(label);
    log(" ");
    if (len <= BODY_CAP) {
        log(body);
        log("\n");
        ret;
    }
    if (body != nil) { os.write(LOG_FD, body::*u8, BODY_CAP); }
    logf(" ... [{} of {} bytes]", BODY_CAP, len);
}

# monotonic nanoseconds, for span timing
# ---
# ret: the monotonic clock reading in nanoseconds
pub fun now_ns() i64 {
    val c: chrono.InstantClock = chrono.instant();
    if (sel c.err) { ret 0; }
    ret c.ok.sec * 1000000000 + c.ok.nsec;
}

# writer sink appending to the trace destination
fun trace_sink(ctx: ptr, p: *u8, len: usize) res[usize, writer.WriteError] {
    os.write(LOG_FD, p, len);
    ret res[usize, writer.WriteError].ok{len};
}

# writer sink appending to the early lines; the caller holds the lock
fun early_sink(ctx: ptr, p: *u8, len: usize) res[usize, writer.WriteError] {
    keep(p, len);
    ret res[usize, writer.WriteError].ok{len};
}

# append one formatted line to the trace; a no-op when the trace is off
# ---
# fmt: std.format hole syntax
# va:  comptime variadic argument pack
pub fun logf(fmt: str, va: ...) {
    if (!settled()) {
        mutex.lock(?MU);
        if (!settled()) {
            var e: writer.Writer;
            e.ctx     = nil;
            e.f_write = early_sink;
            fmtstr.vformat(?e, fmt, va...);
            keep("\n"::*u8, 1);
            mutex.unlock(?MU);
            ret;
        }
        mutex.unlock(?MU);
    }
    if (!enabled()) { ret; }
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = trace_sink;
    fmtstr.vformat(?w, fmt, va...);
    os.write(LOG_FD, "\n"::*u8, 1);
}

use std.types.result.res;
