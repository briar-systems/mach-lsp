# pure helpers over sema's typing output
#
# the feature layer reads per-expression types and the nominal back-link from a
# record TypeId to its declaring module here, so the resolution rules live in one
# place - and, being free of any session / project state, are unit-testable in
# isolation. `project.mach` re-exports these through its own narrowed accessors so
# no feature signature carries a `*sess.Session`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use std.types.option.opt;

use std.types.result.res;

use std.allocator.Allocator;
use std.allocator.page;

use mach.lang.fe.ast;
use adecl: mach.lang.fe.ast.decl;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.module;
use mach.lang.fe.sema;
use mach.lang.fe.token;
use mach.lang.intern;
use sess: mach.lang.session;
use src:  mach.lang.source;
use mach.lang.type;
use mls.positions;

use mach.lang.fail;
use std.types.error.err;

# the declaration site a record / union / tag TypeId nominally refers to -
# the back-link a field feature follows from a value's type to the declaration
# whose fields it must walk. the type table names a nominal by its declaring
# file and its interned name; `nominal_decl` turns that into a DeclId against
# the file's Ast. a generic instance resolves to its template
# ---
# file: FileId of the declaring source file
# name: interned declaration name
# kind: the resolved type kind (TYPE_REC, TYPE_UNI, TYPE_TAG, or TYPE_INSTANCE)
pub rec Nominal {
    file: src.FileId;
    name: intern.StrId;
    kind: type.TypeKind;
}

# the semantic type of expression `eid` in `sr`, or TYPE_NIL when `sr`
# is nil or `eid` is out of range. the one read the feature layer makes against a
# buffer's / module's SemaResult to learn an expression's type
# ---
# sr:  the module's / buffer's SemaResult, or nil
# eid: the expression id to type
# ret: the expression's TypeId, or TYPE_NIL when unavailable
pub fun type_of(sr: *sema.SemaResult, eid: id.ExprId) type.TypeId {
    if (sr == nil || sr.expr_type == nil) { ret type.TYPE_NIL; }
    if (eid::u32 >= sr.expr_count)        { ret type.TYPE_NIL; }
    ret sr.expr_type[eid];
}

# the declared (or inferred) type of decl `did` in `sr`, or
# TYPE_NIL when `sr` is nil or `did` is out of range. the decl-keyed twin of
# `type_of`, for typing a binding from its declaration rather than a use
# ---
# sr:  the module's / buffer's SemaResult, or nil
# did: the declaration id to type
# ret: the declaration's TypeId, or TYPE_NIL when unavailable
pub fun decl_type_of(sr: *sema.SemaResult, did: id.DeclId) type.TypeId {
    if (sr == nil || sr.decl_type == nil) { ret type.TYPE_NIL; }
    if (did::u32 >= sr.decl_count)        { ret type.TYPE_NIL; }
    ret sr.decl_type[did];
}

# the semantic type an Ast type node denotes, or TYPE_NIL when `sr`
# is nil or `tid` is out of range. the type-position twin of `type_of`: a cursor
# on a written type (`var b: Box[i32];`, a field's declared type, a return type)
# is neither an expression nor a declaration, and this is the only table that
# carries what it resolved to
# ---
# sr:  the module's / buffer's SemaResult, or nil
# tid: the Ast type id to resolve
# ret: the written type's TypeId, or TYPE_NIL when unavailable
pub fun type_ref_of(sr: *sema.SemaResult, tid: id.TypeId) type.TypeId {
    if (sr == nil || sr.type_resolved_ty == nil) { ret type.TYPE_NIL; }
    if (tid::u32 >= sr.type_count)               { ret type.TYPE_NIL; }
    ret sr.type_resolved_ty[tid];
}

# the declaration site a record / union TypeId nominally refers to,
# or none when `tid` is not a nominal type (a primitive, pointer, array, function,
# generic parameter, or a sentinel). a pointer to a record is peeled to the record
# first, so `*T` and `T` resolve to the same declaration - a field access through a
# pointer reaches the same `rec` decl. a generic instance resolves to its template
# declaration. this is the nominal back-link a field go-to-def / rename follows
# ---
# ti:  the session's type interner
# tid: the TypeId to resolve
# ret: some(Nominal) for a nominal / instance type, none otherwise
pub fun nominal_of(ti: *type.TypeInterner, tid: type.TypeId) opt[Nominal] {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret opt[Nominal].none{}; }
    val t_opt: opt[*type.Type] = type.get(ti, tid);
    if (sel t_opt.none) { ret opt[Nominal].none{}; }
    val t: *type.Type = t_opt.some;

    # peel a single pointer level: a field access through `*T` resolves to T's decl.
    if (t.kind == type.TYPE_POINTER) {
        ret nominal_of(ti, t.data.pointer.base);
    }
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        var n: Nominal;
        n.file = t.data.nominal.owner.file;
        n.name = t.data.nominal.name;
        n.kind = t.kind;
        ret opt[Nominal].some{n};
    }
    if (t.kind == type.TYPE_INSTANCE) {
        val inner: opt[Nominal] = nominal_of(ti, t.data.instance.nominal);
        if (sel inner.none) { ret inner; }
        var n: Nominal = inner.some;
        n.kind = t.kind;
        ret opt[Nominal].some{n};
    }
    ret opt[Nominal].none{};
}

# the module-scope declaration in `a` that `n` names, or none when the Ast
# declares no rec / uni / tag of that name. `a` and `text` must be the Ast and
# text of `n.file`; the caller chooses them, since only it knows whether the
# file is a loaded project module or the live buffer
# ---
# a:    the declaring file's Ast
# text: the declaring file's text
# itn:  the interner `n.name` was interned in
# n:    the nominal to find
# ret:  the DeclId, or none
pub fun nominal_decl(a: *ast.Ast, text: positions.Text, itn: *intern.Interner, n: Nominal) opt[id.DeclId] {
    if (a == nil || itn == nil) { ret opt[id.DeclId].none{}; }
    val want: opt[str] = intern.lookup(itn, n.name);
    if (sel want.none) { ret opt[id.DeclId].none{}; }
    val mo: opt[*module.Module] = ast.get_module(a, a.root_module);
    if (sel mo.none) { ret opt[id.DeclId].none{}; }
    val m: *module.Module = mo.some;
    var i: u32            = 0;
    for (i < m.decls_len) {
        val did:   id.DeclId        = a.decl_ids[m.decls_start + i];
        val d_opt: opt[*adecl.Decl] = ast.get_decl(a, did);
        if (sel d_opt.some) {
            val d:     *adecl.Decl = d_opt.some;
            var name:  token.Span;
            var named: bool        = true;
            if (d.kind == adecl.DECL_KIND_REC)                         { name = d.data.rec_.name; }
            or (d.kind == adecl.DECL_KIND_UNI)                         { name = d.data.uni_.name; }
            or (d.kind == adecl.DECL_KIND_TAG)                         { name = d.data.tag_.name; }
            or                                                         { named = false; }
            if (named && positions.span_equals(text, name, want.some)) { ret opt[id.DeclId].some{did}; }
        }
        i = i + 1;
    }
    ret opt[id.DeclId].none{};
}

test nominal_of_peels_a_pointer_to_the_pointee_record {
    var pa: Allocator;
    page.make(?pa);
    var ti: type.TypeInterner;
    if (!type_init_ok(?ti, ?pa)) { ret 1; }

    val reco: res[type.TypeId, fail.Fail] = type.intern_nominal(?ti, 4::intern.StrId, t_owner(2), type.TYPE_REC);
    if (sel reco.err) {
        type.dnit(?ti);
        ret 1;
    }
    val rec:  type.TypeId                 = reco.ok;
    val ptro: res[type.TypeId, fail.Fail] = type.intern_pointer(?ti, rec);
    if (sel ptro.err) {
        type.dnit(?ti);
        ret 1;
    }
    val ptr: type.TypeId = ptro.ok;

    val no:   opt[Nominal] = nominal_of(?ti, ptr);
    var fail: bool         = false;
    if (sel no.some) {
        val n: Nominal = no.some;
        if (n.file != 2::src.FileId)   { fail = true; }
        if (n.name != 4::intern.StrId) { fail = true; }
        if (n.kind != type.TYPE_REC)   { fail = true; }
    }
    or { fail = true; }

    type.dnit(?ti);
    if (fail) { ret 1; }
    ret 0;
}

test nominal_of_maps_a_generic_instance_to_its_template {
    var pa: Allocator;
    page.make(?pa);
    var ti: type.TypeInterner;
    if (!type_init_ok(?ti, ?pa)) { ret 1; }

    val i32o: opt[type.TypeId] = type.prim(?ti, type.TYPE_I32);
    if (sel i32o.none) {
        type.dnit(?ti);
        ret 1;
    }
    val i32t: type.TypeId = i32o.some;
    var args: [1]type.TypeId;
    args[0] = i32t;
    val reco: res[type.TypeId, fail.Fail] = type.intern_nominal(?ti, 8::intern.StrId, t_owner(5), type.TYPE_REC);
    if (sel reco.err) {
        type.dnit(?ti);
        ret 1;
    }
    val insto: res[type.TypeId, fail.Fail] = type.intern_instance(?ti, reco.ok, ?args[0], 1);
    if (sel insto.err) {
        type.dnit(?ti);
        ret 1;
    }
    val inst: type.TypeId = insto.ok;

    val no:   opt[Nominal] = nominal_of(?ti, inst);
    var fail: bool         = false;
    if (sel no.some) {
        val n: Nominal = no.some;
        if (n.file != 5::src.FileId)      { fail = true; }
        if (n.name != 8::intern.StrId)    { fail = true; }
        if (n.kind != type.TYPE_INSTANCE) { fail = true; }
    }
    or { fail = true; }

    type.dnit(?ti);
    if (fail) { ret 1; }
    ret 0;
}

test nominal_of_returns_none_for_a_type_that_is_not_nominal {
    var pa: Allocator;
    page.make(?pa);
    var ti: type.TypeInterner;
    if (!type_init_ok(?ti, ?pa)) { ret 1; }
    var fail: bool             = false;
    val i32o: opt[type.TypeId] = type.prim(?ti, type.TYPE_I32);
    if (sel i32o.some) {
        val prim_o: opt[Nominal] = nominal_of(?ti, i32o.some);
        if (sel prim_o.some) { fail = true; }
    }
    or { fail = true; }
    val nil_o: opt[Nominal] = nominal_of(?ti, type.TYPE_NIL);
    val err_o: opt[Nominal] = nominal_of(?ti, type.TYPE_ERROR);
    if (sel nil_o.some) { fail = true; }
    if (sel err_o.some) { fail = true; }
    type.dnit(?ti);
    if (fail) { ret 1; }
    ret 0;
}

#[testing]
fun type_init_ok(ti: *type.TypeInterner, pa: *Allocator) bool {
    val r: err[fail.Fail] = type.init(ti, pa);
    ret sel r.ok;
}

#[testing]
fun t_owner(file: u32) type.TypeOwner {
    var o: type.TypeOwner;
    o.module = file;
    o.file   = file::src.FileId;
    ret o;
}
