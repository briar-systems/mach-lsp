# pure helpers over sema's typing output
#
# the feature layer reads per-expression types and the nominal back-link from a
# record TypeId to its declaring module here, so the resolution rules live in one
# place - and, being free of any session / project state, are unit-testable in
# isolation. `project.mach` re-exports these through its own narrowed accessors so
# no feature signature carries a `*sess.Session`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use std.types.option.opt;

use std.types.result.res;

use std.allocator.Allocator;
use std.allocator.page;

use mach.base.intern;
use src: mach.base.source;
use mach.front.ast;
use adecl: mach.front.ast.decl;
use mach.front.ast.id;
use mach.front.ast.module;
use sema_product: mach.front.sema.product;
use sess:         mach.session;
use lmodule:      mach.session.module;
use mach.type;
use type_kind: mach.type.kind;
use mls.positions;

use mach.base.fail;
use std.types.error.err;

# the declaration site a record / union / tag TypeId nominally refers to -
# the back-link a field feature follows from a value's type to the declaration
# whose fields it must walk. the type table names a nominal by its declaring
# file and its interned name; `nominal_decl` turns that into a DeclId against
# the file's Ast. a generic instance resolves to its template
# ---
# file: FileId of the declaring source file
# name: interned declaration name
# kind: the resolved type kind (TYPE_REC, TYPE_UNI, TYPE_TAG, or TYPE_INSTANCE)
pub rec Nominal {
    file: src.FileId;
    name: intern.StrId;
    kind: type_kind.TypeKind;
}

# the semantic type of expression `eid` in `sr`, or TYPE_NIL when `sr`
# is nil or `eid` is out of range. the one read the feature layer makes against a
# buffer's / module's SemaResult to learn an expression's type
# ---
# sr:  the module's / buffer's SemaResult, or nil
# eid: the expression id to type
# ret: the expression's TypeId, or TYPE_NIL when unavailable
pub fun type_of(sr: *sema_product.SemaResult, eid: id.ExprId) type_kind.TypeId {
    if (sr == nil || sr.expr_type == nil)    { ret type_kind.TYPE_NIL; }
    if (id.expr_index(eid) >= sr.expr_count) { ret type_kind.TYPE_NIL; }
    ret sr.expr_type[id.expr_index(eid)];
}

# the declared (or inferred) type of decl `did` in `sr`, or
# TYPE_NIL when `sr` is nil or `did` is out of range. the decl-keyed twin of
# `type_of`, for typing a binding from its declaration rather than a use
# ---
# sr:  the module's / buffer's SemaResult, or nil
# did: the declaration id to type
# ret: the declaration's TypeId, or TYPE_NIL when unavailable
pub fun decl_type_of(sr: *sema_product.SemaResult, did: id.DeclId) type_kind.TypeId {
    if (sr == nil || sr.decl_type == nil)    { ret type_kind.TYPE_NIL; }
    if (id.decl_index(did) >= sr.decl_count) { ret type_kind.TYPE_NIL; }
    ret sr.decl_type[id.decl_index(did)];
}

# the semantic type an Ast type node denotes, or TYPE_NIL when `sr`
# is nil or `tid` is out of range. the type-position twin of `type_of`: a cursor
# on a written type (`var b: Box[i32];`, a field's declared type, a return type)
# is neither an expression nor a declaration, and this is the only table that
# carries what it resolved to
# ---
# sr:  the module's / buffer's SemaResult, or nil
# tid: the Ast type id to resolve
# ret: the written type's TypeId, or TYPE_NIL when unavailable
pub fun type_ref_of(sr: *sema_product.SemaResult, tid: id.TypeId) type_kind.TypeId {
    if (sr == nil || sr.type_resolved_ty == nil) { ret type_kind.TYPE_NIL; }
    if (id.type_index(tid) >= sr.type_count)     { ret type_kind.TYPE_NIL; }
    ret sr.type_resolved_ty[id.type_index(tid)];
}

# the declaration site a record / union TypeId nominally refers to,
# or none when `tid` is not a nominal type (a primitive, pointer, array, function,
# generic parameter, or a sentinel). a pointer to a record is peeled to the record
# first, so `*T` and `T` resolve to the same declaration - a field access through a
# pointer reaches the same `rec` decl. a generic instance resolves to its template
# declaration. this is the nominal back-link a field go-to-def / rename follows
# ---
# ti:  the session's type interner
# tid: the TypeId to resolve
# ret: some(Nominal) for a nominal / instance type, none otherwise
pub fun nominal_of(ti: *type.TypeInterner, tid: type_kind.TypeId) opt[Nominal] {
    if (type_kind.is_nil(tid) || type_kind.is_error(tid)) { ret opt[Nominal].none{}; }
    val opt_tid_entry: opt[*type.Type] = type.get(ti, tid);
    if (sel opt_tid_entry.none) { ret opt[Nominal].none{}; }
    val t: *type.Type = opt_tid_entry.some;

    # peel a single pointer level: a field access through `*T` resolves to T's decl.
    if (t.kind == type_kind.TYPE_POINTER) {
        ret nominal_of(ti, t.data.pointer.base);
    }
    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI || t.kind == type_kind.TYPE_TAG) {
        var n: Nominal;
        n.file = t.data.nominal.owner.file;
        n.name = t.data.nominal.name;
        n.kind = t.kind;
        ret opt[Nominal].some{n};
    }
    if (t.kind == type_kind.TYPE_INSTANCE) {
        val opt_inner: opt[Nominal] = nominal_of(ti, t.data.instance.nominal);
        if (sel opt_inner.none) { ret opt_inner; }
        var n: Nominal = opt_inner.some;
        n.kind = t.kind;
        ret opt[Nominal].some{n};
    }
    ret opt[Nominal].none{};
}

# the module-scope declaration in `a` that `n` names, or none when the Ast
# declares no rec / uni / tag of that name. `a` and `text` must be the Ast and
# text of `n.file`; the caller chooses them, since only it knows whether the
# file is a loaded project module or the live buffer
# ---
# a:    the declaring file's Ast
# text: the declaring file's text
# itn:  the interner `n.name` was interned in
# n:    the nominal to find
# ret:  the DeclId, or none
pub fun nominal_decl(a: *ast.Ast, text: positions.Text, itn: *intern.Interner, n: Nominal) opt[id.DeclId] {
    if (a == nil || itn == nil) { ret opt[id.DeclId].none{}; }
    val opt_want: opt[str] = intern.get(itn, n.name);
    if (sel opt_want.none) { ret opt[id.DeclId].none{}; }
    val opt_module: opt[*module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret opt[id.DeclId].none{}; }
    val m: *module.Module = opt_module.some;
    var i: u32            = 0;
    for (i < m.decls_len) {
        val did:      id.DeclId        = a.decl_ids.data[m.decls_start + i];
        val opt_decl: opt[*adecl.Decl] = ast.get_decl(a, did);
        if (sel opt_decl.some) {
            val d:     *adecl.Decl = opt_decl.some;
            var name:  src.Span;
            var named: bool        = true;
            if (d.kind == adecl.DECL_KIND_REC)                             { name = d.data.rec_.name; }
            or (d.kind == adecl.DECL_KIND_UNI)                             { name = d.data.uni_.name; }
            or (d.kind == adecl.DECL_KIND_TAG)                             { name = d.data.tag_.name; }
            or                                                             { named = false; }
            if (named && positions.span_equals(text, name, opt_want.some)) { ret opt[id.DeclId].some{did}; }
        }
        i = i + 1;
    }
    ret opt[id.DeclId].none{};
}

test nominal_of_peels_a_pointer_to_the_pointee_record {
    var pa: Allocator;
    page.make(?pa);
    var ti: type.TypeInterner;
    if (!type_init_ok(?ti, ?pa)) { ret 1; }

    val res_intern_nominal: res[type_kind.TypeId, fail.Fail] = type.intern_nominal(?ti, intern.str_id(4), t_owner(2), type_kind.TYPE_REC);
    if (sel res_intern_nominal.err) {
        type.dnit(?ti);
        ret 1;
    }
    val rec:                type_kind.TypeId                 = res_intern_nominal.ok;
    val res_intern_pointer: res[type_kind.TypeId, fail.Fail] = type.intern_pointer(?ti, rec);
    if (sel res_intern_pointer.err) {
        type.dnit(?ti);
        ret 1;
    }
    val ptr: type_kind.TypeId = res_intern_pointer.ok;

    val opt_nominal_of: opt[Nominal] = nominal_of(?ti, ptr);
    var fail:           bool         = false;
    if (sel opt_nominal_of.some) {
        val n: Nominal = opt_nominal_of.some;
        if (!src.file_same(n.file, src.file_id(2)))     { fail = true; }
        if (!intern.str_same(n.name, intern.str_id(4))) { fail = true; }
        if (n.kind != type_kind.TYPE_REC)               { fail = true; }
    }
    or { fail = true; }

    type.dnit(?ti);
    if (fail) { ret 1; }
    ret 0;
}

test nominal_of_maps_a_generic_instance_to_its_template {
    var pa: Allocator;
    page.make(?pa);
    var ti: type.TypeInterner;
    if (!type_init_ok(?ti, ?pa)) { ret 1; }

    val opt_prim: opt[type_kind.TypeId] = type.prim(?ti, type_kind.TYPE_I32);
    if (sel opt_prim.none) {
        type.dnit(?ti);
        ret 1;
    }
    val i32t: type_kind.TypeId = opt_prim.some;
    var args: [1]type_kind.TypeId;
    args[0] = i32t;
    val res_intern_nominal: res[type_kind.TypeId, fail.Fail] = type.intern_nominal(?ti, intern.str_id(8), t_owner(5), type_kind.TYPE_REC);
    if (sel res_intern_nominal.err) {
        type.dnit(?ti);
        ret 1;
    }
    val res_intern_instance: res[type_kind.TypeId, fail.Fail] = type.intern_instance(?ti, res_intern_nominal.ok, ?args[0], 1);
    if (sel res_intern_instance.err) {
        type.dnit(?ti);
        ret 1;
    }
    val inst: type_kind.TypeId = res_intern_instance.ok;

    val opt_nominal_of: opt[Nominal] = nominal_of(?ti, inst);
    var fail:           bool         = false;
    if (sel opt_nominal_of.some) {
        val n: Nominal = opt_nominal_of.some;
        if (!src.file_same(n.file, src.file_id(5)))     { fail = true; }
        if (!intern.str_same(n.name, intern.str_id(8))) { fail = true; }
        if (n.kind != type_kind.TYPE_INSTANCE)          { fail = true; }
    }
    or { fail = true; }

    type.dnit(?ti);
    if (fail) { ret 1; }
    ret 0;
}

test nominal_of_returns_none_for_a_type_that_is_not_nominal {
    var pa: Allocator;
    page.make(?pa);
    var ti: type.TypeInterner;
    if (!type_init_ok(?ti, ?pa)) { ret 1; }
    var fail:     bool                  = false;
    val opt_prim: opt[type_kind.TypeId] = type.prim(?ti, type_kind.TYPE_I32);
    if (sel opt_prim.some) {
        val opt_prim: opt[Nominal] = nominal_of(?ti, opt_prim.some);
        if (sel opt_prim.some) { fail = true; }
    }
    or { fail = true; }
    val opt_nil:        opt[Nominal] = nominal_of(?ti, type_kind.TYPE_NIL);
    val opt_nominal_of: opt[Nominal] = nominal_of(?ti, type_kind.TYPE_ERROR);
    if (sel opt_nil.some)        { fail = true; }
    if (sel opt_nominal_of.some) { fail = true; }
    type.dnit(?ti);
    if (fail) { ret 1; }
    ret 0;
}

#[testing]
fun type_init_ok(ti: *type.TypeInterner, pa: *Allocator) bool {
    val err_type_made: err[fail.Fail] = type.init(ti, pa);
    ret sel err_type_made.ok;
}

#[testing]
fun t_owner(file: u32) type.TypeOwner {
    var o: type.TypeOwner;
    o.module = lmodule.stable_id(file);
    o.file   = src.file_id(file);
    ret o;
}
