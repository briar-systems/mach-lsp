# whether a rename's new name keeps each file it touches meaning the same (#286)
#
# A rename changes the spelling of some identifiers and nothing else. Two things
# can make that untrue, and each is checked on its own terms:
#
#   - the new name is not one identifier, or is a word the grammar reads as
#     something else where it now stands (`foo(1);` renamed to `ret` is a
#     return). Mach's keywords are contextual, so no list of reserved words
#     answers this. Each edited file is parsed again instead, and must produce
#     the same tree, node for node, as before;
#   - the new name is already bound where the renamed symbol is declared or
#     used. That is a question for the resolver's symbol tables, which the
#     caller answers (`language`).

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator;
use std.allocator.Allocator;
use std.allocator.allocate;
use std.allocator.deallocate;
use std.allocator.reallocate;

use mem: std.memory;

use mach.lang.diagnostic;
use mach.lang.editor;
use mach.lang.fail;
use src: mach.lang.source;

# the spans one file's rename rewrites, in the order they were found
pub rec Spans {
    alloc: *Allocator;
    items: *src.Span;
    len:   usize;
    cap:   usize;
}

pub fun spans_init(alloc: *Allocator) Spans {
    ret Spans{alloc: alloc, items: nil, len: 0, cap: 0};
}

pub fun spans_dnit(s: *Spans) {
    if (s.items != nil) { deallocate[src.Span](s.alloc, s.items, s.cap); }
    s.items = nil;
    s.len   = 0;
    s.cap   = 0;
}

# forget the spans, keeping the storage
pub fun spans_clear(s: *Spans) {
    s.len = 0;
}

# ret: false when memory ran out
pub fun spans_push(s: *Spans, span: src.Span) bool {
    if (s.len == s.cap) {
        var cap: usize = s.cap * 2;
        if (cap == 0) { cap = 16; }
        if (s.items == nil) {
            val r: res[*src.Span, allocator.Error] = allocate[src.Span](s.alloc, cap);
            if (sel r.err) { ret false; }
            s.items = r.ok;
        }
        or {
            val r: res[*src.Span, allocator.Error] = reallocate[src.Span](s.alloc, s.items, s.cap, cap);
            if (sel r.err) { ret false; }
            s.items = r.ok;
        }
        s.cap = cap;
    }
    s.items[s.len] = span;
    s.len          = s.len + 1;
    ret true;
}

# whether `name` is exactly one identifier token
pub fun identifier(alloc: *Allocator, name: str) bool {
    val r: res[bool, fail.Fail] = editor.is_identifier(alloc, name);
    if (sel r.err) { ret false; }
    ret r.ok;
}

# `text` with every span replaced by `name`, owned, or nil when memory ran out.
# the spans are sorted and a repeated span is applied once. release with
# `applied_free`
pub fun apply(alloc: *Allocator, text: str, spans: *Spans, name: str) str {
    sort(spans);
    val n:    usize = str_len(text);
    val repl: usize = str_len(name);
    var size: usize = 1;
    var from: usize = 0;
    var i:    usize = 0;
    for (i < spans.len) {
        val s: src.Span = spans.items[i];
        if (s.offset >= from && s.offset + s.len <= n) {
            size = size + (s.offset - from) + repl;
            from = s.offset + s.len;
        }
        i = i + 1;
    }
    size = size + (n - from);
    val r: res[*u8, allocator.Error] = allocate[u8](alloc, size);
    if (sel r.err) { ret nil; }
    val out: *u8 = r.ok;

    var at: usize = 0;
    from = 0;
    i    = 0;
    for (i < spans.len) {
        val s: src.Span = spans.items[i];
        if (s.offset >= from && s.offset + s.len <= n) {
            copy(out, ?at, text, from, s.offset - from);
            copy(out, ?at, name, 0, repl);
            from = s.offset + s.len;
        }
        i = i + 1;
    }
    copy(out, ?at, text, from, n - from);
    out[at] = 0;
    ret out::str;
}

# release a string from `apply`
pub fun applied_free(alloc: *Allocator, text: str) {
    if (text == nil) { ret; }
    deallocate[u8](alloc, text::*u8, str_len(text) + 1);
}

fun copy(out: *u8, at: *usize, from: str, offset: usize, len: usize) {
    if (len == 0) { ret; }
    mem.raw_copy((?out[@at])::ptr, (?from[offset])::ptr, len);
    @at = @at + len;
}

fun sort(s: *Spans) {
    var i: usize = 1;
    for (i < s.len) {
        val cur: src.Span = s.items[i];
        var j:   usize    = i;
        for (j > 0 && s.items[j - 1].offset > cur.offset) {
            s.items[j] = s.items[j - 1];
            j          = j - 1;
        }
        s.items[j] = cur;
        i          = i + 1;
    }
}

# what re-parsing an edited file found
pub val SHAPE_SAME:      u8 = 0;
pub val SHAPE_CHANGED:   u8 = 1;
pub val SHAPE_UNCHECKED: u8 = 2;

# whether `after` parses to the same tree as `before`, node for node, with no
# more errors. a file whose parse is not accepted before cannot be checked
pub fun shape(alloc: *Allocator, before: str, after: str) u8 {
    var b: res[editor.AnalysisResult, fail.Fail] = editor.parse_text(alloc, before);
    if (sel b.err) { ret SHAPE_UNCHECKED; }
    var out: u8 = SHAPE_UNCHECKED;
    if (sel b.ok.failure.none && fail.is_accepted(b.ok.status)) {
        out = SHAPE_CHANGED;
        var a: res[editor.AnalysisResult, fail.Fail] = editor.parse_text(alloc, after);
        if (sel a.ok) {
            if (sel a.ok.failure.none && fail.is_accepted(a.ok.status)
                && diagnostic.error_count(a.ok.diagnostics) <= diagnostic.error_count(b.ok.diagnostics)) {
                val same: res[bool, fail.Fail] = editor.same_shape(?b.ok, ?a.ok);
                if (sel same.ok) {
                    if (same.ok) { out = SHAPE_SAME; }
                }
            }
            editor.analysis_dnit(?a.ok);
        }
    }
    editor.analysis_dnit(?b.ok);
    ret out;
}

use std.allocator.page;
use std.types.string.str_equals;

test an_identifier_is_one_identifier_token_and_nothing_else {
    var pa: Allocator;
    page.make(?pa);
    var fail: bool = false;
    if (!identifier(?pa, "renamed_1")) { fail = true; }
    if (!identifier(?pa, "_x"))        { fail = true; }
    if (identifier(?pa, ""))           { fail = true; }
    if (identifier(?pa, "has space"))  { fail = true; }
    if (identifier(?pa, "x.y"))        { fail = true; }
    if (identifier(?pa, "1bad"))       { fail = true; }
    if (identifier(?pa, "a-b"))        { fail = true; }
    if (identifier(?pa, "x # note"))   { fail = true; }
    if (identifier(?pa, "\"s\""))      { fail = true; }
    if (fail)                          { ret 1; }
    ret 0;
}

test spans_apply_in_order_once_each {
    var pa: Allocator;
    page.make(?pa);
    var s: Spans = spans_init(?pa);
    spans_push(?s, src.Span{offset: 8, len: 3});
    spans_push(?s, src.Span{offset: 0, len: 3});
    spans_push(?s, src.Span{offset: 8, len: 3});
    val out:  str  = apply(?pa, "foo(); (foo);", ?s, "barbaz");
    var fail: bool = out == nil || !str_equals(out, "barbaz(); (barbaz);");
    applied_free(?pa, out);
    spans_dnit(?s);
    if (fail) { ret 1; }
    ret 0;
}

test a_rename_that_changes_what_the_grammar_reads_is_refused {
    var pa: Allocator;
    page.make(?pa);
    var fail: bool = false;
    val base: str  = "fun foo(n: i32) i32 { ret n; }\nfun main() i32 { foo(1); val a: i32 = foo(2); ret a; }\n";
    if (shape(?pa, base, "fun bar(n: i32) i32 { ret n; }\nfun main() i32 { bar(1); val a: i32 = bar(2); ret a; }\n") != SHAPE_SAME)    { fail = true; }
    if (shape(?pa, base, "fun ret(n: i32) i32 { ret n; }\nfun main() i32 { ret(1); val a: i32 = ret(2); ret a; }\n") != SHAPE_CHANGED) { fail = true; }
    if (shape(?pa, base, "fun if(n: i32) i32 { ret n; }\nfun main() i32 { if(1); val a: i32 = if(2); ret a; }\n") != SHAPE_CHANGED)    { fail = true; }
    # where the grammar reads a contextual keyword as a name, the rename stands
    if (shape(?pa, base, "fun fun(n: i32) i32 { ret n; }\nfun main() i32 { fun(1); val a: i32 = fun(2); ret a; }\n") != SHAPE_SAME) { fail = true; }
    if (shape(?pa, "fun f(x: i32) i32 { ret x; }\n", "fun f(ret: i32) i32 { ret ret; }\n") != SHAPE_SAME)                           { fail = true; }
    if (shape(?pa, "fun f() i32 { ret \"open; }\n", "fun g() i32 { ret \"open; }\n") != SHAPE_UNCHECKED)                            { fail = true; }
    if (fail)                                                                                                                       { ret 1; }
    ret 0;
}
