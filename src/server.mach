# top-level server state, lifecycle, message loop, and dispatch
#
# owns the long-lived state of one server process: the lifecycle status, the
# allocator, the compiler `session.Session` (SourceMap + DiagList), the
# `editor.EditorSession` (per-buffer analysis), and the document registry that
# binds LSP URIs to editor buffers. `run` reads framed messages until exit;
# `dispatch` routes each by method. this slice implements the lifecycle and the
# document-synchronization notifications that drive diagnostics; unimplemented
# language-feature requests are answered with a `method not found` error.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.allocator.Allocator;
use std.allocator.allocate;
use std.allocator.deallocate;

use mem:     std.memory;
use strutil: std.text.string;

use mach.lang.editor;
use sess: mach.lang.session;
use src:  mach.lang.source;

use mls.actions;
use mls.callhierarchy;
use mls.diagnostics;
use mls.documents;
use mls.hints;
use mls.jobs;
use mls.json;
use mls.language;
use mls.parked;
use mls.positions;
use mls.progress;
use mls.project;
use mls.render;
use mls.settings;
use mls.sideband;
use mls.signature;
use mls.textedit;
use mls.tokens;
use mls.trace;
use mls.transport;
use mls.uris;
use mls.version;
use mls.workspace;
use sj: std.data.json;
use std.process.exec;
use std.sync.atomic;

use mach.lang.fail;
# lifecycle statuses
pub val STATUS_UNINITIALIZED: u8 = 0;
pub val STATUS_RUNNING:       u8 = 1;
pub val STATUS_SHUTTING_DOWN: u8 = 2;
pub val STATUS_EXITED:        u8 = 3;
# language features, as dispatch selectors
val FEATURE_HOVER:              u8 = 0;
val FEATURE_DEFINITION:         u8 = 1;
val FEATURE_REFERENCES:         u8 = 2;
val FEATURE_RENAME:             u8 = 3;
val FEATURE_PREPARE_RENAME:     u8 = 4;
val FEATURE_DOCUMENT_SYMBOL:    u8 = 5;
val FEATURE_COMPLETION:         u8 = 6;
val FEATURE_DOCUMENT_HIGHLIGHT: u8 = 7;
val FEATURE_SIGNATURE_HELP:     u8 = 8;
val FEATURE_INLAY_HINT:         u8 = 9;
val FEATURE_SEMANTIC_TOKENS:    u8 = 10;
val FEATURE_CODE_ACTION:        u8 = 11;
val FEATURE_TYPE_DEFINITION:    u8 = 12;
val FEATURE_CALL_PREPARE:       u8 = 13;
val FEATURE_CALL_INCOMING:      u8 = 14;
val FEATURE_CALL_OUTGOING:      u8 = 15;

# LSP RequestCancelled
val REQUEST_CANCELLED: i64 = -32800;

# JSON-RPC InternalError
val INTERNAL_ERROR: i64 = -32603;

val WATCH_FALLBACK: u8 = 0;
val WATCH_PENDING:  u8 = 1;
val WATCH_ACTIVE:   u8 = 2;

# the long-lived server state
# ---
# status:         current lifecycle phase
# exit_code:      process exit code to return from `run`
# alloc:          allocator backing all server-owned memory
# s:              compiler session (SourceMap + DiagList)
# es:             editor session over `s` (per-buffer analysis)
# docs:           URI -> editor buffer registry
# ws:             per-root project graphs backing cross-module analysis
# rd:             per-message JSON parse arena, owned by the analysis thread
# q:              message queue feeding the analysis thread
# cancels:        ids the client has withdrawn, written by the reading thread
# rd_client:      the READING thread's parse arena, private to it
# stop:           set once the reading thread should stop; read atomically
# deferred:       a document changed but its analysis was postponed behind newer
#                 input, and must run once the queue drains
# hover_markdown: whether the client renders markdown hover content
# watch_dynamic:  whether the client supports dynamic file-watch registration
#                 (`workspace/didChangeWatchedFiles`), advertised at initialize
# held:           requests waiting for a snapshot that has caught up (#251)
# holding:        the message being handled was held rather than answered
# body:           the text of the message being handled, for holding it
# body_len:       byte length of `body`
# refresh_tokens: the client re-requests semantic tokens when asked
# refresh_hints:  the client re-requests inlay hints when asked
# served_stale:   an answer came from a snapshot behind its buffer since the
#                 last swap, so the client is asked to refresh after the next
# refresh_seq:    ids for the refresh requests the server sends
pub rec Server {
    status:         u8;
    exit_code:      i64;
    alloc:          *Allocator;
    s:              sess.Session;
    es:             editor.EditorSession;
    docs:           documents.Store;
    ws:             project.Workspace;
    rd:             json.Reader;
    q:              jobs.Queue;
    cancels:        jobs.Cancels;
    rd_client:      json.Reader;
    stop:           i64;
    deferred:       bool;
    hover_markdown: bool;
    watch_dynamic:  bool;
    watch_state:    u8;
    held:           parked.Queue;
    holding:        bool;
    body:           str;
    body_len:       usize;
    refresh_tokens: bool;
    refresh_hints:  bool;
    served_stale:   bool;
    refresh_seq:    u64;
}

# build a server over the given allocator
# ---
# srv:   server to initialize
# alloc: allocator backing all server-owned memory; must outlive the server
# ret:   true on success, false when the compiler session fails to initialize
pub fun init(srv: *Server, alloc: *Allocator) bool {
    srv.status         = STATUS_UNINITIALIZED;
    srv.exit_code      = 0;
    srv.alloc          = alloc;
    srv.watch_dynamic  = false;
    srv.watch_state    = WATCH_FALLBACK;
    srv.held           = parked.init(alloc);
    srv.holding        = false;
    srv.body           = nil;
    srv.body_len       = 0;
    srv.refresh_tokens = false;
    srv.refresh_hints  = false;
    srv.served_stale   = false;
    srv.refresh_seq    = 0;

    val sr: res[sess.Session, fail.Fail] = sess.init(alloc);
    if (sel sr.err) { ret false; }
    srv.s = sr.ok;

    srv.es   = editor.init(?srv.s);
    srv.docs = documents.init(?srv.es, alloc);
    srv.ws   = project.init(?srv.s, alloc);
    project.attach_documents(?srv.ws, ?srv.docs);
    if (!json.reader_init(?srv.rd, alloc)) { ret false; }
    srv.stop           = 0;
    srv.deferred       = false;
    srv.hover_markdown = true;
    if (!jobs.init(?srv.q, alloc))                { ret false; }
    if (!jobs.cancels_init(?srv.cancels, alloc))  { ret false; }
    if (!json.reader_init(?srv.rd_client, alloc)) { ret false; }
    ret true;
}

# tear down the server's owned state
# ---
# srv: server to tear down
pub fun dnit(srv: *Server) {
    parked.dnit(?srv.held);
    jobs.dnit(?srv.q);
    jobs.cancels_dnit(?srv.cancels);
    json.reader_dnit(?srv.rd_client);
    json.reader_dnit(?srv.rd);
    documents.dnit(?srv.docs);
    project.dnit(?srv.ws);
    editor.dnit(?srv.es);
    sess.dnit(?srv.s);
    srv.status = STATUS_EXITED;
}

# read framed messages until input ends, handing each to the analysis thread
#
# This thread owns stdin and nothing else. Every message - parsing included -
# is handled on the worker, so the compiler's state has exactly one owner and
# needs no locking, and a cold analysis cannot stop the server from reading the
# cancellation, edit, or shutdown that follows it.
#
# The worker decides the exit code, so the read loop drains the queue before
# reading it: an EOF arriving while `shutdown` is still queued must not be
# mistaken for input closing before shutdown.
# ---
# srv: the server to drive
# ret: the process exit code
pub fun run(srv: *Server) i64 {
    trace.log("=== mach-lsp started ===\n");

    if (!jobs.start(?srv.q, handle_job, handle_signal, (srv)::ptr)) {
        trace.log("server: could not start the analysis thread\n");
        ret 1;
    }
    # a project rebuild is seconds of compiler work, and run on the analysis
    # thread it stops the server answering anything for its whole duration.
    # without the worker every build runs inline, which is correct but slow, so
    # a failure to spawn is reported and not fatal.
    if (!project.start_builder(?srv.ws, wake_analysis, (srv)::ptr)) {
        trace.log("server: could not start the build thread; rebuilds will block analysis\n");
    }

    var last_read: transport.ReadStatus = transport.READ_OK;
    for (true) {
        var msg: transport.Message;
        last_read = transport.read_message(?msg, srv.alloc);
        if (last_read != transport.READ_OK) {
            if (last_read == transport.READ_EOF)       { trace.log("transport: input closed\n"); }
            or (last_read == transport.READ_MALFORMED) { trace.log("transport: malformed input frame\n"); }
            or                                         { trace.log("transport: input error\n"); }
            brk;
        }

        # a cancellation is handled HERE rather than queued: queued, it would be
        # dequeued after the request it withdraws had already run
        if (!intercept_cancel(srv, msg.body, msg.body_len)) {
            if (!jobs.push(?srv.q, msg.body, msg.body_len)) {
                trace.logf("server: analysis queue full at {} messages, dropping input",
                    jobs.depth(?srv.q)::i64);
            }
        }
        transport.message_free(?msg, srv.alloc);
        if (atomic.load(?srv.stop) != 0) { brk; }
    }

    # every accepted message is answered before the exit code is decided
    jobs.join(?srv.q);
    settings.settle_trace(srv.alloc);
    trace.log("=== mach-lsp exiting ===\n");

    if (transport.write_failed())                                              { ret 1; }
    if (srv.status == STATUS_EXITED)                                           { ret srv.exit_code; }
    if (last_read == transport.READ_EOF && srv.status == STATUS_SHUTTING_DOWN) { ret 0; }
    ret 1;
}

# record a `$/cancelRequest` and report whether the message was one
#
# Runs on the READING thread, with its own parse arena, so it never touches the
# worker's. The substring test is a cheap negative filter, not the decision: a
# body that contains the text is still parsed and checked structurally, so a
# document whose own source mentions the method cannot be mistaken for one.
fun intercept_cancel(srv: *Server, body: str, len: usize) bool {
    if (body == nil)                            { ret false; }
    if (!str_contains(body, "$/cancelRequest")) { ret false; }

    var parsed:  json.Message = json.read(?srv.rd_client, body, len);
    var handled: bool         = false;
    if (parsed.valid) {
        if (json.text_equals(json.member(?parsed.root, "method"), "$/cancelRequest", srv.alloc)) {
            val id_token: str = json.id_text(
                json.member(json.member(?parsed.root, "params"), "id"), srv.alloc);
            if (id_token != nil) {
                jobs.cancel_add(?srv.cancels, id_token);
                trace.logf("server: cancel requested for id {}", id_token);
                json.free_str(id_token, srv.alloc);
                # a held request is not in the queue, so nothing would look at the
                # cancellation until the next message; wake the analysis thread
                jobs.signal(?srv.q);
            }
            handled = true;
        }
    }
    json.release(?srv.rd_client);
    ret handled;
}

# record which message this was, without recording what it carried
#
# The method and id are the parts a reader actually needs to follow a session -
# what arrived, in what order, and which response answered which request - and
# neither is user content, so they are recorded whether or not bodies are.
fun trace_method(srv: *Server, root: *sj.Value) {
    if (!trace.enabled()) { ret; }
    val m: str = json.text(json.member(root, "method"), srv.alloc);
    val i: str = json.id_text(json.member(root, "id"), srv.alloc);
    if (m != nil && i != nil) { trace.logf("  method {} id {}", m, i); }
    or (m != nil)             { trace.logf("  method {}", m); }
    or (i != nil)             { trace.logf("  id {}", i); }
    if (m != nil)             { json.free_str(m, srv.alloc); }
    if (i != nil)             { json.free_str(i, srv.alloc); }
}

# handle one queued message on the analysis thread
#
# The parse arena and every compiler-owned structure belong to this thread.
fun handle_job(ctx: ptr, body: str, len: usize) {
    val srv: *Server = ctx::*Server;
    sideband.next(srv.alloc);

    # a message boundary is the only place a rebuilt snapshot may be swapped in,
    # because it is the only place no request holds a pointer into the outgoing
    # session. doing it before dispatch also means this message is answered from
    # the freshest snapshot that has actually finished building.
    collect_rebuilds(srv);

    trace.frame("recv:", body, len);

    val started_ns: i64          = trace.now_ns();
    var parsed:     json.Message = json.read(?srv.rd, body, len);
    srv.body     = body;
    srv.body_len = len;
    if (parsed.valid) {
        trace_method(srv, ?parsed.root);
        dispatch(srv, ?parsed.root);
    }
    or { reply_parse_error(srv); }
    json.release(?srv.rd);
    srv.body     = nil;
    srv.body_len = 0;

    # a coalesced burst leaves the newest text unanalyzed; the moment the queue
    # drains is when that debt comes due, whatever the last message happened to
    # be. deferring analysis must never mean skipping it.
    if (srv.deferred && jobs.depth(?srv.q) == 0 && srv.status == STATUS_RUNNING) {
        srv.deferred = false;
        republish_all(srv);
    }
    # with the queue drained the analysis thread is about to idle, and the only
    # other place it pumps is before the NEXT message. pump once more here so a
    # cold spare's warm-up, or a rebuild an edit just made due, starts now rather
    # than waiting for a message that idle may never bring (#252)
    if (jobs.depth(?srv.q) == 0 && srv.status == STATUS_RUNNING) {
        collect_rebuilds(srv);
    }
    trace.logf("server: handled message in {}ms", (trace.now_ns() - started_ns) / 1000000);

    if (srv.status == STATUS_EXITED || transport.write_failed()) {
        atomic.store(?srv.stop, 1);
    }
}

# swap in any finished rebuild and republish what it moved
#
# Runs on the analysis thread only.
fun collect_rebuilds(srv: *Server) {
    val moved: u8 = project.pump(?srv.ws, jobs.depth(?srv.q) == 0);
    if (srv.status != STATUS_RUNNING) { ret; }
    if (moved == project.PUMP_SWAPPED) {
        republish_all(srv);
        request_refresh(srv);
    }
    release_held(srv);
}

# answer every held request that no longer has anything to wait for: its root
# caught up, its awaited build failed, or the client withdrew it. the rest keep
# their place, in arrival order. runs only where no parse tree is live
fun release_held(srv: *Server) {
    if (srv.held.len == 0) { ret; }
    var batch: parked.Queue = parked.take(?srv.held);
    var i:     usize        = 0;
    for (i < batch.len) {
        val e: *parked.Entry = ?batch.items[i];
        if (jobs.cancel_has(?srv.cancels, e.id) || !still_waiting(srv, e)) {
            sideband.held(srv.alloc, e.id, false);
            redispatch(srv, e);
        }
        or {
            if (!parked.push(?srv.held, e.body, e.len, e.uri, e.id)) {
                send_error_token(srv, e.id, render.CONTENT_MODIFIED, "the request could not be held");
            }
        }
        i = i + 1;
    }
    parked.dnit(?batch);
}

# whether a held request's document still has a catching-up build on its way
fun still_waiting(srv: *Server, e: *parked.Entry) bool {
    val d: *documents.Document = documents.find(?srv.docs, e.uri);
    if (d == nil) { ret false; }
    ret project.current_pending(?srv.ws, d);
}

# run a held request as if it had just arrived
fun redispatch(srv: *Server, e: *parked.Entry) {
    var parsed: json.Message = json.read(?srv.rd, e.body, e.len);
    srv.body     = e.body;
    srv.body_len = e.len;
    if (parsed.valid) { dispatch(srv, ?parsed.root); }
    or                { send_error_token(srv, e.id, INTERNAL_ERROR, "a held request could not be read back"); }
    json.release(?srv.rd);
    srv.body     = nil;
    srv.body_len = 0;
}

# answer every held request for `uri`, or all of them when `uri` is nil, with
# ContentModified: what they were waiting to answer about is gone
fun abandon_held(srv: *Server, uri: str, message: str) {
    if (srv.held.len == 0) { ret; }
    var batch: parked.Queue = parked.take(?srv.held);
    var i:     usize        = 0;
    for (i < batch.len) {
        val e: *parked.Entry = ?batch.items[i];
        if (uri == nil || parked.names(e, uri)) { send_error_token(srv, e.id, render.CONTENT_MODIFIED, message); }
        or {
            if (!parked.push(?srv.held, e.body, e.len, e.uri, e.id)) {
                send_error_token(srv, e.id, render.CONTENT_MODIFIED, "the request could not be held");
            }
        }
        i = i + 1;
    }
    parked.dnit(?batch);
}

# ask the client to re-request what it was given from a stale snapshot
fun request_refresh(srv: *Server) {
    if (!srv.served_stale) { ret; }
    srv.served_stale = false;
    if (srv.refresh_tokens) { send_refresh(srv, "workspace/semanticTokens/refresh"); }
    if (srv.refresh_hints)  { send_refresh(srv, "workspace/inlayHint/refresh"); }
}

fun send_refresh(srv: *Server, method: str) {
    srv.refresh_seq = srv.refresh_seq + 1;
    var b: json.Buf = json.buf_init(srv.alloc);
    json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"id\":\"mls/refresh/");
    json.buf_push_usize(?b, srv.refresh_seq::usize);
    json.buf_push(?b, "\",\"method\":");
    json.buf_push_quoted(?b, method);
    json.buf_push_byte(?b, '}');
    val msg: str = json.buf_str(?b);
    if (msg != nil) { transport.send_message(msg, srv.alloc); }
    json.buf_dnit(?b);
}

# the build worker telling the analysis thread a rebuild is ready
#
# Runs ON THE BUILD WORKER, so it does exactly one thing: wake. Everything that
# touches compiler state, the document store, or the transport happens in
# `handle_signal`, back on the thread that owns them.
fun wake_analysis(ctx: ptr) {
    val srv: *Server = ctx::*Server;
    jobs.signal(?srv.q);
}

# the analysis thread answering that wake
#
# A rebuild that finishes while the client is idle still has to reach the
# editor, so the swap and its republish cannot wait for the next keystroke.
fun handle_signal(ctx: ptr) {
    val srv: *Server = ctx::*Server;
    sideband.next(srv.alloc);
    collect_rebuilds(srv);
}

# a response has an id, no method, and exactly one of `result` or `error`.
fun is_response(root: *sj.Value) bool {
    if (json.member(root, "id") == nil)     { ret false; }
    if (json.member(root, "method") != nil) { ret false; }
    val result: *sj.Value = json.member(root, "result");
    val error:  *sj.Value = json.member(root, "error");
    ret (result != nil && error == nil) || (result == nil && error != nil);
}

# route one parsed message by its `method` member
#
# an unknown method gets a JSON-RPC method-not-found error when it carries an
# id, and is dropped when it does not - a notification owes no response.
fun dispatch(srv: *Server, root: *sj.Value) {
    if (is_response(root)) {
        handle_response(srv, root);
        ret;
    }

    val id: *sj.Value = json.member(root, "id");
    if (id == nil) {
        dispatch_inner(srv, root);
        ret;
    }

    # every request owes exactly one response. A handler can fail to send one
    # for reasons it cannot report - a latched allocation failure in the
    # response buffer, a path that gives up without replying - and a client that
    # never hears back waits forever. Rather than asking every handler to
    # remember, the dispatcher checks and backstops.
    val before: u64 = render.responses();
    srv.holding = false;
    dispatch_inner(srv, root);
    if (srv.holding) {
        # held, to be answered when the snapshot it needs lands
        srv.holding = false;
        ret;
    }
    if (render.responses() == before) {
        trace.log("server: handler produced no response; answering internal error\n");
        send_error(srv, id, INTERNAL_ERROR, "the server produced no response for this request");
    }
}

fun dispatch_inner(srv: *Server, root: *sj.Value) {
    val a:        *Allocator = srv.alloc;
    val method_v: *sj.Value  = json.member(root, "method");
    if (method_v == nil) {
        reply_invalid_request(srv, root);
        ret;
    }
    val method: str = json.text(method_v, a);
    if (method == nil) {
        reply_invalid_request(srv, root);
        ret;
    }
    val params: *sj.Value = json.member(root, "params");

    if (str_equals(method, "initialize")) {
        json.free_str(method, a);
        handle_initialize(srv, root, params);
        ret;
    }
    if (str_equals(method, "initialized")) {
        json.free_str(method, a);
        handle_initialized(srv);
        ret;
    }
    if (str_equals(method, "shutdown")) {
        json.free_str(method, a);
        handle_shutdown(srv, root);
        ret;
    }
    if (str_equals(method, "exit")) {
        json.free_str(method, a);
        handle_exit(srv);
        ret;
    }

    if (srv.status != STATUS_RUNNING) {
        json.free_str(method, a);
        reply_error(srv, root, -32002, "server not initialized");
        ret;
    }

    if (str_equals(method, "textDocument/didOpen")) {
        json.free_str(method, a);
        handle_did_open(srv, params);
        ret;
    }
    if (str_equals(method, "textDocument/didChange")) {
        json.free_str(method, a);
        handle_did_change(srv, params);
        ret;
    }
    if (str_equals(method, "textDocument/didClose")) {
        json.free_str(method, a);
        handle_did_close(srv, params);
        ret;
    }
    if (str_equals(method, "textDocument/didSave")) {
        json.free_str(method, a);
        handle_did_save(srv, params);
        ret;
    }
    if (str_equals(method, "$/setTrace")) {
        json.free_str(method, a);
        val lo: opt[u8] = settings.lsp_level(json.member(params, "value"), a);
        if (sel lo.some) { trace.set_level(lo.some); }
        ret;
    }
    if (str_equals(method, "workspace/didChangeConfiguration")) {
        json.free_str(method, a);
        ret;
    }
    if (str_equals(method, "workspace/didChangeWatchedFiles")) {
        json.free_str(method, a);
        handle_did_change_watched_files(srv, params);
        ret;
    }

    if (str_equals(method, "textDocument/hover")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_HOVER);
        ret;
    }
    if (str_equals(method, "textDocument/definition")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_DEFINITION);
        ret;
    }
    if (str_equals(method, "textDocument/typeDefinition")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_TYPE_DEFINITION);
        ret;
    }
    if (str_equals(method, "textDocument/references")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_REFERENCES);
        ret;
    }
    if (str_equals(method, "textDocument/rename")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_RENAME);
        ret;
    }
    if (str_equals(method, "textDocument/prepareRename")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_PREPARE_RENAME);
        ret;
    }
    if (str_equals(method, "textDocument/documentSymbol")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_DOCUMENT_SYMBOL);
        ret;
    }
    if (str_equals(method, "textDocument/completion")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_COMPLETION);
        ret;
    }
    if (str_equals(method, "textDocument/documentHighlight")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_DOCUMENT_HIGHLIGHT);
        ret;
    }
    if (str_equals(method, "textDocument/signatureHelp")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_SIGNATURE_HELP);
        ret;
    }
    if (str_equals(method, "textDocument/inlayHint")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_INLAY_HINT);
        ret;
    }
    if (str_equals(method, "textDocument/semanticTokens/full")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_SEMANTIC_TOKENS);
        ret;
    }
    if (str_equals(method, "textDocument/codeAction")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_CODE_ACTION);
        ret;
    }
    if (str_equals(method, "textDocument/prepareCallHierarchy")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_CALL_PREPARE);
        ret;
    }
    if (str_equals(method, "callHierarchy/incomingCalls")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_CALL_INCOMING);
        ret;
    }
    if (str_equals(method, "callHierarchy/outgoingCalls")) {
        json.free_str(method, a);
        handle_feature(srv, root, params, FEATURE_CALL_OUTGOING);
        ret;
    }
    if (str_equals(method, "workspace/symbol")) {
        json.free_str(method, a);
        handle_workspace_symbol(srv, root, params);
        ret;
    }

    trace.logf("server: unhandled method {}", method);
    json.free_str(method, a);
    if (json.member(root, "id") != nil) { reply_error(srv, root, -32601, "method not found"); }
}

# answer the initialize request with the server's capabilities (full-text
# document sync) and mark the server running
fun handle_initialize(srv: *Server, root: *sj.Value, params: *sj.Value) {
    # what the client configured decides where the trace goes and whether it
    # is on, so it is applied before anything is written (#264, #285). the
    # notes about it are written once there is somewhere to write them
    var st:  settings.Settings  = settings.parse(params, srv.alloc, false);
    var eff: settings.Effective = settings.effective(?st, srv.alloc, false);
    trace.start(eff.level, eff.file);
    settings.effective_dnit(?eff, srv.alloc);
    settings.dnit(?st, srv.alloc);
    var noted:     settings.Settings  = settings.parse(params, srv.alloc, true);
    var noted_eff: settings.Effective = settings.effective(?noted, srv.alloc, true);
    settings.effective_dnit(?noted_eff, srv.alloc);
    settings.dnit(?noted, srv.alloc);

    # remember whether the client can accept a dynamic watch registration, so
    # `initialized` only sends one when it will be honoured.
    val watched: *sj.Value = json.member(
        json.member2(params, "capabilities", "workspace"), "didChangeWatchedFiles");
    srv.watch_dynamic = json.boolean(json.member(watched, "dynamicRegistration"), false);

    # a client advertises the hover formats it renders, in order of preference.
    # Sending markdown to one that only takes plaintext puts literal backticks
    # and fences in front of the reader, which is worse than the plain text it
    # asked for.
    srv.hover_markdown = accepts_markdown(
        json.member(json.member2(params, "capabilities", "textDocument"), "hover"), srv.alloc);
    progress.configure(json.boolean(
        json.member(json.member2(params, "capabilities", "window"), "workDoneProgress"), false));

    # an answer from a stale snapshot (#251) is replaced once the rebuild lands,
    # for the features a client re-requests on its own only when told to
    val ws_caps: *sj.Value = json.member2(params, "capabilities", "workspace");
    srv.refresh_tokens = json.boolean(json.member(json.member(ws_caps, "semanticTokens"), "refreshSupport"), false);
    srv.refresh_hints  = json.boolean(json.member(json.member(ws_caps, "inlayHint"), "refreshSupport"), false);

    # negotiate the position encoding both sides will use. utf-16 is the base
    # default and 1.0's promise; a client offering utf-8 (mach's own byte
    # offsets) or utf-32 gets it instead. applied to `positions` and echoed
    # back below so the client uses the same units.
    val enc: positions.Encoding = negotiate_encoding(
        json.member2(params, "capabilities", "general"), srv.alloc);
    positions.use_encoding(enc);

    var b: json.Buf = json.buf_init(srv.alloc);
    json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"id\":");
    json.buf_push_id(?b, json.member(root, "id"));
    json.buf_push(?b, ",\"result\":{\"capabilities\":{\"positionEncoding\":");
    json.buf_push_quoted(?b, encoding_name(enc));
    json.buf_push(?b, ",\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[");
    json.buf_push(?b, tokens.TOKEN_TYPES);
    json.buf_push(?b, "],\"tokenModifiers\":[");
    json.buf_push(?b, tokens.TOKEN_MODIFIERS);
    json.buf_push(?b, "]},\"full\":true},\"textDocumentSync\":2,\"hoverProvider\":true,\"definitionProvider\":true,\"typeDefinitionProvider\":true,\"callHierarchyProvider\":true,\"referencesProvider\":true,\"renameProvider\":{\"prepareProvider\":true},\"documentSymbolProvider\":true,\"documentHighlightProvider\":true,\"workspaceSymbolProvider\":true,\"inlayHintProvider\":true,\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\"]},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"],\"retriggerCharacters\":[\",\"]},\"completionProvider\":{\"triggerCharacters\":[\".\"]}},\"serverInfo\":{\"name\":\"mach-lsp\",\"version\":");
    json.buf_push_quoted(?b, version.VERSION);
    json.buf_push(?b, ",\"mach\":");
    json.buf_push_quoted(?b, version.MACH);
    json.buf_push(?b, "}}}");
    send_buf(srv, ?b);

    srv.status = STATUS_RUNNING;
    trace.log("initialized\n");
}

# once the client signals it is ready, register file watchers for the manifest,
# lockfile, and source trees so a dep-graph change (pulling deps, editing a dep
# source) triggers `workspace/didChangeWatchedFiles` and the affected project
# root is rebuilt. only sent when the client advertised dynamic registration;
# clients without it fall back to the server's fingerprint check
fun handle_initialized(srv: *Server) {
    if (!srv.watch_dynamic) { ret; }
    val reg: str = "{\"jsonrpc\":\"2.0\",\"id\":\"mls/registerWatchers\",\"method\":\"client/registerCapability\",\"params\":{\"registrations\":[{\"id\":\"mls-watched-files\",\"method\":\"workspace/didChangeWatchedFiles\",\"registerOptions\":{\"watchers\":[{\"globPattern\":\"**/mach.toml\"},{\"globPattern\":\"**/mach.lock\"},{\"globPattern\":\"**/*.mach\"}]}}]}}";
    transport.send_message(reg, srv.alloc);
    srv.watch_state = WATCH_PENDING;
}

# accept dynamic watching only after the client acknowledges registration;
# rejection keeps conservative fallback invalidation enabled
fun handle_response(srv: *Server, root: *sj.Value) {
    if (srv.watch_state != WATCH_PENDING)                                              { ret; }
    if (!json.text_equals(json.member(root, "id"), "mls/registerWatchers", srv.alloc)) { ret; }
    if (json.member(root, "error") != nil) {
        srv.watch_state = WATCH_FALLBACK;
        ret;
    }
    srv.watch_state = WATCH_ACTIVE;
}

# a save makes the buffer's disk state authoritative again for its root
fun handle_did_save(srv: *Server, params: *sj.Value) {
    val uri: str = json.text(json.member2(params, "textDocument", "uri"), srv.alloc);
    if (uri == nil) { ret; }
    project.invalidate_uri(?srv.ws, uri);
    json.free_str(uri, srv.alloc);
    after_disk_change(srv);
}

# act on a change on disk now rather than at the next message
#
# The client may send nothing more for a while, and a fixed manifest must not
# keep its complaint until it does. A root that never loaded is loaded here, and
# a rebuild for one that did is started; its result arrives through the build
# worker's wake.
fun after_disk_change(srv: *Server) {
    if (project.retry_failed(?srv.ws)) { republish_all(srv); }
    collect_rebuilds(srv);
}

# invalidate every project root whose tree contains a changed file, so the next
# request rebuilds it from disk. each entry of the notification's `changes`
# array is invalidated in turn
fun handle_did_change_watched_files(srv: *Server, params: *sj.Value) {
    val changes: *sj.Value = json.member(params, "changes");
    val n:       usize     = json.count(changes);
    var i:       usize     = 0;
    for (i < n) {
        val uri: str = json.text(json.member(json.element(changes, i), "uri"), srv.alloc);
        if (uri != nil) {
            project.invalidate_uri(?srv.ws, uri);
            json.free_str(uri, srv.alloc);
        }
        i = i + 1;
    }
    after_disk_change(srv);
}

# acknowledge a shutdown request and enter the shutting-down phase
fun handle_shutdown(srv: *Server, root: *sj.Value) {
    abandon_held(srv, nil, "the server is shutting down");
    if (json.member(root, "id") != nil) {
        var b: json.Buf = json.buf_init(srv.alloc);
        json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"id\":");
        json.buf_push_id(?b, json.member(root, "id"));
        json.buf_push(?b, ",\"result\":null}");
        send_buf(srv, ?b);
    }
    srv.status = STATUS_SHUTTING_DOWN;
}

# exit the process, with code 0 only after a clean shutdown
fun handle_exit(srv: *Server) {
    if (srv.status == STATUS_SHUTTING_DOWN) { srv.exit_code = 0; }
    or                                      { srv.exit_code = 1; }
    srv.status = STATUS_EXITED;
    atomic.store(?srv.stop, 1);

    # `exit` means terminate, and the client is entitled to keep its end of the
    # pipe open while it waits for that. The reading thread is parked in
    # `read(2)` on stdin and nothing this thread can do reliably wakes it -
    # closing the descriptor under a blocked reader does not - so the orderly
    # return through `run` is not reachable here. Ending the process is what the
    # notification asked for; responses are written unbuffered, so nothing that
    # was owed to the client is still pending.
    settings.settle_trace(srv.alloc);
    trace.log("=== mach-lsp exiting ===\n");
    exec.exit(srv.exit_code);
}

# register the opened document and publish its diagnostics
fun handle_did_open(srv: *Server, params: *sj.Value) {
    val doc: *sj.Value = json.member(params, "textDocument");
    val uri: str       = json.text(json.member(doc, "uri"), srv.alloc);
    if (uri == nil) { ret; }
    val text: str = json.text(json.member(doc, "text"), srv.alloc);
    if (text == nil) {
        json.free_str(uri, srv.alloc);
        ret;
    }
    val version_v: *sj.Value = json.member(doc, "version");
    if (version_v != nil) { publish_for(srv, uri, text, json.number(version_v, 0), true); }
    json.free_str(text, srv.alloc);
    json.free_str(uri, srv.alloc);
}

# apply the document's new full text and republish diagnostics. only
# full-document sync (textDocumentSync = 1) is advertised, so the last change
# entry carries the entire new text
fun handle_did_change(srv: *Server, params: *sj.Value) {
    val doc: *sj.Value = json.member(params, "textDocument");
    val uri: str       = json.text(json.member(doc, "uri"), srv.alloc);
    if (uri == nil) { ret; }
    val changes:   *sj.Value = json.member(params, "contentChanges");
    val n:         usize     = json.count(changes);
    val version_v: *sj.Value = json.member(doc, "version");
    if (n == 0 || version_v == nil) {
        json.free_str(uri, srv.alloc);
        ret;
    }

    val text: str = apply_changes(srv, uri, changes, n);
    if (text == nil) {
        json.free_str(uri, srv.alloc);
        ret;
    }
    publish_for(srv, uri, text, json.number(version_v, 0), false);
    json.free_str(text, srv.alloc);
    json.free_str(uri, srv.alloc);
}

# build the document's new text from a change list
#
# The splice itself lives in `textedit`, shared with the supervisor's replay
# mirror; this resolves which document is being changed and hands over its
# current text as the base.
# ---
# srv:     the server
# uri:     the document being changed
# changes: the `contentChanges` array
# n:       its length
# ret:     owned new text, or nil
fun apply_changes(srv: *Server, uri: str, changes: *sj.Value, n: usize) str {
    val d: *documents.Document = documents.find(?srv.docs, uri);
    if (d == nil) { ret nil; }
    ret textedit.apply_changes(srv.alloc, d.text, changes, n);
}

# retire the document, reclaim its cached analysis, and clear its diagnostics# retire the document, reclaim its cached analysis, and clear its diagnostics
fun handle_did_close(srv: *Server, params: *sj.Value) {
    val uri: str = json.text(json.member2(params, "textDocument", "uri"), srv.alloc);
    if (uri == nil) { ret; }
    abandon_held(srv, uri, "the document was closed");
    val doc: *documents.Document = documents.closing(?srv.docs, uri);
    if (doc != nil) { project.document_closed(?srv.ws, doc); }
    documents.close(?srv.docs, uri);
    diagnostics.clear(srv.alloc, uri);
    republish_all(srv);
    json.free_str(uri, srv.alloc);
}

# whether a feature must answer from a snapshot that has caught up with every
# buffer of its root: a reference list is wrong when incomplete, and a rename or
# a code action edits text the snapshot no longer describes
fun needs_current(which: u8) bool {
    ret which == FEATURE_REFERENCES || which == FEATURE_RENAME
        || which == FEATURE_PREPARE_RENAME || which == FEATURE_CODE_ACTION;
}

# keep the message being handled until its snapshot lands
#
# The build that will release it is started here if the slot is free; otherwise
# the build worker's signal starts it when the running one finishes. Nothing
# that could swap a snapshot runs here, because this message's tree is live.
fun hold(srv: *Server, id: *sj.Value, uri: str, d: *documents.Document) bool {
    if (srv.body == nil || id == nil) { ret false; }
    val token: str = json.id_text(id, srv.alloc);
    if (token == nil) { ret false; }
    val held: bool = parked.push(?srv.held, srv.body, srv.body_len, uri, token);
    # a held request is waiting for a build, which the deadline does not bound
    if (held) { sideband.held(srv.alloc, token, true); }
    json.free_str(token, srv.alloc);
    if (!held) { ret false; }
    project.catch_up(?srv.ws, d);
    srv.holding = true;
    trace.log("server: holding a request until its snapshot catches up\n");
    ret true;
}

# send a JSON-RPC error for a request known only by its id token
fun send_error_token(srv: *Server, id_token: str, code: i64, message: str) {
    var b: json.Buf = json.buf_init(srv.alloc);
    json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"id\":");
    json.buf_push(?b, id_token);
    json.buf_push(?b, ",\"error\":{\"code\":");
    json.buf_push_i64(?b, code);
    json.buf_push(?b, ",\"message\":");
    json.buf_push_quoted(?b, message);
    json.buf_push(?b, "}}");
    send_buf(srv, ?b);
}

# route a language-feature request to its handler in `language`
#
# the document uri is read once here and passed through; the feature code
# resolves the buffer, pivots the cursor, and replies. an unknown or unopened
# uri still gets a null / empty reply, so the client is never left waiting
fun handle_feature(srv: *Server, root: *sj.Value, params: *sj.Value, which: u8) {
    val id: *sj.Value = json.member(root, "id");
    if (withdrawn(srv, id)) { ret; }
    val uri: str = json.text(json.member2(params, "textDocument", "uri"), srv.alloc);

    # a request whose answer must be complete or edits text waits for a current
    # snapshot when one is on its way; every other feature answers now, from
    # whatever snapshot there is, through its mapping (#251)
    val d: *documents.Document = documents.find(?srv.docs, uri);
    if (d != nil && project.current_pending(?srv.ws, d)) {
        if (needs_current(which) && hold(srv, id, uri, d)) {
            json.free_str(uri, srv.alloc);
            ret;
        }
        if (!needs_current(which) && project.document_behind(?srv.ws, d)) { srv.served_stale = true; }
    }

    # snapshot compiler epochs so a feature-triggered rebuild republishes the
    # now-current diagnostics for every affected open document
    val epoch_before: u32 = project.load_epoch(?srv.ws);
    val sema_before:  u32 = project.sema_epoch(?srv.ws);

    if (which == FEATURE_HOVER)              { language.hover(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri, srv.hover_markdown); }
    or (which == FEATURE_DEFINITION)         { language.definition(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_TYPE_DEFINITION)    { language.type_definition(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_REFERENCES)         { language.references(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_RENAME)             { language.rename(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_PREPARE_RENAME)     { language.prepare_rename(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_DOCUMENT_SYMBOL)    { language.document_symbol(?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_COMPLETION)         { language.completion(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_DOCUMENT_HIGHLIGHT) { language.document_highlight(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_SIGNATURE_HELP)     { signature.signature_help(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_INLAY_HINT)         { hints.inlay_hints(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_SEMANTIC_TOKENS)    { tokens.semantic_tokens(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_CODE_ACTION)        { actions.code_actions(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_CALL_PREPARE)       { callhierarchy.prepare(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params, uri); }
    or (which == FEATURE_CALL_INCOMING)      { callhierarchy.incoming(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params); }
    or (which == FEATURE_CALL_OUTGOING)      { callhierarchy.outgoing(?srv.ws, ?srv.es, srv.alloc, ?srv.docs, id, params); }

    if (uri != nil) { json.free_str(uri, srv.alloc); }

    if (project.load_epoch(?srv.ws) != epoch_before || project.sema_epoch(?srv.ws) != sema_before) { republish_all(srv); }
}

# a client lists the position encodings it accepts in `general.positionEncodings`.
# utf-16 is the base protocol's guarantee and exactly what 1.0 promised, so it
# stays the fallback when the client offers nothing or nothing better. of what
# is offered, utf-8 is preferred because it matches mach's byte offsets and
# needs no conversion at all, then utf-32; utf-16 is chosen only when it is the
# only option. the choice is set once, here, and drives every conversion in
# `positions`, the single conversion point.
fun negotiate_encoding(general: *sj.Value, alloc: *Allocator) positions.Encoding {
    val encs: *sj.Value = json.member(general, "positionEncodings");
    if (encs == nil) { ret positions.ENC_UTF16; }
    val n:         usize = json.count(encs);
    var has_utf8:  bool  = false;
    var has_utf32: bool  = false;
    var i:         usize = 0;
    for (i < n) {
        val e: str = json.text(json.element(encs, i), alloc);
        if (e != nil) {
            if (str_equals(e, "utf-8"))  { has_utf8 = true; }
            if (str_equals(e, "utf-32")) { has_utf32 = true; }
            json.free_str(e, alloc);
        }
        i = i + 1;
    }
    if (has_utf8)  { ret positions.ENC_UTF8; }
    if (has_utf32) { ret positions.ENC_UTF32; }
    ret positions.ENC_UTF16;
}

# the LSP name for a negotiated encoding, echoed back in ServerCapabilities so
# the client sends and reads positions in the same units.
fun encoding_name(e: positions.Encoding) str {
    if (e == positions.ENC_UTF8)  { ret "utf-8"; }
    if (e == positions.ENC_UTF32) { ret "utf-32"; }
    ret "utf-16";
}

# whether the client's hover capability lists markdown
#
# An absent capability means an old client, and the spec's default there is
# plaintext; an empty list says the same. Markdown is only used when the client
# actually names it.
fun accepts_markdown(hover: *sj.Value, alloc: *Allocator) bool {
    if (hover == nil) { ret false; }
    val formats: *sj.Value = json.member(hover, "contentFormat");
    if (formats == nil) { ret false; }
    val n: usize = json.count(formats);
    var i: usize = 0;
    for (i < n) {
        val f: str = json.text(json.element(formats, i), alloc);
        if (f != nil) {
            val md: bool = str_equals(f, "markdown");
            json.free_str(f, alloc);
            if (md) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether the client withdrew this request before the worker reached it
#
# A cancelled request still owes exactly one response, so it is answered with
# RequestCancelled rather than dropped.
fun withdrawn(srv: *Server, id: *sj.Value) bool {
    if (id == nil) { ret false; }
    val id_token: str = json.id_text(id, srv.alloc);
    if (id_token == nil) { ret false; }
    val cancelled: bool = jobs.cancel_take(?srv.cancels, id_token);
    if (cancelled) { send_error(srv, id, REQUEST_CANCELLED, "request cancelled"); }
    json.free_str(id_token, srv.alloc);
    ret cancelled;
}

# answer workspace/symbol from every loaded root
fun handle_workspace_symbol(srv: *Server, root: *sj.Value, params: *sj.Value) {
    val id: *sj.Value = json.member(root, "id");
    if (withdrawn(srv, id)) { ret; }
    val id_raw: str = json.id_text(id, srv.alloc);
    if (id_raw == nil) { ret; }
    val query: str = json.text(json.member(params, "query"), srv.alloc);
    workspace.symbols(?srv.ws, srv.alloc, id_raw, query);
    if (query != nil) { json.free_str(query, srv.alloc); }
}

# re-publish diagnostics for every open document the given root governs
#
# A rebuild can move diagnostics for any document mirrored into that root's
# session - an unsaved export change in one module introduces or clears errors
# in the modules importing it - so the whole root is republished, not just the
# document that changed. Documents under OTHER roots are untouched: their
# snapshots did not move, and republishing them would emit one notification per
# open buffer per keystroke.
#
# A nil root is the standalone case, where `only` is the whole set.
fun republish_root(srv: *Server, root: *project.Root, only: *documents.Document) {
    val n: usize = documents.slot_count(?srv.docs);
    var i: usize = 0;
    for (i < n) {
        val d: *documents.Document = documents.at(?srv.docs, i);
        if (d != nil && d.in_use && d.uri != nil) {
            if (root == nil) {
                if (d == only) { diagnostics.publish(?srv.ws, ?srv.es, srv.alloc, d); }
            }
            or (project.root_covers_document(?srv.ws, root, d)) {
                diagnostics.publish(?srv.ws, ?srv.es, srv.alloc, d);
            }
        }
        i = i + 1;
    }
}

# re-publish every open document, for the events that can move any root at once
# (a watched-file change, a close that returns a buffer to disk authority)
fun republish_all(srv: *Server) {
    val n: usize = documents.slot_count(?srv.docs);
    var i: usize = 0;
    for (i < n) {
        val d: *documents.Document = documents.at(?srv.docs, i);
        if (d != nil && d.in_use && d.uri != nil) {
            diagnostics.publish(?srv.ws, ?srv.es, srv.alloc, d);
        }
        i = i + 1;
    }
}

# register/update `uri`'s buffer and publish its diagnostics.
# `is_open` selects open vs change registration; both end in a publish
fun publish_for(srv: *Server, uri: str, text: str, version: i64, is_open: bool) {
    val path: str = uris.path_of(srv.alloc, uri);
    if (path == nil) { ret; }
    var dr: res[*documents.Document, str];
    if (is_open) { dr = documents.open(?srv.docs, uri, path, text, version); }
    or           { dr = documents.change(?srv.docs, uri, text, version); }
    json.free_str(path, srv.alloc);

    if (sel dr.err) {
        trace.log("documents: ");
        trace.log(dr.err);
        trace.log("\n");
        ret;
    }
    val doc: *documents.Document = dr.ok;
    val cr:  res[bool, str]      = project.document_changed(?srv.ws, doc);
    if (sel cr.err) {
        trace.log("project: failed to mirror document overlay\n");
        ret;
    }

    # The document's text and revision are recorded above; analyzing it is what
    # costs. While more input is already queued, that analysis would be thrown
    # away by the very next message, so a burst of keystrokes coalesces into one
    # analysis of the newest text instead of one per revision. The message that
    # finds the queue empty is the one that publishes, so the newest state is
    # always analyzed - deferring is never dropping.
    if (jobs.depth(?srv.q) > 0) {
        srv.deferred = true;
        trace.log("server: newer input queued, deferring analysis\n");
        ret;
    }
    srv.deferred = false;
    republish_root(srv, project.root_for(?srv.ws, doc.uri), doc);
}

# send a JSON-RPC error response for a request that carries an id
#
# a notification owes no response, so one without an id is dropped.
fun reply_error(srv: *Server, root: *sj.Value, code: i64, message: str) {
    val id: *sj.Value = json.member(root, "id");
    if (id == nil) { ret; }
    send_error(srv, id, code, message);
}

# a parse error names no id: the body never became a tree, so there is nothing
# to echo. the spec answers this with a null id
fun reply_parse_error(srv: *Server) {
    trace.log("server: message body is not valid JSON\n");
    send_error(srv, nil, -32700, "parse error");
}

# a tree that is not a usable JSON-RPC envelope
fun reply_invalid_request(srv: *Server, root: *sj.Value) {
    send_error(srv, json.member(root, "id"), -32600, "invalid request");
}

# frame and send one JSON-RPC error object
fun send_error(srv: *Server, id: *sj.Value, code: i64, message: str) {
    var b: json.Buf = json.buf_init(srv.alloc);
    json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"id\":");
    json.buf_push_id(?b, id);
    json.buf_push(?b, ",\"error\":{\"code\":");
    json.buf_push_i64(?b, code);
    json.buf_push(?b, ",\"message\":");
    json.buf_push_quoted(?b, message);
    json.buf_push(?b, "}}");
    send_buf(srv, ?b);
}

# frame and send a buffer's contents, then release it
fun send_buf(srv: *Server, b: *json.Buf) {
    val msg: str = json.buf_str(b);
    if (msg != nil) {
        transport.send_message(msg, srv.alloc);
        render.note_response();
    }
    json.buf_dnit(b);
}
