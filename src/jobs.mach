# a single-consumer job queue handing message bodies to an analysis thread
#
# the protocol loop must keep reading while the compiler works. a cold project
# analysis takes seconds, and running it on the reading thread means the server
# cannot see a cancellation, a newer edit, or a shutdown until it finishes -
# which is how an editor concludes the server is dead and restarts it, only to
# pay the same cost again.
#
# so the reading thread owns stdin and this queue, and one worker thread owns
# everything the compiler touches: the sessions, the snapshots, the document
# registry, and the feature handlers. exactly one thread ever reaches compiler
# state, so nothing there needs locking; the queue is the only shared structure
# and the only thing a lock protects.
#
# the worker blocks on a futex rather than polling, so an idle server costs no
# CPU: `seq` advances on every push and on stop, and a waiter that saw the old
# value sleeps until someone bumps it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator.Allocator;
use std.allocator.allocate;
use std.allocator.deallocate;

use mem: std.memory;
use std.sync.atomic;
use std.sync.mutex;
use std.sync.thread;
use std.system.os;

use mls.frontend;

# what the worker does with one dequeued body
#
# ctx is the opaque pointer handed to `start`; body is owned by the callback
# for the duration of the call and released by the queue afterwards.
pub def JobFn: fun(ptr, str, usize);

# what the worker does when something other than a client message wakes it
#
# The analysis thread has exactly one wait point, so work that completes off it
# - a project rebuild finishing on the build worker - has to arrive here or not
# at all. A signal carries no payload: it says only that the analysis thread
# should look at state it already owns.
pub def SignalFn: fun(ptr);

# one queued message body, owned by the queue
# ---
# body: nul-terminated copy of the message body
# len:  body length in bytes, excluding the terminator
rec Job {
    body: str;
    len:  usize;
}

# the queue and the worker thread draining it
#
# `lock` guards `jobs`, `head`, `count`, and `closed`. `seq` is the futex word
# the worker sleeps on and is written under the lock but read without it, so a
# waiter can compare against a value it sampled before locking.
# ---
# alloc:  allocator backing the ring and every queued body
# lock:   guards the ring and `closed`
# jobs:   ring of `cap` slots
# cap:    ring length
# head:   index of the next job to pop
# count:  queued jobs
# seq:    futex word, advanced on every push, signal, and close
# closed: no further pushes are accepted and the worker should drain and exit
# woken:  a signal is pending; collapses, since it carries no payload
# th:     the worker thread handle
# live:   whether `th` was spawned and still needs joining
pub rec Queue {
    alloc:  *Allocator;
    lock:   mutex.Mutex;
    jobs:   *Job;
    cap:    usize;
    head:   usize;
    count:  usize;
    seq:    i64;
    closed: bool;
    woken:  bool;
    th:     thread.Thread;
    live:   bool;
}

# the queue a spawned worker drains
#
# `thread.spawn_with` hands the entry a single opaque pointer and std has no
# thread-local storage, so the callback and its context ride the queue itself.
# ---
# q:  the queue to drain
# f:  the callback to run per job
# sf: the callback to run per signal
# fx: opaque context handed to `f` and `sf`
rec Bound {
    q:  *Queue;
    f:  JobFn;
    sf: SignalFn;
    fx: ptr;
}

# bound state for the single worker, addressed by the spawned thread
#
# The handle must outlive the thread and std threads take one pointer, so the
# binding lives here rather than in a caller frame. One server runs one queue.
var BOUND: Bound;

# how many messages may wait before a push is refused
#
# The queue holds whole message bodies, and `didChange` carries a document's
# full text, so this bounds memory as well as latency. A client that outruns
# the worker by more than this is answered rather than buffered without limit.
pub val CAPACITY: usize = 256;

# construct an empty queue over `alloc`
# ---
# q:     queue to initialize
# alloc: allocator backing the ring and queued bodies; must outlive the queue
# ret:   true on success
pub fun init(q: *Queue, alloc: *Allocator) bool {
    q.alloc  = alloc;
    q.lock   = mutex.make();
    q.jobs   = nil;
    q.cap    = 0;
    q.head   = 0;
    q.count  = 0;
    q.seq    = 0;
    q.closed = false;
    q.woken  = false;
    q.live   = false;

    val r: res[*Job, allocator.Error] = allocate[Job](alloc, CAPACITY);
    if (sel r.err) { ret false; }
    q.jobs = r.ok;
    q.cap  = CAPACITY;
    var i: usize = 0;
    for (i < q.cap) {
        q.jobs[i].body = nil;
        q.jobs[i].len  = 0;
        i              = i + 1;
    }
    ret true;
}

# spawn the worker thread draining `q` into `f`
#
# `f` runs on the worker for every pushed body, in push order, one at a time.
# ---
# q:   the initialized queue
# f:   per-job callback
# sf:  per-signal callback, run when something off-thread asks for attention
# fx:  opaque context handed to `f` and `sf`
# ret: true when the thread started
pub fun start(q: *Queue, f: JobFn, sf: SignalFn, fx: ptr) bool {
    if (q.jobs == nil || q.live) { ret false; }
    BOUND.q  = q;
    BOUND.f  = f;
    BOUND.sf = sf;
    BOUND.fx = fx;
    var c: thread.Config;
    thread.config_default(?c);
    c.stack_reserve = frontend.STACK_RESERVE;
    thread.spawn_with_config(worker_main, (?BOUND)::*u8, ?c, ?q.th);
    if (q.th.tid < 0) { ret false; }
    q.live = true;
    ret true;
}

# copy `body` onto the queue and wake the worker
#
# The body is copied because the caller's frame owns the transport buffer and
# reuses it for the next frame.
# ---
# q:    the queue
# body: nul-terminated message body
# len:  body length in bytes
# ret:  true when queued; false when closed, full, or out of memory
pub fun push(q: *Queue, body: str, len: usize) bool {
    if (body == nil) { ret false; }

    val r: res[*u8, allocator.Error] = allocate[u8](q.alloc, len + 1);
    if (sel r.err) { ret false; }
    val copy: *u8 = r.ok;
    if (len > 0) { mem.raw_copy(copy::ptr, body::ptr, len); }
    copy[len] = 0;

    mutex.lock(?q.lock);
    if (q.closed || q.count == q.cap) {
        mutex.unlock(?q.lock);
        deallocate[u8](q.alloc, copy, len + 1);
        ret false;
    }
    val slot: usize = (q.head + q.count) % q.cap;
    q.jobs[slot].body = copy::str;
    q.jobs[slot].len  = len;
    q.count           = q.count + 1;
    atomic.store(?q.seq, atomic.load(?q.seq) + 1);
    mutex.unlock(?q.lock);

    os.thread_wake(?q.seq);
    ret true;
}

# ask the worker to run its signal callback once
#
# Safe from any thread and from a thread that owns no allocator: a signal takes
# no memory and collapses with any other still pending, so a producer that
# finishes twice before the worker looks costs one callback, not two.
pub fun signal(q: *Queue) {
    mutex.lock(?q.lock);
    q.woken = true;
    atomic.store(?q.seq, atomic.load(?q.seq) + 1);
    mutex.unlock(?q.lock);
    os.thread_wake(?q.seq);
}

# refuse further pushes and wake the worker so it drains and exits
pub fun close(q: *Queue) {
    mutex.lock(?q.lock);
    q.closed = true;
    atomic.store(?q.seq, atomic.load(?q.seq) + 1);
    mutex.unlock(?q.lock);
    os.thread_wake(?q.seq);
}

# close the queue and wait for the worker to finish the jobs already queued
#
# Every accepted message is handled before this returns, so a shutdown does not
# strand a reply the client is waiting for.
pub fun join(q: *Queue) {
    close(q);
    if (q.live) {
        thread.join(?q.th);
        q.live = false;
    }
}

# release the ring and any body still queued
pub fun dnit(q: *Queue) {
    if (q.live)        { join(q); }
    if (q.jobs == nil) { ret; }
    var i: usize = 0;
    for (i < q.count) {
        val slot: usize = (q.head + i) % q.cap;
        free_job(q, ?q.jobs[slot]);
        i = i + 1;
    }
    deallocate[Job](q.alloc, q.jobs, q.cap);
    q.jobs  = nil;
    q.cap   = 0;
    q.count = 0;
}

# how many messages are waiting
#
# A sample, not a reservation: the worker may pop between the read and its use.
pub fun depth(q: *Queue) usize {
    mutex.lock(?q.lock);
    val n: usize = q.count;
    mutex.unlock(?q.lock);
    ret n;
}

# what `pop_blocking` handed back
pub val TAKE_JOB:    u8 = 0;
pub val TAKE_SIGNAL: u8 = 1;
pub val TAKE_CLOSED: u8 = 2;

# release one job's owned body
fun free_job(q: *Queue, j: *Job) {
    if (j.body != nil) { deallocate[u8](q.alloc, j.body::*u8, j.len + 1); }
    j.body = nil;
    j.len  = 0;
}

# take the next job, blocking until one arrives or the queue closes
#
# The futex word is sampled before locking so a push that lands between the
# empty check and the sleep changes the value the sleep compares against, and
# the sleep returns immediately instead of missing the wake.
# Queued client messages are drained ahead of a pending signal: a signal only
# ever asks the analysis thread to look at state it already owns, and that look
# happens at every message boundary anyway, so input never waits behind it.
# ---
# q:   the queue
# out: receives the popped job when the result is TAKE_JOB
# ret: TAKE_JOB, TAKE_SIGNAL, or TAKE_CLOSED once closed and drained
fun pop_blocking(q: *Queue, out: *Job) u8 {
    for (true) {
        val sampled: i64 = atomic.load(?q.seq);

        mutex.lock(?q.lock);
        if (q.count > 0) {
            @out                = q.jobs[q.head];
            q.jobs[q.head].body = nil;
            q.jobs[q.head].len  = 0;
            q.head              = (q.head + 1) % q.cap;
            q.count             = q.count - 1;
            mutex.unlock(?q.lock);
            ret TAKE_JOB;
        }
        if (q.woken) {
            q.woken = false;
            mutex.unlock(?q.lock);
            ret TAKE_SIGNAL;
        }
        val done: bool = q.closed;
        mutex.unlock(?q.lock);

        if (done) { ret TAKE_CLOSED; }
        os.thread_wait(?q.seq, sampled);
    }
    ret TAKE_CLOSED;
}

# the worker thread entry: drain the queue into the bound callback until close
fun worker_main(arg: *u8) {
    val b: *Bound = arg::*Bound;
    val q: *Queue = b.q;
    for (true) {
        var j: Job;
        j.body = nil;
        j.len  = 0;
        val took: u8 = pop_blocking(q, ?j);
        if (took == TAKE_CLOSED) { brk; }
        if (took == TAKE_SIGNAL) {
            if (b.sf != nil) { b.sf(b.fx); }
        }
        or {
            if (j.body != nil) { b.f(b.fx, j.body, j.len); }
            free_job(q, ?j);
        }
    }
}

use std.allocator.page;
use std.types.string.str_equals;

use std.allocator;

# the queue's contract is that every accepted body reaches the callback exactly
# once and in push order, so the tests assert the sequence rather than a count

#[testing]
var SEEN: [64]u8;
#[testing]
var SEEN_LEN: i64 = 0;
#[testing]
var SEEN_SUM: i64 = 0;

#[testing]
var SIGNALS: i64 = 0;

#[testing]
fun note(ctx: ptr) {
    SIGNALS = SIGNALS + 1;
}

#[testing]
fun record(ctx: ptr, body: str, len: usize) {
    if (SEEN_LEN < 64) {
        SEEN[SEEN_LEN::usize] = body[0];
        SEEN_LEN              = SEEN_LEN + 1;
    }
    SEEN_SUM = SEEN_SUM + len::i64;
}

test every_pushed_body_reaches_the_worker_once_in_order {
    var pa: Allocator;
    page.make(?pa);
    var q: Queue;
    if (!init(?q, ?pa)) { ret 1; }
    SEEN_LEN = 0;
    SEEN_SUM = 0;
    if (!start(?q, record, note, nil)) {
        dnit(?q);
        ret 1;
    }

    if (!push(?q, "a1", 2)) {
        dnit(?q);
        ret 1;
    }
    if (!push(?q, "b22", 3)) {
        dnit(?q);
        ret 1;
    }
    if (!push(?q, "c333", 4)) {
        dnit(?q);
        ret 1;
    }
    join(?q);

    var fail: bool = false;
    if (SEEN_LEN != 3) { fail = true; }
    or {
        if (SEEN[0] != 'a') { fail = true; }
        if (SEEN[1] != 'b') { fail = true; }
        if (SEEN[2] != 'c') { fail = true; }
    }
    if (SEEN_SUM != 9) { fail = true; }
    dnit(?q);
    if (fail) { ret 1; }
    ret 0;
}

# a body is copied on push, so the caller's buffer may be reused immediately
test a_pushed_body_is_copied_not_borrowed {
    var pa: Allocator;
    page.make(?pa);
    var q: Queue;
    if (!init(?q, ?pa)) { ret 1; }
    SEEN_LEN = 0;
    SEEN_SUM = 0;

    var scratch: [8]u8;
    scratch[0] = 'x';
    scratch[1] = 'y';
    scratch[2] = 0;
    if (!push(?q, (?scratch[0])::str, 2)) {
        dnit(?q);
        ret 1;
    }
    scratch[0] = 'z';

    if (!start(?q, record, note, nil)) {
        dnit(?q);
        ret 1;
    }
    join(?q);

    var fail: bool = false;
    if (SEEN_LEN != 1) { fail = true; }
    or {
        if (SEEN[0] != 'x') { fail = true; }
    }
    dnit(?q);
    if (fail) { ret 1; }
    ret 0;
}

# the bound is what stops a client from buying unbounded memory with didChange
test a_full_queue_refuses_a_push_instead_of_growing {
    var pa: Allocator;
    page.make(?pa);
    var q: Queue;
    if (!init(?q, ?pa)) { ret 1; }

    var fail: bool  = false;
    var i:    usize = 0;
    for (i < CAPACITY) {
        if (!push(?q, "j", 1)) { fail = true; }
        i = i + 1;
    }
    if (push(?q, "overflow", 8)) { fail = true; }
    if (depth(?q) != CAPACITY)   { fail = true; }

    dnit(?q);
    if (fail) { ret 1; }
    ret 0;
}

# a rebuild finishing off the analysis thread reaches it only through a signal,
# so the queue must deliver one that arrives while the worker is asleep
test a_signal_reaches_the_worker_with_no_message_queued {
    var pa: Allocator;
    page.make(?pa);
    var q: Queue;
    if (!init(?q, ?pa)) { ret 1; }
    SIGNALS  = 0;
    SEEN_LEN = 0;
    if (!start(?q, record, note, nil)) {
        dnit(?q);
        ret 1;
    }
    signal(?q);
    join(?q);
    var fail: bool = false;
    if (SIGNALS != 1)  { fail = true; }
    if (SEEN_LEN != 0) { fail = true; }
    dnit(?q);
    if (fail) { ret 1; }
    ret 0;
}

# a signal carries no payload, so two that land before the worker looks are one
# piece of work, not two
test pending_signals_collapse {
    var pa: Allocator;
    page.make(?pa);
    var q: Queue;
    if (!init(?q, ?pa)) { ret 1; }
    SIGNALS = 0;
    signal(?q);
    signal(?q);
    signal(?q);
    if (!start(?q, record, note, nil)) {
        dnit(?q);
        ret 1;
    }
    join(?q);
    var fail: bool = false;
    if (SIGNALS != 1) { fail = true; }
    dnit(?q);
    if (fail) { ret 1; }
    ret 0;
}

# queued input is drained ahead of a signal, so a rebuild landing mid-burst
# never delays the message already waiting
test a_queued_message_is_taken_before_a_pending_signal {
    var pa: Allocator;
    page.make(?pa);
    var q: Queue;
    if (!init(?q, ?pa)) { ret 1; }
    SIGNALS  = 0;
    SEEN_LEN = 0;
    SEEN_SUM = 0;
    signal(?q);
    if (!push(?q, "a1", 2)) {
        dnit(?q);
        ret 1;
    }
    if (!start(?q, record, note, nil)) {
        dnit(?q);
        ret 1;
    }
    join(?q);
    var fail: bool = false;
    if (SEEN_LEN != 1) { fail = true; }
    if (SIGNALS != 1)  { fail = true; }
    dnit(?q);
    if (fail) { ret 1; }
    ret 0;
}

# ids of requests the client has withdrawn
#
# The reading thread records a cancellation the moment it arrives; the worker
# consults this before starting queued work. That ordering is the entire point:
# a cancellation handled in queue order would be dequeued after the request it
# withdraws had already run, which is no cancellation at all.
#
# Ids are stored as their wire token text, so a string id and the number that
# spells the same digits stay distinct. The set is small and short-lived - an
# id is removed when it is answered - so a linear scan is the right structure.
pub rec Cancels {
    lock:  mutex.Mutex;
    ids:   *Job;
    cap:   usize;
    count: usize;
    alloc: *Allocator;
}

# how many outstanding cancellations are remembered
#
# A client that cancels faster than the worker retires requests is dropping
# cancellations, not accumulating memory; the request is then answered normally,
# which is permitted.
pub val CANCEL_CAP: usize = 64;

pub fun cancels_init(c: *Cancels, alloc: *Allocator) bool {
    c.lock  = mutex.make();
    c.alloc = alloc;
    c.count = 0;
    c.cap   = 0;
    c.ids   = nil;
    val r: res[*Job, allocator.Error] = allocate[Job](alloc, CANCEL_CAP);
    if (sel r.err) { ret false; }
    c.ids = r.ok;
    c.cap = CANCEL_CAP;
    var i: usize = 0;
    for (i < c.cap) {
        c.ids[i].body = nil;
        c.ids[i].len  = 0;
        i             = i + 1;
    }
    ret true;
}

pub fun cancels_dnit(c: *Cancels) {
    if (c.ids == nil) { ret; }
    var i: usize = 0;
    for (i < c.count) {
        if (c.ids[i].body != nil) { deallocate[u8](c.alloc, c.ids[i].body::*u8, c.ids[i].len + 1); }
        i = i + 1;
    }
    deallocate[Job](c.alloc, c.ids, c.cap);
    c.ids   = nil;
    c.cap   = 0;
    c.count = 0;
}

# remember that `id_token` has been withdrawn
# ---
# c:        the registry
# id_token: the request id as it appeared on the wire
# ret:      true when recorded; false when full or out of memory
pub fun cancel_add(c: *Cancels, id_token: str) bool {
    if (id_token == nil || c.ids == nil) { ret false; }
    val len: usize                     = str_len(id_token);
    val r:   res[*u8, allocator.Error] = allocate[u8](c.alloc, len + 1);
    if (sel r.err) { ret false; }
    val copy: *u8 = r.ok;
    if (len > 0) { mem.raw_copy(copy::ptr, id_token::ptr, len); }
    copy[len] = 0;

    mutex.lock(?c.lock);
    if (c.count == c.cap) {
        mutex.unlock(?c.lock);
        deallocate[u8](c.alloc, copy, len + 1);
        ret false;
    }
    c.ids[c.count].body = copy::str;
    c.ids[c.count].len  = len;
    c.count             = c.count + 1;
    mutex.unlock(?c.lock);
    ret true;
}

# whether `id_token` was cancelled, leaving the record for `cancel_take`
pub fun cancel_has(c: *Cancels, id_token: str) bool {
    if (id_token == nil || c.ids == nil) { ret false; }
    var found: bool = false;
    mutex.lock(?c.lock);
    var i: usize = 0;
    for (i < c.count && !found) {
        if (c.ids[i].body != nil && str_equals(c.ids[i].body, id_token)) { found = true; }
        i = i + 1;
    }
    mutex.unlock(?c.lock);
    ret found;
}

# whether `id_token` was cancelled, removing it if so
#
# Consuming the entry keeps the set bounded and means a later request that
# happens to reuse the id is not cancelled by a stale entry.
pub fun cancel_take(c: *Cancels, id_token: str) bool {
    if (id_token == nil || c.ids == nil) { ret false; }
    var found: bool = false;
    mutex.lock(?c.lock);
    var i: usize = 0;
    for (i < c.count && !found) {
        if (c.ids[i].body != nil && str_equals(c.ids[i].body, id_token)) {
            deallocate[u8](c.alloc, c.ids[i].body::*u8, c.ids[i].len + 1);
            c.ids[i]                = c.ids[c.count - 1];
            c.ids[c.count - 1].body = nil;
            c.count                 = c.count - 1;
            found                   = true;
        }
        i = i + 1;
    }
    mutex.unlock(?c.lock);
    ret found;
}
