# the rich language-feature request handlers
#
# hover, definition, references, rename, prepareRename, documentSymbol, and
# completion. semantic requests read the document's exact compiler-owned
# ModuleEntry from a retained project snapshot, pivot the cursor position to a
# byte offset, join it against the resolve side tables through `features`, and
# shape the LSP result with `json`. documentSymbol stays on the syntax-only
# editor parse path. lifecycle and dispatch stay in `server`.
#
# cross-module scope: the buffer is resolved with a populated dependency set, so
# a symbol imported through a `use` binds to its declaration in a dependency Ast.
# definition / hover resolve that declaration through `project`'s symbol -> Ast /
# SourceFile / URI mapping, pointing at the defining module's file on disk
# (`project.site_of`). references and rename walk the whole loaded project graph
# through a shared use-site index (`build_refs` over `project.module_view`):
# references reports every use-site across all modules; rename rewrites the
# declaration plus every importer (body references and `use` path leaves), but
# only for symbols declared in the user's own project - a dependency's
# declaration is not the editor's to rewrite. completion offers the file's
# module-level names, `use` aliases, and the primitive types (see
# `features.completion_candidate`).

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.allocator.Allocator;
use std.allocator.allocate;
use std.allocator.deallocate;

use mem: std.memory;

use mach.lang.editor;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use aexpr: mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use atype: mach.lang.fe.ast.type;
use fedoc: mach.lang.fe.doc;
use np:    mach.lang.fe.path;
use rslv:  mach.lang.fe.resolve;
use mach.lang.fe.sema;
use mach.lang.fe.sema.typename;
use mach.lang.fe.token;
use mach.lang.intern;
use sess: mach.lang.session;
use src:  mach.lang.source;
use mach.lang.type;
use mls.trace;
use strutil: std.text.string;

use mls.analysis;
use mls.documents;
use mls.features;
use mls.json;
use mls.names;
use mls.positions;
use mls.project;
use mls.render;
use mls.transport;
use mtypes: mls.types;
use sj:     std.data.json;

use mach.lang.fail;
use std.allocator;
# the resolved analysis of one request's target document
# ---
# interner: the session's string interner, for resolving symbol-name StrIds
# file:     the document's SourceFile (text + line index for offset/position)
# sr:       compiler-owned semantic result for this exact module snapshot
# a:        the buffer's parsed Ast
# rr:       the buffer's ResolveResult side tables
# own:      this buffer's module id (Symbol.origin equals it for local symbols)

# answer textDocument/hover with the type / declaration of the symbol at
# the cursor, or null when the position is not on a resolved symbol
pub fun hover(ws: *project.Workspace, es: *editor.EditorSession, alloc: *Allocator, docs: *documents.Store, id: *sj.Value, params: *sj.Value, uri: str, markdown: bool) {
    val id_raw: str = json.id_text(id, alloc);
    if (id_raw == nil) { ret; }

    var an:    analysis.Analyzed;
    val off_o: opt[usize] = analysis.locate(ws, es, docs, params, uri, ?an);
    if (sel off_o.none) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    val offset: usize = off_o.some;

    val ro: opt[features.SymbolRef] = features.ref_at(an.a, an.rr, an.own, an.text.file, offset);
    if (sel ro.none) {
        # name resolution leaves a value-field access unbound, so a cursor on a
        # field name yields no SymbolRef - fall through to the type-driven field
        # hover before giving up.
        if (field_hover(ws, alloc, ?an, offset, id_raw, markdown)) { ret; }
        # nothing named this position, but sema may still know what the
        # expression under it evaluates to. an inferred type is the whole reason
        # to hover a call or an operator, neither of which resolves to a symbol
        if (expression_hover(ws, alloc, ?an, offset, id_raw, markdown)) { ret; }
        render.reply_null(alloc, id_raw);
        ret;
    }
    val sr: features.SymbolRef = ro.some;

    val so: opt[*rslv.Symbol] = features.symbol(an.rr, sr.sym_id);
    if (sel so.none) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    val sym: *rslv.Symbol = so.some;

    val md: str = hover_markdown(ws, an, sym, uri, alloc);
    if (md == nil) {
        render.reply_null(alloc, id_raw);
        ret;
    }

    reply_hover(alloc, id_raw, an.text, sr.name_span, md, markdown);
}

# hover the type of the expression under the cursor
#
# Mach requires a type annotation on every binding, so there is no inferred
# BINDING type to reveal - but a call, an operator, a cast, or a member access
# has a type the source never spells, and that is what a reader hovering it
# wants. The spelling comes from the compiler's own `type_to_str`, the renderer
# its diagnostics use, so a hover and an error message never disagree about how
# a type is written.
fun expression_hover(ws: *project.Workspace, alloc: *Allocator, an: *analysis.Analyzed,
    offset: usize, id_raw: str, markdown: bool) bool {
    if (an.sr == nil || an.root == nil) { ret false; }
    val s: *sess.Session = project.root_session(an.root);
    if (s == nil) { ret false; }

    val eid: id.ExprId = ast.offset_to_expr(an.a, offset);
    if (eid == id.EXPR_NIL) { ret false; }
    val tid: type.TypeId = project.type_of(an.sr, eid);
    if (tid == type.TYPE_NIL) { ret false; }

    val tr: res[str, fail.Fail] = typename.type_to_str(s, tid);
    if (sel tr.err) { ret false; }
    val text: str = tr.ok;
    # the renderer answers `<error>` / `<anon>` for a type it cannot spell;
    # showing that reads as a claim about the code rather than a gap in tooling
    if (text == nil || str_len(text) == 0 || text[0] == '<') {
        typename.type_str_free(s, text);
        ret false;
    }

    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, "```mach\n");
    json.buf_push(?b, text);
    json.buf_push(?b, "\n```");
    typename.type_str_free(s, text);
    val md: str = buf_into_str(?b, alloc);
    if (md == nil) { ret false; }

    val eo: opt[*aexpr.Expr] = ast.get_expr(an.a, eid);
    if (sel eo.none) {
        json.free_str(md, alloc);
        ret false;
    }
    reply_hover(alloc, id_raw, an.text, features.text_span_of_expr(eo.some), md, markdown);
    ret true;
}

# send a `textDocument/hover` reply rendering Markdown `md` over the
# name span `name_span` in `file`, freeing `md` and `id_raw`. nil-replies when the
# Markdown cannot be quoted. shared by the symbol and field hover paths
# append `md` with its markdown fencing removed
#
# The content is composed as markdown because that is what almost every client
# takes; a plaintext client gets the same text without the fence markers rather
# than a second rendering path that could drift from the first.
fun push_unfenced(b: *json.Buf, md: str) {
    var plain: json.Buf = json.buf_init(b.a);
    val n:     usize    = str_len(md);
    var i:     usize    = 0;
    for (i < n) {
        if (md[i] == '`' && i + 2 < n && md[i + 1] == '`' && md[i + 2] == '`') {
            i = i + 3;
            # a fence opener carries a language tag through to its newline
            for (i < n && md[i] != '\n') { i = i + 1; }
            if (i < n) { i = i + 1; }
        }
        or {
            json.buf_push_byte(?plain, md[i]);
            i = i + 1;
        }
    }
    json.buf_push_quoted(b, json.buf_str(?plain));
    json.buf_dnit(?plain);
}

# an owned copy of a buffer's contents, releasing the buffer
#
# The markdown composers build a string rather than a JSON value, so they append
# into a Buf and take the result instead of summing fragment lengths into an
# exact allocation and filling it in a second pass.
fun buf_into_str(b: *json.Buf, alloc: *Allocator) str {
    val view: str = json.buf_str(b);
    if (view == nil) {
        json.buf_dnit(b);
        ret nil;
    }
    val n: usize                     = str_len(view);
    val r: res[*u8, allocator.Error] = allocate[u8](alloc, n + 1);
    if (sel r.err) {
        json.buf_dnit(b);
        ret nil;
    }
    val out: *u8 = r.ok;
    if (n > 0) { mem.raw_copy(out::ptr, view::ptr, n); }
    out[n] = 0;
    json.buf_dnit(b);
    ret out::str;
}

# reply with one Location, or null when the span cannot be reported
fun reply_location(alloc: *Allocator, id_raw: str, text: positions.Text, uri: str, span: token.Span) {
    if (!positions.maps(text, span)) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    var b: json.Buf = json.buf_init(alloc);
    render.result_begin(?b, id_raw);
    render.location(?b, text, uri, span);
    render.send(?b, alloc, id_raw);
}

# reply with one Range, or null when the span cannot be reported
fun reply_range(alloc: *Allocator, id_raw: str, text: positions.Text, span: token.Span) {
    if (!positions.maps(text, span)) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    var b: json.Buf = json.buf_init(alloc);
    render.result_begin(?b, id_raw);
    render.span_range(?b, text, span);
    render.send(?b, alloc, id_raw);
}

# reply with a hover over `name_span`, or null when that span cannot be reported
fun reply_hover(alloc: *Allocator, id_raw: str, text: positions.Text, name_span: token.Span, md: str, markdown: bool) {
    if (!positions.maps(text, name_span)) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    var b: json.Buf = json.buf_init(alloc);
    render.result_begin(?b, id_raw);
    json.buf_push(?b, "{\"contents\":{\"kind\":");
    if (markdown) { json.buf_push_quoted(?b, "markdown"); }
    or            { json.buf_push_quoted(?b, "plaintext"); }
    json.buf_push(?b, ",\"value\":");
    if (markdown) { json.buf_push_quoted(?b, md); }
    or            { push_unfenced(?b, md); }
    json.buf_push(?b, "},\"range\":");
    render.span_range(?b, text, name_span);
    json.buf_push_byte(?b, '}');
    render.send(?b, alloc, id_raw);
}

# the type-driven hover path for a record / union field, consulted
# when the symbol-table pivot finds nothing at `offset`. types the referencing
# expression (a member access `foo.bar` or a struct-literal field name
# `T{ bar: ... }`), peels it to its record site, and renders the field's name,
# its declared type, and - when the record's doc block carries a matching
# `# <name>: <desc>` component - that description. cross-module aware: the record
# may be declared in a dependency module, in which case its Ast / file / doc all
# come from the loaded module. emits the hover over the cursor's field-name span
# and returns true when a field was rendered; returns false (without replying) so
# the caller can fall back to a null reply. requires a loaded project root
# ---
# ws:     the workspace
# alloc:  request allocator
# an:     the analyzed request document
# offset: cursor byte offset into the buffer
# id_raw: the raw JSON request id (for the reply)
# ret:    true when a field hover was rendered and replied
fun field_hover(ws: *project.Workspace, alloc: *Allocator, an: *analysis.Analyzed, offset: usize, id_raw: str, markdown: bool) bool {
    if (an.root == nil) { ret false; }

    val fo: opt[features.FieldRef] = features.field_ref_at(an.a, offset);
    if (sel fo.none) { ret false; }
    val fr: features.FieldRef = fo.some;

    val sr: *sema.SemaResult = an.sr;
    if (sr == nil) { ret false; }

    val tid: type.TypeId             = project.type_of(sr, fr.host);
    val rso: opt[project.RecordSite] = project.record_decl_in(ws, an.root, an.own, an.own_fid, an.a, an.text, tid);
    if (sel rso.none) { ret false; }
    val rs: project.RecordSite = rso.some;

    val md: str = field_hover_markdown(rs, an.text.file, fr.name_span, alloc);
    if (md == nil) { ret false; }

    reply_hover(alloc, id_raw, an.text, fr.name_span, md, markdown);
    ret true;
}

# a fenced `mach` code block rendering a field as
# `<name>: <type>`, with the field's matching doc component description following
# as prose when present. the field is located by matching the cursor's field-name
# bytes `query` (in `query_file`, the buffer) against the record site's declared
# field names; name and type spans are read from the declaring module's source so
# a cross-module field renders. nil when no field matches, the field name cannot
# be read, or allocation fails. a field with no matching doc component renders the
# `name: type` block alone (no description, no error)
fun field_hover_markdown(rs: project.RecordSite, query_file: *src.SourceFile, query: token.Span, alloc: *Allocator) str {
    val i: usize = field_index(rs, query_file, query);
    if (i >= rs.fields_len::usize) { ret nil; }
    val tn: *decl.TypedName = ?rs.a.typed_names[rs.fields_start + i::u32];

    val name: str = positions.span_text(rs.text, tn.name, alloc);
    if (name == nil) { ret nil; }
    val ty: str = field_type_text(rs, tn, alloc);

    var doc:    str             = nil;
    val do_opt: opt[*decl.Decl] = ast.get_decl(rs.a, rs.decl);
    if (sel do_opt.some) {
        val d:   *decl.Decl      = do_opt.some;
        val dso: opt[token.Span] = features.field_doc_desc(rs.text.file.text, d.doc, tn.name);
        if (sel dso.some) { doc = doc_desc_prose(rs.text.file, dso.some, alloc); }
    }

    val r: str = compose_field_hover(name, ty, doc, alloc);
    json.free_str(name, alloc);
    json.free_str(ty, alloc);
    json.free_str(doc, alloc);
    ret r;
}

# the index into the record site's field range whose declared name
# bytes equal `query` (in `query_file`), or fields_len when no field matches. the
# cross-source byte compare lets the receiver and the declaration live in
# different modules
fun field_index(rs: project.RecordSite, query_file: *src.SourceFile, query: token.Span) usize {
    if (query.len == 0) { ret rs.fields_len::usize; }
    var i: u32 = 0;
    for (i < rs.fields_len) {
        val tn: *decl.TypedName = ?rs.a.typed_names[rs.fields_start + i];
        if (features.span_bytes_equal(rs.text.file, tn.name, query_file, query)) { ret i::usize; }
        i = i + 1;
    }
    ret rs.fields_len::usize;
}

# the declared-type text of a field, read from the declaring
# module's source (`TypedName.ty` -> its AST type span), or nil when the field
# carries no type node. the declaring module's file backs the span, so a
# cross-module field's type renders
fun field_type_text(rs: project.RecordSite, tn: *decl.TypedName, alloc: *Allocator) str {
    ret typed_name_type_text(rs.a, rs.text, tn, alloc);
}

# the written type of `tn` in `a`, as source text, or nil when it has none
fun typed_name_type_text(a: *ast.Ast, text: positions.Text, tn: *decl.TypedName, alloc: *Allocator) str {
    if (tn.ty == id.TYPE_NIL) { ret nil; }
    val to: opt[*atype.Type] = ast.get_type(a, tn.ty);
    if (sel to.none) { ret nil; }
    ret positions.span_text(text, to.some.span, alloc);
}

# render a single doc-component description span as prose,
# folding its embedded comment-line breaks the way `doc_text` does. nil on an
# empty span or allocation failure
fun doc_desc_prose(file: *src.SourceFile, span: token.Span, alloc: *Allocator) str {
    if (span.len == 0) { ret nil; }
    val source: str   = file.text;
    val total:  usize = doc_text(nil, 0, source, span);
    if (total == 0) { ret nil; }
    val r: res[*u8, allocator.Error] = allocate[u8](alloc, total + 1);
    if (sel r.err) { ret nil; }
    val buf: *u8 = r.ok;
    doc_text(buf, 0, source, span);
    buf[total] = 0;
    ret buf::str;
}

# assemble the field hover Markdown - a fenced `mach` block
# of `name: type` (or just `name` when the type is unavailable), followed by the
# description prose as a paragraph when present. nil on allocation failure
fun compose_field_hover(name: str, ty: str, doc: str, alloc: *Allocator) str {
    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, "```mach\n");
    json.buf_push(?b, name);
    if (ty != nil) {
        json.buf_push(?b, ": ");
        json.buf_push(?b, ty);
    }
    json.buf_push(?b, "\n```");
    if (doc != nil) {
        json.buf_push(?b, "\n\n");
        json.buf_push(?b, doc);
    }
    ret buf_into_str(?b, alloc);
}

# a fenced `mach` code block rendering the symbol at hover. it
# shows the declaration header as written - read from the buffer for a local
# symbol, from the defining dependency module's file for a cross-module one -
# falling back to the symbol kind and name when no decl header is available. the
# decl's doc comment, if any, follows the block as prose, read from the same
# Site so a cross-module symbol's docs render too
fun hover_markdown(ws: *project.Workspace, an: analysis.Analyzed, sym: *rslv.Symbol, uri: str, alloc: *Allocator) str {
    var sig: str = nil;
    var doc: str = nil;

    # a module alias's decl is the `use` line the cursor is already on, so
    # rendering it back is no answer. name the module instead.
    var mid: sess.ModuleId;
    if (module_alias_target(sym, ?mid) && an.root != nil) {
        val fqn: str = project.module_fqn(ws, an.root, mid);
        if (fqn != nil) { ret module_hover_markdown(fqn, alloc); }
    }

    val site_o: opt[project.Site] = project.site_of(ws, an.root, an.own, an.a, an.text, uri, sym);
    if (sel site_o.some) {
        var site: project.Site = site_o.some;
        if (site.sym.decl != id.DECL_NIL) {
            val sso: opt[token.Span] = features.signature_span(site.a, site.text.file, site.sym);
            if (sel sso.some) {
                sig = positions.span_text(site.text, sso.some, alloc);
            }
            val dso: opt[token.Span] = features.doc_span_of(site.a, site.sym);
            if (sel dso.some) {
                doc = doc_prose(site.text.file, dso.some, decl_kind_of(site.a, site.sym), alloc);
            }
            or { doc = binding_doc(site, site.sym, an, alloc); }
        }
        project.free_site(ws, ?site);
    }
    if (sig == nil) {
        sig = compose_kind_name(sym, an.interner, alloc);
    }
    if (sig == nil) {
        json.free_str(doc, alloc);
        ret nil;
    }

    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, "```mach\n");
    json.buf_push(?b, sig);
    json.buf_push(?b, "\n```");
    if (doc != nil) {
        json.buf_push(?b, "\n\n");
        json.buf_push(?b, doc);
    }
    json.free_str(sig, alloc);
    json.free_str(doc, alloc);
    ret buf_into_str(?b, alloc);
}

# render a declaration's first-class doc block (`Decl.doc`) as
# Markdown. the block is read through `fe/doc.mach`: the summary becomes a prose
# paragraph; when a `# ---` component block follows, a thematic break (`---`
# fenced by blank lines so CommonMark reads a horizontal rule, not a setext
# heading) precedes each `# <name>: <desc>` component rendered as a
# `- **name** - desc` list item. because `Decl.doc` excludes the decl's `#[...]`
# attribute lines, no attribute syntax can leak into the rendering. one
# `doc_render` walk both sizes and fills the buffer, so the two passes cannot
# diverge and the allocation is str_len + 1 as `json.free_str` expects. nil on an
# empty span, a block carrying no rendered text, or allocation failure
# ---
# file:  the source file the doc span points into
# span:  the declaration's `Decl.doc` span
# alloc: request allocator
# ret:   the rendered Markdown, or nil
# the one description a doc block gives for a parameter or a generic
#
# `doc_span_of` refuses these on purpose. A parameter's owning decl is the whole
# function, so rendering that decl's doc block under a cursor on one parameter
# answers a question nobody asked - the reader wants the line written for that
# parameter, which the component block already carries and which nothing was
# reading back out.
# ---
# site:  the declaring site, whose Ast and source the doc block belongs to
# sym:   the parameter or generic under the cursor
# an:    the analysis, for the interner the symbol's name lives in
# alloc: request allocator
# ret:   the folded description, or nil
fun binding_doc(site: project.Site, sym: *rslv.Symbol, an: analysis.Analyzed, alloc: *Allocator) str {
    if (sym.kind != rslv.SYM_PARAM && sym.kind != rslv.SYM_GENERIC) { ret nil; }
    if (sym.decl == id.DECL_NIL)                                    { ret nil; }
    val d_opt: opt[*decl.Decl] = ast.get_decl(site.a, sym.decl);
    if (sel d_opt.none) { ret nil; }
    val d: *decl.Decl = d_opt.some;
    if (d.doc.len == 0) { ret nil; }

    val no: opt[str] = intern.lookup(an.interner, sym.name);
    if (sel no.none) { ret nil; }
    val dso: opt[token.Span] = features.component_desc_named(
        site.text.file.text, d.doc, no.some, sym.kind == rslv.SYM_GENERIC);
    if (sel dso.none) { ret nil; }
    ret doc_fragment(site.text.file.text, dso.some, alloc);
}

# the kind of the decl a symbol was declared by, for naming its components
fun decl_kind_of(a: *ast.Ast, sym: *rslv.Symbol) decl.DeclKind {
    if (sym.decl == id.DECL_NIL) { ret decl.DECL_KIND_FUN; }
    val d_opt: opt[*decl.Decl] = ast.get_decl(a, sym.decl);
    if (sel d_opt.none) { ret decl.DECL_KIND_FUN; }
    ret d_opt.some.kind;
}

# fold one description span into owned prose, by the same walk the whole block
# uses so a wrapped component reads the same either way
fun doc_fragment(source: str, sp: token.Span, alloc: *Allocator) str {
    if (sp.len == 0) { ret nil; }
    val total: usize = doc_text(nil, 0, source, sp);
    if (total == 0) { ret nil; }
    val r: res[*u8, allocator.Error] = allocate[u8](alloc, total + 1);
    if (sel r.err) { ret nil; }
    val buf: *u8 = r.ok;
    doc_text(buf, 0, source, sp);
    buf[total] = 0;
    ret buf::str;
}

fun doc_prose(file: *src.SourceFile, span: token.Span, kind: decl.DeclKind, alloc: *Allocator) str {
    if (span.len == 0) { ret nil; }
    val source: str = file.text;

    var has_text: bool  = false;
    val total:    usize = doc_render(source, span, kind, nil, ?has_text);
    if (!has_text) { ret nil; }

    val r: res[*u8, allocator.Error] = allocate[u8](alloc, total + 1);
    if (sel r.err) { ret nil; }
    val buf: *u8 = r.ok;

    doc_render(source, span, kind, buf, ?has_text);
    buf[total] = 0;
    ret buf::str;
}

# walk a doc block once, writing the Markdown rendering into `buf`
# when it is non-nil and only measuring otherwise. both passes share this walk so
# the sized length and the written bytes stay identical. sets `has_text` when any
# summary or component byte is rendered. returns the rendered length in bytes
fun doc_render(source: str, span: token.Span, kind: decl.DeclKind, buf: *u8, has_text: *bool) usize {
    @has_text = false;
    var off: usize = 0;

    val sum: token.Span = fedoc.summary_span(source, span);
    if (sum.len > 0) {
        off       = doc_text(buf, off, source, sum);
        @has_text = true;
    }

    # the return value is not one of the inputs, and listing it among them read
    # as though a function took an argument called `ret`. It is held back and
    # given its own line, which is also where a reader looks for it
    var ret_desc: token.Span;
    ret_desc.offset = 0;
    ret_desc.len    = 0;

    var it:    fedoc.DocComponentIter = fedoc.component_iter(source, span);
    var c:     fedoc.DocComponent;
    var first: bool                   = true;
    for (fedoc.component_next(?it, ?c)) {
        if (kind == decl.DECL_KIND_FUN && span_is(source, c.name_span, "ret")) {
            ret_desc  = c.desc_span;
            @has_text = true;
            cnt;
        }
        if (first) {
            if (off > 0) {
                off = doc_lf(buf, off);
                off = doc_lf(buf, off);
            }
            off   = doc_emit(buf, off, "**");
            off   = doc_emit(buf, off, component_heading(kind));
            off   = doc_emit(buf, off, "**");
            off   = doc_lf(buf, off);
            first = false;
        }
        off = doc_lf(buf, off);
        off = doc_emit(buf, off, "- `");
        off = doc_text(buf, off, source, c.name_span);
        off = doc_emit(buf, off, "`");
        if (c.desc_span.len > 0) {
            off = doc_emit(buf, off, " \xe2\x80\x94 ");
            off = doc_text(buf, off, source, c.desc_span);
        }
        @has_text = true;
    }

    if (ret_desc.len > 0) {
        if (off > 0) {
            off = doc_lf(buf, off);
            off = doc_lf(buf, off);
        }
        off = doc_emit(buf, off, "**Returns** \xe2\x80\x94 ");
        off = doc_text(buf, off, source, ret_desc);
    }
    ret off;
}

# what a declaration's components are called
#
# The spec names them per declaration kind rather than generically, and a reader
# scanning a hover is looking for the word that matches what they are reading:
# `Fields` under a record, `Parameters` under a function.
fun component_heading(kind: decl.DeclKind) str {
    if (kind == decl.DECL_KIND_FUN) { ret "Parameters"; }
    if (kind == decl.DECL_KIND_REC) { ret "Fields"; }
    if (kind == decl.DECL_KIND_UNI) { ret "Variants"; }
    ret "Components";
}

# whether `sp` covers exactly the bytes of `s`
fun span_is(source: str, sp: token.Span, s: str) bool {
    val n: usize = str_len(s);
    if (sp.len != n) { ret false; }
    val src: *u8   = source::*u8;
    val txt: *u8   = s::*u8;
    var i:   usize = 0;
    for (i < n) {
        if (src[sp.offset + i] != txt[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# write a single newline into `buf` when non-nil, returning the advanced
# offset
fun doc_lf(buf: *u8, off: usize) usize {
    if (buf != nil) { buf[off] = '\n'; }
    ret off + 1;
}

# write null-terminated `s` into `buf` at `off` when non-nil, only
# measuring its length otherwise, returning the advanced offset
fun doc_emit(buf: *u8, off: usize, s: str) usize {
    val n: usize = str_len(s);
    if (buf != nil && n > 0) { mem.raw_copy((buf::usize + off)::ptr, s::ptr, n); }
    ret off + n;
}

# copy a summary / description span into `buf`, keeping the line structure the
# comment carries
#
# A doc comment is wrapped prose, so most line breaks are soft and have to fold
# into a space or every hover arrives as a column of fragments. Not all of them
# are: a bullet list is structure the author wrote deliberately, and folding it
# into the surrounding sentence produced exactly one run-on paragraph with
# `- item` markers stranded mid-sentence, which no renderer reads as a list.
#
# What separates the two is the indentation, which is why this keeps it rather
# than skipping it as whitespace. A marker at any indent starts a line; a line
# indented further than the marker above it is that item wrapping and folds; a
# line back at the prose margin ends the list, and needs a blank line after it or
# the paragraph that follows is absorbed into the final item.
#
# Nesting is emitted relative to the list's own first marker rather than
# verbatim, so a comment that indents its top level by four spaces stays a list
# instead of turning into an indented code block.
#
# A carriage return is treated as part of the line ending rather than as
# content, so a file saved with CRLF renders the same as one saved with LF.
#
# A span from `fe/doc.mach` covers only the first line's leading `#`;
# continuation lines keep their own, so those are stripped here. Measures when
# `buf` is nil, by the same walk, so the two passes cannot disagree.
fun doc_text(buf: *u8, off: usize, source: str, sp: token.Span) usize {
    val s:        *u8   = source::*u8;
    val end:      usize = sp.offset + sp.len;
    var i:        usize = sp.offset;
    var at_break: bool  = false;
    var in_list:  bool  = false;
    var base:     usize = 0;
    var item:     usize = 0;

    for (i < end) {
        # a carriage return belongs to the line ending, not to the line. A file
        # saved with CRLF put one at the end of every doc line, and copying it
        # as content dropped a stray control byte into the middle of the
        # rendered prose
        if (s[i] == '\r') {
            i = i + 1;
            cnt;
        }

        if (s[i] != '\n') {
            if (buf != nil) { buf[off] = s[i]; }
            off      = off + 1;
            at_break = false;
            i        = i + 1;
            cnt;
        }

        # step over the break and the next line's comment prefix, then measure
        # the indentation that follows it
        i = i + 1;
        for (i < end && (s[i] == ' ' || s[i] == '\t')) { i = i + 1; }
        if (i < end && s[i] == '#') { i = i + 1; }
        var indent: usize = 0;
        for (i < end && (s[i] == ' ' || s[i] == '\t')) {
            indent = indent + 1;
            i      = i + 1;
        }

        # a comment line with nothing after its `#` is a paragraph break, not a
        # wrapped line. Folding it to a space ran two paragraphs together and
        # left the join marked only by a double space, which no renderer treats
        # as a boundary
        if (i >= end || s[i] == '\n' || s[i] == '\r') {
            if (!at_break) {
                off      = doc_lf(buf, off);
                off      = doc_lf(buf, off);
                at_break = true;
            }
            in_list = false;
            cnt;
        }

        if (marker_at(s, i, end)) {
            if (in_list) { off = doc_lf(buf, off); }
            or {
                if (!at_break) {
                    off = doc_lf(buf, off);
                    off = doc_lf(buf, off);
                }
                in_list = true;
                base    = indent;
            }
            item = indent;
            var k: usize = base;
            for (k < indent) {
                off = doc_ch(buf, off, ' ');
                k   = k + 1;
            }
            at_break = false;
            cnt;
        }

        if (in_list && indent > item) {
            off      = doc_ch(buf, off, ' ');
            at_break = false;
            cnt;
        }

        if (in_list) {
            off      = doc_lf(buf, off);
            off      = doc_lf(buf, off);
            in_list  = false;
            at_break = true;
            cnt;
        }

        if (!at_break) { off = doc_ch(buf, off, ' '); }
        at_break = false;
    }
    ret off;
}

# whether a list marker starts at `i`
#
# The bullet forms plus the ordered ones, because this renders whatever the
# reader has open and not only the comments in this repository. A marker needs
# the space after it: `-1` and `1.5` are text, not list items.
fun marker_at(s: *u8, i: usize, end: usize) bool {
    if (i >= end) { ret false; }
    if (s[i] == '-' || s[i] == '*' || s[i] == '+') {
        ret i + 1 < end && (s[i + 1] == ' ' || s[i + 1] == '\t');
    }
    if (s[i] < '0' || s[i] > '9') { ret false; }
    var j: usize = i;
    for (j < end && s[j] >= '0' && s[j] <= '9') { j = j + 1; }
    if (j >= end || (s[j] != '.' && s[j] != ')')) { ret false; }
    ret j + 1 < end && (s[j + 1] == ' ' || s[j + 1] == '\t');
}

# write one byte into `buf` when non-nil, returning the advanced offset
fun doc_ch(buf: *u8, off: usize, c: u8) usize {
    if (buf != nil) { buf[off] = c; }
    ret off + 1;
}

# a `<kind> <name>` rendering for a symbol with no local
# decl header (an imported symbol or primitive), or nil
fun compose_kind_name(sym: *rslv.Symbol, interner: *intern.Interner, alloc: *Allocator) str {
    val no: opt[str] = intern.lookup(interner, sym.name);
    if (sel no.none) { ret nil; }
    val name: str = no.some;
    val kind: str = features.kind_label(sym.kind);

    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, kind);
    json.buf_push_byte(?b, ' ');
    json.buf_push(?b, name);
    ret buf_into_str(?b, alloc);
}

# answer textDocument/definition with the Location of the resolved
# symbol's declaration. lands in the buffer for a local symbol and in the
# defining dependency module's on-disk file for a cross-module one; null when
# the position is not on a resolved symbol or its declaration cannot be located
pub fun definition(ws: *project.Workspace, es: *editor.EditorSession, alloc: *Allocator, docs: *documents.Store, id: *sj.Value, params: *sj.Value, uri: str) {
    val id_raw: str = json.id_text(id, alloc);
    if (id_raw == nil) { ret; }

    var an:    analysis.Analyzed;
    val off_o: opt[usize] = analysis.locate(ws, es, docs, params, uri, ?an);
    if (sel off_o.none) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    val offset: usize = off_o.some;

    val ro: opt[features.SymbolRef] = features.ref_at(an.a, an.rr, an.own, an.text.file, offset);
    if (sel ro.none) {
        # name resolution leaves a value-field access unbound, so a cursor on a
        # field name yields no SymbolRef - fall through to the type-driven field
        # path before giving up.
        if (field_definition(ws, alloc, ?an, uri, offset, id_raw)) { ret; }
        render.reply_null(alloc, id_raw);
        ret;
    }
    val sr: features.SymbolRef = ro.some;

    val so: opt[*rslv.Symbol] = features.symbol(an.rr, sr.sym_id);
    if (sel so.none) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    val sym: *rslv.Symbol = so.some;

    # a module alias names a file, not a declaration: `sym.decl` is the `use`
    # line the cursor is already on, and the module has no name span to point
    # at. its target ModuleId rides `sym.slot`, so answer with the module's own
    # file at its start.
    if (module_definition(ws, an, sym, alloc, id_raw)) { ret; }

    val site_o: opt[project.Site] = project.site_of(ws, an.root, an.own, an.a, an.text, uri, sym);
    if (sel site_o.none) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    var site: project.Site = site_o.some;

    val spo: opt[token.Span] = features.definition_name_span(site.a, site.sym);
    if (sel spo.none) {
        project.free_site(ws, ?site);
        render.reply_null(alloc, id_raw);
        ret;
    }
    val span: token.Span = spo.some;

    reply_location(alloc, id_raw, site.text, site.uri, span);
    project.free_site(ws, ?site);
}

# answer textDocument/typeDefinition with the declaring site of the *type* of the
# thing under the cursor
#
# Go-to-definition answers where a name was declared; this answers where its type
# was declared. The pivot is `type_site_at`, which maps the cursor to the rec /
# uni / tag that names its type.
#
# A type with no nominal declaration - a primitive, an array, a function type -
# answers null, the protocol's "nothing to go to". So does a document outside any
# project: the nominal back-link is a read against the session's type interner,
# which only a loaded root owns, and the single-buffer editor session has none.
pub fun type_definition(ws: *project.Workspace, es: *editor.EditorSession, alloc: *Allocator, docs: *documents.Store, req: *sj.Value, params: *sj.Value, uri: str) {
    val id_raw: str = json.id_text(req, alloc);
    if (id_raw == nil) { ret; }

    var an:    analysis.Analyzed;
    val off_o: opt[usize] = analysis.locate(ws, es, docs, params, uri, ?an);
    if (sel off_o.none) {
        render.reply_null(alloc, id_raw);
        ret;
    }

    val so: opt[project.TypeSite] = type_site_at(ws, ?an, off_o.some);
    if (sel so.none) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    val ts: project.TypeSite = so.some;

    var furi:  str  = uri;
    var owned: bool = false;
    if (ts.origin != an.own) {
        furi = project.module_uri(ws, an.root, ts.origin);
        if (furi == nil) {
            render.reply_null(alloc, id_raw);
            ret;
        }
        owned = true;
    }

    reply_location(alloc, id_raw, ts.text, furi, ts.name_span);
    if (owned) { json.free_str(furi, ws.alloc); }
}

# the declaring site of the type the cursor names, or none
#
# Four candidates are tried in order, and the first one that resolves to a
# declaration wins. Resolving - not merely typing - is the test, because the
# tightest node often has a type that names no declaration: the callee of a call
# has a function type, so committing to it would answer null on the cursor
# position users reach for most.
#
#   1. the tightest expression - a value, a member access, a call result;
#   2. the call whose callee that expression is, so a cursor on `make` in
#      `make()` reaches the return type rather than the function type;
#   3. a written type, which is neither expression nor declaration: `Box` in
#      `var b: Box[i32];`, a field's declared type, a return type;
#   4. the binding under the cursor: a function parameter's written type, which
#      is not a decl of its own, else the enclosing declaration's type.
# ---
# ws:     the workspace
# an:     the analyzed request document
# offset: cursor byte offset into the buffer
# ret:    some(TypeSite), or none
fun type_site_at(ws: *project.Workspace, an: *analysis.Analyzed, offset: usize) opt[project.TypeSite] {
    if (an.sr == nil) { ret opt[project.TypeSite].none{}; }

    val eid: id.ExprId = ast.offset_to_expr(an.a, offset);
    if (eid != id.EXPR_NIL) {
        val so: opt[project.TypeSite] = site_of_type(ws, an, project.type_of(an.sr, eid));
        if (sel so.some) { ret so; }

        val call: id.ExprId = enclosing_call(an.a, eid);
        if (call != id.EXPR_NIL) {
            val co: opt[project.TypeSite] = site_of_type(ws, an, project.type_of(an.sr, call));
            if (sel co.some) { ret co; }
        }
    }

    val atid: id.TypeId = ast.offset_to_type(an.a, offset);
    if (atid != id.TYPE_NIL) {
        val to: opt[project.TypeSite] = site_of_type(ws, an, project.type_ref_of(an.sr, atid));
        if (sel to.some) { ret to; }
    }

    val did: id.DeclId = ast.offset_to_decl(an.a, offset);
    if (did == id.DECL_NIL) { ret opt[project.TypeSite].none{}; }

    val ptid: id.TypeId = features.param_type_at(an.a, did, offset);
    if (ptid != id.TYPE_NIL) { ret site_of_type(ws, an, project.type_ref_of(an.sr, ptid)); }
    ret site_of_type(ws, an, project.decl_type_of(an.sr, did));
}

# the declaring site of `tid` against the request's buffer and project
fun site_of_type(ws: *project.Workspace, an: *analysis.Analyzed, tid: type.TypeId) opt[project.TypeSite] {
    if (tid == type.TYPE_NIL) { ret opt[project.TypeSite].none{}; }
    ret project.type_site_in(ws, an.root, an.own, an.own_fid, an.a, an.text, tid);
}

# the call expression `eid` is the callee of, or EXPR_NIL. a call
# records its callee, never the reverse, so the only way back up is a scan
fun enclosing_call(a: *ast.Ast, eid: id.ExprId) id.ExprId {
    var i: usize = 0;
    for (i < a.expr_len) {
        val eo: opt[*aexpr.Expr] = ast.get_expr(a, i::id.ExprId);
        if (sel eo.some) {
            val e: *aexpr.Expr = eo.some;
            if (e.kind == aexpr.EXPR_KIND_CALL && e.data.call.callee == eid) { ret i::id.ExprId; }
        }
        i = i + 1;
    }
    ret id.EXPR_NIL;
}

# `module <fqn>` as a fenced hover body
fun module_hover_markdown(fqn: str, alloc: *Allocator) str {
    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, "```mach\nmodule ");
    json.buf_push(?b, fqn);
    json.buf_push(?b, "\n```");
    val view: str = json.buf_str(?b);
    if (view == nil) {
        json.buf_dnit(?b);
        ret nil;
    }
    val n: usize                     = str_len(view);
    val r: res[*u8, allocator.Error] = allocate[u8](alloc, n + 1);
    if (sel r.err) {
        json.buf_dnit(?b);
        ret nil;
    }
    val out: *u8 = r.ok;
    if (n > 0) { mem.raw_copy(out::ptr, view::ptr, n); }
    out[n] = 0;
    json.buf_dnit(?b);
    ret out::str;
}

# whether `sym` is a module alias (`use json: mls.json;`) rather than a symbol
# import (`use std.types.string.str_equals;`), and the module it names
#
# The two forms are distinguished by kind, not by a flag: a module alias binds
# SYM_USE carrying the target ModuleId in `slot`, while a symbol import binds
# SYM_IMPORTED carrying the imported declaration. `SYM_FLAG_MODULE` is set on
# the PublicSymbol snapshot of a re-exported alias, not on the local symbol, so
# it is not the discriminator here.
# ---
# sym: the symbol under the cursor
# out: receives the aliased module id
# ret: true when `sym` is a module alias
fun module_alias_target(sym: *rslv.Symbol, out: *sess.ModuleId) bool {
    if (sym.kind != rslv.SYM_USE) { ret false; }
    @out = sym.slot::sess.ModuleId;
    ret true;
}

# emit the Location of the module `sym` aliases, at the start of its file
# ---
# ws:     the workspace
# an:     the analyzed request document
# sym:    the symbol under the cursor
# alloc:  request allocator
# id_raw: the raw JSON request id, consumed on success
# ret:    true when a module Location was emitted and replied
fun module_definition(ws: *project.Workspace, an: analysis.Analyzed, sym: *rslv.Symbol, alloc: *Allocator, id_raw: str) bool {
    var mid: sess.ModuleId;
    if (!module_alias_target(sym, ?mid)) { ret false; }
    if (an.root == nil)                  { ret false; }
    val muri: str = project.module_uri(ws, an.root, mid);
    if (muri == nil) { ret false; }

    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"id\":");
    json.buf_push(?b, id_raw);
    json.buf_push(?b, ",\"result\":{\"uri\":");
    json.buf_push_quoted(?b, muri);
    json.buf_push(?b, ",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}}}");
    val msg: str = json.buf_str(?b);
    if (msg != nil) {
        transport.send_message(msg, alloc);
        render.note_response();
    }
    json.buf_dnit(?b);
    strutil.str_free(ws.alloc, muri);
    json.free_str(id_raw, alloc);
    ret true;
}

# the type-driven go-to-definition path for a record / union
# field, consulted when the symbol-table pivot finds nothing at `offset`. handles
# three field positions: a member access `foo.bar`, a struct-literal field name
# `T{ bar: ... }`, and a field's own declaration site (which resolves to itself).
# the first two type the referencing expression, peel it to its record site, and
# match the field name; the third matches the cursor against the rec / uni decl's
# own field names. emits the field declaration's Location and returns true when a
# field is found and replied; returns false (without replying) so the caller can
# fall back to a null reply otherwise. requires a loaded project root for typing
# ---
# ws:     the workspace
# alloc:  request allocator
# an:     the analyzed request document
# uri:    the request document URI
# offset: cursor byte offset into the buffer
# id_raw: the raw JSON request id (for the reply)
# ret:    true when a field declaration was located and emitted
fun field_definition(ws: *project.Workspace, alloc: *Allocator, an: *analysis.Analyzed, uri: str, offset: usize, id_raw: str) bool {
    if (an.root == nil) { ret false; }

    val fo: opt[features.FieldRef] = features.field_ref_at(an.a, offset);
    if (sel fo.some) {
        val fr: features.FieldRef = fo.some;

        val sr: *sema.SemaResult = an.sr;
        if (sr == nil) { ret false; }

        val tid: type.TypeId             = project.type_of(sr, fr.host);
        val rso: opt[project.RecordSite] = project.record_decl_in(ws, an.root, an.own, an.own_fid, an.a, an.text, tid);
        if (sel rso.none) { ret false; }
        val rs: project.RecordSite = rso.some;

        val spo: opt[token.Span] = features.field_decl_span(rs.a, rs.text.file, rs.fields_start, rs.fields_len, an.text.file, fr.name_span);
        if (sel spo.none) { ret false; }
        ret emit_field_location(ws, alloc, an, uri, rs, spo.some, id_raw);
    }

    # the cursor may sit on a field's own declaration name inside a rec / uni;
    # resolve it to itself by matching the offset against the decl's field names
    val self_o: opt[FieldSelf] = field_self_at(an, offset);
    if (sel self_o.some) {
        val fs: FieldSelf = self_o.some;
        reply_location(alloc, id_raw, an.text, uri, fs.name);
        ret true;
    }

    ret false;
}

# a field declaration the cursor sits on at its own definition site -
# the field name span resolves to itself for go-to-definition
# ---
# name: byte span of the field name in the buffer
rec FieldSelf {
    name: token.Span;
}

# the rec / uni field whose own declaration name covers `offset` in
# the buffer, or none. enumerates the buffer's record / union declarations and
# their fields so a cursor on a field's binding name resolves to itself
# ---
# an:     the analyzed request document
# offset: cursor byte offset into the buffer
# ret:    some(FieldSelf) on a field declaration name, or none
fun field_self_at(an: *analysis.Analyzed, offset: usize) opt[FieldSelf] {
    val did: id.DeclId = ast.offset_to_decl(an.a, offset);
    if (did == id.DECL_NIL) { ret opt[FieldSelf].none{}; }
    val d_opt: opt[*decl.Decl] = ast.get_decl(an.a, did);
    if (sel d_opt.none) { ret opt[FieldSelf].none{}; }
    val d: *decl.Decl = d_opt.some;

    var start: u32 = 0;
    var len:   u32 = 0;
    if (d.kind == decl.DECL_KIND_REC) {
        start = d.data.rec_.fields_start;
        len   = d.data.rec_.fields_len;
    }
    or (d.kind == decl.DECL_KIND_UNI) {
        start = d.data.uni_.fields_start;
        len   = d.data.uni_.fields_len;
    }
    or {
        ret opt[FieldSelf].none{};
    }

    val nso: opt[token.Span] = features.field_decl_self_at(an.a, start, len, offset);
    if (sel nso.none) { ret opt[FieldSelf].none{}; }
    var fs: FieldSelf;
    fs.name = nso.some;
    ret opt[FieldSelf].some{fs};
}

# send the Location of a field declaration at its record
# site. builds the site's `file://` URI (the buffer's own URI when the record is
# declared in this module, else the defining module's on-disk file) and emits the
# field name span. true on success; false on a URI / allocation failure
fun emit_field_location(ws: *project.Workspace, alloc: *Allocator, an: *analysis.Analyzed, uri: str, rs: project.RecordSite, name: token.Span, id_raw: str) bool {
    var furi:  str  = uri;
    var owned: bool = false;
    if (rs.origin != an.own) {
        furi = project.module_uri(ws, an.root, rs.origin);
        if (furi == nil) { ret false; }
        owned = true;
    }

    reply_location(alloc, id_raw, rs.text, furi, name);
    if (owned) { json.free_str(furi, ws.alloc); }
    ret true;
}

# a record / union field resolved from a cursor, the type-driven twin
# of a SymbolRef for the field references / rename / prepareRename paths. carries
# the field's cross-module identity (`key`), the record's declaring site (`rs`,
# for the field-declaration span and its doc block), and whether that site is the
# active buffer (so the declaring module's edits - the field decl name and the doc
# component - are placed in the buffer's URI rather than a loaded module's)
# ---
# key:            the field's cross-module identity
# rs:             the record's declaring site (field range, Ast, file, doc)
# decl_in_buffer: true when the record is declared in the active buffer
rec FieldTarget {
    key:            features.FieldKey;
    rs:             project.RecordSite;
    decl_in_buffer: bool;
}

# the record / union field a cursor references, resolved to its
# cross-module identity and declaring site, or none. drives the field references /
# rename / prepareRename paths: pivots the offset through `field_ref_at` (a member
# access or struct-literal field name) or `field_self_at` (a field's own decl
# name), types the host expression, peels it to a `RecordSite`, and matches the
# field name to recover its declaring span. none when the position is not on a
# field, the host cannot be typed, or no field matches. requires a loaded project
# root for typing
# ---
# ws:     the workspace
# an:     the analyzed request document
# offset: cursor byte offset into the buffer
# ret:    some(FieldTarget) on a field position, or none
fun field_target_at(ws: *project.Workspace, an: *analysis.Analyzed, offset: usize) opt[FieldTarget] {
    if (an.root == nil) { ret opt[FieldTarget].none{}; }

    val fo: opt[features.FieldRef] = features.field_ref_at(an.a, offset);
    if (sel fo.some) {
        val fr: features.FieldRef = fo.some;
        if (an.sr == nil) { ret opt[FieldTarget].none{}; }
        val tid: type.TypeId             = project.type_of(an.sr, fr.host);
        val rso: opt[project.RecordSite] = project.record_decl_in(ws, an.root, an.own, an.own_fid, an.a, an.text, tid);
        if (sel rso.none) { ret opt[FieldTarget].none{}; }
        val rs:  project.RecordSite = rso.some;
        val spo: opt[token.Span]    = features.field_decl_span(rs.a, rs.text.file, rs.fields_start, rs.fields_len, an.text.file, fr.name_span);
        if (sel spo.none) { ret opt[FieldTarget].none{}; }
        ret opt[FieldTarget].some{make_field_target(an, rs, spo.some)};
    }

    # the cursor may sit on a field's own declaration name inside a rec / uni in
    # the buffer; resolve it to itself, then to that record's site for the walk
    val self_o: opt[FieldSelf] = field_self_at(an, offset);
    if (sel self_o.some) {
        val fs:  FieldSelf               = self_o.some;
        val did: id.DeclId               = ast.offset_to_decl(an.a, offset);
        val rso: opt[project.RecordSite] = project.record_site_at(project.interner(ws, an.root), ws.alloc, an.own, an.own_fid, an.a, an.text, did);
        if (sel rso.none) { ret opt[FieldTarget].none{}; }
        ret opt[FieldTarget].some{make_field_target(an, rso.some, fs.name)};
    }

    ret opt[FieldTarget].none{};
}

# assemble a FieldTarget from a resolved record site and the
# field's declared-name span. the field name and its source live in the record's
# declaring module (`rs.text.file`), which is the cross-module byte identity every
# other module's references are matched against
fun make_field_target(an: *analysis.Analyzed, rs: project.RecordSite, field_name: token.Span) FieldTarget {
    var t: FieldTarget;
    t.key.origin     = rs.origin;
    t.key.decl       = rs.decl;
    t.key.file       = rs.file;
    t.key.name       = rs.name;
    t.key.decl_file  = rs.text.file;
    t.key.field_name = field_name;
    t.rs             = rs;
    t.decl_in_buffer = rs.origin == an.own;
    ret t;
}

# one module contributing field references - its Ast, SemaResult (for
# typing each host expression), source file, document URI, and whether it is the
# record's declaring module (so its field-declaration name span and doc component
# are emitted). the active buffer is always `out[0]`; each other loaded module
# that types a reference is another (owned `file://` URI freed by free_field_refs)
rec FieldXRef {
    a:         *ast.Ast;
    sr:        *sema.SemaResult;
    text:      positions.Text;
    uri:       str;
    declaring: bool;
    owned:     bool;
}

# populate `out` with each compiler-owned module exactly once. The active module
# borrows the request URI; all other modules own their generated file URI. A
# standalone buffer contributes its editor semantic result as the sole entry.
# ---
# ws:  the workspace
# an:  the active buffer's analysis
# uri: the active buffer's document URI
# t:   the resolved field target
# out: array of at least `cap` FieldXRef slots
# cap: capacity of `out` (module_count, or one for a standalone file)
# ret: number of populated entries (>= 1), or 0 when the buffer cannot be typed
fun build_field_refs(ws: *project.Workspace, an: analysis.Analyzed, uri: str, t: FieldTarget, out: *FieldXRef, cap: usize) usize {
    if (an.sr == nil) { ret 0; }
    if (an.root == nil) {
        out[0].a         = an.a;
        out[0].sr        = an.sr;
        out[0].text      = an.text;
        out[0].uri       = uri;
        out[0].declaring = t.decl_in_buffer;
        out[0].owned     = false;
        ret 1;
    }

    var n:   usize = 0;
    val mc:  u32   = project.module_count(an.root);
    var mid: u32   = 0;
    for (mid < mc && n < cap) {
        val cur:  sess.ModuleId           = mid::sess.ModuleId;
        val mv_o: opt[project.ModuleView] = project.module_view(ws, an.root, cur);
        if (sel mv_o.none) {
            mid = mid + 1;
            cnt;
        }
        if (mv_o.some.sr == nil) {
            mid = mid + 1;
            cnt;
        }
        var muri: str = nil;
        if (cur == an.own) { muri = uri; }
        or                 { muri = project.module_uri(ws, an.root, cur); }
        if (muri == nil) {
            mid = mid + 1;
            cnt;
        }
        val mv: project.ModuleView = mv_o.some;
        out[n].a         = mv.a;
        out[n].sr        = mv.sr;
        out[n].text      = mv.text;
        out[n].uri       = muri;
        out[n].declaring = cur == t.key.origin;
        out[n].owned     = cur != an.own;
        n                = n + 1;
        mid              = mid + 1;
    }
    ret n;
}

# release generated graph-module URIs; the active request URI is borrowed
fun free_field_refs(ws: *project.Workspace, refs: *FieldXRef, n: usize) {
    var i: usize = 0;
    for (i < n) {
        if (refs[i].owned && refs[i].uri != nil) { json.free_str(refs[i].uri, ws.alloc); }
        i = i + 1;
    }
}

# feed every site naming the keyed field in module `s` to the
# sink - every member access / struct-literal init whose host type peels to the
# keyed record, plus (when `s` is the record's declaring module) the field
# declaration's own name span and, for rename, the matching `# <field>:` doc
# component name token. the span set is computed by the pure
# `features.collect_field_sites` (a module can name a field at most once per expr,
# so the buffer is sized to the expr count plus the two declaring extras)
fun walk_field_sites(s: *FieldXRef, ti: *type.TypeInterner, t: FieldTarget, want_doc: bool, k: *WalkSink) {
    var doc: token.Span;
    doc.offset = 0;
    doc.len    = 0;
    if (s.declaring) {
        val d_opt: opt[*decl.Decl] = ast.get_decl(t.rs.a, t.rs.decl);
        if (sel d_opt.some) { doc = d_opt.some.doc; }
    }

    val cap: usize                             = s.a.expr_len + 2;
    val ra:  res[*token.Span, allocator.Error] = allocate[token.Span](k.alloc, cap);
    if (sel ra.err) { ret; }
    val spans: *token.Span = ra.ok;

    val n: usize = features.collect_field_sites(s.a, s.sr, ti, s.text.file, t.key, s.declaring, want_doc, t.rs.text.file.text, doc, spans, cap);
    var i: usize = 0;
    for (i < n) {
        sink_emit(k, s.text, s.uri, spans[i]);
        i = i + 1;
    }
    deallocate[token.Span](k.alloc, spans, cap);
}

# the type-driven references path for a record / union field.
# resolves the field, walks every loaded module's SemaResult collecting its
# member-access / struct-literal sites plus the field declaration, and emits a
# Location[]. true when a field was resolved and replied; false (without replying)
# so the caller falls back to an empty array
fun field_references(ws: *project.Workspace, alloc: *Allocator, an: *analysis.Analyzed, uri: str, offset: usize, id_raw: str) bool {
    val to: opt[FieldTarget] = field_target_at(ws, an, offset);
    if (sel to.none) { ret false; }
    val t: FieldTarget = to.some;

    var cap: usize = project.module_count(an.root)::usize;
    if (cap == 0) { cap = 1; }
    val ra: res[*FieldXRef, allocator.Error] = allocate[FieldXRef](alloc, cap);
    if (sel ra.err) { ret false; }
    val refs: *FieldXRef = ra.ok;

    val n: usize = build_field_refs(ws, @an, uri, t, refs, cap);
    if (n == 0) {
        deallocate[FieldXRef](alloc, refs, cap);
        ret false;
    }

    emit_field_locations(ws, an.root, alloc, id_raw, refs, n, t);
    free_field_refs(ws, refs, n);
    deallocate[FieldXRef](alloc, refs, cap);
    ret true;
}

# the type-driven rename path for a record / union field. refuses
# (returns false without replying - the caller emits an empty edit) when the
# field's record is declared in a vendored dependency: such a declaration is not
# the editor's to rewrite. otherwise resolves the field, walks every loaded
# module, and emits a WorkspaceEdit replacing every member-access / struct-literal
# site, the field declaration, and the record's matching doc component. true when
# the edit was replied
fun field_rename(ws: *project.Workspace, alloc: *Allocator, an: *analysis.Analyzed, uri: str, offset: usize, id_raw: str, new_name: str) bool {
    val to: opt[FieldTarget] = field_target_at(ws, an, offset);
    if (sel to.none) { ret false; }
    val t: FieldTarget = to.some;

    if (!field_record_renameable(ws, an.root, t)) {
        render.reply_error(alloc, id_raw, render.REQUEST_FAILED, DEPENDENCY_REFUSAL);
        ret true;
    }
    if (record_has_field(t.rs, new_name)) {
        refuse_rename(alloc, id_raw, "is already a field of this record", new_name, nil);
        ret true;
    }

    var cap: usize = project.module_count(an.root)::usize;
    if (cap == 0) { cap = 1; }
    val ra: res[*FieldXRef, allocator.Error] = allocate[FieldXRef](alloc, cap);
    if (sel ra.err) { ret false; }
    val refs: *FieldXRef = ra.ok;

    val n: usize = build_field_refs(ws, @an, uri, t, refs, cap);
    if (n == 0) {
        deallocate[FieldXRef](alloc, refs, cap);
        render.reply_empty_edit(alloc, id_raw);
        ret true;
    }

    if (field_rename_keeps_meaning(ws, an.root, alloc, refs, n, t, new_name, id_raw)) {
        emit_field_rename(ws, an.root, alloc, id_raw, refs, n, t, new_name);
    }
    free_field_refs(ws, refs, n);
    deallocate[FieldXRef](alloc, refs, cap);
    ret true;
}

# whether the field's canonical declaring module is owned by the user
fun field_record_renameable(ws: *project.Workspace, root: *project.Root, t: FieldTarget) bool {
    if (root == nil) { ret true; }
    ret project.is_project_module(ws, root, t.key.origin);
}

# write the field-name span the cursor sits on into `out` and
# return true when it resolves to a field of a project-owned record, or false. the
# prepareRename gate for field positions
fun field_prepare_span(ws: *project.Workspace, an: *analysis.Analyzed, uri: str, offset: usize, out: *token.Span) bool {
    val to: opt[FieldTarget] = field_target_at(ws, an, offset);
    if (sel to.none) { ret false; }
    val t: FieldTarget = to.some;
    if (!field_record_renameable(ws, an.root, t)) { ret false; }
    # the range reported is the cursor's own field-name token in the buffer; the
    # decl-site name lives in the record's module, which may not be the buffer
    val fo: opt[features.FieldRef] = features.field_ref_at(an.a, offset);
    if (sel fo.some) {
        @out = fo.some.name_span;
        ret true;
    }
    val self_o: opt[FieldSelf] = field_self_at(an, offset);
    if (sel self_o.some) {
        @out = self_o.some.name;
        ret true;
    }
    ret false;
}

# send a Location[] of every field site across `refs` (each
# module's member-access / struct-literal sites plus the field declaration). takes
# ownership of `id_raw` and frees it
fun emit_field_locations(ws: *project.Workspace, root: *project.Root, alloc: *Allocator, id_raw: str, refs: *FieldXRef, nref: usize, t: FieldTarget) {
    val ti: *type.TypeInterner = project.type_interner(ws, root);
    var b:  json.Buf           = json.buf_init(alloc);
    render.result_begin(?b, id_raw);
    json.buf_push_byte(?b, '[');

    var k: WalkSink = sink_init(?b, alloc, nil, nil);
    var i: usize    = 0;
    for (i < nref) {
        walk_field_sites(?refs[i], ti, t, false, ?k);
        i = i + 1;
    }

    json.buf_push_byte(?b, ']');
    render.send(?b, alloc, id_raw);
}

# send a WorkspaceEdit renaming the field to `new_name` across
# `refs`, one `changes` entry per module. each entry rewrites that module's
# member-access / struct-literal sites; the declaring module's entry also rewrites
# the field declaration and the record's matching doc component. takes ownership of
# `id_raw` and frees it
fun emit_field_rename(ws: *project.Workspace, root: *project.Root, alloc: *Allocator, id_raw: str, refs: *FieldXRef, nref: usize, t: FieldTarget, new_name: str) {
    val ti: *type.TypeInterner = project.type_interner(ws, root);
    var b:  json.Buf           = json.buf_init(alloc);
    render.result_begin(?b, id_raw);
    json.buf_push(?b, "{\"changes\":{");

    var emitted: usize = 0;
    var hole:    bool  = false;
    var i:       usize = 0;
    for (i < nref) {
        if (push_field_rename_group(?b, ?refs[i], ti, t, new_name, emitted > 0, alloc, ?hole)) {
            emitted = emitted + 1;
        }
        i = i + 1;
    }
    finish_rename(?b, alloc, id_raw, hole);
}

# send a built WorkspaceEdit, unless some occurrence could not be carried into
# the client's buffer: an edit set with a hole in it renames half a symbol, so
# the client is told to ask again instead
fun finish_rename(b: *json.Buf, alloc: *Allocator, id_raw: str, hole: bool) {
    if (hole) {
        json.buf_dnit(b);
        render.reply_error(alloc, id_raw, render.CONTENT_MODIFIED, "the document changed while the rename was computed");
        ret;
    }
    json.buf_push(b, "}}");
    render.send(b, alloc, id_raw);
}

# append the `changes`-map entry `"<uri>":[<edits>]` for module `s`
#
# Rewrites that module's field sites and, for the declaring module, the field
# declaration and the record's matching doc component. Opened speculatively and
# rolled back when the module contributes no edit, so one walk decides and
# writes.
fun push_field_rename_group(b: *json.Buf, s: *FieldXRef, ti: *type.TypeInterner, t: FieldTarget,
    new_name: str, comma: bool, alloc: *Allocator, hole: *bool) bool {
    val mark: usize = json.buf_len(b);
    if (comma) { json.buf_push_byte(b, ','); }
    json.buf_push_quoted(b, s.uri);
    json.buf_push(b, ":[");

    var k: WalkSink = sink_init(b, alloc, new_name, nil);
    walk_field_sites(s, ti, t, true, ?k);
    if (k.unmapped) { @hole = true; }
    if (k.count == 0) {
        json.buf_rewind(b, mark);
        ret false;
    }

    json.buf_push_byte(b, ']');
    ret true;
}

# answer textDocument/references with every Location resolving to
# the symbol at the cursor - its declaration plus every use-site across the
# loaded project graph (the requesting buffer and every other module that
# references the symbol). empty when the position is not on a resolved symbol
pub fun references(ws: *project.Workspace, es: *editor.EditorSession, alloc: *Allocator, docs: *documents.Store, id: *sj.Value, params: *sj.Value, uri: str) {
    val id_raw: str = json.id_text(id, alloc);
    if (id_raw == nil) { ret; }

    var an:    analysis.Analyzed;
    val off_o: opt[usize] = analysis.locate_current(ws, es, docs, params, uri, ?an);
    if (sel off_o.none) {
        render.reply_empty_array(alloc, id_raw);
        ret;
    }
    val offset: usize = off_o.some;

    val ro: opt[features.SymbolRef] = features.ref_at(an.a, an.rr, an.own, an.text.file, offset);
    if (sel ro.none) {
        # name resolution leaves a value-field access unbound, so a cursor on a
        # field name yields no SymbolRef - fall through to the type-driven field
        # references before giving up.
        if (field_references(ws, alloc, ?an, uri, offset, id_raw)) { ret; }
        render.reply_empty_array(alloc, id_raw);
        ret;
    }
    val sr: features.SymbolRef = ro.some;

    val so: opt[*rslv.Symbol] = features.symbol(an.rr, sr.sym_id);
    if (sel so.none) {
        render.reply_empty_array(alloc, id_raw);
        ret;
    }
    val sym: *rslv.Symbol = so.some;

    var bind:     token.Span;
    val has_bind: bool = binding_span(an, sr.sym_id, ?bind);

    var set: RefSet = empty_refs();
    if (!build_refs(ws, alloc, an, uri, sym, sr.sym_id, false, ?set)) {
        render.reply_empty_array(alloc, id_raw);
        ret;
    }
    emit_locations(alloc, id_raw, set.items, set.len, bind, has_bind);
    free_refs(ws, alloc, ?set);
}

# answer textDocument/documentHighlight with every occurrence of the symbol at
# the cursor within this document, classified read or write
#
# The same query `references` answers, scoped to one file and with an access
# kind. Clients fire it on every cursor move, so it never leaves the buffer's
# own analysis: no other module is walked and no rebuild is triggered.
pub fun document_highlight(ws: *project.Workspace, es: *editor.EditorSession, alloc: *Allocator, docs: *documents.Store, id: *sj.Value, params: *sj.Value, uri: str) {
    val id_raw: str = json.id_text(id, alloc);
    if (id_raw == nil) { ret; }

    var an:    analysis.Analyzed;
    val off_o: opt[usize] = analysis.locate(ws, es, docs, params, uri, ?an);
    if (sel off_o.none) {
        render.reply_empty_array(alloc, id_raw);
        ret;
    }
    val offset: usize = off_o.some;

    val ro: opt[features.SymbolRef] = features.ref_at(an.a, an.rr, an.own, an.text.file, offset);
    if (sel ro.none) {
        if (field_highlights(ws, alloc, ?an, uri, offset, id_raw)) { ret; }
        render.reply_empty_array(alloc, id_raw);
        ret;
    }
    val sr: features.SymbolRef = ro.some;

    var b: json.Buf = json.buf_init(alloc);
    render.result_begin(?b, id_raw);
    json.buf_push_byte(?b, '[');
    push_symbol_highlights(?b, an, sr.sym_id);
    json.buf_push_byte(?b, ']');
    render.send(?b, alloc, id_raw);
}

# append every occurrence of `target` in the buffer, classified by access
#
# Lives apart from the request handler because that handler takes an `id`
# parameter, which shadows the `mach.lang.fe.ast.id` module alias the walk needs.
fun push_symbol_highlights(b: *json.Buf, an: analysis.Analyzed, target: rslv.SymbolId) {
    var emitted: usize = 0;

    var bind: token.Span;
    if (binding_span(an, target, ?bind)) {
        if (push_highlight(b, an.text, bind, HIGHLIGHT_TEXT, emitted > 0)) { emitted = emitted + 1; }
    }

    var di: usize = 0;
    for (di < an.a.decl_len) {
        val dso: opt[token.Span] = features.decl_ref_span(an.a, an.rr, di::id.DeclId, target);
        if (sel dso.some) {
            if (push_highlight(b, an.text, dso.some, HIGHLIGHT_WRITE, emitted > 0)) { emitted = emitted + 1; }
        }
        val iso: opt[token.Span] = features.import_ref_span(an.a, an.rr, di::id.DeclId, target, an.text.file);
        if (sel iso.some) {
            if (push_highlight(b, an.text, iso.some, HIGHLIGHT_TEXT, emitted > 0)) { emitted = emitted + 1; }
        }
        di = di + 1;
    }

    var ei: usize = 0;
    for (ei < an.a.expr_len) {
        val so: opt[token.Span] = features.expr_ref_span(an.a, an.rr, ei::id.ExprId, target);
        if (sel so.some) {
            var kind: i64 = HIGHLIGHT_READ;
            if (is_assign_target(an.a, ei::id.ExprId))                  { kind = HIGHLIGHT_WRITE; }
            if (push_highlight(b, an.text, so.some, kind, emitted > 0)) { emitted = emitted + 1; }
        }
        ei = ei + 1;
    }

    var ti: usize = 0;
    for (ti < an.a.type_len) {
        val so: opt[token.Span] = features.type_ref_span(an.a, an.rr, ti::id.TypeId, target);
        if (sel so.some) {
            if (push_highlight(b, an.text, so.some, HIGHLIGHT_READ, emitted > 0)) { emitted = emitted + 1; }
        }
        ti = ti + 1;
    }
}

# highlight the field under the cursor across this document, for the positions
# where name resolution leaves a value-field access unbound
fun field_highlights(ws: *project.Workspace, alloc: *Allocator, an: *analysis.Analyzed, uri: str, offset: usize, id_raw: str) bool {
    if (an.root == nil || an.sr == nil) { ret false; }
    val to: opt[FieldTarget] = field_target_at(ws, an, offset);
    if (sel to.none) { ret false; }
    val t:  FieldTarget        = to.some;
    val ti: *type.TypeInterner = project.type_interner(ws, an.root);

    var s: FieldXRef;
    s.a         = an.a;
    s.sr        = an.sr;
    s.text      = an.text;
    s.uri       = uri;
    s.declaring = an.own == t.rs.origin;
    s.owned     = false;

    var b: json.Buf = json.buf_init(alloc);
    render.result_begin(?b, id_raw);
    json.buf_push_byte(?b, '[');
    var k: WalkSink = sink_init_mode(?b, alloc, SINK_HIGHLIGHT, nil, nil);
    walk_field_sites(?s, ti, t, s.declaring, ?k);
    json.buf_push_byte(?b, ']');
    render.send(?b, alloc, id_raw);
    ret true;
}

# whether expression `eid` is the left operand of an assignment, which makes a
# reference through it a write rather than a read
fun is_assign_target(a: *ast.Ast, eid: id.ExprId) bool {
    var i: usize = 0;
    for (i < a.expr_len) {
        val eo: opt[*aexpr.Expr] = ast.get_expr(a, i::id.ExprId);
        if (sel eo.some) {
            val e: *aexpr.Expr = eo.some;
            if (e.kind == aexpr.EXPR_KIND_BINARY && e.data.binary.op == aexpr.BIN_ASSIGN
                && e.data.binary.lhs == eid) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# append one DocumentHighlight, or nothing when the span cannot be reported
fun push_highlight(b: *json.Buf, text: positions.Text, span: token.Span, kind: i64, comma: bool) bool {
    if (!positions.maps(text, span)) { ret false; }
    if (comma)                       { json.buf_push_byte(b, ','); }
    push_highlight_body(b, text, span, kind);
    ret true;
}

# one DocumentHighlight object, without the separating comma, for a span the
# caller has checked maps
fun push_highlight_body(b: *json.Buf, text: positions.Text, span: token.Span, kind: i64) {
    json.buf_push(b, "{\"range\":");
    render.span_range(b, text, span);
    json.buf_push(b, ",\"kind\":");
    json.buf_push_i64(b, kind);
    json.buf_push_byte(b, '}');
}

# answer textDocument/rename with a WorkspaceEdit replacing every
# reference to the symbol at the cursor with the requested new name, across the
# whole project graph - the declaring file plus every module that imports or
# uses it (including each importer's `use` path leaf). confined to symbols
# declared in the user's own project: a dependency's declaration is not the
# editor's to rewrite (whether referenced cross-module or opened as the buffer
# itself), so those yield an empty edit. an empty edit is also returned when a
# module-scope symbol resolves to a dependency owned by the user
pub fun rename(ws: *project.Workspace, es: *editor.EditorSession, alloc: *Allocator, docs: *documents.Store, id: *sj.Value, params: *sj.Value, uri: str) {
    val id_raw: str = json.id_text(id, alloc);
    if (id_raw == nil) { ret; }

    val new_name: str = json.text(json.member(params, "newName"), alloc);
    if (new_name == nil) {
        render.reply_error(alloc, id_raw, render.REQUEST_FAILED, "the new name is missing");
        ret;
    }
    if (!names.identifier(alloc, new_name)) {
        refuse_rename(alloc, id_raw, "is not a mach identifier", new_name, nil);
        json.free_str(new_name, alloc);
        ret;
    }

    var an:    analysis.Analyzed;
    val off_o: opt[usize] = analysis.locate_current(ws, es, docs, params, uri, ?an);
    if (sel off_o.none) {
        render.reply_empty_edit(alloc, id_raw);
        json.free_str(new_name, alloc);
        ret;
    }
    val offset: usize = off_o.some;

    val ro: opt[features.SymbolRef] = features.ref_at(an.a, an.rr, an.own, an.text.file, offset);
    if (sel ro.none) {
        # a cursor on a field name yields no SymbolRef - fall through to the
        # type-driven field rename, which gates on the record's ownership.
        if (field_rename(ws, alloc, ?an, uri, offset, id_raw, new_name)) {
            json.free_str(new_name, alloc);
            ret;
        }
        render.reply_empty_edit(alloc, id_raw);
        json.free_str(new_name, alloc);
        ret;
    }
    val sr: features.SymbolRef = ro.some;

    val so: opt[*rslv.Symbol] = features.symbol(an.rr, sr.sym_id);
    if (sel so.none) {
        render.reply_empty_edit(alloc, id_raw);
        json.free_str(new_name, alloc);
        ret;
    }
    val sym: *rslv.Symbol = so.some;
    if (!renameable(ws, an.root, sym)) {
        render.reply_error(alloc, id_raw, render.REQUEST_FAILED, DEPENDENCY_REFUSAL);
        json.free_str(new_name, alloc);
        ret;
    }

    # the declared name guards the cross-file walk: only occurrences spelled with
    # it are rewritten, so an aliased import's references are left untouched
    # the guard is the DECLARED name, read from the defining symbol: only
    # occurrences spelled as declared are rewritten, so an alias keeps its own
    # spelling. a `use` binding happens to carry the declared name already, but a
    # symbol's own name is not that promise
    val decl_sym: *rslv.Symbol = project.defining_symbol_in(an.root, sym);
    if (decl_sym == nil) {
        render.reply_empty_edit(alloc, id_raw);
        json.free_str(new_name, alloc);
        ret;
    }
    val no: opt[str] = intern.lookup(an.interner, decl_sym.name);
    if (sel no.none) {
        render.reply_empty_edit(alloc, id_raw);
        json.free_str(new_name, alloc);
        ret;
    }
    val name: str = no.some;

    var bind:     token.Span;
    val has_bind: bool = binding_span(an, sr.sym_id, ?bind);

    # a param / generic carries its name in its owning decl's docstring component
    # block too (`# <param>:` / `# [T]:`); rename rewrites that name token in the
    # buffer where the decl lives. a fun / rec / val / etc. summary line no longer
    # carries the name, so only param / generic bindings contribute a doc edit
    var doc:     token.Span;
    val has_doc: bool = param_generic_doc_span(an, sym, name, ?doc);

    var set: RefSet = empty_refs();
    if (!build_refs(ws, alloc, an, uri, sym, sr.sym_id, true, ?set)) {
        render.reply_empty_edit(alloc, id_raw);
        json.free_str(new_name, alloc);
        ret;
    }
    if (!rename_keeps_meaning(alloc, an.interner, decl_sym, set.items, set.len, name, new_name,
        bind, has_bind, doc, has_doc, id_raw)) {
        free_refs(ws, alloc, ?set);
        json.free_str(new_name, alloc);
        ret;
    }
    emit_rename(alloc, id_raw, set.items, set.len, new_name, name, bind, has_bind, doc, has_doc);
    free_refs(ws, alloc, ?set);
    json.free_str(new_name, alloc);
}

# write the doc-component name token for a param / generic
# symbol's binding into `out` and return true, or false when the symbol is not a
# param / generic, its owning decl has no docstring, or no component matches its
# name. the doc block lives in the buffer the decl is declared in, so its name span
# (`Decl.doc` resolved through `mach.lang.fe.doc`) is a buffer edit. a generic's
# component head is the bracket form `# [T]:`, so the returned span is the inner
# identifier only (the brackets stay)
fun param_generic_doc_span(an: analysis.Analyzed, sym: *rslv.Symbol, name: str, out: *token.Span) bool {
    if (sym.kind != rslv.SYM_PARAM && sym.kind != rslv.SYM_GENERIC) { ret false; }
    if (sym.decl == id.DECL_NIL)                                    { ret false; }
    val d_opt: opt[*decl.Decl] = ast.get_decl(an.a, sym.decl);
    if (sel d_opt.none) { ret false; }
    val d: *decl.Decl = d_opt.some;
    if (d.doc.len == 0) { ret false; }

    val bo: opt[token.Span] = features.binding_name_span(an.a, sym);
    if (sel bo.none) { ret false; }
    val is_generic: bool            = sym.kind == rslv.SYM_GENERIC;
    val co:         opt[token.Span] = features.doc_component_name_span(an.text.file.text, d.doc, an.text.file, bo.some, is_generic);
    if (sel co.none) { ret false; }
    @out = co.some;
    ret true;
}

# answer textDocument/prepareRename with the range of the name
# token at the cursor when it is a renameable symbol (a buffer-local symbol, or a
# project-owned cross-module one) or a field of a known, project-owned record, or
# null when it is not the editor's to rename (an unresolved position, a dependency
# symbol, or a field of a vendored record)
pub fun prepare_rename(ws: *project.Workspace, es: *editor.EditorSession, alloc: *Allocator, docs: *documents.Store, id: *sj.Value, params: *sj.Value, uri: str) {
    val id_raw: str = json.id_text(id, alloc);
    if (id_raw == nil) { ret; }

    var an:    analysis.Analyzed;
    val off_o: opt[usize] = analysis.locate_current(ws, es, docs, params, uri, ?an);
    if (sel off_o.none) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    val offset: usize = off_o.some;

    val ro: opt[features.SymbolRef] = features.ref_at(an.a, an.rr, an.own, an.text.file, offset);
    if (sel ro.none) {
        # a cursor on a field name yields no SymbolRef - accept it when it resolves
        # to a field of a project-owned record (the same gate field rename uses)
        var name_span: token.Span;
        if (field_prepare_span(ws, ?an, uri, offset, ?name_span)) {
            reply_range(alloc, id_raw, an.text, name_span);
            ret;
        }
        render.reply_null(alloc, id_raw);
        ret;
    }
    val sr: features.SymbolRef = ro.some;

    val so: opt[*rslv.Symbol] = features.symbol(an.rr, sr.sym_id);
    if (sel so.none) {
        render.reply_null(alloc, id_raw);
        ret;
    }
    if (!renameable(ws, an.root, so.some)) {
        render.reply_error(alloc, id_raw, render.REQUEST_FAILED, DEPENDENCY_REFUSAL);
        ret;
    }

    reply_range(alloc, id_raw, an.text, sr.name_span);
}

# answer textDocument/documentSymbol with a flat list of the
# file's top-level declarations as DocumentSymbol nodes (name, kind, range,
# selectionRange)
pub fun document_symbol(es: *editor.EditorSession, alloc: *Allocator, docs: *documents.Store, id: *sj.Value, params: *sj.Value, uri: str) {
    val id_raw: str = json.id_text(id, alloc);
    if (id_raw == nil) { ret; }

    val d:  *documents.Document = documents.find(docs, uri);
    var an: analysis.Analyzed;
    if (d == nil || !analysis.syntax_of(es, d, ?an)) {
        render.reply_empty_array(alloc, id_raw);
        ret;
    }
    emit_document_symbols(an, alloc, id_raw);
}

# answer completion from the analysis the buffer has
#
# One analysis answers every project-governed request: the root's snapshot,
# read against the client's buffer through the #251 mapping when the buffer has
# moved past it. Completion is no exception. Caught up, the snapshot is the
# buffer; behind, it is what the buffer was before the edit in flight, and the
# live text contributes only bytes to it: the receiver chain, the prefix typed
# so far, and, for a name the snapshot has not seen, the parse of the buffer.
# That answer is marked incomplete so the client asks again once the rebuild
# lands. Snapshot and buffer identities are never joined: offsets cross only
# through the mapping, and every Ast node, symbol, type and site in one answer
# comes from one owner. A document outside any project answers from the
# standalone editor analysis of its own buffer, the one thing that session is
# for (#235).
pub fun completion(ws: *project.Workspace, es: *editor.EditorSession, alloc: *Allocator, docs: *documents.Store, id: *sj.Value, params: *sj.Value, uri: str) {
    val id_raw: str = json.id_text(id, alloc);
    if (id_raw == nil) { ret; }

    val doc: *documents.Document = documents.find(docs, uri);
    if (doc == nil) {
        reply_empty_completion(alloc, id_raw, false);
        ret;
    }
    val live: *src.SourceFile = documents.live_file(docs, doc);
    if (live == nil) {
        reply_empty_completion(alloc, id_raw, false);
        ret;
    }

    val pos:  *sj.Value = json.member(params, "position");
    val line: i64       = json.number(json.member(pos, "line"), -1);
    val ch:   i64       = json.number(json.member(pos, "character"), -1);
    if (line < 0 || ch < 0) {
        reply_empty_completion(alloc, id_raw, false);
        ret;
    }
    val oo: opt[usize] = positions.offset_at(positions.text_of(live), line::usize, ch::usize);
    if (sel oo.none) {
        reply_empty_completion(alloc, id_raw, false);
        ret;
    }
    val offset: usize      = oo.some;
    val prefix: token.Span = ident_prefix_before(live, offset);
    val dot:    usize      = prefix.offset;

    var an: analysis.Analyzed;
    if (!analysis.analyze(ws, es, docs, uri, ?an)) {
        # a document the snapshot has not taken in yet has nothing to answer
        # from until the rebuild lands
        reply_empty_completion(alloc, id_raw, project.has_project(ws, uri));
        ret;
    }
    val behind: bool = an.root != nil && an.stale;

    if (dot > 0 && live.text[dot - 1] == '.') {
        if (emit_receiver_members(ws, es, doc, an, live, alloc, id_raw, prefix, dot - 1, behind)) { ret; }
        reply_empty_completion(alloc, id_raw, behind);
        ret;
    }
    emit_completions(an, alloc, id_raw, prefix, live, behind);
}

# the identifier being typed immediately before `offset`, as a span
#
# Zero-length (anchored at `offset`) when the cursor does not follow an
# identifier character, which is both the "just typed a dot" case and the "start
# of a fresh word" case. The span's `offset` is therefore always the position a
# member receiver's dot would occupy.
fun ident_prefix_before(file: *src.SourceFile, offset: usize) token.Span {
    val text:  str   = file.text;
    var start: usize = offset;
    for (start > 0 && is_ident_byte(text[start - 1])) { start = start - 1; }
    var s: token.Span;
    s.offset = start;
    s.len    = offset - start;
    ret s;
}

# whether `c` can appear inside a Mach identifier
fun is_ident_byte(c: u8) bool {
    if (c >= 'a' && c <= 'z') { ret true; }
    if (c >= 'A' && c <= 'Z') { ret true; }
    if (c >= '0' && c <= '9') { ret true; }
    ret c == '_';
}

# whether the bytes of `span` in `file` are a case-sensitive prefix of `name`
fun span_is_prefix_of(file: *src.SourceFile, span: token.Span, name: str) bool {
    if (span.len == 0)            { ret true; }
    if (name == nil)              { ret false; }
    if (str_len(name) < span.len) { ret false; }
    val text: str   = file.text;
    var i:    usize = 0;
    for (i < span.len) {
        if (text[span.offset + i] != name[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# an empty span, for the no-prefix case
fun empty_span() token.Span {
    var s: token.Span;
    s.offset = 0;
    s.len    = 0;
    ret s;
}

# write the binding name span of a param / generic symbol into
# `out` and return true, or false when the symbol binds at a Decl node (whose
# site the decl walk already covers). lets references / rename include the one
# binding site a param / generic has, which no side table records
fun binding_span(an: analysis.Analyzed, sid: rslv.SymbolId, out: *token.Span) bool {
    val so: opt[*rslv.Symbol] = features.symbol(an.rr, sid);
    if (sel so.none) { ret false; }
    val bo: opt[token.Span] = features.binding_name_span(an.a, so.some);
    if (sel bo.none) { ret false; }
    @out = bo.some;
    ret true;
}

# whether the symbol's canonical declaring module is owned by the user. A
# standalone buffer has no project boundary and remains directly editable.
fun renameable(ws: *project.Workspace, root: *project.Root, sym: *rslv.Symbol) bool {
    if (root == nil) { ret true; }
    ret project.is_project_module(ws, root, sym.origin);
}

# one file contributing references to a target symbol - its Ast, resolve
# tables, source file, document URI, and the local SymbolId every reference in
# it resolves to. Project modules are visited exactly once; the active module
# borrows the request URI and other modules own their generated file URI.
rec XRef {
    a:      *ast.Ast;
    rr:     *rslv.ResolveResult;
    text:   positions.Text;
    uri:    str;
    target: rslv.SymbolId;
    owned:  bool;
}

# the files contributing references to one target, owned
# ---
# items: the entries, allocated for `cap`
# len:   entries in use
# cap:   allocation length
rec RefSet {
    items: *XRef;
    len:   usize;
    cap:   usize;
}

fun empty_refs() RefSet {
    ret RefSet{items: nil, len: 0, cap: 0};
}

# collect every binding, in every retained module, that names the declaration
# the cursor's symbol names
#
# Identity is the defining symbol's (origin, declaration), matched through
# `features.symbol_denotes`: a `use`d binding carries its referent's origin but
# no DeclId of its own, and is recognized by its canonical name and declaring
# kind, which the whole root shares one interner for (#246). A module may bind
# the same declaration more than once - imported plainly and under an alias -
# and each binding is its own entry, since each is its own set of spans.
#
# A symbol that is not visible outside its module - a local, a non-`pub`
# declaration - is walked in the requesting buffer alone. The active document
# uses the request URI; every other module owns its generated file URI.
# ---
# ws:           the workspace
# alloc:        request allocator for the entries
# an:           the requesting buffer's analysis
# uri:          its document URI
# sym:          the symbol at the cursor
# self_target:  its SymbolId in the requesting buffer
# project_only: skip modules the user does not own (rename)
# out:          receives the entries; release with `free_refs`
# ret:          false when memory ran out
fun build_refs(ws: *project.Workspace, alloc: *Allocator, an: analysis.Analyzed, uri: str, sym: *rslv.Symbol,
    self_target: rslv.SymbolId, project_only: bool, out: *RefSet) bool {
    val target: *rslv.Symbol = project.defining_symbol_in(an.root, sym);
    val local:  bool         = an.root == nil || target == nil
        || (target.origin == an.own && ((target.flags & rslv.SYM_FLAG_MODULE) == 0
        || (target.flags & rslv.SYM_FLAG_PUB) == 0));
    if (local) {
        if (!reserve_refs(alloc, out, 1)) { ret false; }
        out.items[0] = XRef{a: an.a, rr: an.rr, text: an.text, uri: uri, target: self_target, owned: false};
        out.len      = 1;
        ret true;
    }

    var total: usize = 0;
    val mc:    u32   = project.module_count(an.root);
    var pass:  u32   = 0;
    for (pass < 2) {
        if (pass == 1 && !reserve_refs(alloc, out, total)) { ret false; }
        var mid: u32 = 0;
        for (mid < mc) {
            val cur: sess.ModuleId = mid::sess.ModuleId;
            if (project_only && !project.is_project_module(ws, an.root, cur)) {
                mid = mid + 1;
                cnt;
            }
            val mv_o: opt[project.ModuleView] = project.module_view(ws, an.root, cur);
            if (sel mv_o.none) {
                mid = mid + 1;
                cnt;
            }
            val mv: project.ModuleView = mv_o.some;
            var si: u32                = 0;
            for (si < mv.rr.symbol_count) {
                val sid: rslv.SymbolId = si::rslv.SymbolId;
                if (features.symbol_denotes(mv.rr, sid, target.origin, target.decl, target.canon, target.kind)) {
                    if (pass == 0) { total = total + 1; }
                    or {
                        if (!push_ref(ws, an, uri, cur, mv, sid, out)) { ret false; }
                    }
                }
                si = si + 1;
            }
            mid = mid + 1;
        }
        pass = pass + 1;
    }
    ret true;
}

# append the entry for binding `sid` of module `cur`; false when its URI could
# not be built
fun push_ref(ws: *project.Workspace, an: analysis.Analyzed, uri: str, cur: sess.ModuleId,
    mv: project.ModuleView, sid: rslv.SymbolId, out: *RefSet) bool {
    var muri:  str  = uri;
    val owned: bool = cur != an.own;
    if (owned)       { muri = project.module_uri(ws, an.root, cur); }
    if (muri == nil) { ret false; }
    if (out.len >= out.cap) {
        if (owned) { json.free_str(muri, ws.alloc); }
        ret false;
    }
    out.items[out.len] = XRef{a: mv.a, rr: mv.rr, text: mv.text, uri: muri, target: sid, owned: owned};
    out.len            = out.len + 1;
    ret true;
}

fun reserve_refs(alloc: *Allocator, out: *RefSet, n: usize) bool {
    var cap: usize = n;
    if (cap == 0) { cap = 1; }
    val r: res[*XRef, allocator.Error] = allocate[XRef](alloc, cap);
    if (sel r.err) { ret false; }
    out.items = r.ok;
    out.cap   = cap;
    out.len   = 0;
    ret true;
}

# release generated module URIs and the entries; the request URI is borrowed
fun free_refs(ws: *project.Workspace, alloc: *Allocator, set: *RefSet) {
    var i: usize = 0;
    for (i < set.len) {
        if (set.items[i].owned && set.items[i].uri != nil) { json.free_str(set.items[i].uri, ws.alloc); }
        i = i + 1;
    }
    if (set.items != nil) { deallocate[XRef](alloc, set.items, set.cap); }
    set.items = nil;
    set.len   = 0;
    set.cap   = 0;
}

# the size-or-write accumulator behind the shared reference walk.
# one walk (walk_refs) feeds it: with `buf` nil it totals JSON byte lengths
# into `total`; pointed at the output buffer it writes entries at `off`. the
# same walk drives both passes, so the sizing and writing can never diverge.
# `qname` nil emits Location entries; non-nil emits TextEdit entries replacing
# each span with that quoted name. `guard`, when non-nil, drops body (expr /
# type) spans not spelled exactly `guard`, so rename skips alias-spelled
# references while references reports them. `count` sequences the separating
# commas across everything fed to the sink
rec WalkSink {
    b:        *json.Buf;
    alloc:    *Allocator;
    count:    usize;
    mode:     u8;
    new_text: str;
    guard:    str;
    unmapped: bool;
    spans:    *names.Spans;
}

# what shape one walked span is emitted as
val SINK_LOCATION:  u8 = 0;
val SINK_TEXT_EDIT: u8 = 1;
val SINK_HIGHLIGHT: u8 = 2;
val SINK_COLLECT:   u8 = 3;

# a sink appending into `b`
#
# One walk feeds every consumer of a reference set: references wants Locations,
# rename wants TextEdits, documentHighlight wants ranges with an access kind.
# `guard`, when non-nil, drops body spans not spelled exactly `guard`, so rename
# skips alias-spelled references while references reports them. There is no
# sizing mode: one walk writes, so size and content cannot disagree.
# ---
# b:        buffer to append into
# alloc:    request allocator
# mode:     which LSP shape to emit
# new_text: replacement text for SINK_TEXT_EDIT, else nil
# guard:    required spelling for body spans, or nil to admit all
# ret:      an empty sink
fun sink_init_mode(b: *json.Buf, alloc: *Allocator, mode: u8, new_text: str, guard: str) WalkSink {
    var k: WalkSink;
    k.b        = b;
    k.alloc    = alloc;
    k.count    = 0;
    k.mode     = mode;
    k.new_text = new_text;
    k.guard    = guard;
    k.unmapped = false;
    k.spans    = nil;
    ret k;
}

# a sink recording the snapshot spans a walk visits, into `spans`
fun sink_collect(spans: *names.Spans, alloc: *Allocator, guard: str) WalkSink {
    var k: WalkSink = sink_init_mode(nil, alloc, SINK_COLLECT, nil, guard);
    k.spans = spans;
    ret k;
}

# a sink emitting Locations, or TextEdits when `new_text` is non-nil
fun sink_init(b: *json.Buf, alloc: *Allocator, new_text: str, guard: str) WalkSink {
    var mode: u8 = SINK_LOCATION;
    if (new_text != nil) { mode = SINK_TEXT_EDIT; }
    ret sink_init_mode(b, alloc, mode, new_text, guard);
}

# append one Location or TextEdit for `span` in `text` (located at `uri`)
#
# Taking `text` / `uri` rather than a source record lets the symbol walk (XRef)
# and the field walk (FieldXRef) share it. A span that cannot be carried into
# the client's buffer is not written; the sink records it, because an edit set
# with a hole in it must not be offered at all.
fun sink_emit(k: *WalkSink, text: positions.Text, uri: str, span: token.Span) {
    if (k.mode == SINK_COLLECT) {
        if (!names.spans_push(k.spans, span)) { k.unmapped = true; }
        k.count = k.count + 1;
        ret;
    }
    if (!positions.maps(text, span)) {
        k.unmapped = true;
        ret;
    }
    if (k.count > 0)              { json.buf_push_byte(k.b, ','); }
    if (k.mode == SINK_TEXT_EDIT) { render.text_edit(k.b, text, span, k.new_text); }
    or (k.mode == SINK_HIGHLIGHT) { push_highlight_body(k.b, text, span, HIGHLIGHT_READ); }
    or                            { render.location(k.b, text, uri, span); }
    k.count = k.count + 1;
}

# feed every reference to `s.target` in source `s` to the sink - the
# declaration name, `use` / `fwd` import-path leaves, and the body (expr / type)
# use-sites, plus the active buffer's param / generic binding when `include_bind`
# and its owning decl's matching doc-component name token when `include_doc`. body
# spans pass the sink's spelling guard (see WalkSink); declaration, import leaves,
# binding, and doc-component spans always carry the declared name and are exempt
fun walk_refs(s: *XRef, include_bind: bool, bind: token.Span, include_doc: bool, doc: token.Span, k: *WalkSink) {
    if (s.target == rslv.SYMBOL_NIL) { ret; }
    if (include_bind)                { sink_emit(k, s.text, s.uri, bind); }
    if (include_doc)                 { sink_emit(k, s.text, s.uri, doc); }
    var di: usize = 0;
    for (di < s.a.decl_len) {
        val dso: opt[token.Span] = features.decl_ref_span(s.a, s.rr, di::id.DeclId, s.target);
        if (sel dso.some) { sink_emit(k, s.text, s.uri, dso.some); }
        val iso: opt[token.Span] = features.import_ref_span(s.a, s.rr, di::id.DeclId, s.target, s.text.file);
        if (sel iso.some) { sink_emit(k, s.text, s.uri, iso.some); }
        di = di + 1;
    }
    var ei: usize = 0;
    for (ei < s.a.expr_len) {
        val so: opt[token.Span] = features.expr_ref_span(s.a, s.rr, ei::id.ExprId, s.target);
        if (sel so.some) {
            if (guard_admits(s, k, so.some)) { sink_emit(k, s.text, s.uri, so.some); }
        }
        ei = ei + 1;
    }
    var ti: usize = 0;
    for (ti < s.a.type_len) {
        val so: opt[token.Span] = features.type_ref_span(s.a, s.rr, ti::id.TypeId, s.target);
        if (sel so.some) {
            if (guard_admits(s, k, so.some)) { sink_emit(k, s.text, s.uri, so.some); }
        }
        ti = ti + 1;
    }
}

# whether a body span passes the sink's spelling guard
fun guard_admits(s: *XRef, k: *WalkSink, span: token.Span) bool {
    if (k.guard == nil) { ret true; }
    ret features.span_text_equals(s.text.file, span, k.guard);
}

# send a Location[] of every reference to the symbol across the
# files in `refs` (declaration, import leaves, body use-sites; see walk_refs).
# the active buffer's param / generic binding (which has no Decl node) is
# `refs[0]`'s and is included when `has_bind`. takes ownership of `id_raw` and
# frees it
fun emit_locations(alloc: *Allocator, id_raw: str, refs: *XRef, nref: usize, bind: token.Span, has_bind: bool) {
    var empty: token.Span;
    var b:     json.Buf = json.buf_init(alloc);
    render.result_begin(?b, id_raw);
    json.buf_push_byte(?b, '[');

    var k: WalkSink = sink_init(?b, alloc, nil, nil);
    var i: usize    = 0;
    for (i < nref) {
        walk_refs(?refs[i], i == 0 && has_bind, bind, false, empty, ?k);
        i = i + 1;
    }

    json.buf_push_byte(?b, ']');
    render.send(?b, alloc, id_raw);
}

# send a WorkspaceEdit renaming the symbol to `new_name` across the
# files in `refs`, one `changes` entry per file. each entry renames the
# declaration, the import-path leaves, and every body reference spelled with the
# declared name `name` (so an aliased import's references are not rewritten); the
# active buffer's param / generic binding is included when `has_bind`, and its
# owning decl's matching doc-component name token when `has_doc`. takes ownership
# of `id_raw` and frees it
fun emit_rename(alloc: *Allocator, id_raw: str, refs: *XRef, nref: usize, new_name: str, name: str, bind: token.Span, has_bind: bool, doc: token.Span, has_doc: bool) {
    var b: json.Buf = json.buf_init(alloc);
    render.result_begin(?b, id_raw);
    json.buf_push(?b, "{\"changes\":{");

    var emitted: usize = 0;
    var hole:    bool  = false;
    var i:       usize = 0;
    for (i < nref) {
        if (push_rename_group(?b, ?refs[i], i == 0 && has_bind, bind, i == 0 && has_doc, doc,
            name, new_name, emitted > 0, alloc, ?hole)) {
            emitted = emitted + 1;
        }
        i = i + 1;
    }
    finish_rename(?b, alloc, id_raw, hole);
}

# the `changes`-map entry `"<uri>":[<edits>]` for source `s`,
# renaming the declaration, import-path leaves, and every body reference spelled
# `name` to the already-quoted `qname` (via the shared walk; see WalkSink), or
# nil when `s` contributes no edit. the active buffer's param / generic binding is
# included when `include_bind` and its owning decl's doc-component name token when
# `include_doc`
fun push_rename_group(b: *json.Buf, s: *XRef, include_bind: bool, bind: token.Span,
    include_doc: bool, doc: token.Span, name: str, new_name: str,
    comma: bool, alloc: *Allocator, hole: *bool) bool {
    if (s.target == rslv.SYMBOL_NIL) { ret false; }

    # a file's edits are only known to be empty once walked, so open the entry
    # speculatively and roll the buffer back when the walk contributes nothing
    val mark: usize = json.buf_len(b);
    if (comma) { json.buf_push_byte(b, ','); }
    json.buf_push_quoted(b, s.uri);
    json.buf_push(b, ":[");

    var k: WalkSink = sink_init(b, alloc, new_name, name);
    walk_refs(s, include_bind, bind, include_doc, doc, ?k);
    if (k.unmapped) { @hole = true; }
    if (k.count == 0) {
        json.buf_rewind(b, mark);
        ret false;
    }

    json.buf_push_byte(b, ']');
    ret true;
}

# what a rename refuses with when the symbol belongs to a dependency
val DEPENDENCY_REFUSAL: str = "this is declared in a dependency, which is not the editor's to rename";

# answer a rename with RequestFailed, saying `new_name` and why, and where when
# `file` names it
fun refuse_rename(alloc: *Allocator, id_raw: str, why: str, new_name: str, file: str) {
    var m: json.Buf = json.buf_init(alloc);
    json.buf_push(?m, "`");
    json.buf_push(?m, new_name);
    json.buf_push(?m, "` ");
    json.buf_push(?m, why);
    if (file != nil) {
        json.buf_push(?m, " (");
        json.buf_push(?m, file_label(file));
        json.buf_push(?m, ")");
    }
    render.reply_error(alloc, id_raw, render.REQUEST_FAILED, json.buf_str(?m));
    json.buf_dnit(?m);
}

# the last path segment of a URI, for a message
fun file_label(uri: str) str {
    val n:    usize = str_len(uri);
    var last: usize = 0;
    var i:    usize = 0;
    for (i < n) {
        if (uri[i] == '/') { last = i + 1; }
        i = i + 1;
    }
    ret (?uri[last])::str;
}

# whether renaming `target` to `new_name` across `refs` leaves every file
# meaning what it did (#286); answers the request with the reason when not
#
# Each file's edits are collected by the same walk that writes them, applied to
# the snapshot text, and parsed again (`names.shape`). Then the file's own
# symbols are checked for the new name: a module-level binding or built-in type
# of that name would take the renamed references, and so would a local declared
# in any top-level declaration a rename site sits in. That last rule is wider
# than the scopes involved, because the resolver does not expose its scopes.
fun rename_keeps_meaning(alloc: *Allocator, itn: *intern.Interner, target: *rslv.Symbol, refs: *XRef, nref: usize,
    name: str, new_name: str, bind: token.Span, has_bind: bool, doc: token.Span, has_doc: bool, id_raw: str) bool {
    var spans: names.Spans = names.spans_init(alloc);
    fin { names.spans_dnit(?spans); }
    var i: usize = 0;
    for (i < nref) {
        val s: *XRef = ?refs[i];
        names.spans_clear(?spans);
        var k: WalkSink = sink_collect(?spans, alloc, name);
        walk_refs(s, i == 0 && has_bind, bind, i == 0 && has_doc, doc, ?k);
        if (k.unmapped) {
            render.reply_error(alloc, id_raw, render.REQUEST_FAILED, "the rename could not be checked");
            ret false;
        }
        if (spans.len > 0) {
            if (!file_keeps_shape(alloc, s.text.file.text, ?spans, new_name, s.uri, id_raw)) { ret false; }
            val why: str = symbol_clash(itn, s, target, ?spans, new_name);
            if (why != nil) {
                refuse_rename(alloc, id_raw, why, new_name, s.uri);
                ret false;
            }
        }
        i = i + 1;
    }
    ret true;
}

# the field version of `rename_keeps_meaning`: a field name is only bound in its
# record, which the caller checked, so what remains is how each file parses
fun field_rename_keeps_meaning(ws: *project.Workspace, root: *project.Root, alloc: *Allocator, refs: *FieldXRef, nref: usize,
    t: FieldTarget, new_name: str, id_raw: str) bool {
    val ti:    *type.TypeInterner = project.type_interner(ws, root);
    var spans: names.Spans        = names.spans_init(alloc);
    fin { names.spans_dnit(?spans); }
    var i: usize = 0;
    for (i < nref) {
        names.spans_clear(?spans);
        var k: WalkSink = sink_collect(?spans, alloc, nil);
        walk_field_sites(?refs[i], ti, t, true, ?k);
        if (k.unmapped) {
            render.reply_error(alloc, id_raw, render.REQUEST_FAILED, "the rename could not be checked");
            ret false;
        }
        if (spans.len > 0 && !file_keeps_shape(alloc, refs[i].text.file.text, ?spans, new_name, refs[i].uri, id_raw)) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

# whether `text` with `spans` renamed parses as it did; answers the request when not
fun file_keeps_shape(alloc: *Allocator, text: str, spans: *names.Spans, new_name: str, uri: str, id_raw: str) bool {
    val edited: str = names.apply(alloc, text, spans, new_name);
    if (edited == nil) {
        render.reply_error(alloc, id_raw, render.REQUEST_FAILED, "the rename could not be checked");
        ret false;
    }
    val shape: u8 = names.shape(alloc, text, edited);
    names.applied_free(alloc, edited);
    if (shape == names.SHAPE_CHANGED) {
        refuse_rename(alloc, id_raw, "would change what the code means where it is written", new_name, uri);
        ret false;
    }
    if (shape == names.SHAPE_UNCHECKED) {
        refuse_rename(alloc, id_raw, "cannot be checked, because the file does not parse", new_name, uri);
        ret false;
    }
    ret true;
}

# why the new name clashes with a binding in `s`'s module, or nil
fun symbol_clash(itn: *intern.Interner, s: *XRef, target: *rslv.Symbol, spans: *names.Spans, new_name: str) str {
    var si: u32 = 0;
    for (si < s.rr.symbol_count) {
        val sid: rslv.SymbolId = si::rslv.SymbolId;
        val sym: *rslv.Symbol  = ?s.rr.symbols[si];
        si = si + 1;
        if (sid == s.target)                                                                           { cnt; }
        if (features.symbol_denotes(s.rr, sid, target.origin, target.decl, target.canon, target.kind)) { cnt; }
        val no: opt[str] = intern.lookup(itn, sym.name);
        if (sel no.none)                    { cnt; }
        if (!str_equals(no.some, new_name)) { cnt; }

        if (sym.kind == rslv.SYM_PRIM || sym.kind == rslv.SYM_VECTOR) { ret "names a built-in type"; }
        if ((sym.flags & rslv.SYM_FLAG_MODULE) != 0 || sym.kind == rslv.SYM_USE || sym.kind == rslv.SYM_IMPORTED) {
            ret "is already bound in this module";
        }
        if (shares_declaration(s.a, sym, spans)) { ret "is already bound in a declaration the rename touches"; }
    }
    ret nil;
}

# whether local `sym` is declared inside a top-level declaration that also
# holds one of `spans`. a local whose declaration cannot be found is assumed to
fun shares_declaration(a: *ast.Ast, sym: *rslv.Symbol, spans: *names.Spans) bool {
    val so: opt[token.Span] = features.decl_span_of(a, sym);
    if (sel so.none) { ret true; }
    val at: usize = so.some.offset;
    val n:  u32   = features.top_level_count(a);
    var i:  u32   = 0;
    for (i < n) {
        val d_o: opt[*decl.Decl] = ast.get_decl(a, features.top_level_decl(a, i));
        i = i + 1;
        if (sel d_o.none) { cnt; }
        val outer: token.Span = d_o.some.span;
        if (at < outer.offset || at >= outer.offset + outer.len) { cnt; }
        var j: usize = 0;
        for (j < spans.len) {
            val sp: token.Span = spans.items[j];
            if (sp.offset >= outer.offset && sp.offset < outer.offset + outer.len) { ret true; }
            j = j + 1;
        }
        ret false;
    }
    ret true;
}

# whether the record already has a field spelled `name`
fun record_has_field(rs: project.RecordSite, name: str) bool {
    var i: u32 = 0;
    for (i < rs.fields_len) {
        val f: token.Span = (?rs.a.typed_names[rs.fields_start + i]).name;
        if (features.span_text_equals(rs.text.file, f, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# send a DocumentSymbol[] of the file's top-level decls.
# takes ownership of `id_raw` and frees it
fun emit_document_symbols(an: analysis.Analyzed, alloc: *Allocator, id_raw: str) {
    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, "{\"jsonrpc\":\"2.0\",\"id\":");
    json.buf_push(?b, id_raw);
    json.buf_push(?b, ",\"result\":[");

    val n:       u32 = features.top_level_count(an.a);
    var emitted: u32 = 0;
    var i:       u32 = 0;
    for (i < n) {
        if (push_doc_symbol(?b, an, features.top_level_decl(an.a, i), emitted > 0, alloc)) {
            emitted = emitted + 1;
        }
        i = i + 1;
    }

    json.buf_push(?b, "]}");
    val msg: str = json.buf_str(?b);
    if (msg != nil) {
        transport.send_message(msg, alloc);
        render.note_response();
    }
    or {
        render.reply_empty_array(alloc, id_raw);
        json.buf_dnit(?b);
        ret;
    }
    json.buf_dnit(?b);
    json.free_str(id_raw, alloc);
}

# append decl `did` as a DocumentSymbol, with its members as `children`
#
# A record's fields, a union's variants, and a function's generics and
# parameters are what the outline is FOR: a flat list of 39 top-level names in a
# 2000-line module tells a reader nothing they could not get from the file
# itself. Emitted in one pass through the buffer rather than sized and then
# filled, so nesting costs one traversal instead of two.
# ---
# b:     output buffer
# an:    the analyzed document
# did:   decl to render
# comma: whether to separate from a preceding sibling
# alloc: request allocator
# ret:   true when a symbol was appended
fun push_doc_symbol(b: *json.Buf, an: analysis.Analyzed, did: id.DeclId, comma: bool, alloc: *Allocator) bool {
    val d_opt: opt[*decl.Decl] = ast.get_decl(an.a, did);
    if (sel d_opt.none) { ret false; }
    val d: *decl.Decl = d_opt.some;

    val nso: opt[token.Span] = features.decl_name_span(d);
    if (sel nso.none) { ret false; }
    val name_span: token.Span = nso.some;
    if (name_span.len == 0) { ret false; }

    val name: str = positions.span_text(an.text, name_span, alloc);
    if (name == nil) { ret false; }

    if (comma) { json.buf_push_byte(b, ','); }
    json.buf_push(b, "{\"name\":");
    json.buf_push_quoted(b, name);
    json.free_str(name, alloc);
    json.buf_push(b, ",\"kind\":");
    json.buf_push_i64(b, render.symbol_kind(d.kind));
    json.buf_push(b, ",\"range\":");
    render.span_range(b, an.text, d.span);
    json.buf_push(b, ",\"selectionRange\":");
    render.span_range(b, an.text, name_span);
    push_doc_symbol_children(b, an, d, alloc);
    json.buf_push_byte(b, '}');
    ret true;
}

# append the `children` member for a declaration that has members, or nothing
#
# A record and a union both hold their members in the shared `typed_names` pool;
# a function holds its generics in `generic_names` and its parameters in the same
# typed pool. A declaration with no members omits `children` entirely rather than
# emitting an empty array, so a client's "has children" test stays meaningful.
fun push_doc_symbol_children(b: *json.Buf, an: analysis.Analyzed, d: *decl.Decl, alloc: *Allocator) {
    var fields_start: u32 = 0;
    var fields_len:   u32 = 0;
    var cases_start:  u32 = 0;
    var cases_len:    u32 = 0;
    var gen_start:    u32 = 0;
    var gen_len:      u32 = 0;
    var member_kind:  i64 = LSP_SYMBOL_FIELD;

    if (d.kind == decl.DECL_KIND_REC) {
        fields_start = d.data.rec_.fields_start;
        fields_len   = d.data.rec_.fields_len;
        gen_start    = d.data.rec_.generics_start;
        gen_len      = d.data.rec_.generics_len;
    }
    or (d.kind == decl.DECL_KIND_UNI) {
        fields_start = d.data.uni_.fields_start;
        fields_len   = d.data.uni_.fields_len;
        gen_start    = d.data.uni_.generics_start;
        gen_len      = d.data.uni_.generics_len;
        member_kind  = LSP_SYMBOL_ENUM_MEMBER;
    }
    or (d.kind == decl.DECL_KIND_TAG) {
        cases_start = d.data.tag_.cases_start;
        cases_len   = d.data.tag_.cases_len;
        gen_start   = d.data.tag_.generics_start;
        gen_len     = d.data.tag_.generics_len;
    }
    or (d.kind == decl.DECL_KIND_FUN) {
        fields_start = d.data.fun_.params_start;
        fields_len   = d.data.fun_.params_len;
        gen_start    = d.data.fun_.generics_start;
        gen_len      = d.data.fun_.generics_len;
        member_kind  = LSP_SYMBOL_VARIABLE;
    }
    or { ret; }

    if (fields_len == 0 && cases_len == 0 && gen_len == 0) { ret; }

    json.buf_push(b, ",\"children\":[");
    var emitted: u32 = 0;
    var g:       u32 = 0;
    for (g < gen_len) {
        if (an.a.generic_names != nil) {
            val gs: token.Span = an.a.generic_names[(gen_start + g)::usize];
            if (push_member_symbol(b, an, gs, id.TYPE_NIL, LSP_SYMBOL_TYPE_PARAMETER, emitted > 0, alloc)) {
                emitted = emitted + 1;
            }
        }
        g = g + 1;
    }
    var f: u32 = 0;
    for (f < fields_len) {
        if (an.a.typed_names != nil) {
            val tn: *decl.TypedName = ?an.a.typed_names[(fields_start + f)::usize];
            if (push_member_symbol(b, an, tn.name, tn.ty, member_kind, emitted > 0, alloc)) {
                emitted = emitted + 1;
            }
        }
        f = f + 1;
    }
    # a tag's cases are its members; a payload type rides as the detail
    var c: u32 = 0;
    for (c < cases_len) {
        if (an.a.tag_cases != nil) {
            val tc: *decl.TagCase = ?an.a.tag_cases[(cases_start + c)::usize];
            if (push_member_symbol(b, an, tc.name, tc.payload, LSP_SYMBOL_ENUM_MEMBER, emitted > 0, alloc)) {
                emitted = emitted + 1;
            }
        }
        c = c + 1;
    }
    json.buf_push_byte(b, ']');
}

# append one member (field, variant, parameter, or generic) as a DocumentSymbol
#
# A member has no span of its own beyond its name, so `range` and
# `selectionRange` are both the name; `detail` carries its declared type where
# it has one.
fun push_member_symbol(b: *json.Buf, an: analysis.Analyzed, name_span: token.Span, ty: id.TypeId,
    kind: i64, comma: bool, alloc: *Allocator) bool {
    if (name_span.len == 0) { ret false; }
    val name: str = positions.span_text(an.text, name_span, alloc);
    if (name == nil) { ret false; }

    if (comma) { json.buf_push_byte(b, ','); }
    json.buf_push(b, "{\"name\":");
    json.buf_push_quoted(b, name);
    json.free_str(name, alloc);

    if (ty != id.TYPE_NIL) {
        val to: opt[*atype.Type] = ast.get_type(an.a, ty);
        if (sel to.some) {
            val tt: str = positions.span_text(an.text, to.some.span, alloc);
            if (tt != nil) {
                json.buf_push(b, ",\"detail\":");
                json.buf_push_quoted(b, tt);
                json.free_str(tt, alloc);
            }
        }
    }

    json.buf_push(b, ",\"kind\":");
    json.buf_push_i64(b, kind);
    json.buf_push(b, ",\"range\":");
    render.span_range(b, an.text, name_span);
    json.buf_push(b, ",\"selectionRange\":");
    render.span_range(b, an.text, name_span);
    json.buf_push_byte(b, '}');
    ret true;
}

# LSP DocumentHighlightKind
val HIGHLIGHT_TEXT:  i64 = 1;
val HIGHLIGHT_READ:  i64 = 2;
val HIGHLIGHT_WRITE: i64 = 3;

# LSP CompletionItemKind for a record or union field
val LSP_COMPLETION_FIELD: i64 = 5;

# LSP CompletionItemKind for a tag's case selector
val LSP_COMPLETION_ENUM_MEMBER: i64 = 20;

# LSP SymbolKind values used for declaration members
val LSP_SYMBOL_ENUM_MEMBER:    i64 = 22;
val LSP_SYMBOL_FIELD:          i64 = 8;
val LSP_SYMBOL_VARIABLE:       i64 = 13;
val LSP_SYMBOL_TYPE_PARAMETER: i64 = 26;

# send a CompletionItem[] of the file's top-level names, each
# deduped by spelling so a name declared once appears once. takes ownership of
# `id_raw` and frees it
fun emit_completions(an: analysis.Analyzed, alloc: *Allocator, id_raw: str,
    prefix: token.Span, pfile: *src.SourceFile, incomplete: bool) {
    var b: json.Buf = json.buf_init(alloc);
    push_completion_head(?b, id_raw, incomplete);

    var emitted: usize = 0;
    var i:       u32   = 0;
    for (i < an.rr.symbol_count) {
        if (completion_first(an, i)) {
            val sym: *rslv.Symbol = ?an.rr.symbols[i];
            val no:  opt[str]     = intern.lookup(an.interner, sym.name);
            if (sel no.some) {
                val name: str = no.some;
                if (pfile == nil || span_is_prefix_of(pfile, prefix, name)) {
                    push_completion_item(?b, name, features.lsp_completion_kind(sym.kind),
                        features.kind_label(sym.kind), nil, emitted > 0);
                    emitted = emitted + 1;
                }
            }
        }
        i = i + 1;
    }

    push_completion_tail(?b, alloc, id_raw);
}

# offer a module's public symbols, including `fwd` re-exports
#
# The module and its names come from `root`'s snapshot. Only `prefix`, a span
# of `pfile`, comes from the client's buffer.
# ---
# root:       the loaded root holding the module
# pfile:      the source `prefix` indexes
# prefix:     the identifier typed so far after the dot
# mid:        the module in `root`
# incomplete: the answer is from a snapshot the buffer has moved past
fun emit_module_members(ws: *project.Workspace, root: *project.Root, pfile: *src.SourceFile, alloc: *Allocator, id_raw: str,
    prefix: token.Span, mid: sess.ModuleId, incomplete: bool) bool {
    if (root == nil) { ret false; }
    val mvo: opt[project.ModuleView] = project.module_view(ws, root, mid);
    if (sel mvo.none) { ret false; }
    val mv: project.ModuleView = mvo.some;
    if (mv.rr == nil) { ret false; }
    var b: json.Buf = json.buf_init(alloc);
    push_completion_head(?b, id_raw, incomplete);
    var emitted: usize = 0;
    var i:       u32   = 0;
    for (i < mv.rr.pub_count) {
        val sym: *rslv.Symbol = ?mv.rr.symbols[i];
        val no:  opt[str]     = intern.lookup(?root.s.interner, sym.name);
        if (sel no.some) {
            val name: str = no.some;
            if (span_is_prefix_of(pfile, prefix, name)) {
                push_completion_item(?b, name, features.lsp_completion_kind(sym.kind),
                    features.kind_label(sym.kind), nil, emitted > 0);
                emitted = emitted + 1;
            }
        }
        i = i + 1;
    }
    push_completion_tail(?b, alloc, id_raw);
    ret true;
}

# the longest receiver chain the walk follows, `a.b.c...`
val RECEIVER_MAX_HOPS: usize = 16;

# offer the members of the receiver before a `.`: one walk over the chain of
# identifiers ending there, `a.b.c`, against the analysis the buffer has
# (#297, #321, #332, #334, #336, #235)
#
# The chain is read from the live buffer as bytes. The walk resolves the
# longest prefix of it the analysis has already typed as an expression, so a
# dot typed after a receiver the snapshot saw is answered by the resolver's own
# semantics, whatever the receiver's shape: a module alias, a local, a field
# access, a type name. A head the analysis has no expression for was typed
# inside the edit in flight; it is a binding looked up by name where the edit
# begins, typed by its written annotation through the analysis's own
# resolution, or a type or module alias declared there. A head the snapshot has
# not seen at all was declared inside the edit too, and is read from the parse
# of the live buffer and resolved as text through that parse's `use`s. Every
# further segment is a field of the site so far, whose declared type resolves in
# the module that declares it. `incomplete` reports which analysis answered.
# ---
# an:         the analysis the buffer has: a root's snapshot, or the standalone analysis
# live:       the client's buffer, the file the chain and prefix index
# dot:        offset of the `.` in `live`
# incomplete: whether the snapshot the members come from is behind the buffer
fun emit_receiver_members(ws: *project.Workspace, es: *editor.EditorSession, doc: *documents.Document,
    an: analysis.Analyzed, live: *src.SourceFile, alloc: *Allocator, id_raw: str,
    prefix: token.Span, dot: usize, incomplete: bool) bool {
    if (dot == 0) { ret false; }
    var segs: [RECEIVER_MAX_HOPS]token.Span;
    val n:    usize = receiver_chain(live, dot, ?segs[0]);
    if (n == 0) { ret false; }

    var ts:    project.TypeSite;
    var found: bool  = false;
    var i:     usize = 0;

    # the longest chain prefix the analysis typed as an expression
    var k: usize = n;
    for (k > 0 && !found) {
        var span: token.Span;
        span.offset = segs[0].offset;
        span.len    = (segs[k - 1].offset + segs[k - 1].len) - segs[0].offset;
        val mapped: opt[token.Span] = positions.analyzed_span(an.text, span);
        if (sel mapped.some) {
            val eid: id.ExprId = ast.offset_to_expr(an.a, mapped.some.offset + mapped.some.len - 1);
            if (eid != id.EXPR_NIL) {
                val sym: *rslv.Symbol = expr_symbol(an, eid);
                var mid: sess.ModuleId;
                if (sym != nil && module_alias_target(sym, ?mid)) {
                    if (k == n) { ret emit_module_members(ws, an.root, live, alloc, id_raw, prefix, mid, incomplete); }
                    val named: opt[project.TypeSite] = type_named_in_module(ws, an.root, alloc, mid, live, segs[k]);
                    if (sel named.none) { ret false; }
                    ts    = named.some;
                    found = true;
                    i     = k + 1;
                }
                or {
                    val typed: opt[project.TypeSite] = expr_type_site(ws, an, eid, sym);
                    if (sel typed.some) {
                        ts    = typed.some;
                        found = true;
                        i     = k;
                    }
                }
            }
        }
        k = k - 1;
    }

    # a head typed inside the edit in flight, looked up by name where the edit
    # begins; then, when the snapshot never saw it, in the parse of the live
    # buffer, resolved as text through that parse's `use`s
    var lan:       analysis.Analyzed;
    var have_live: bool = false;
    if (!found) {
        val anchor: usize                 = positions.analyzed_anchor(an.text, segs[0].offset);
        val head:   opt[project.TypeSite] = head_site_in(ws, an, an.a, an.text.file, an.rr, anchor, live, segs[0]);
        if (sel head.some) {
            ts    = head.some;
            found = true;
            i     = 1;
        }
        or {
            val mo: opt[sess.ModuleId] = module_alias_of(ws, an.root, an.a, an.text.file, alloc, live, segs[0]);
            if (sel mo.some) {
                if (n == 1) { ret emit_module_members(ws, an.root, live, alloc, id_raw, prefix, mo.some, incomplete); }
                val named: opt[project.TypeSite] = type_named_in_module(ws, an.root, alloc, mo.some, live, segs[1]);
                if (sel named.none) { ret false; }
                ts    = named.some;
                found = true;
                i     = 2;
            }
        }
    }
    if (!found && incomplete) {
        have_live = live_parse(es, doc, an, live, ?lan);
        if (have_live) {
            val head: opt[project.TypeSite] = head_site_in(ws, lan, lan.a, live, nil, segs[0].offset, live, segs[0]);
            if (sel head.some) {
                ts    = head.some;
                found = true;
                i     = 1;
            }
            or {
                val mo: opt[sess.ModuleId] = module_alias_of(ws, an.root, lan.a, live, alloc, live, segs[0]);
                if (sel mo.some) {
                    if (n == 1) { ret emit_module_members(ws, an.root, live, alloc, id_raw, prefix, mo.some, incomplete); }
                    val named: opt[project.TypeSite] = type_named_in_module(ws, an.root, alloc, mo.some, live, segs[1]);
                    if (sel named.none) { ret false; }
                    ts    = named.some;
                    found = true;
                    i     = 2;
                }
            }
        }
    }
    if (!found) { ret false; }

    for (i < n) {
        var next: opt[project.TypeSite];
        if (have_live && ts.a == lan.a) { next = field_type_site(ws, lan, alloc, ts, live, segs[i]); }
        or                              { next = field_type_site(ws, an, alloc, ts, live, segs[i]); }
        if (sel next.none)              { ret false; }
        ts = next.some;
        i  = i + 1;
    }
    ret emit_type_site_members(ws, es, an.root, live, alloc, id_raw, prefix, ts, incomplete);
}

# the identifier chain ending at `dot`, `a.b.c` as its segments in source
# order, or 0 when no identifier ends there. capped at RECEIVER_MAX_HOPS
fun receiver_chain(file: *src.SourceFile, dot: usize, out: *token.Span) usize {
    var n:   usize = 0;
    var end: usize = dot;
    for (n < RECEIVER_MAX_HOPS) {
        val seg: token.Span = ident_prefix_before(file, end);
        if (seg.len == 0) { brk; }
        out[n] = seg;
        n      = n + 1;
        if (seg.offset == 0 || file.text[seg.offset - 1] != '.') { brk; }
        end = seg.offset - 1;
    }
    # collected last-first; put the segments in source order
    var lo: usize = 0;
    for (n > 0 && lo < n - 1 - lo) {
        val tmp: token.Span = out[lo];
        out[lo]         = out[n - 1 - lo];
        out[n - 1 - lo] = tmp;
        lo              = lo + 1;
    }
    ret n;
}

# the symbol expression `eid` resolves to in `an`, or nil
fun expr_symbol(an: analysis.Analyzed, eid: id.ExprId) *rslv.Symbol {
    if (an.rr == nil || an.rr.expr_resolved == nil || eid::u32 >= an.rr.expr_count) { ret nil; }
    val sid: rslv.SymbolId = an.rr.expr_resolved[eid];
    if (sid == rslv.SYMBOL_NIL || sid >= an.rr.symbol_count) { ret nil; }
    ret ?an.rr.symbols[sid];
}

# the type site of expression `eid`: the site of its semantic type, or, for a
# type name standing as the receiver (a tag whose cases are named through it),
# the site of the type the name resolves to
fun expr_type_site(ws: *project.Workspace, an: analysis.Analyzed, eid: id.ExprId, sym: *rslv.Symbol) opt[project.TypeSite] {
    if (an.sr != nil) {
        val tid: type.TypeId           = project.type_of(an.sr, eid);
        val so:  opt[project.TypeSite] =
            project.type_site_in(ws, an.root, an.own, an.own_fid, an.a, an.text, tid);
        if (sel so.some) { ret so; }
    }
    if (sym == nil) { ret opt[project.TypeSite].none{}; }
    val kind: rslv.SymKind = features.definition_kind_of(sym);
    if (kind != rslv.SYM_REC && kind != rslv.SYM_UNI && kind != rslv.SYM_TAG) { ret opt[project.TypeSite].none{}; }
    ret symbol_type_site(ws, an, sym);
}

# the type site of the declaration `sym` names, followed to the defining
# module through a `use` or `fwd` binding
fun symbol_type_site(ws: *project.Workspace, an: analysis.Analyzed, sym: *rslv.Symbol) opt[project.TypeSite] {
    var def: *rslv.Symbol = sym;
    if (an.root != nil)                        { def = project.defining_symbol_in(an.root, sym); }
    if (def == nil || def.decl == id.DECL_NIL) { ret opt[project.TypeSite].none{}; }
    if (def.origin == an.own)                  { ret project.type_site_from(an.own, def.decl, an.own_fid, an.a, an.text); }
    val mvo: opt[project.ModuleView] = project.module_view(ws, an.root, def.origin);
    if (sel mvo.none) { ret opt[project.TypeSite].none{}; }
    val mv: project.ModuleView = mvo.some;
    ret project.type_site_from(def.origin, def.decl, mv.file_id, mv.a, mv.text);
}

# the type site the written type `ty` in `a` names, resolved by `rr`, the
# resolution of the module `a` is, following a `use` or `fwd` to the defining
# module. `rr` nil means `a` is a parse with no resolution, and the name is
# then resolved as text through `a`'s `use`s against the snapshot (#336)
fun written_type_site(ws: *project.Workspace, an: analysis.Analyzed, a: *ast.Ast, file: *src.SourceFile,
    rr: *rslv.ResolveResult, alloc: *Allocator, ty: id.TypeId) opt[project.TypeSite] {
    if (ty == id.TYPE_NIL) { ret opt[project.TypeSite].none{}; }
    if (rr == nil) {
        val to: opt[*atype.Type] = named_type_in(a, ty);
        if (sel to.none) { ret opt[project.TypeSite].none{}; }
        ret type_site_for_written(ws, an, a, file, alloc, to.some.data.named.name);
    }
    var tid: id.TypeId        = ty;
    val po:  opt[*atype.Type] = ast.get_type(a, tid);
    if (sel po.none)                                          { ret opt[project.TypeSite].none{}; }
    if (po.some.kind == atype.TYPE_KIND_PTR)                  { tid = po.some.data.ptr.pointee; }
    if (rr.type_resolved == nil || tid::u32 >= rr.type_count) { ret opt[project.TypeSite].none{}; }
    val sid: rslv.SymbolId = rr.type_resolved[tid];
    if (sid == rslv.SYMBOL_NIL || sid >= rr.symbol_count) { ret opt[project.TypeSite].none{}; }
    ret symbol_type_site(ws, an, ?rr.symbols[sid]);
}

# the type site of the binding named `name` that is in scope at `anchor` in
# `a`: the nearest preceding `val` or `var` of the function enclosing `anchor`,
# then that function's parameters, then a module-level binding. Every binding
# is written with its type, and that annotation names the site. A binding in
# a block that closed before `anchor` is not told apart from one still open,
# which is the one approximation this lookup makes; the rebuild replaces its
# answer
# ---
# a:      the tree the lookup walks
# file:   the source `a`'s spans index
# rr:     `a`'s resolution, or nil for a parse
# anchor: the offset in `file` the name is in scope at
# nfile:  the source `name` indexes
# name:   the binding's spelling
fun head_site_in(ws: *project.Workspace, an: analysis.Analyzed, a: *ast.Ast, file: *src.SourceFile,
    rr: *rslv.ResolveResult, anchor: usize, nfile: *src.SourceFile, name: token.Span) opt[project.TypeSite] {
    var best:       id.TypeId  = id.TYPE_NIL;
    var best_off:   usize      = 0;
    var found:      bool       = false;
    var best_local: bool       = false;
    var owner:      *decl.Decl = nil;
    var i:          usize      = 0;
    for (i < a.decl_len) {
        val d: *decl.Decl = ?a.decls[i];
        i = i + 1;
        if (d.kind == decl.DECL_KIND_FUN && d.span.offset <= anchor && anchor < d.span.offset + d.span.len) {
            if (owner == nil || d.span.len < owner.span.len) { owner = d; }
        }
    }
    if (owner != nil) {
        var p: u32 = 0;
        for (p < owner.data.fun_.params_len) {
            val tn: *decl.TypedName = ?a.typed_names[owner.data.fun_.params_start + p];
            p = p + 1;
            if (!features.span_bytes_equal(file, tn.name, nfile, name)) { cnt; }
            best       = tn.ty;
            best_off   = tn.name.offset;
            found      = true;
            best_local = true;
        }
    }
    i = 0;
    for (i < a.decl_len) {
        val d: *decl.Decl = ?a.decls[i];
        i = i + 1;
        if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR)    { cnt; }
        if (d.span.offset >= anchor)                                         { cnt; }
        if (!features.span_bytes_equal(file, d.data.bind.name, nfile, name)) { cnt; }
        val inside: bool = owner != nil && d.span.offset >= owner.span.offset
            && d.span.offset < owner.span.offset + owner.span.len;
        if (inside) {
            # the nearest of the function's own bindings
            if (found && best_local && d.span.offset < best_off) { cnt; }
        }
        or {
            # a module-level binding stands only when the function has none
            if (found || decl_enclosed_by_fun(a, d)) { cnt; }
        }
        best       = d.data.bind.ty;
        best_off   = d.span.offset;
        found      = true;
        best_local = inside;
    }
    if (found) { ret written_type_site(ws, an, a, file, rr, ws.alloc, best); }
    # not a value: a type name standing as the receiver, declared here or
    # brought in by a `use`, through the resolution when there is one and as
    # text when `a` is a parse
    if (rr != nil) { ret named_type_symbol_site(ws, an, rr, nfile, name); }
    ret type_site_for_written(ws, an, a, file, ws.alloc, name);
}

# the site of the rec / uni / tag the symbol table `rr` knows as `name`
fun named_type_symbol_site(ws: *project.Workspace, an: analysis.Analyzed, rr: *rslv.ResolveResult,
    nfile: *src.SourceFile, name: token.Span) opt[project.TypeSite] {
    var i: u32 = 0;
    for (i < rr.symbol_count) {
        val sym: *rslv.Symbol = ?rr.symbols[i];
        i = i + 1;
        val kind: rslv.SymKind = features.definition_kind_of(sym);
        if (kind != rslv.SYM_REC && kind != rslv.SYM_UNI && kind != rslv.SYM_TAG) { cnt; }
        val no: opt[str] = intern.lookup(an.interner, sym.name);
        if (sel no.none)                                      { cnt; }
        if (!features.span_text_equals(nfile, name, no.some)) { cnt; }
        ret symbol_type_site(ws, an, sym);
    }
    ret opt[project.TypeSite].none{};
}

# whether declaration `d` lies inside some function's span in `a`
fun decl_enclosed_by_fun(a: *ast.Ast, d: *decl.Decl) bool {
    var i: usize = 0;
    for (i < a.decl_len) {
        val f: *decl.Decl = ?a.decls[i];
        i = i + 1;
        if (f.kind != decl.DECL_KIND_FUN || f == d)                                       { cnt; }
        if (f.span.offset <= d.span.offset && d.span.offset < f.span.offset + f.span.len) { ret true; }
    }
    ret false;
}

# the parse of the live buffer as an analysis with no resolution: the tree and
# text are the buffer's, the root and module identities are the snapshot's, so
# a type it names resolves against the snapshot as text
fun live_parse(es: *editor.EditorSession, doc: *documents.Document, an: analysis.Analyzed,
    live: *src.SourceFile, out: *analysis.Analyzed) bool {
    val tree: *ast.Ast = analysis.syntax_tree(es, doc);
    if (tree == nil) { ret false; }
    @out      = an;
    out.a     = tree;
    out.rr    = nil;
    out.sr    = nil;
    out.text  = positions.text_of(live);
    out.stale = false;
    ret true;
}

# the module a `use` in `a` binds `name` to, or none when `name` is not a
# module alias. the head is matched by the bytes it is spelled with, so it
# resolves the same whether it is used as a value or as a type qualifier (#321)
fun module_alias_of(ws: *project.Workspace, root: *project.Root, a: *ast.Ast, file: *src.SourceFile,
    alloc: *Allocator, nfile: *src.SourceFile, name: token.Span) opt[sess.ModuleId] {
    if (root == nil) { ret opt[sess.ModuleId].none{}; }
    val text: positions.Text = positions.text_of(file);
    var i:    usize          = 0;
    for (i < a.decl_len) {
        val d: *decl.Decl = ?a.decls[i];
        i = i + 1;
        if (d.kind != decl.DECL_KIND_USE) { cnt; }
        val u:     *decl.DeclUse = ?d.data.use_;
        var bound: token.Span    = u.alias;
        if (bound.len == 0)                                       { bound = np.leaf(file.text, u.path); }
        if (!features.span_bytes_equal(file, bound, nfile, name)) { cnt; }
        val fqn: str = positions.span_text(text, u.path, alloc);
        if (fqn == nil) { ret opt[sess.ModuleId].none{}; }
        val mo: opt[sess.ModuleId] = project.module_by_fqn(ws, root, fqn);
        strutil.str_free(alloc, fqn);
        ret mo;
    }
    ret opt[sess.ModuleId].none{};
}

# the type `name`, spelled in `nfile`, declares in loaded module `mid`
fun type_named_in_module(ws: *project.Workspace, root: *project.Root, alloc: *Allocator,
    mid: sess.ModuleId, nfile: *src.SourceFile, name: token.Span) opt[project.TypeSite] {
    val fqn: str = project.module_fqn(ws, root, mid);
    if (fqn == nil) { ret opt[project.TypeSite].none{}; }
    val tname: str = positions.span_text(positions.text_of(nfile), name, alloc);
    if (tname == nil) { ret opt[project.TypeSite].none{}; }
    val tso: opt[project.TypeSite] = project.type_in_module(ws, root, fqn, tname);
    strutil.str_free(alloc, tname);
    ret tso;
}

# the type site of the field `field` of the rec / uni at `ts`, one hop of the
# receiver walk. the field's declared type resolves in the module that declares
# it: through that module's own resolution when it is loaded, and as text
# through the buffer's `use`s when `ts` is the parse of the live buffer
fun field_type_site(ws: *project.Workspace, an: analysis.Analyzed, alloc: *Allocator,
    ts: project.TypeSite, nfile: *src.SourceFile, field: token.Span) opt[project.TypeSite] {
    val d_opt: opt[*decl.Decl] = ast.get_decl(ts.a, ts.decl);
    if (sel d_opt.none) { ret opt[project.TypeSite].none{}; }
    val d:     *decl.Decl = d_opt.some;
    var start: u32;
    var len:   u32;
    if (d.kind == decl.DECL_KIND_REC) {
        start = d.data.rec_.fields_start;
        len   = d.data.rec_.fields_len;
    }
    or (d.kind == decl.DECL_KIND_UNI) {
        start = d.data.uni_.fields_start;
        len   = d.data.uni_.fields_len;
    }
    or { ret opt[project.TypeSite].none{}; }

    var i: u32 = 0;
    for (i < len) {
        val tn: *decl.TypedName = ?ts.a.typed_names[start + i];
        i = i + 1;
        if (!features.span_bytes_equal(ts.text.file, tn.name, nfile, field)) { cnt; }
        if (ts.a == an.a)                                                    { ret written_type_site(ws, an, an.a, an.text.file, an.rr, alloc, tn.ty); }
        val mvo: opt[project.ModuleView] = project.module_view(ws, an.root, ts.origin);
        if (sel mvo.none) { ret opt[project.TypeSite].none{}; }
        ret written_type_site(ws, an, ts.a, ts.text.file, mvo.some.rr, alloc, tn.ty);
    }
    ret opt[project.TypeSite].none{};
}

# the named type node `ty` in `a` denotes, peeling one pointer, or none when it
# is not a name
fun named_type_in(a: *ast.Ast, ty: id.TypeId) opt[*atype.Type] {
    if (ty == id.TYPE_NIL) { ret opt[*atype.Type].none{}; }
    val first: opt[*atype.Type] = ast.get_type(a, ty);
    if (sel first.none) { ret first; }
    var tid: id.TypeId = ty;
    if (first.some.kind == atype.TYPE_KIND_PTR) { tid = first.some.data.ptr.pointee; }
    val to: opt[*atype.Type] = ast.get_type(a, tid);
    if (sel to.none)                           { ret to; }
    if (to.some.kind != atype.TYPE_KIND_NAMED) { ret opt[*atype.Type].none{}; }
    ret to;
}

# the type site the type path `name`, written in the parse `a` of `file`,
# names: a declaration in that parse when the path is a bare name, otherwise
# through its `use` declarations against the snapshot
fun type_site_for_written(ws: *project.Workspace, an: analysis.Analyzed, a: *ast.Ast, file: *src.SourceFile,
    alloc: *Allocator, name: token.Span) opt[project.TypeSite] {
    if (np.prefix(file.text, name).len == 0) {
        val own: opt[id.DeclId] = same_file_type_decl(a, file, file, np.leaf(file.text, name));
        if (sel own.some) { ret project.type_site_from(an.own, own.some, an.own_fid, a, positions.text_of(file)); }
    }
    ret type_site_for_type_path(ws, an.root, a, file, alloc, name);
}

# the rec / uni / tag declaration in `a` named `name` (spelled in `nfile`), as its DeclId
fun same_file_type_decl(a: *ast.Ast, file: *src.SourceFile, nfile: *src.SourceFile, name: token.Span) opt[id.DeclId] {
    var i: usize = 0;
    for (i < a.decl_len) {
        val di: usize      = i;
        val d:  *decl.Decl = ?a.decls[di];
        i = i + 1;
        var dn: token.Span;
        if (d.kind == decl.DECL_KIND_REC)                     { dn = d.data.rec_.name; }
        or (d.kind == decl.DECL_KIND_UNI)                     { dn = d.data.uni_.name; }
        or (d.kind == decl.DECL_KIND_TAG)                     { dn = d.data.tag_.name; }
        or                                                    { cnt; }
        if (features.span_bytes_equal(file, dn, nfile, name)) { ret opt[id.DeclId].some{di::id.DeclId}; }
    }
    ret opt[id.DeclId].none{};
}

# offer the members of the type at `ts`: a rec's or uni's fields, or a tag's
# case selectors. `pfile` is the buffer `prefix` indexes
#
# The snapshot resolved the receiver and named the declaring module. When the
# buffer of that module's document has moved past the snapshot, the member list
# is read from the parse of that buffer instead, so a member typed since the
# snapshot is offered on the next request rather than one rebuild later (#367,
# reported as #366). That parse contributes text only, names and written
# annotations, and the answer stays incomplete until the rebuild lands. The
# test is on the declaring document, not the requesting one: a sibling buffer
# ahead of the snapshot changes the type just the same.
fun emit_type_site_members(ws: *project.Workspace, es: *editor.EditorSession, root: *project.Root,
    pfile: *src.SourceFile, alloc: *Allocator, id_raw: str, prefix: token.Span, ts: project.TypeSite,
    incomplete: bool) bool {
    var a:     *ast.Ast            = ts.a;
    var text:  positions.Text      = ts.text;
    var did:   id.DeclId           = ts.decl;
    var inc:   bool                = incomplete;
    val ahead: *documents.Document = project.ahead_document(ws, root, ts.origin);
    if (ahead != nil) {
        val tree:  *ast.Ast        = analysis.syntax_tree(es, ahead);
        val afile: *src.SourceFile = documents.live_file(ws.docs, ahead);
        if (tree != nil && afile != nil) {
            val own: opt[id.DeclId] = same_file_type_decl(tree, afile, ts.text.file, ts.name_span);
            if (sel own.some) {
                a    = tree;
                text = positions.text_of(afile);
                did  = own.some;
                inc  = true;
            }
        }
    }
    val d_opt: opt[*decl.Decl] = ast.get_decl(a, did);
    if (sel d_opt.none) { ret false; }
    val d: *decl.Decl = d_opt.some;
    if (d.kind == decl.DECL_KIND_REC) {
        ret emit_fields_of(pfile, alloc, id_raw, prefix, a, text, d.data.rec_.fields_start, d.data.rec_.fields_len, inc);
    }
    if (d.kind == decl.DECL_KIND_UNI) {
        ret emit_fields_of(pfile, alloc, id_raw, prefix, a, text, d.data.uni_.fields_start, d.data.uni_.fields_len, inc);
    }
    if (d.kind == decl.DECL_KIND_TAG) {
        ret emit_tag_cases_from_decl(pfile, alloc, id_raw, prefix, a, text, d, inc);
    }
    ret false;
}

# resolve the type-name path `name`, written in the parse `a` of `file`,
# against `root`'s snapshot to the type it names, through that parse's `use`
# declarations, following `fwd` re-exports. the one text-to-snapshot bridge a
# buffer request crosses (#321, #334)
fun type_site_for_type_path(ws: *project.Workspace, root: *project.Root, a: *ast.Ast, file: *src.SourceFile,
    alloc: *Allocator, name: token.Span) opt[project.TypeSite] {
    val text: positions.Text = positions.text_of(file);
    val leaf: token.Span     = np.leaf(file.text, name);
    val qual: token.Span     = np.prefix(file.text, name);
    if (leaf.len == 0) { ret opt[project.TypeSite].none{}; }

    var i: usize = 0;
    for (i < a.decl_len) {
        val d: *decl.Decl = ?a.decls[i];
        i = i + 1;
        if (d.kind != decl.DECL_KIND_USE) { cnt; }
        val u:     *decl.DeclUse = ?d.data.use_;
        var bound: token.Span    = u.alias;
        if (bound.len == 0) { bound = np.leaf(file.text, u.path); }

        if (qual.len > 0) {
            if (!features.span_bytes_equal(file, bound, file, qual)) { cnt; }
            ret type_in_module_owned(ws, root, alloc,
                positions.span_text(text, u.path, alloc),
                positions.span_text(text, leaf, alloc));
        }
        or {
            if (!features.span_bytes_equal(file, bound, file, leaf)) { cnt; }
            ret type_in_module_owned(ws, root, alloc,
                positions.span_text(text, np.prefix(file.text, u.path), alloc),
                positions.span_text(text, np.leaf(file.text, u.path), alloc));
        }
    }
    ret opt[project.TypeSite].none{};
}

# look up a type by module FQN and name, freeing the two owned name strings
fun type_in_module_owned(ws: *project.Workspace, root: *project.Root, alloc: *Allocator,
    module_fqn: str, type_name: str) opt[project.TypeSite] {
    if (module_fqn == nil || type_name == nil) {
        if (module_fqn != nil) { strutil.str_free(alloc, module_fqn); }
        if (type_name != nil)  { strutil.str_free(alloc, type_name); }
        ret opt[project.TypeSite].none{};
    }
    val tso: opt[project.TypeSite] = project.type_in_module(ws, root, module_fqn, type_name);
    strutil.str_free(alloc, module_fqn);
    strutil.str_free(alloc, type_name);
    ret tso;
}

# emit a tag's case selectors as completion items, from the tag declaration `d`
# in `a` (backed by `text`), filtered by the buffer prefix already typed
fun emit_tag_cases_from_decl(pfile: *src.SourceFile, alloc: *Allocator, id_raw: str,
    prefix: token.Span, a: *ast.Ast, text: positions.Text, d: *decl.Decl, incomplete: bool) bool {
    if (d.kind != decl.DECL_KIND_TAG) { ret false; }
    val start: u32 = d.data.tag_.cases_start;
    val len:   u32 = d.data.tag_.cases_len;

    var b: json.Buf = json.buf_init(alloc);
    push_completion_head(?b, id_raw, incomplete);
    var emitted: usize = 0;
    var c:       u32   = 0;
    for (c < len) {
        if (a.tag_cases != nil) {
            val tc:    *decl.TagCase = ?a.tag_cases[(start + c)::usize];
            val cname: str           = positions.span_text(text, tc.name, alloc);
            if (cname != nil) {
                if (span_is_prefix_of(pfile, prefix, cname)) {
                    push_completion_item(?b, cname, LSP_COMPLETION_ENUM_MEMBER, "case", nil, emitted > 0);
                    emitted = emitted + 1;
                }
                json.free_str(cname, alloc);
            }
        }
        c = c + 1;
    }
    push_completion_tail(?b, alloc, id_raw);
    ret true;
}

# offer the fields in `a.typed_names[start .. start + len]`, backed by `text`,
# filtered by the buffer prefix already typed. the one field emitter, whether
# the fields were reached through a typed RecordSite or the receiver walk
fun emit_fields_of(pfile: *src.SourceFile, alloc: *Allocator, id_raw: str, prefix: token.Span,
    a: *ast.Ast, text: positions.Text, start: u32, len: u32, incomplete: bool) bool {
    var b: json.Buf = json.buf_init(alloc);
    push_completion_head(?b, id_raw, incomplete);

    var emitted: usize = 0;
    var i:       u32   = 0;
    for (i < len) {
        val tn:    *decl.TypedName = ?a.typed_names[start + i];
        val fname: str             = positions.span_text(text, tn.name, alloc);
        if (fname != nil) {
            if (span_is_prefix_of(pfile, prefix, fname)) {
                val ftype: str = typed_name_type_text(a, text, tn, alloc);
                push_completion_item(?b, fname, LSP_COMPLETION_FIELD, "field", ftype, emitted > 0);
                if (ftype != nil) { json.free_str(ftype, alloc); }
                emitted = emitted + 1;
            }
            json.free_str(fname, alloc);
        }
        i = i + 1;
    }

    push_completion_tail(?b, alloc, id_raw);
    ret true;
}

# an empty CompletionList
#
# The same shape as a populated reply rather than a bare `[]`, so a client sees
# one response type from this method whatever the cursor is on.
fun reply_empty_completion(alloc: *Allocator, id_raw: str, incomplete: bool) {
    var b: json.Buf = json.buf_init(alloc);
    push_completion_head(?b, id_raw, incomplete);
    push_completion_tail(?b, alloc, id_raw);
}

# the response envelope every completion list shares
fun push_completion_head(b: *json.Buf, id_raw: str, incomplete: bool) {
    json.buf_push(b, "{\"jsonrpc\":\"2.0\",\"id\":");
    json.buf_push(b, id_raw);
    json.buf_push(b, ",\"result\":{\"isIncomplete\":");
    if (incomplete) { json.buf_push(b, "true"); }
    or              { json.buf_push(b, "false"); }
    json.buf_push(b, ",\"items\":[");
}

# close the envelope, send it, and release the request id
fun push_completion_tail(b: *json.Buf, alloc: *Allocator, id_raw: str) {
    json.buf_push(b, "]}}");
    val msg: str = json.buf_str(b);
    if (msg != nil) {
        transport.send_message(msg, alloc);
        render.note_response();
    }
    json.buf_dnit(b);
    json.free_str(id_raw, alloc);
}

# append one CompletionItem
#
# `detail` is what the client shows beside the label: a field's declared type
# where there is one, otherwise the symbol's kind.
fun push_completion_item(b: *json.Buf, label: str, kind: i64, kind_label: str, detail: str, comma: bool) {
    if (comma) { json.buf_push_byte(b, ','); }
    json.buf_push(b, "{\"label\":");
    json.buf_push_quoted(b, label);
    json.buf_push(b, ",\"kind\":");
    json.buf_push_i64(b, kind);
    json.buf_push(b, ",\"detail\":");
    if (detail != nil) { json.buf_push_quoted(b, detail); }
    or                 { json.buf_push_quoted(b, kind_label); }
    json.buf_push_byte(b, '}');
}

# whether symbol `sid` is a completion candidate AND the first
# symbol with its name, so a name bound more than once is offered only once
fun completion_first(an: analysis.Analyzed, sid: rslv.SymbolId) bool {
    if (!features.completion_candidate(an.rr, sid)) { ret false; }
    val name: intern.StrId = an.rr.symbols[sid].name;
    var j:    u32          = 0;
    for (j < sid) {
        if (features.completion_candidate(an.rr, j) && an.rr.symbols[j].name == name) { ret false; }
        j = j + 1;
    }
    ret true;
}
