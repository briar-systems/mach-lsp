# what a client configures at `initialize` (#264)
#
# The whole surface is three `initializationOptions` keys and the LSP trace
# value; nothing changes after `initialize` except the trace level, which
# `$/setTrace` moves. Each key has an environment variable behind it, and the
# precedence is: option, then environment, then default.
#
#   trace              "off" | "messages" | "bodies"    MLS_TRACE
#   traceFile          path                             MLS_TRACE_FILE
#   requestDeadlineMs  integer >= 1000                  MLS_REQUEST_DEADLINE_MS
#
# The trace level has one more source, the LSP `initialize.trace` value, after
# the environment: an editor's default `trace: "off"` does not silence a trace
# the user turned on in the environment, and an explicit option does. With no
# file named, the trace goes to stderr.
#
# A key this server does not know, and a value it cannot use, is ignored with a
# note in the trace, whether it came from an option or the environment.
# `initialize` never fails because of configuration: a client that sends a
# newer server's settings still gets a working one.
#
# Both halves of the server read these: the supervisor owns the request
# deadline, and the worker answers `initialize`. They resolve the same frame
# with this module, so they cannot disagree about what it said. The worker is
# the one that writes the notes.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.allocator;
use std.allocator.Allocator;
use std.process.env;

use sj:      std.data.json;
use strutil: std.text.string;
use pathlib: std.types.path;

use mls.json;
use mls.trace;
use mls.uris;

# how much a trace records, as `trace` spells it
pub val TRACE_OFF:      u8 = trace.LEVEL_OFF;
pub val TRACE_MESSAGES: u8 = trace.LEVEL_MESSAGES;
pub val TRACE_BODIES:   u8 = trace.LEVEL_BODIES;

# the smallest request deadline that may be configured, in milliseconds
pub val MIN_DEADLINE_MS: i64 = 1000;

# the request deadline when nothing configures one. not part of the interface
pub val DEFAULT_DEADLINE_MS: i64 = 120000;

val TRACE_VAR:    str = "MLS_TRACE";
val FILE_VAR:     str = "MLS_TRACE_FILE";
val DEADLINE_VAR: str = "MLS_REQUEST_DEADLINE_MS";

# where an effective value came from, as the trace names it
pub val FROM_OPTION:  str = "option";
pub val FROM_ENV:     str = "environment";
pub val FROM_LSP:     str = "initialize.trace";
pub val FROM_DEFAULT: str = "default";

# the configuration one `initialize` carried
# ---
# trace:       the `trace` option, when valid
# lsp_trace:   the LSP `initialize.trace` value, when valid
# trace_file:  the `traceFile` option, owned, or nil
# deadline_ms: the `requestDeadlineMs` option, when valid
pub rec Settings {
    trace:       opt[u8];
    lsp_trace:   opt[u8];
    trace_file:  str;
    deadline_ms: opt[i64];
}

# the configuration in an `initialize` request's params
#
# The notes about ignored keys and values are only worth writing once the trace
# they go to is configured, which these very settings decide. So a caller parses
# quietly, applies the result, and parses again with `report` to write them.
# ---
# params: the request's `params`, or nil
# alloc:  allocator for the owned trace file path
# report: write a trace note for each ignored key or value
# ret:    the settings; release with `dnit`
pub fun parse(params: *sj.Value, alloc: *Allocator, report: bool) Settings {
    var s: Settings = Settings{
        trace:       opt[u8].none{},
        lsp_trace:   opt[u8].none{},
        trace_file:  nil,
        deadline_ms: opt[i64].none{},
    };
    val lsp: *sj.Value = json.member(params, "trace");
    if (lsp != nil) {
        s.lsp_trace = lsp_level(lsp, alloc);
        if (report && sel s.lsp_trace.none) { trace.log("settings: initialize.trace is not off, messages or verbose; ignored\n"); }
    }

    val opts: *sj.Value = json.member(params, "initializationOptions");
    if (opts == nil || json.is_null(opts)) { ret s; }
    if (!sj.value_is_object(opts)) {
        if (report) { trace.log("settings: initializationOptions is not an object; ignored\n"); }
        ret s;
    }

    var i: usize = 0;
    for (i < json.count(opts)) {
        val key: str            = key_text(opts, i, alloc);
        val v:   opt[*sj.Value] = sj.value_get(opts, i);
        if (key != nil) {
            if (sel v.some) { apply_option(?s, key, v.some, alloc, report); }
            strutil.str_free(alloc, key);
        }
        i = i + 1;
    }
    s.trace_file = resolve_file(s.trace_file, params, alloc, report);
    ret s;
}

# fold one `initializationOptions` member into `s`
fun apply_option(s: *Settings, key: str, v: *sj.Value, alloc: *Allocator, report: bool) {
    if (str_equals(key, "trace"))             { s.trace = option_level(v, alloc, report); }
    or (str_equals(key, "traceFile"))         { s.trace_file = option_file(v, alloc, report); }
    or (str_equals(key, "requestDeadlineMs")) { s.deadline_ms = option_deadline(v, report); }
    or (report)                               { trace.logf("settings: unknown option `{}` ignored", key); }
}

pub fun dnit(s: *Settings, alloc: *Allocator) {
    json.free_str(s.trace_file, alloc);
    s.trace_file = nil;
}

# what the server runs with, once options, environment and defaults are applied
# ---
# level:       the trace level
# file:        the trace file, owned, or nil for stderr
# deadline_ms: the request deadline
pub rec Effective {
    level:       u8;
    file:        str;
    deadline_ms: i64;
}

# apply the environment and the defaults under what the client configured
# ---
# s:      the parsed options, or nil when there were none
# alloc:  allocator for the owned file path
# report: note each unusable environment value, and the result
# ret:    the effective settings; release with `effective_dnit`
pub fun effective(s: *Settings, alloc: *Allocator, report: bool) Effective {
    var e: Effective = Effective{level: TRACE_OFF, file: nil, deadline_ms: DEFAULT_DEADLINE_MS};

    var given_level: opt[u8]  = opt[u8].none{};
    var lsp_level:   opt[u8]  = opt[u8].none{};
    var given_ms:    opt[i64] = opt[i64].none{};
    if (s != nil) {
        given_level = s.trace;
        lsp_level   = s.lsp_trace;
        given_ms    = s.deadline_ms;
    }

    var level_from: str     = FROM_DEFAULT;
    val env_level:  opt[u8] = env_trace(report);
    if (sel given_level.some) {
        e.level    = given_level.some;
        level_from = FROM_OPTION;
    }
    or (sel env_level.some) {
        e.level    = env_level.some;
        level_from = FROM_ENV;
    }
    or (sel lsp_level.some) {
        e.level    = lsp_level.some;
        level_from = FROM_LSP;
    }

    var file_from: str = FROM_DEFAULT;
    val env_path:  str = env_file(alloc, report);
    if (s != nil && s.trace_file != nil) {
        e.file    = json.dup(s.trace_file, alloc);
        file_from = FROM_OPTION;
        json.free_str(env_path, alloc);
    }
    or (env_path != nil) {
        e.file    = env_path;
        file_from = FROM_ENV;
    }

    var deadline_from: str      = FROM_DEFAULT;
    val env_deadline:  opt[i64] = env_deadline_ms(report);
    if (sel given_ms.some) {
        e.deadline_ms = given_ms.some;
        deadline_from = FROM_OPTION;
    }
    or (sel env_deadline.some) {
        e.deadline_ms = env_deadline.some;
        deadline_from = FROM_ENV;
    }

    if (report) {
        trace.logf("settings: trace {} ({}), to {} ({}), request deadline {}ms ({})",
            level_name(e.level), level_from, file_name(e.file), file_from, e.deadline_ms, deadline_from);
    }
    ret e;
}

# apply the environment's trace settings when no `initialize` ever did, so what
# the trace kept for it is written or dropped
pub fun settle_trace(alloc: *Allocator) {
    if (trace.settled()) { ret; }
    var e: Effective = effective(nil, alloc, false);
    trace.start(e.level, e.file);
    effective_dnit(?e, alloc);
}

pub fun effective_dnit(e: *Effective, alloc: *Allocator) {
    json.free_str(e.file, alloc);
    e.file = nil;
}

fun level_name(level: u8) str {
    if (level == TRACE_BODIES)   { ret "bodies"; }
    if (level == TRACE_MESSAGES) { ret "messages"; }
    ret "off";
}

fun file_name(file: str) str {
    if (file == nil) { ret "stderr"; }
    ret file;
}

# MLS_TRACE: `off`, `messages` or `bodies`. any other value turns the trace on
# at `messages`, so `MLS_TRACE=1` works; an empty one is as if unset
fun env_trace(report: bool) opt[u8] {
    var buf: [32]u8;
    val n_o: opt[usize] = read_env(TRACE_VAR, ?buf[0], 32, report);
    if (sel n_o.none) { ret opt[u8].none{}; }
    val v: str = (?buf[0])::str;
    if (str_equals(v, "off"))    { ret opt[u8].some{TRACE_OFF}; }
    if (str_equals(v, "bodies")) { ret opt[u8].some{TRACE_BODIES}; }
    ret opt[u8].some{TRACE_MESSAGES};
}

# MLS_TRACE_FILE, owned, or nil when unset or unusable
fun env_file(alloc: *Allocator, report: bool) str {
    var buf: [trace.MAX_PATH]u8;
    val n_o: opt[usize] = read_env(FILE_VAR, ?buf[0], trace.MAX_PATH, report);
    if (sel n_o.none) { ret nil; }
    ret json.dup((?buf[0])::str, alloc);
}

# MLS_REQUEST_DEADLINE_MS, when it is an integer of at least the minimum
fun env_deadline_ms(report: bool) opt[i64] {
    var buf: [24]u8;
    val n_o: opt[usize] = read_env(DEADLINE_VAR, ?buf[0], 24, report);
    if (sel n_o.none) { ret opt[i64].none{}; }
    val n:  usize = n_o.some;
    var ms: i64   = 0;
    var i:  usize = 0;
    for (i < n) {
        if (buf[i] < '0' || buf[i] > '9' || i >= 12) {
            if (report) { trace.logf("settings: {} `{}` is not an integer; ignored", DEADLINE_VAR, (?buf[0])::str); }
            ret opt[i64].none{};
        }
        ms = ms * 10 + (buf[i]::i64 - '0'::i64);
        i  = i + 1;
    }
    if (ms < MIN_DEADLINE_MS) {
        if (report) { trace.logf("settings: {} {} is below {}; ignored", DEADLINE_VAR, ms, MIN_DEADLINE_MS); }
        ret opt[i64].none{};
    }
    ret opt[i64].some{ms};
}

# a variable's value, nul-terminated in `buf`, or none when it is unset, empty,
# unreadable or too long, noting the last two
fun read_env(name: str, buf: *u8, cap: usize, report: bool) opt[usize] {
    val r: res[opt[usize], env.EnvError] = env.get(name, buf, cap);
    if (sel r.err) {
        if (report) { trace.logf("settings: {} could not be read; ignored", name); }
        ret opt[usize].none{};
    }
    val n_o: opt[usize] = r.ok;
    if (sel n_o.none) { ret opt[usize].none{}; }
    val n: usize = n_o.some;
    if (n == 0) { ret opt[usize].none{}; }
    if (n >= cap) {
        if (report) { trace.logf("settings: {} is longer than {} bytes; ignored", name, cap - 1); }
        ret opt[usize].none{};
    }
    buf[n] = 0;
    ret opt[usize].some{n};
}

# the trace level a `$/setTrace` or `initialize.trace` value names: the LSP
# spelling, where `verbose` is what this server calls bodies
pub fun lsp_level(v: *sj.Value, alloc: *Allocator) opt[u8] {
    if (json.text_equals(v, "off", alloc))      { ret opt[u8].some{TRACE_OFF}; }
    if (json.text_equals(v, "messages", alloc)) { ret opt[u8].some{TRACE_MESSAGES}; }
    if (json.text_equals(v, "verbose", alloc))  { ret opt[u8].some{TRACE_BODIES}; }
    ret opt[u8].none{};
}

fun option_level(v: *sj.Value, alloc: *Allocator, report: bool) opt[u8] {
    if (json.text_equals(v, "off", alloc))      { ret opt[u8].some{TRACE_OFF}; }
    if (json.text_equals(v, "messages", alloc)) { ret opt[u8].some{TRACE_MESSAGES}; }
    if (json.text_equals(v, "bodies", alloc))   { ret opt[u8].some{TRACE_BODIES}; }
    if (report)                                 { trace.log("settings: option `trace` is not off, messages or bodies; ignored\n"); }
    ret opt[u8].none{};
}

fun option_file(v: *sj.Value, alloc: *Allocator, report: bool) str {
    val path: str = json.text(v, alloc);
    if (path == nil && report) { trace.log("settings: option `traceFile` is not a string; ignored\n"); }
    ret path;
}

# the `traceFile` option as the absolute path it names
#
# A relative path is a path under the workspace root: the first workspace
# folder, else `rootUri`. A client that sends neither has no root to resolve
# against, so the option is ignored rather than aimed at wherever the server
# was started. One that resolves outside the root is ignored too: a project
# setting shared through version control must not write beside the project,
# and an absolute path is there for anyone who means to write elsewhere.
# ---
# path:   the option as given, owned; consumed
# params: the `initialize` params, for the workspace root
# ret:    an owned absolute path, or nil when it cannot be used
fun resolve_file(path: str, params: *sj.Value, alloc: *Allocator, report: bool) str {
    if (path == nil) { ret nil; }
    var out: str = path;
    if (!pathlib.is_abs(path)) {
        out = nil;
        val root: str = workspace_root(params, alloc);
        if (root == nil) {
            if (report) { trace.logf("settings: option `traceFile` `{}` is relative and there is no workspace root; ignored", path); }
        }
        or {
            val jr: res[pathlib.Path, allocator.Error] = pathlib.join(alloc, root, path);
            if (sel jr.ok) {
                out = uris.normalize(alloc, jr.ok);
                strutil.str_free(alloc, jr.ok);
            }
            if (out != nil && !uris.is_under(out, root)) {
                if (report) { trace.logf("settings: option `traceFile` `{}` resolves outside the workspace root; ignored", path); }
                strutil.str_free(alloc, out);
                out = nil;
            }
            strutil.str_free(alloc, root);
        }
        json.free_str(path, alloc);
    }
    if (out != nil && str_len(out) >= trace.MAX_PATH) {
        if (report) { trace.logf("settings: option `traceFile` is longer than {} bytes; ignored", trace.MAX_PATH - 1); }
        strutil.str_free(alloc, out);
        ret nil;
    }
    ret out;
}

# the filesystem path of the workspace root an `initialize` names, owned, or nil
fun workspace_root(params: *sj.Value, alloc: *Allocator) str {
    val folders: *sj.Value = json.member(params, "workspaceFolders");
    if (folders != nil && sj.value_is_array(folders) && json.count(folders) > 0) {
        val first: *sj.Value = json.element(folders, 0);
        val uri:   str       = json.text(json.member(first, "uri"), alloc);
        if (uri != nil) {
            val path: str = uris.path_of(alloc, uri);
            json.free_str(uri, alloc);
            if (path != nil) { ret path; }
        }
    }
    val root: str = json.text(json.member(params, "rootUri"), alloc);
    if (root == nil) { ret nil; }
    val path: str = uris.path_of(alloc, root);
    json.free_str(root, alloc);
    ret path;
}

fun option_deadline(v: *sj.Value, report: bool) opt[i64] {
    if (!sj.value_is_number(v) || sj.value_is_float(v)) {
        if (report) { trace.log("settings: option `requestDeadlineMs` is not an integer; ignored\n"); }
        ret opt[i64].none{};
    }
    val ms: i64 = sj.value_number(v);
    if (ms < MIN_DEADLINE_MS) {
        if (report) { trace.logf("settings: option `requestDeadlineMs` {} is below {}; ignored", ms, MIN_DEADLINE_MS); }
        ret opt[i64].none{};
    }
    ret opt[i64].some{ms};
}

# an owned, nul-terminated copy of object key `i`
fun key_text(obj: *sj.Value, i: usize, alloc: *Allocator) str {
    val ko: opt[str] = sj.value_key(obj, i);
    if (sel ko.none) { ret nil; }
    val n: usize                     = sj.value_key_len(obj, i);
    val r: res[str, allocator.Error] = strutil.str_dup_range(alloc, ko.some, 0, n);
    if (sel r.err) { ret nil; }
    ret r.ok;
}
