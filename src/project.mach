# retained per-root compiler snapshots for cross-module language features
#
# Each project root owns a separately allocated stable Session and at most one
# live compiler Project. Open documents retain their own canonical path, text,
# and revision; their text is mirrored into every governing Session as a
# filesystem-path overlay. A snapshot is rebuilt through analyze_project with
# all open source files as compiler-owned extra roots, so imports, comptime
# context, resolve, sema, and diagnostics share the build's exact semantics.
#
# ModuleId, FileId, interner, type, and query identities never cross Root
# boundaries. Documents inside an already-loaded ancestor dependency graph route
# to that graph; otherwise the nearest manifest owns them.
#
# A root that already has a snapshot rebuilds off the analysis thread. The
# incoming snapshot is built into a SECOND Session, from a BuildInput captured
# on the analysis thread, so the two never share mutable state and the old
# snapshot keeps answering every request until the new one is swapped in. The
# swap happens in `pump`, between messages, which is what makes it safe: every
# request runs to completion on the analysis thread, so no borrowed pointer into
# a Session outlives the message that took it. A root with no snapshot at all
# has nothing to serve, so its FIRST build still runs inline.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use std.allocator.Allocator;
use std.allocator.allocate;
use std.allocator.deallocate;
use std.allocator.reallocate;

use chrono: std.chrono.time;
use std.data.toml;
use fs:      std.filesystem;
use strutil: std.text.string;
use pathlib: std.types.path;

use std.allocator.page;
use mem: std.memory;

use mach.lang.build.outcome;
use mach.lang.build.request;
use mach.lang.driver;
use mach.lang.fe.ast;
use adecl: mach.lang.fe.ast.decl;
use mach.lang.fe.ast.id;
use rslv: mach.lang.fe.resolve;
use mach.lang.fe.sema;
use mach.lang.intern;
use mach.lang.manifest;
use sess: mach.lang.session;
use src:  mach.lang.source;
use mach.lang.type;
use std.collections.vector;

use mls.build;
use mls.documents;
use mls.json;
use mls.positions;
use mls.progress;
use mls.trace;
use mls.transport;
use mtypes: mls.types;

use mach.lang.fail;
use mach.lang.fe.token;
use std.allocator;
use io_error: std.io.error;

# where a resolved symbol's declaration lives - the Ast and SourceFile to
# read its spans from, and the document URI to report. for a buffer-local symbol
# this is the request's own buffer; for a cross-module symbol it is the defining
# dependency module's on-disk file
# ---
# a:     Ast owning the symbol's decl (spans are decl-ids into this tree)
# text:  SourceFile backing `a`, paired with its length (span text, positions)
# uri:   document URI of `text.file`
# owned: whether `uri` is heap-owned by this Site and must be freed
pub rec Site {
    a:     *ast.Ast;
    text:  positions.Text;
    uri:   str;
    sym:   *rslv.Symbol;
    owned: bool;
}

# a source file's change-detection state
#
# Stat metadata only. A content hash would suppress a rebuild after a touch
# that did not change bytes, but reading and hashing every module to save that
# case costs more than the case does: a spurious rebuild reuses the retained
# session, where `Q_FILE_TEXT`'s byte-equality cutoff keeps every unchanged
# module's parse, resolve, and sema entry valid. The compiler already owns
# content-change detection, so the LSP does not duplicate it.
# ---
# mtime: modification time in unix nanoseconds, 0 when absent
# size:  size in bytes
rec SourceFingerprint {
    mtime: i64;
    size:  usize;
}

# one project root and its compiler-owned semantic snapshot
# ---
# path:              owned absolute directory containing mach.toml
# loaded:            whether p is live
# p:                 retained frontend Project, valid only while loaded
# mod_paths:         canonical source path per ModuleId
# mod_path_count:    number of mod_paths entries
# mod_fingerprints:  on-disk fingerprint per mod_paths entry
# man_mtime:         last observed manifest mtime
# lock_mtime:        last observed lockfile mtime
# vendored:          whether the root belongs to an ancestor dependency tree
# s:                 serving Session, owning every identity `p` refers to
# spare:             the idle Session the next build runs into
# spare_p:           a dead Project still held by `spare`, released by that build
# spare_has_p:       whether spare_p is live
# spare_primed:      whether spare has run a build of this root, so its query
#                    cache holds the closure and the next build into it is warm
# input_revision:    newest covered document revision mirrored into s
# snapshot_revision: input revision captured by p
# attempted_revision:last input revision analyzed, including a failed attempt
# dirty:             explicit watcher/save invalidation requiring one attempt
# last_disk_scan_ns: last fallback fingerprint scan time
pub rec Root {
    path:               str;
    loaded:             bool;
    analyzed_once:      bool;
    p:                  driver.Project;
    mod_paths:          *str;
    mod_path_count:     u32;
    mod_fingerprints:   *SourceFingerprint;
    man_mtime:          i64;
    lock_mtime:         i64;
    vendored:           bool;
    s:                  *sess.Session;
    spare:              *sess.Session;
    spare_p:            driver.Project;
    spare_has_p:        bool;
    spare_primed:       bool;
    input_revision:     u64;
    snapshot_revision:  u64;
    attempted_revision: u64;
    dirty:              bool;
    last_disk_scan_ns:  i64;
}

# project roots and the standalone-editor fallback
# ---
# s:             fallback Session for documents outside projects
# alloc:         workspace allocator
# roots:         movable Root slots; each Root.s itself has a stable allocation
# root_cap:      roots allocation length
# load_epoch:    successful snapshot build counter
# sema_epoch:    semantic snapshot build counter
# docs:          borrowed live document store
# builder:       the worker rebuilds run on, one build at a time
# building:      a build is in flight or finished and uncollected
# building_root: index of the root being built; Root slots move, so the build
#                is tied to an index rather than a pointer
pub rec Workspace {
    s:             *sess.Session;
    alloc:         *Allocator;
    roots:         *Root;
    root_cap:      u32;
    load_epoch:    u32;
    sema_epoch:    u32;
    docs:          *documents.Store;
    builder:       build.Builder;
    building:      bool;
    building_root: u32;
}

# construct an empty workspace over the server's sessions
# ---
# s:     compiler session the graphs load into
# alloc: allocator for all workspace-owned storage
# ret:   an empty, rootless Workspace
pub fun init(s: *sess.Session, alloc: *Allocator) Workspace {
    var w: Workspace;
    w.s             = s;
    w.alloc         = alloc;
    w.roots         = nil;
    w.root_cap      = 0;
    w.load_epoch    = 0;
    w.sema_epoch    = 0;
    w.docs          = nil;
    w.building      = false;
    w.building_root = 0;
    build.init(?w.builder, run_build, nil, nil);
    ret w;
}

# attach the live document store after the mutually referring server fields are
# initialized
# ---
# w:    workspace to configure
# docs: borrowed live document store
pub fun attach_documents(w: *Workspace, docs: *documents.Store) {
    w.docs = docs;
}

# start the build worker and say how it should wake the analysis thread
#
# `wake` runs ON the build worker and must do nothing but wake: the analysis
# thread is what looks at the result, in `pump`. Without a start the workspace
# still works - `schedule_build` is refused and every build runs inline - so a
# worker that cannot spawn degrades to the old behaviour rather than failing.
# ---
# w:    the workspace
# wake: called on the worker once a build finishes
# ctx:  opaque context handed to `wake`
# ret:  true when the worker started
pub fun start_builder(w: *Workspace, wake: build.WakeFn, ctx: ptr) bool {
    build.init(?w.builder, run_build, wake, ctx);
    ret build.start(?w.builder);
}

# the governing root's type interner, or the standalone fallback when root is nil
# ---
# w:    workspace containing the fallback
# root: governing compiler root
# ret:  the session's type interner
pub fun type_interner(w: *Workspace, root: *Root) *type.TypeInterner {
    if (root != nil && root.s != nil) { ret ?root.s.types; }
    ret ?w.s.types;
}

# the governing root's string interner, or the standalone fallback when root is nil
pub fun interner(w: *Workspace, root: *Root) *intern.Interner {
    if (root != nil && root.s != nil) { ret ?root.s.interner; }
    ret ?w.s.interner;
}

# the workspace's current load epoch - a counter bumped on every
# successful root build. the server snapshots it around a feature request; a
# change means a lazy project load completed, so the open buffers it now governs
# can have their diagnostics re-published with semantic (dep-aware) results
# without waiting for an edit (#96)
# ---
# w:   the workspace
# ret: the current load epoch
pub fun load_epoch(w: *Workspace) u32 {
    ret w.load_epoch;
}

# the workspace's semantic snapshot epoch, bumped with each successful retained
# frontend analysis
# ---
# w:   the workspace
# ret: the current sema epoch
pub fun sema_epoch(w: *Workspace) u32 {
    ret w.sema_epoch;
}

# release every retained project and its stable per-root Session
# ---
# w: workspace to tear down; all owned fields are zeroed
pub fun dnit(w: *Workspace) {
    # the worker owns memory this is about to release, so it stops first
    val stranded: ptr = build.dnit(?w.builder);
    if (stranded != nil) { free_build_output(stranded::*BuildOutput); }
    if (w.roots != nil) {
        var i: u32 = 0;
        for (i < w.root_cap) {
            if (w.roots[i].path != nil) { free_root(w, ?w.roots[i]); }
            i = i + 1;
        }
        deallocate[Root](w.alloc, w.roots, w.root_cap::usize);
    }
    w.roots    = nil;
    w.root_cap = 0;
}

# the root governing the document at `uri`, loading it on first use,
# or nil when the document resolves single-file (no ancestor `mach.toml`, or a
# remembered failed load). a document that is a dependency module of a root
# rooted elsewhere - whether that root is already loaded, or is an ancestor
# project loaded here on demand - is routed to that root read-only, rather than
# spun up as its own project, regardless of document open order
# ---
# w:   the workspace
# uri: the document's URI
# ret: a borrowed pointer to the governing Root, or nil
pub fun root_for(w: *Workspace, uri: str) *Root {
    if (uri == nil) { ret nil; }
    val doc_root: str   = document_root(w, uri);
    val twin:     *Root = containing_root(w, uri, doc_root);
    if (twin != nil) {
        if (doc_root != nil) { strutil.str_free(w.alloc, doc_root); }
        ret twin;
    }
    if (doc_root == nil) { ret nil; }

    val existing: *Root = find_root(w, doc_root);
    if (existing != nil) {
        strutil.str_free(w.alloc, doc_root);
        maybe_reload(w, existing);
        val rr: res[bool, str] = refresh_inputs(w, existing);
        if (sel rr.err)       { ret nil; }
        if (!existing.loaded) { ret nil; }
        ret existing;
    }
    val outer: *Root = ancestor_root(w, uri, doc_root, doc_root);
    if (outer != nil) {
        strutil.str_free(w.alloc, doc_root);
        ret outer;
    }
    ret load_root(w, doc_root);
}

# the root governing the document at `uri` ONLY when it is
# already loaded - never triggering a build. unlike `root_for`, this neither
# loads a fresh root nor speculatively loads a vendoring ancestor nor reloads a
# stale one; it returns nil when no loaded root holds the document. the
# diagnostics publish path uses this so opening or editing a buffer publishes
# instantly (parse-only) instead of blocking on a ~tens-of-seconds project build
# (#96); the project still loads lazily on the first feature request, where
# `root_for` runs. a document already governed by a loaded root resolves
# dep-aware as before (#78). matches `root_for`'s routing: a loaded twin rooted
# elsewhere wins, else the document's own root when it is loaded
# ---
# w:   the workspace
# uri: the document's URI
# ret: a borrowed pointer to the governing loaded Root, or nil
pub fun root_for_loaded(w: *Workspace, uri: str) *Root {
    if (uri == nil) { ret nil; }
    val twin: *Root = containing_root_loaded(w, uri);
    if (twin != nil) { ret twin; }
    val doc_root: str = document_root(w, uri);
    if (doc_root == nil) { ret nil; }
    val existing: *Root = find_root(w, doc_root);
    strutil.str_free(w.alloc, doc_root);
    if (existing != nil && existing.loaded) { ret existing; }
    ret nil;
}

# load-and-prefer the outermost project that vendors the document
# at `uri` (whose own fresh root is `doc_root`) and whose loaded graph holds it.
# walks the chain of ancestor manifest dirs strictly above `dir` (`doc_root` on
# the outer call), outermost first; an ancestor is only considered when its
# manifest declares a dependency whose vendor dir encloses `doc_root`
# (`vendors_enclosing`), so unrelated outer projects - a monorepo root, this repo
# above its test fixtures - are never speculatively built. the outermost
# considered ancestor whose loaded graph holds the document governs it; one that
# loads but does not hold it stays loaded (it is a real project) and the walk
# falls inward to the next vendoring ancestor - so a dependency nested inside
# another dependency's tree reaches the outermost project that actually closes
# over it, not merely its immediate parent. ancestors already tracked are
# skipped: a loaded one was already offered by containing_root, and a failed one
# is not retried here. nil when no ancestor claims the document
fun ancestor_root(w: *Workspace, uri: str, doc_root: str, dir: str) *Root {
    val par_r: res[pathlib.Path, allocator.Error] = pathlib.parent(w.alloc, dir);
    if (sel par_r.err) { ret nil; }
    val par: str = par_r.ok;
    if (str_equals(par, dir)) {
        strutil.str_free(w.alloc, par);
        ret nil;
    }
    val anc: str = project_root_for(w.alloc, par);
    strutil.str_free(w.alloc, par);
    if (anc == nil) { ret nil; }

    val above: *Root = ancestor_root(w, uri, doc_root, anc);
    if (above != nil) {
        strutil.str_free(w.alloc, anc);
        ret above;
    }

    val tracked: *Root = find_root(w, anc);
    if (tracked != nil) {
        maybe_reload(w, tracked);
        refresh_inputs(w, tracked);
        if (tracked.loaded && has_module_for_uri(module_for_uri(w, tracked, uri))) {
            strutil.str_free(w.alloc, anc);
            ret tracked;
        }
        strutil.str_free(w.alloc, anc);
        ret nil;
    }
    if (!vendors_enclosing(w, anc, doc_root)) {
        strutil.str_free(w.alloc, anc);
        ret nil;
    }

    val r: *Root = load_root(w, anc);
    if (r == nil)                                      { ret nil; }
    if (has_module_for_uri(module_for_uri(w, r, uri))) { ret r; }
    ret nil;
}

# whether the project at `root_path` declares a dependency
# whose vendor dir encloses `dir` - i.e. `dir` equals or lies under
# `<root>/<[project].dep>/<alias>` for some `[dep.<alias>]`, the same layout the
# driver's dep resolution reads. one small manifest parse answers "could this
# project's dependency tree contain that nested root?" without paying a full
# graph build; the loaded graph remains the authority on actual containment.
# enclosure rather than equality is the speculative-build gate that lets a dep
# nested inside another dep's tree reach the outermost vendoring project, not
# merely its immediate parent, while still never building unrelated outer
# projects - a monorepo root, this repo above its test fixtures - whose declared
# vendor dirs enclose nothing the document sits in. a manifest that fails to read
# or parse vendors nothing. `get_str` and `table_key` borrow out of the table, so
# it is torn down at scope exit rather than at the last read
fun vendors_enclosing(w: *Workspace, root_path: str, dir: str) bool {
    val mp_r: res[pathlib.Path, allocator.Error] = pathlib.join(w.alloc, root_path, "mach.toml");
    if (sel mp_r.err) { ret false; }
    val mp:     str                  = mp_r.ok;
    val text_r: res[str, fs.FsError] = fs.read_string(w.alloc, mp);
    strutil.str_free(w.alloc, mp);
    if (sel text_r.err) { ret false; }
    val text: str                             = text_r.ok;
    val t_r:  res[toml.Table, toml.TomlError] = toml.parse(w.alloc, text);
    strutil.str_free(w.alloc, text);
    if (sel t_r.err) { ret false; }
    var t: toml.Table = t_r.ok;
    fin { toml.dnit(w.alloc, ?t); }

    val deps_o: opt[*toml.Table] = toml.get_table(?t, "dep");
    if (sel deps_o.none) { ret false; }
    val deps:    *toml.Table = deps_o.some;
    var dir_dep: str         = "dep";
    val dir_o:   opt[str]    = toml.get_str(?t, "project.dep");
    if (sel dir_o.some) { dir_dep = dir_o.some; }

    val want: str = normalize_path(w.alloc, dir);
    if (want == nil) { ret false; }

    var found: bool  = false;
    var i:     usize = 0;
    for (i < toml.table_len(deps) && !found) {
        val alias_o: opt[str] = toml.table_key(deps, i);
        if (sel alias_o.some) {
            val alias:  str                                = alias_o.some;
            val base_r: res[pathlib.Path, allocator.Error] = pathlib.join(w.alloc, root_path, dir_dep);
            if (sel base_r.ok) {
                val base:   str                                = base_r.ok;
                val cand_r: res[pathlib.Path, allocator.Error] = pathlib.join(w.alloc, base, alias);
                strutil.str_free(w.alloc, base);
                if (sel cand_r.ok) {
                    val cand: str = cand_r.ok;
                    val norm: str = normalize_path(w.alloc, cand);
                    strutil.str_free(w.alloc, cand);
                    if (norm != nil) {
                        if (is_under(want, norm)) { found = true; }
                        strutil.str_free(w.alloc, norm);
                    }
                }
            }
        }
        i = i + 1;
    }
    strutil.str_free(w.alloc, want);
    ret found;
}

# the tracked slot whose path equals `root_path`, or nil
fun find_root(w: *Workspace, root_path: str) *Root {
    if (w.roots == nil) { ret nil; }
    var i: u32 = 0;
    for (i < w.root_cap) {
        val r: *Root = ?w.roots[i];
        if (r.path != nil && str_equals(r.path, root_path)) { ret r; }
        i = i + 1;
    }
    ret nil;
}

# the outermost loaded root whose graph holds the document at
# `uri` as a module (matched on the normalized filesystem path), skipping the
# document's own root at `doc_root` (which find_root handles, with its
# outside-the-closure files resolving against its dep set). when several loaded
# roots hold the document - an outer project and a dependency nested within it -
# the outermost wins (the shortest root path, since every holder is an ancestor
# of the document on one root-to-file chain and so they nest), so a dependency
# module routes to the project that vendors it regardless of which root loaded
# first. each candidate is reload-checked and its containment re-verified before
# it is accepted, so a twin-routed document does not bypass the staleness check.
# nil when no other loaded root holds the document
fun containing_root(w: *Workspace, uri: str, doc_root: str) *Root {
    if (w.roots == nil) { ret nil; }
    val norm: str = uri_to_norm(w.alloc, uri);
    if (norm == nil) { ret nil; }
    var found: *Root = nil;
    var i:     u32   = 0;
    for (i < w.root_cap) {
        val r: *Root = ?w.roots[i];
        if (r.path != nil && r.loaded
            && (doc_root == nil || !str_equals(r.path, doc_root))
            && has_module_for_norm(module_for_norm(r, norm))) {
            maybe_reload(w, r);
            refresh_inputs(w, r);
            if (r.loaded && has_module_for_norm(module_for_norm(r, norm))
                && (found == nil || str_len(r.path) < str_len(found.path))) {
                found = r;
            }
        }
        i = i + 1;
    }
    strutil.str_free(w.alloc, norm);
    ret found;
}

# the load-free counterpart of `containing_root` for the
# diagnostics publish path - the outermost already-loaded root whose graph holds
# the document at `uri`, without the per-candidate `maybe_reload` (which would
# rebuild a stale root). selection is identical otherwise: the shortest holding
# root path wins, so a vendored module routes to the project that vendors it. nil
# when no loaded root holds the document. staleness is reconciled on the feature
# path's `root_for`, never on publish
fun containing_root_loaded(w: *Workspace, uri: str) *Root {
    if (w.roots == nil) { ret nil; }
    val norm: str = uri_to_norm(w.alloc, uri);
    if (norm == nil) { ret nil; }
    var found: *Root = nil;
    var i:     u32   = 0;
    for (i < w.root_cap) {
        val r: *Root = ?w.roots[i];
        if (r.path != nil && r.loaded
            && has_module_for_norm(module_for_norm(r, norm))
            && (found == nil || str_len(r.path) < str_len(found.path))) {
            found = r;
        }
        i = i + 1;
    }
    strutil.str_free(w.alloc, norm);
    ret found;
}

# claim a slot for `root_path` (taking ownership of the string) and
# build its graph. the vendored flag is stamped once here - intrinsic to the
# path, so every root-creating path (root_for's fresh-root load, ancestor_root's
# speculative loads) gets it correct, and it survives in-place reloads (which keep
# the slot). on failure the slot is kept as a remembered failed load and nil is
# returned; on success the loaded Root pointer is returned
# a separately allocated, initialized Session, or nil
fun new_session(alloc: *Allocator) *sess.Session {
    val p_r: res[*sess.Session, allocator.Error] = allocate[sess.Session](alloc, 1);
    if (sel p_r.err) { ret nil; }
    val sn: *sess.Session                = p_r.ok;
    val sr: res[sess.Session, fail.Fail] = sess.init(alloc);
    if (sel sr.err) {
        deallocate[sess.Session](alloc, sn, 1);
        ret nil;
    }
    @sn = sr.ok;
    ret sn;
}

fun free_session(alloc: *Allocator, sn: *sess.Session) {
    if (sn == nil) { ret; }
    sess.dnit(sn);
    deallocate[sess.Session](alloc, sn, 1);
}

fun load_root(w: *Workspace, root_path: str) *Root {
    val slot: *Root = alloc_slot(w);
    if (slot == nil) {
        strutil.str_free(w.alloc, root_path);
        ret nil;
    }
    # both sessions exist from the start: a root ping-pongs between them so the
    # one not currently serving keeps its query cache warm for the next build
    slot.s     = new_session(w.alloc);
    slot.spare = new_session(w.alloc);
    if (slot.s == nil || slot.spare == nil) {
        free_session(w.alloc, slot.s);
        free_session(w.alloc, slot.spare);
        slot.s     = nil;
        slot.spare = nil;
        strutil.str_free(w.alloc, root_path);
        ret nil;
    }
    slot.path     = root_path;
    slot.vendored = vendored_under_ancestor(w, root_path);
    if (try_load(w, slot)) { ret slot; }
    ret nil;
}

# whether `root_path`'s own directory lies under some
# strict-ancestor project's declared vendor dir - i.e. this root is a vendored
# dependency of an outer project. climbs the chain of ancestor manifest dirs
# strictly above `root_path` (the same dirs ancestor_root walks), asking
# vendors_enclosing of each; true on the first whose declared dep vendor dir
# encloses `root_path`. this is a property of the path, not of how the root was
# reached: a root materialized as an outer vendoring project for a deeper dep is
# still flagged when it itself sits under a grandparent's vendor dir, which is
# correct - its own sources remain a vendored dependency. a root with no such
# ancestor (a top-level project, even one that loads dep modules) is not vendored
fun vendored_under_ancestor(w: *Workspace, root_path: str) bool {
    var cur:    str  = root_path;
    var result: bool = false;
    var done:   bool = false;
    for (!done) {
        val anc: str = project_root_for(w.alloc, cur);
        if (cur != root_path) { strutil.str_free(w.alloc, cur); }
        if (anc == nil)       { done = true; }
        or {
            if (vendors_enclosing(w, anc, root_path)) {
                strutil.str_free(w.alloc, anc);
                result = true;
                done   = true;
            }
            or { cur = anc; }
        }
    }
    ret result;
}

# zero a Root slot's fields, marking it dead and reusable. owned
# storage must already be released (free_root) or never allocated (a fresh
# slot)
fun reset_slot(r: *Root) {
    r.path               = nil;
    r.loaded             = false;
    r.analyzed_once      = false;
    r.mod_paths          = nil;
    r.mod_path_count     = 0;
    r.mod_fingerprints   = nil;
    r.man_mtime          = 0;
    r.lock_mtime         = 0;
    r.vendored           = false;
    r.s                  = nil;
    r.spare              = nil;
    r.spare_has_p        = false;
    r.spare_primed       = false;
    r.input_revision     = 0;
    r.snapshot_revision  = 0;
    r.attempted_revision = 0;
    r.dirty              = false;
    r.last_disk_scan_ns  = 0;
}

# a reusable dead slot, growing the array when every slot is
# tracked. nil on allocation failure
fun alloc_slot(w: *Workspace) *Root {
    var i: u32 = 0;
    for (i < w.root_cap) {
        if (w.roots[i].path == nil) { ret ?w.roots[i]; }
        i = i + 1;
    }
    val old_cap: u32 = w.root_cap;
    var new_cap: u32 = old_cap;
    if (new_cap == 0) { new_cap = 4; }
    or                { new_cap = new_cap * 2; }
    if (w.roots == nil) {
        val r: res[*Root, allocator.Error] = allocate[Root](w.alloc, new_cap::usize);
        if (sel r.err) { ret nil; }
        w.roots = r.ok;
    }
    or {
        val r: res[*Root, allocator.Error] = reallocate[Root](w.alloc, w.roots, old_cap::usize, new_cap::usize);
        if (sel r.err) { ret nil; }
        w.roots = r.ok;
    }
    var z: u32 = old_cap;
    for (z < new_cap) {
        reset_slot(?w.roots[z]);
        z = z + 1;
    }
    w.root_cap = new_cap;
    ret ?w.roots[old_cap];
}

# everything one project analysis reads, captured on the analysis thread
#
# The worker gets this and nothing else. Every question whose answer lives in
# the live workspace - which root mirrors this document, which root owns it -
# is decided here, while the analysis thread still owns the answer, so what
# crosses the thread boundary is a flat set of facts with no pointers back.
# ---
# path:     canonical document path, owned
# text:     the buffer's text at capture, owned
# belongs:  whether the root mirrors this document into its session
# own_root: whether the root is this document's own nearest project
rec DocSnapshot {
    path:     str;
    text:     str;
    belongs:  bool;
    own_root: bool;
}

# one root's pending build, owned by whoever holds it
# ---
# alloc:       allocator backing this input and the result built from it
# root_path:   owned copy of the root directory
# docs:        owned document snapshots
# doc_count:   live entries in docs
# span:        docs allocation length, which is the store's slot count, not doc_count
# revision:    the input revision this build covers
# warmup:      the root was current at capture, so the build only primes `sn`
# sn:          BORROWED idle Session to build into; the Root owns it throughout
# stale_p:     a dead Project still held by `sn`
# has_stale_p: whether stale_p must be released before building
rec BuildInput {
    alloc:       *Allocator;
    root_path:   str;
    docs:        *DocSnapshot;
    doc_count:   u32;
    span:        usize;
    revision:    u64;
    warmup:      bool;
    sn:          *sess.Session;
    stale_p:     driver.Project;
    has_stale_p: bool;
}

# one finished build, owned by whoever holds it
#
# `message` is an owned copy rather than a borrow: a failure's text usually
# points into a Fail or a manifest that is gone by the time the analysis thread
# reads it, and the thread that may write to the client is not the thread that
# produced the words.
# ---
# alloc:            allocator everything here came from
# ok:               whether `p` and the path snapshot are valid
# s:                BORROWED Session the build ran into; the Root owns it
# p:                the retained Project, valid only when ok
# mod_paths:        canonical source path per ModuleId
# mod_fingerprints: on-disk fingerprint per mod_paths entry
# mod_path_count:   mod_paths length
# man_mtime:        manifest mtime observed at build start
# lock_mtime:       lockfile mtime observed at build start
# revision:         the input revision this build covered
# warmup:           the build only primed its session, see BuildInput
# message:          owned failure text, nil on success
rec BuildOutput {
    alloc:            *Allocator;
    ok:               bool;
    s:                *sess.Session;
    p:                driver.Project;
    mod_paths:        *str;
    mod_fingerprints: *SourceFingerprint;
    mod_path_count:   u32;
    man_mtime:        i64;
    lock_mtime:       i64;
    revision:         u64;
    warmup:           bool;
    message:          str;
}

# an owned copy of `text`, or nil
fun dup_str(alloc: *Allocator, text: str) str {
    if (text == nil) { ret nil; }
    val r: res[str, allocator.Error] = strutil.str_dup(alloc, text);
    if (sel r.err) { ret nil; }
    ret r.ok;
}

# capture everything `r`'s next build needs, and record what it will cover
#
# Also advances `r.input_revision` to the newest covered buffer, which is what
# a later build result is compared against to decide whether input moved on
# while it ran.
fun capture_input(w: *Workspace, r: *Root) *BuildInput {
    val ir: res[*BuildInput, allocator.Error] = allocate[BuildInput](w.alloc, 1);
    if (sel ir.err) { ret nil; }
    val in: *BuildInput = ir.ok;
    in.alloc       = w.alloc;
    in.root_path   = nil;
    in.docs        = nil;
    in.doc_count   = 0;
    in.span        = 0;
    in.revision    = r.input_revision;
    in.warmup      = false;
    in.sn          = r.spare;
    in.has_stale_p = r.spare_has_p;
    if (r.spare_has_p) { in.stale_p = r.spare_p; }
    r.spare_has_p = false;

    in.root_path = dup_str(w.alloc, r.path);
    if (in.root_path == nil) {
        free_build_input(in);
        ret nil;
    }

    var n: usize = 0;
    if (w.docs != nil) { n = documents.slot_count(w.docs); }
    if (n > 4294967295) {
        free_build_input(in);
        ret nil;
    }
    if (n > 0) {
        val dr: res[*DocSnapshot, allocator.Error] = allocate[DocSnapshot](w.alloc, n);
        if (sel dr.err) {
            free_build_input(in);
            ret nil;
        }
        in.docs = dr.ok;
        in.span = n;
        var latest: u64   = r.input_revision;
        var i:      usize = 0;
        for (i < n) {
            val d: *documents.Document = documents.at(w.docs, i);
            if (d != nil && d.in_use && d.path != nil) {
                val slot: *DocSnapshot = ?in.docs[in.doc_count];
                slot.path     = dup_str(w.alloc, d.path);
                slot.text     = dup_str(w.alloc, d.text);
                slot.belongs  = document_belongs(w, r, d.path);
                slot.own_root = document_own_root(w, r, d.path);
                if (slot.path == nil || slot.text == nil) {
                    if (slot.path != nil) { strutil.str_free(w.alloc, slot.path); }
                    if (slot.text != nil) { strutil.str_free(w.alloc, slot.text); }
                    free_build_input(in);
                    ret nil;
                }
                in.doc_count = in.doc_count + 1;
                if (slot.belongs && d.revision > latest) { latest = d.revision; }
            }
            i = i + 1;
        }
        r.input_revision = latest;
        in.revision      = latest;
    }
    ret in;
}

fun free_build_input(in: *BuildInput) {
    if (in == nil) { ret; }
    val alloc: *Allocator = in.alloc;
    if (in.docs != nil) {
        var i: u32 = 0;
        for (i < in.doc_count) {
            if (in.docs[i].path != nil) { strutil.str_free(alloc, in.docs[i].path); }
            if (in.docs[i].text != nil) { strutil.str_free(alloc, in.docs[i].text); }
            i = i + 1;
        }
        # the array is sized by the document store's slot count, and doc_count
        # only counts the live ones, so the allocation length is not doc_count
        deallocate[DocSnapshot](alloc, in.docs, in.span);
    }
    if (in.root_path != nil) { strutil.str_free(alloc, in.root_path); }
    deallocate[BuildInput](alloc, in, 1);
}

# release a build result that was never installed
#
# `s` is borrowed from the Root and is deliberately not touched: an abandoned
# result leaves the spare Session exactly where it was, ready for the next build.
pub fun free_build_output(o: *BuildOutput) {
    if (o == nil) { ret; }
    val alloc: *Allocator = o.alloc;
    if (o.ok)               { driver.dnit_project(?o.p); }
    if (o.mod_paths != nil) { free_path_snapshot(alloc, o.mod_paths, o.mod_fingerprints, o.mod_path_count, o.mod_path_count); }
    if (o.message != nil)   { strutil.str_free(alloc, o.message); }
    deallocate[BuildOutput](alloc, o, 1);
}

# run one project analysis into a fresh Session
#
# This is the whole of what runs off the analysis thread. It reads its input and
# the filesystem, writes only into memory it allocated, and never touches the
# workspace, the document store, or the transport - a failure is carried back as
# text for the analysis thread to report, because the thread that may write to
# the client is not this one. The allocator is page-backed and stateless, so it
# is the one thing both threads may use at once.
fun run_build(arg: ptr) ptr {
    val in:    *BuildInput = arg::*BuildInput;
    val alloc: *Allocator  = in.alloc;

    val or_: res[*BuildOutput, allocator.Error] = allocate[BuildOutput](alloc, 1);
    if (sel or_.err) {
        free_build_input(in);
        ret nil;
    }
    val o: *BuildOutput = or_.ok;
    o.alloc            = alloc;
    o.ok               = false;
    o.s                = in.sn;
    o.mod_paths        = nil;
    o.mod_fingerprints = nil;
    o.mod_path_count   = 0;
    o.man_mtime        = 0;
    o.lock_mtime       = 0;
    o.revision         = in.revision;
    o.warmup           = in.warmup;
    o.message          = nil;

    if (o.s == nil) {
        o.message = dup_str(alloc, "project: no session to build into");
        free_build_input(in);
        ret (o)::ptr;
    }

    # the session being built into was serving until the last swap, so it still
    # holds that snapshot's Project and its overlay keys. Releasing them is the
    # worker's job precisely because it is real work on a big closure, and the
    # analysis thread is what this whole design exists to keep free.
    if (in.has_stale_p) { driver.dnit_project(?in.stale_p); }
    for (o.s.overlay_len > 0) { sess.clear_overlay(o.s, o.s.overlays[0].path); }

    stat_mtimes(alloc, in.root_path, ?o.man_mtime, ?o.lock_mtime);
    val started_ns: i64 = trace.now_ns();
    analyze_into(in, o);
    trace.logf("project: rebuilt {} in {}ms", in.root_path, (trace.now_ns() - started_ns) / 1000000);
    free_build_input(in);
    ret (o)::ptr;
}

# the analysis proper, split out so every failure path is one `ret` and the
# session and input cleanup stay with the caller
fun analyze_into(in: *BuildInput, o: *BuildOutput) {
    val alloc: *Allocator    = in.alloc;
    val sn:    *sess.Session = o.s;

    var i: u32 = 0;
    for (i < in.doc_count) {
        if (in.docs[i].belongs) {
            val sr: res[bool, str] = install_overlay(alloc, sn, in.docs[i].path, in.docs[i].text);
            if (sel sr.err) {
                o.message = dup_str(alloc, sr.err);
                ret;
            }
        }
        i = i + 1;
    }

    val mr: res[manifest.Manifest, outcome.Fail] = driver.load_manifest(sn, in.root_path);
    if (sel mr.err) {
        var mf: outcome.Fail = mr.err;
        o.message = dup_str(alloc, fail_message(?mf));
        ret;
    }
    var m: manifest.Manifest = mr.ok;

    var selection: manifest.Selection;
    selection.target       = "";
    selection.profile      = "";
    selection.artifact     = "";
    selection.want_lib     = false;
    selection.has_artifact = false;
    val psr: err[outcome.Fail] = manifest.select_primary_artifact(alloc, ?sn.interner, ?m, ?selection);
    if (sel psr.err) {
        var pf: outcome.Fail = psr.err;
        o.message = dup_str(alloc, fail_message(?pf));
        manifest.dnit(?m, sn.build_alloc);
        ret;
    }
    if (!selection.has_artifact && m.artifact_count == 1) {
        val ao: opt[str] = intern.lookup(?sn.interner, m.artifacts[0].name);
        if (sel ao.none) {
            manifest.dnit(?m, sn.build_alloc);
            o.message = dup_str(alloc, "project: artifact name is not interned");
            ret;
        }
        selection.artifact     = ao.some;
        selection.want_lib     = m.artifacts[0].is_lib;
        selection.has_artifact = true;
    }

    var cli: request.CliArgs                         = empty_cli();
    val rr:  res[request.BuildRequest, outcome.Fail] = request.compose(
        alloc, ?sn.interner, ?m, ?cli, in.root_path, request.GOAL_OBJECTS, ?selection);
    if (sel rr.err) {
        var f: outcome.Fail = rr.err;
        o.message = dup_str(alloc, fail_message(?f));
        manifest.dnit(?m, sn.build_alloc);
        ret;
    }
    var req: request.BuildRequest = rr.ok;

    var extra: *intern.StrId = nil;
    val ecr:   res[u32, str] = collect_extra_roots(in, sn, ?m, ?extra);
    if (sel ecr.err) {
        o.message = dup_str(alloc, ecr.err);
        vector.dnit[request.LinkToken](?req.link_tokens);
        vector.dnit[str](?req.lib_dirs);
        manifest.dnit(?m, sn.build_alloc);
        ret;
    }
    val extra_count: u32 = ecr.ok;
    # the tolerant entry point keeps the project through a rejected phase, so
    # the products behind the diagnostics stay readable while the user types
    val pr: res[driver.Project, outcome.Fail] = driver.analyze_project_tolerant(sn, ?m, ?req, extra, extra_count, driver.FRONTEND_SEMA);
    if (extra != nil) { deallocate[intern.StrId](alloc, extra, in.doc_count::usize); }
    vector.dnit[request.LinkToken](?req.link_tokens);
    vector.dnit[str](?req.lib_dirs);
    manifest.dnit(?m, sn.build_alloc);
    if (sel pr.err) {
        var f: outcome.Fail = pr.err;
        o.message = dup_str(alloc, fail_message(?f));
        ret;
    }

    o.p = pr.ok;
    val bpr: res[bool, str] = snapshot_mod_paths(alloc, sn, ?o.p, o);
    if (sel bpr.err) {
        driver.dnit_project(?o.p);
        o.message = dup_str(alloc, bpr.err);
        ret;
    }
    o.ok = true;
}

# install a finished build as `r`'s serving snapshot, releasing the old one.
# true when what clients see may have moved and diagnostics must republish
#
# The incoming Session replaces the outgoing one wholesale. Every identity a
# feature borrowed - Ast, SourceFile, Symbol, TypeId - belongs to the outgoing
# Session, which is why this may only run between messages: a request that has
# already returned holds nothing, and one that has not started has taken
# nothing.
fun apply_build(w: *Workspace, r: *Root, o: *BuildOutput) bool {
    r.attempted_revision = o.revision;
    r.man_mtime          = o.man_mtime;
    r.lock_mtime         = o.lock_mtime;

    if (!o.ok) {
        # the previous snapshot keeps serving; only the attempt is recorded. the
        # spare still ran the build, so its cache holds whatever the build reached
        # and warming it again would only fail the same way
        r.spare_primed = true;
        if (o.message != nil) { report_load_failure(w, r.path, o.message); }
        free_build_output(o);
        ret false;
    }

    # the outgoing Session becomes the spare and KEEPS its query cache. That
    # cache is the whole reason a rebuild costs a fraction of a cold build, and
    # building into a fresh session each time would discard it - measured on
    # this repo, a rebuild goes from ~7s to ~34s without it. Its Project rides
    # along to be released by the next build, on the worker.
    free_mod_paths(w, r);
    if (r.loaded) {
        r.spare_p     = r.p;
        r.spare_has_p = true;
    }
    # the outgoing Session is warm only if it was serving a snapshot. after the
    # first load it never ran a build, and `pump` warms it before an edit needs it
    r.spare_primed = r.loaded;
    r.spare        = r.s;

    r.s                 = o.s;
    r.p                 = o.p;
    r.loaded            = true;
    r.mod_paths         = o.mod_paths;
    r.mod_fingerprints  = o.mod_fingerprints;
    r.mod_path_count    = o.mod_path_count;
    r.snapshot_revision = o.revision;
    r.analyzed_once     = true;
    w.load_epoch        = w.load_epoch + 1;
    w.sema_epoch        = w.sema_epoch + 1;

    # the Project and the path snapshot moved into the Root; the Session was
    # only ever borrowed from it
    # a warm-up describes exactly what was already serving, so nothing a client
    # sees has moved and there is nothing to republish
    val moved: bool = !o.warmup;
    o.s         = nil;
    o.ok        = false;
    o.mod_paths = nil;
    deallocate[BuildOutput](w.alloc, o, 1);
    ret moved;
}

# build `r`'s first snapshot on this thread
#
# A root with no snapshot has nothing to serve, so there is no latency to hide:
# deferring the first build would only mean answering from a project that does
# not exist yet. This is also the only build that reports progress - a
# revalidation is short, and a spinner on every keystroke teaches the reader to
# ignore the one that means something.
fun try_load(w: *Workspace, r: *Root) bool {
    val started_ns: i64 = trace.now_ns();
    fin { trace.logf("project: analyzed {} in {}ms", r.path, (trace.now_ns() - started_ns) / 1000000); }

    var token: str = nil;
    if (!r.analyzed_once) { token = progress.start(w.alloc, "mach: analyzing project"); }
    fin { progress.finish(w.alloc, token, nil); }

    r.dirty = false;
    val in: *BuildInput = capture_input(w, r);
    if (in == nil) { ret false; }
    val out: ptr = run_build((in)::ptr);
    if (out == nil) { ret false; }
    ret apply_build(w, r, out::*BuildOutput);
}

# start `r`'s rebuild on the build worker, keeping the current snapshot serving
#
# Refused, harmlessly, when a build is already in flight: the root stays stale
# and `pump` schedules it again once the slot frees.
fun schedule_build(w: *Workspace, r: *Root, index: u32) bool {
    if (build.busy(?w.builder)) { ret false; }
    val warmup: bool = !snapshot_stale(r);
    r.dirty = false;
    val in: *BuildInput = capture_input(w, r);
    if (in == nil) { ret false; }
    in.warmup = warmup;
    if (!build.submit(?w.builder, (in)::ptr)) {
        free_build_input(in);
        ret false;
    }
    w.building      = true;
    w.building_root = index;
    if (warmup) { trace.logf("project: warming {} off the analysis thread", r.path); }
    or          { trace.logf("project: rebuilding {} off the analysis thread", r.path); }
    ret true;
}

# whether `r` should be built again
#
# `attempted_revision` is what stops a failing root from spinning. A build that
# failed still recorded the input it failed on, and rebuilding that same input
# would fail identically while holding the one build slot - starving every other
# root. So a retry waits for the input to actually move, or for `dirty`, which
# is how a disk change says the same input may now produce a different result.
fun snapshot_stale(r: *Root) bool {
    if (r.dirty)                                  { ret true; }
    if (r.input_revision == r.attempted_revision) { ret false; }
    if (!r.loaded)                                { ret true; }
    ret r.input_revision != r.snapshot_revision;
}

# what `pump` did, so the caller knows whether diagnostics moved
pub val PUMP_IDLE:    u8 = 0;
pub val PUMP_SWAPPED: u8 = 1;

# collect a finished rebuild and start the next one
#
# The analysis thread calls this at every message boundary and whenever the
# build worker signals. It is the only place a Root's Session changes, and it is
# by construction between messages, which is the whole safety argument for
# rebuilding off-thread.
#
# Coalescing lives here: a swap is immediately followed by at most one new build,
# and only when input actually advanced past what the finished one covered. A
# burst of edits during a build therefore costs one follow-up, not one per edit.
#
# With no root stale, the slot warms a root whose spare has never built. The
# first load builds only one of a root's two sessions, and without this the
# first edit's rebuild pays a whole cold build (#252). Stale roots go first,
# because an edit waiting on a warm-up is the latency this exists to remove, and
# no warm-up starts while input is queued: an edit already waiting would sit
# behind a whole cold build of text it has replaced, then pay its own rebuild.
# ---
# w:        the workspace
# may_warm: no input is queued, so an idle slot may warm a spare
# ret:      PUMP_SWAPPED when a snapshot changed and diagnostics must republish
pub fun pump(w: *Workspace, may_warm: bool) u8 {
    var moved: u8 = PUMP_IDLE;

    val done: ptr = build.take(?w.builder);
    if (done != nil) {
        val idx: u32 = w.building_root;
        w.building = false;
        if (idx < w.root_cap && w.roots[idx].path != nil) {
            if (apply_build(w, ?w.roots[idx], done::*BuildOutput)) { moved = PUMP_SWAPPED; }
        }
        or { free_build_output(done::*BuildOutput); }
    }
    or {
        # a run that produced nothing frees the slot without a result
        if (w.building && !build.busy(?w.builder)) { w.building = false; }
    }

    if (w.roots == nil || build.busy(?w.builder)) { ret moved; }
    var i: u32 = 0;
    for (i < w.root_cap) {
        val r: *Root = ?w.roots[i];
        if (r.path != nil && r.s != nil && r.loaded && snapshot_stale(r)) {
            if (schedule_build(w, r, i)) { ret moved; }
        }
        i = i + 1;
    }
    if (!may_warm) { ret moved; }
    i = 0;
    for (i < w.root_cap) {
        val r: *Root = ?w.roots[i];
        if (r.path != nil && r.s != nil && r.loaded && !r.spare_primed) {
            if (schedule_build(w, r, i)) { ret moved; }
        }
        i = i + 1;
    }
    ret moved;
}

fun empty_cli() request.CliArgs {
    var c: request.CliArgs;
    c.verbosity    = 0;
    c.quiet        = false;
    c.target       = nil;
    c.output       = nil;
    c.emit_asm     = false;
    c.emit_ir      = false;
    c.profile      = nil;
    c.bin          = nil;
    c.lib          = nil;
    c.all_targets  = false;
    c.pie          = false;
    c.subsystem    = nil;
    c.g            = false;
    c.opt_set      = false;
    c.opt_release  = false;
    c.jobs         = nil;
    c.include_deps = false;
    c.link_tokens  = vector.init[*u8](nil);
    c.lib_dirs     = vector.init[*u8](nil);
    ret c;
}

# install an open document under both its canonical path and the exact raw
# `<project root>/<manifest src>/<relative module>` spelling the compiler driver
# currently constructs. The second key covers `src = "./src"` in project and
# dependency manifests until Mach #2998 centralizes normalization upstream.
fun install_overlay(alloc: *Allocator, sn: *sess.Session, path: str, buffer: str) res[bool, str] {
    val nr: err[fail.Fail] = sess.set_overlay(sn, path, buffer);
    if (sel nr.err) { ret res[bool, str].err{fail.describe(nr.err)}; }
    val own: str = project_root_for(alloc, path);
    if (own == nil) { ret res[bool, str].ok{true}; }
    val mp_r: res[pathlib.Path, allocator.Error] = pathlib.join(alloc, own, "mach.toml");
    if (sel mp_r.err) {
        strutil.str_free(alloc, own);
        ret res[bool, str].err{outcome.alloc_text(mp_r.err)};
    }
    val mp:     str                  = mp_r.ok;
    val text_r: res[str, fs.FsError] = fs.read_string(alloc, mp);
    strutil.str_free(alloc, mp);
    if (sel text_r.err) {
        strutil.str_free(alloc, own);
        ret res[bool, str].err{outcome.fs_text(text_r.err)};
    }
    val text:    str                             = text_r.ok;
    val table_r: res[toml.Table, toml.TomlError] = toml.parse(alloc, text);
    strutil.str_free(alloc, text);
    if (sel table_r.err) {
        strutil.str_free(alloc, own);
        ret res[bool, str].err{"project: manifest is not valid toml"};
    }
    var table: toml.Table = table_r.ok;
    fin { toml.dnit(alloc, ?table); }
    val src_o: opt[str] = toml.get_str(?table, "project.src");
    if (sel src_o.none) {
        strutil.str_free(alloc, own);
        ret res[bool, str].ok{true};
    }
    val src_dir:   str                                = src_o.some;
    val raw_src_r: res[pathlib.Path, allocator.Error] = pathlib.join(alloc, own, src_dir);
    strutil.str_free(alloc, own);
    if (sel raw_src_r.err) { ret res[bool, str].err{outcome.alloc_text(raw_src_r.err)}; }
    val raw_src:  str = raw_src_r.ok;
    val src_norm: str = normalize_path(alloc, raw_src);
    if (src_norm == nil) {
        strutil.str_free(alloc, raw_src);
        ret res[bool, str].err{"project: failed to normalize document source directory"};
    }
    if (!is_under(path, src_norm) || str_len(path) <= str_len(src_norm)) {
        strutil.str_free(alloc, src_norm);
        strutil.str_free(alloc, raw_src);
        ret res[bool, str].ok{true};
    }
    val raw_path_r: res[pathlib.Path, allocator.Error] = pathlib.join(alloc, raw_src,
        (path::usize + str_len(src_norm) + 1)::str);
    strutil.str_free(alloc, src_norm);
    strutil.str_free(alloc, raw_src);
    if (sel raw_path_r.err) { ret res[bool, str].err{outcome.alloc_text(raw_path_r.err)}; }
    val raw_path: str            = raw_path_r.ok;
    val rr:       err[fail.Fail] = sess.set_overlay(sn, raw_path, buffer);
    var out:      res[bool, str] = res[bool, str].ok{true};
    if (sel rr.err) { out = res[bool, str].err{fail.describe(rr.err)}; }
    strutil.str_free(alloc, raw_path);
    ret out;
}

# build compiler-owned extra roots for open files under this project's source
# directory. files already in the artifact closure are harmless duplicates.
fun collect_extra_roots(in: *BuildInput, sn: *sess.Session, m: *manifest.Manifest, out: **intern.StrId) res[u32, str] {
    @out = nil;
    val alloc: *Allocator = in.alloc;
    val n:     usize      = in.doc_count::usize;
    if (n == 0) { ret res[u32, str].ok{0}; }
    val ar: res[*intern.StrId, allocator.Error] = allocate[intern.StrId](alloc, n);
    if (sel ar.err) { ret res[u32, str].err{outcome.alloc_text(ar.err)}; }
    val roots: *intern.StrId = ar.ok;

    val io: opt[str] = intern.lookup(?sn.interner, m.id);
    val so: opt[str] = intern.lookup(?sn.interner, m.src);
    if (sel io.none) {
        deallocate[intern.StrId](alloc, roots, n);
        ret res[u32, str].err{"project: manifest source path is not interned"};
    }
    if (sel so.none) {
        deallocate[intern.StrId](alloc, roots, n);
        ret res[u32, str].err{"project: manifest source path is not interned"};
    }
    val src_r: res[pathlib.Path, allocator.Error] = pathlib.join(alloc, in.root_path, so.some);
    if (sel src_r.err) {
        deallocate[intern.StrId](alloc, roots, n);
        ret res[u32, str].err{outcome.alloc_text(src_r.err)};
    }
    val src_norm: str = normalize_path(alloc, src_r.ok);
    strutil.str_free(alloc, src_r.ok);
    if (src_norm == nil) {
        deallocate[intern.StrId](alloc, roots, n);
        ret res[u32, str].err{"project: failed to normalize source directory"};
    }

    var count: u32   = 0;
    var i:     usize = 0;
    for (i < n) {
        val d: *DocSnapshot = ?in.docs[i::u32];
        if (d.own_root && is_under(d.path, src_norm)) {
            val fr: res[intern.StrId, str] = document_fqn(sn, io.some, src_norm, d.path);
            if (sel fr.err) {
                strutil.str_free(alloc, src_norm);
                deallocate[intern.StrId](alloc, roots, n);
                ret res[u32, str].err{fr.err};
            }
            roots[count] = fr.ok;
            count        = count + 1;
        }
        i = i + 1;
    }
    strutil.str_free(alloc, src_norm);
    if (count == 0) {
        deallocate[intern.StrId](alloc, roots, n);
        ret res[u32, str].ok{0};
    }
    @out = roots;
    ret res[u32, str].ok{count};
}

fun document_fqn(sn: *sess.Session, id_text: str, src_dir: str, path: str) res[intern.StrId, str] {
    val prefix: usize = str_len(src_dir);
    val plen:   usize = str_len(path);
    if (plen <= prefix + 6 || path[prefix] != '/') { ret res[intern.StrId, str].err{"project: document lies outside the source directory"}; }
    if (path[plen - 5] != '.' || path[plen - 4] != 'm' || path[plen - 3] != 'a'
        || path[plen - 2] != 'c' || path[plen - 1] != 'h') { ret res[intern.StrId, str].err{"project: document is not a Mach source file"}; }
    val rel_len: usize                     = plen - prefix - 1 - 5;
    val id_len:  usize                     = str_len(id_text);
    val total:   usize                     = id_len + 1 + rel_len;
    val br:      res[*u8, allocator.Error] = allocate[u8](sn.alloc, total);
    if (sel br.err) { ret res[intern.StrId, str].err{outcome.alloc_text(br.err)}; }
    val buf: *u8   = br.ok;
    var i:   usize = 0;
    for (i < id_len) {
        buf[i] = id_text[i];
        i      = i + 1;
    }
    buf[id_len] = '.';
    var j: usize = 0;
    for (j < rel_len) {
        val c: u8 = path[prefix + 1 + j];
        if (c == '/') { buf[id_len + 1 + j] = '.'; }
        or            { buf[id_len + 1 + j] = c; }
        j = j + 1;
    }
    val ir: res[intern.StrId, allocator.Error] = intern.intern_bytes(?sn.interner, buf::str, total);
    deallocate[u8](sn.alloc, buf, total);
    if (sel ir.err) { ret res[intern.StrId, str].err{outcome.alloc_text(ir.err)}; }
    ret res[intern.StrId, str].ok{ir.ok};
}

# snapshot every loaded module's normalized source path into
# `r.mod_paths`, indexed by module id, so the per-request uri -> module lookups
# are allocation-free string compares. replacement is transactional: a failed
# allocation or normalization rejects the new Project and preserves the last
# successful path/fingerprint set for disk-change retry detection.
fun snapshot_mod_paths(alloc: *Allocator, sn: *sess.Session, pr: *driver.Project, o: *BuildOutput) res[bool, str] {
    val n: u32 = pr.module_len;
    if (n == 0) { ret res[bool, str].ok{true}; }
    val arr_r: res[*str, allocator.Error] = allocate[str](alloc, n::usize);
    if (sel arr_r.err) { ret res[bool, str].err{outcome.alloc_text(arr_r.err)}; }
    val mt_r: res[*SourceFingerprint, allocator.Error] = allocate[SourceFingerprint](alloc, n::usize);
    if (sel mt_r.err) {
        deallocate[str](alloc, arr_r.ok, n::usize);
        ret res[bool, str].err{outcome.alloc_text(mt_r.err)};
    }
    val paths:        *str               = arr_r.ok;
    val fingerprints: *SourceFingerprint = mt_r.ok;

    var i: u32 = 0;
    for (i < n) {
        paths[i]              = nil;
        fingerprints[i].mtime = 0;
        fingerprints[i].size  = 0;
        val fo: opt[*src.SourceFile] = src.get(?sn.sources, (?pr.modules[i]).file_id);
        if (sel fo.none) {
            free_path_snapshot(alloc, paths, fingerprints, n, i);
            ret res[bool, str].err{"project: loaded module source is unavailable"};
        }
        paths[i] = normalize_path(alloc, fo.some.path);
        if (paths[i] == nil) {
            free_path_snapshot(alloc, paths, fingerprints, n, i);
            ret res[bool, str].err{"project: failed to normalize loaded module path"};
        }
        fingerprints[i] = verified_fingerprint(alloc, sn, fo.some, paths[i]);
        i               = i + 1;
    }
    o.mod_paths        = paths;
    o.mod_fingerprints = fingerprints;
    o.mod_path_count   = n;
    ret res[bool, str].ok{true};
}

fun free_path_snapshot(alloc: *Allocator, paths: *str, fingerprints: *SourceFingerprint, cap: u32, initialized: u32) {
    var i: u32 = 0;
    for (i < initialized) {
        if (paths[i] != nil) { strutil.str_free(alloc, paths[i]); }
        i = i + 1;
    }
    deallocate[str](alloc, paths, cap::usize);
    deallocate[SourceFingerprint](alloc, fingerprints, cap::usize);
}

# release the per-module normalized path snapshot
fun free_mod_paths(w: *Workspace, r: *Root) {
    if (r.mod_paths == nil) { ret; }
    free_path_snapshot(w.alloc, r.mod_paths, r.mod_fingerprints, r.mod_path_count, r.mod_path_count);
    r.mod_paths        = nil;
    r.mod_fingerprints = nil;
    r.mod_path_count   = 0;
}

# mark `r` stale when its manifest or lockfile changed on
# disk since the last load attempt - the conservative fallback for clients that
# do not deliver `workspace/didChangeWatchedFiles`, and the retry path for a
# root whose previous load failed. watcher delivery improves latency but does
# not disable this correctness fallback. a no-op when nothing changed.
#
# Marking, not rebuilding: this runs on the analysis thread inside a request,
# and `refresh_inputs` is what decides whether the rebuild it implies can go
# off-thread.
fun maybe_reload(w: *Workspace, r: *Root) {
    val clock: chrono.Clock = chrono.monotonic();
    if (sel clock.err) { ret; }
    val now: i64 = chrono.time_unix_nsec(clock.ok);
    if (!r.dirty && r.last_disk_scan_ns != 0 && now - r.last_disk_scan_ns < 250000000) { ret; }
    r.last_disk_scan_ns = now;
    var man:  i64 = 0;
    var lock: i64 = 0;
    stat_mtimes(w.alloc, r.path, ?man, ?lock);
    var changed: bool = man != r.man_mtime || lock != r.lock_mtime;
    var i:       u32  = 0;
    for (!changed && i < r.mod_path_count) {
        if (r.mod_paths[i] != nil
            && !fingerprint_matches(r.mod_paths[i], ?r.mod_fingerprints[i])) { changed = true; }
        i = i + 1;
    }
    if (!changed) { ret; }
    r.dirty = true;
}

# bring `r`'s snapshot up to date with its input
#
# A root with a snapshot never blocks here: the rebuild is handed to the build
# worker and the existing snapshot answers this request, one revision behind.
# That staleness is bounded by one build and resolved by `pump`, and it is the
# whole point - the alternative is the request waiting seconds for a snapshot
# the next keystroke would invalidate anyway.
#
# A root with no snapshot has nothing to answer from, so its build runs inline.
fun refresh_inputs(w: *Workspace, r: *Root) res[bool, str] {
    if (!snapshot_stale(r)) { ret res[bool, str].ok{r.loaded}; }
    if (r.loaded) {
        schedule_build(w, r, root_index(w, r));
        ret res[bool, str].ok{true};
    }
    try_load(w, r);
    ret res[bool, str].ok{r.loaded};
}

# a root's slot index, or root_cap when it is not one of ours
fun root_index(w: *Workspace, r: *Root) u32 {
    var i: u32 = 0;
    for (i < w.root_cap) {
        if (?w.roots[i] == r) { ret i; }
        i = i + 1;
    }
    ret w.root_cap;
}

# mirror a changed document into every already-tracked root it belongs to and
# mark those snapshots stale. a not-yet-tracked root picks it up during load.
pub fun document_changed(w: *Workspace, d: *documents.Document) res[bool, str] {
    if (d == nil || d.path == nil || w.roots == nil) { ret res[bool, str].ok{true}; }
    var i: u32 = 0;
    for (i < w.root_cap) {
        val r: *Root = ?w.roots[i];
        if (r.path != nil && r.s != nil && document_belongs(w, r, d.path)) {
            r.input_revision = d.revision;
        }
        i = i + 1;
    }
    ret res[bool, str].ok{true};
}

# remove a closing document's compiler overlays before its owned text is freed.
# the next request rebuilds affected snapshots from disk.
pub fun document_closed(w: *Workspace, d: *documents.Document) {
    if (d == nil || d.path == nil || w.roots == nil) { ret; }
    var i: u32 = 0;
    for (i < w.root_cap) {
        val r: *Root = ?w.roots[i];
        if (r.path != nil && r.s != nil && document_belongs(w, r, d.path)) {
            sess.clear_overlay(r.s, d.path);
            r.input_revision = d.revision;
        }
        i = i + 1;
    }
}

# drop every loaded root whose tree contains the changed file, so
# the next request rebuilds it from disk. the LSP trigger is
# `workspace/didChangeWatchedFiles`; a changed `mach.toml` / `mach.lock` or any
# source under a root (including a vendored dependency under `dep/`) invalidates
# that root. each dropped root's cached results are evicted per-root by free_root
# ---
# w:   the workspace
# uri: the URI of the changed file
pub fun invalidate_uri(w: *Workspace, uri: str) {
    if (uri == nil || w.roots == nil) { ret; }
    val norm: str = uri_to_norm(w.alloc, uri);
    if (norm == nil) { ret; }

    var i: u32 = 0;
    for (i < w.root_cap) {
        val r: *Root = ?w.roots[i];
        if (r.path != nil && (root_covers(w, norm, r.path)
            || has_module_for_norm(module_for_norm(r, norm)))) {
            # the snapshot is kept, not dropped: it is what answers requests
            # until the rebuild this schedules has actually produced a
            # replacement, and a root left with nothing serves nothing
            r.man_mtime  = 0 - 1;
            r.lock_mtime = 0 - 1;
            r.dirty      = true;
        }
        i = i + 1;
    }
    strutil.str_free(w.alloc, norm);
}

# whether `file_norm` (a normalized absolute path) lies within the
# project rooted at `root_path` - equal to it or under it
fun root_covers(w: *Workspace, file_norm: str, root_path: str) bool {
    if (root_path == nil) { ret false; }
    val rn: str = normalize_path(w.alloc, root_path);
    if (rn == nil) { ret false; }
    val covered: bool = is_under(file_norm, rn);
    strutil.str_free(w.alloc, rn);
    ret covered;
}

# whether `file` equals `dir` or is a path beneath it
fun is_under(file: str, dir: str) bool {
    val dl: usize = str_len(dir);
    val fl: usize = str_len(file);
    if (fl < dl || !str_starts_with(file, dir)) { ret false; }
    if (fl == dl)                               { ret true; }
    ret file[dl] == '/';
}

fun document_own_root(w: *Workspace, r: *Root, path: str) bool {
    val own: str = project_root_for(w.alloc, path);
    if (own == nil) { ret false; }
    val matches: bool = str_equals(own, r.path);
    strutil.str_free(w.alloc, own);
    ret matches;
}

fun document_belongs(w: *Workspace, r: *Root, path: str) bool {
    val own: str = project_root_for(w.alloc, path);
    if (own != nil && str_equals(own, r.path)) {
        strutil.str_free(w.alloc, own);
        ret true;
    }
    if (has_module_for_norm(module_for_norm(r, path))) {
        if (own != nil) { strutil.str_free(w.alloc, own); }
        ret true;
    }
    # Before the first successful graph there are no retained module paths to
    # identify an open vendored dependency. Its declaring ancestor is the only
    # additional root allowed to mirror it; unrelated nested projects remain
    # isolated.
    var vendored: bool = false;
    if (own != nil && r.mod_path_count == 0) { vendored = vendors_enclosing(w, r.path, own); }
    if (own != nil)                          { strutil.str_free(w.alloc, own); }
    ret vendored;
}

# whether `d` is mirrored into `r`'s session, and so shares its snapshot
#
# Diagnostics for a document can only move when the root that analyzes it is
# rebuilt, so this is the republish set after a change: the documents a root
# actually governs, not every open buffer in the session.
# ---
# w:   the workspace
# r:   the root to test against, or nil
# d:   the open document
# ret: true when `r` governs `d`
pub fun root_covers_document(w: *Workspace, r: *Root, d: *documents.Document) bool {
    if (r == nil || d == nil || d.path == nil || r.path == nil || r.s == nil) { ret false; }
    ret document_belongs(w, r, d.path);
}

# release a root's retained Project, source index, Session, and owned path
fun free_root(w: *Workspace, r: *Root) {
    free_root_graph(w, r);
    free_mod_paths(w, r);
    if (r.spare_has_p) {
        driver.dnit_project(?r.spare_p);
        r.spare_has_p = false;
    }
    free_session(w.alloc, r.s);
    free_session(w.alloc, r.spare);
    r.s     = nil;
    r.spare = nil;
    if (r.path != nil) { strutil.str_free(w.alloc, r.path); }
    reset_slot(r);
}

# release the retained Project while preserving the root, Session, and last
# successful source index so a failed rebuild can detect a later disk repair
fun free_root_graph(w: *Workspace, r: *Root) {
    if (r.loaded) {
        driver.dnit_project(?r.p);
        r.loaded = false;
    }
}

# snapshot the root's manifest / lockfile mtimes for the
# conservative reload check
fun record_mtimes(w: *Workspace, r: *Root) {
    stat_mtimes(w.alloc, r.path, ?r.man_mtime, ?r.lock_mtime);
}

# write the mtimes of `<root_path>/mach.toml` and
# `<root_path>/mach.lock` (0 when absent) into `man` / `lock`
fun stat_mtimes(alloc: *Allocator, root_path: str, man: *i64, lock: *i64) {
    @man  = join_mtime(alloc, root_path, "mach.toml");
    @lock = join_mtime(alloc, root_path, "mach.lock");
}

# the mtime of `<dir>/<name>` in unix nanoseconds, or 0 when the file is
# absent or cannot be joined. nanosecond resolution matters: the check is an
# equality test, and a save followed immediately by a request lands inside the
# same second
fun join_mtime(alloc: *Allocator, dir: str, name: str) i64 {
    val jr: res[pathlib.Path, allocator.Error] = pathlib.join(alloc, dir, name);
    if (sel jr.err) { ret 0; }
    val p:    str                              = jr.ok;
    var m:    i64                              = 0;
    val fi_r: res[fs.Metadata, io_error.Error] = fs.metadata(p);
    if (sel fi_r.ok) {
        var fi: fs.Metadata = fi_r.ok;
        m = chrono.time_unix_nsec(fi.modified);
    }
    strutil.str_free(alloc, p);
    ret m;
}

# the `(mtime, size)` of `path`, zeroed when it is absent or unreadable
# ---
# path: absolute source path to stat
# ret:  the file's stat fingerprint
fun file_fingerprint(path: str) SourceFingerprint {
    var fp: SourceFingerprint;
    fp.mtime = 0;
    fp.size  = 0;
    val fi_r: res[fs.Metadata, io_error.Error] = fs.metadata(path);
    if (sel fi_r.err) { ret fp; }
    var fi: fs.Metadata = fi_r.ok;
    fp.mtime = chrono.time_unix_nsec(fi.modified);
    fp.size  = fi.size;
    ret fp;
}

# a fingerprint no stat produces, so the next scan always reports a change
fun unknown_fingerprint() SourceFingerprint {
    var fp: SourceFingerprint;
    fp.mtime = -1;
    fp.size  = ~(0::usize);
    ret fp;
}

# the on-disk fingerprint of `path`, provided the file still holds exactly the
# text the build analyzed
#
# A fingerprint taken after the build can describe bytes written after the
# compiler read the file. Recorded as-is, that change would read as the
# snapshot's own and never be rebuilt. So the stat comes first and the file is
# then compared with what was analyzed, through the same read the loader uses: a
# write that landed in between is a mismatch, recorded as unknown so the next
# scan rebuilds it. An open document is analyzed from its overlay, whose bytes
# the disk is not expected to hold, and is not compared.
fun verified_fingerprint(alloc: *Allocator, sn: *sess.Session, file: *src.SourceFile, path: str) SourceFingerprint {
    val fp: SourceFingerprint = file_fingerprint(path);
    val ov: opt[str]          = sess.overlay_get(sn, file.path);
    if (sel ov.some) { ret fp; }
    val tr:   res[str, fs.FsError] = fs.read_string(alloc, path);
    var same: bool                 = false;
    if (sel tr.ok) {
        same = str_equals(tr.ok, file.text);
        strutil.str_free(alloc, tr.ok);
    }
    if (same) { ret fp; }
    ret unknown_fingerprint();
}

# whether `path` still matches the fingerprint recorded in `prev`
#
# `prev` is refreshed on a mismatch so one disk change triggers one rebuild
# rather than one per scan until the snapshot is replaced.
# ---
# path: absolute source path to check
# prev: recorded fingerprint, updated in place on a mismatch
# ret:  true when the file looks unchanged
fun fingerprint_matches(path: str, prev: *SourceFingerprint) bool {
    val now: SourceFingerprint = file_fingerprint(path);
    if (now.mtime == prev.mtime && now.size == prev.size) { ret true; }
    @prev = now;
    ret false;
}

# where symbol `sym` is declared, as an Ast / SourceFile / URI triple.
# a buffer-local symbol (origin equals the buffer's module) reports against the
# request buffer; a cross-module symbol reports against the defining dependency
# module's on-disk file, read from `root`'s own project module array (whose ids
# are private to that root), with a freshly built `file://` URI the caller must
# free (see `free_site`). none when there is no project, or the defining module
# cannot be located
# ---
# w:     the workspace
# root:  the root the buffer resolved against, or nil
# own:   the buffer's own module id
# own_a: the buffer's Ast
# own_file:the buffer's SourceFile
# uri: the request document's URI
# sym: the symbol whose declaration site is wanted
# ret: some(Site), or none when the defining module cannot be located
pub fun site_of(w: *Workspace, root: *Root, own: sess.ModuleId, own_a: *ast.Ast, own_file: *src.SourceFile, uri: str, sym: *rslv.Symbol) opt[Site] {
    if (sym.origin == own) {
        var s: Site;
        s.a     = own_a;
        s.text  = positions.text_of(own_file);
        s.uri   = uri;
        s.sym   = sym;
        s.owned = false;
        ret opt[Site].some{s};
    }

    val m: *driver.ModuleEntry = module_entry(root, sym.origin);
    if (m == nil) { ret opt[Site].none{}; }
    val fo: opt[*src.SourceFile] = src.get(?root.s.sources, m.file_id);
    if (sel fo.none) { ret opt[Site].none{}; }
    val local: *rslv.Symbol = defining_symbol(m.resolve_result, sym);
    if (local == nil) { ret opt[Site].none{}; }

    val furi: str = module_uri(w, root, sym.origin);
    if (furi == nil) { ret opt[Site].none{}; }

    var s: Site;
    s.a     = m.a;
    s.text  = positions.text_of(fo.some);
    s.uri   = furi;
    s.sym   = local;
    s.owned = true;
    ret opt[Site].some{s};
}

# the defining module's own symbol for `sym`. a `use` or `fwd` binding names
# its definition by canonical name and kind and carries no DeclId of its own
# (a `use` binding is SYM_IMPORTED over `definition_kind`, a `fwd` binding
# carries the definition's kind directly); the origin module's table holds
# the declaration-bearing symbol
# ---
# rr:  the origin module's resolve result
# sym: a symbol whose origin is that module
# ret: the local symbol, `sym` itself when it already carries its declaration, or nil
fun defining_symbol(rr: *rslv.ResolveResult, sym: *rslv.Symbol) *rslv.Symbol {
    if (sym.decl != id.DECL_NIL) { ret sym; }
    if (rr == nil)               { ret nil; }
    var kind: rslv.SymKind = sym.kind;
    if (kind == rslv.SYM_IMPORTED) { kind = sym.definition_kind; }
    var i: u32 = 0;
    for (i < rr.symbol_count) {
        val cand: *rslv.Symbol = ?rr.symbols[i];
        if (cand.kind == kind && cand.canon == sym.canon
            && cand.origin == sym.origin && cand.decl != id.DECL_NIL) { ret cand; }
        i = i + 1;
    }
    ret nil;
}

# loaded module `mid`'s entry in `root`, or nil when there is no
# loaded project or the id is out of range
# the loaded module whose source is `file`, or none
fun module_for_file(root: *Root, file: src.FileId) opt[sess.ModuleId] {
    if (root == nil || !root.loaded) { ret opt[sess.ModuleId].none{}; }
    var i: u32 = 0;
    for (i < root.p.module_len) {
        if (root.p.modules[i].file_id == file) { ret opt[sess.ModuleId].some{i::sess.ModuleId}; }
        i = i + 1;
    }
    ret opt[sess.ModuleId].none{};
}

fun module_entry(root: *Root, mid: sess.ModuleId) *driver.ModuleEntry {
    if (root == nil || !root.loaded || mid::u32 >= root.p.module_len) { ret nil; }
    ret ?root.p.modules[mid::u32];
}

# release a Site's URI when it owns one
# ---
# w:    the workspace
# site: the site to release
pub fun free_site(w: *Workspace, site: *Site) {
    if (site.owned && site.uri != nil) { strutil.str_free(w.alloc, site.uri); }
    site.uri   = nil;
    site.owned = false;
}

# a borrowed view of one loaded module for the workspace-wide
# use-site walk - its parsed Ast, resolve side tables, and backing source file
# ---
# a:       the module's parsed Ast (decl / expr / type ids index into it)
# rr:      the module's ResolveResult side tables
# sr:      the module's SemaResult, or nil when its sema did not run
# text:    the SourceFile backing `a`, paired with its length (positions, span text)
# file_id: FileId of that source file, the identity a nominal type names
pub rec ModuleView {
    a:       *ast.Ast;
    rr:      *rslv.ResolveResult;
    sr:      *sema.SemaResult;
    text:    positions.Text;
    file_id: src.FileId;
}

# compiler-owned snapshot of one open document.
pub rec DocumentView {
    root:     *Root;
    module:   sess.ModuleId;
    a:        *ast.Ast;
    rr:       *rslv.ResolveResult;
    sr:       *sema.SemaResult;
    text:     positions.Text;
    interner: *intern.Interner;
    revision: u64;
    file_id:  src.FileId;
}

# analyze through the retained project containing `d` and return its exact
# ModuleEntry. THIS DOCUMENT's revision against the snapshot is the staleness
# boundary.
#
# A snapshot built before `d`'s current text describes EARLIER text, so every
# offset in it is measured against a document the client no longer has. Callers
# answer that by falling back to editor analysis of the live buffer - current
# positions, no cross-module reach - the same degradation they already accept
# before a root's first build finishes.
#
# The test is per document, not per root, and that distinction is load-bearing
# rather than merely tighter. A root-wide test says "stale" whenever ANY covered
# buffer has moved, including when the move was a rebuild that FAILED: the
# attempt is recorded, the snapshot revision is not, and the root is then
# permanently stale with nothing left to schedule - every cross-module feature
# dead until some unrelated edit happens to succeed. Keyed on the document, a
# failed rebuild leaves every buffer the last good snapshot still describes
# exactly where it was, which is what "a failure keeps serving" has to mean.
pub fun document_view(w: *Workspace, d: *documents.Document) res[DocumentView, str] {
    val root: *Root = root_for(w, d.uri);
    if (root == nil || !root.loaded) { ret res[DocumentView, str].err{"project: document has no compiler project"}; }
    if (d.revision > root.snapshot_revision) {
        ret res[DocumentView, str].err{"project: document snapshot is stale"};
    }
    ret view_from_root(root, d);
}

# return a document view only when an already-loaded project captured its latest
# input; this never loads, rebuilds, or runs sema and is safe on notifications
# ---
# w:   workspace containing retained roots
# d:   live document
# ret: current compiler view, or an error requiring fallback diagnostics
pub fun document_view_loaded(w: *Workspace, d: *documents.Document) res[DocumentView, str] {
    val root: *Root = root_for_loaded(w, d.uri);
    if (root == nil || !root.loaded || d.revision > root.snapshot_revision) {
        ret res[DocumentView, str].err{"project: no current loaded snapshot"};
    }
    ret view_from_root(root, d);
}

fun view_from_root(root: *Root, d: *documents.Document) res[DocumentView, str] {
    val mo: opt[sess.ModuleId] = module_for_norm(root, d.path);
    if (sel mo.none) { ret res[DocumentView, str].err{"project: document module was not loaded"}; }
    val mid: sess.ModuleId       = mo.some;
    val m:   *driver.ModuleEntry = module_entry(root, mid);
    # a module whose own parse was rejected carries its tree and resolve result
    # but no sema product; the view says so through a nil `sr` rather than
    # falling back to single-buffer analysis
    if (m == nil || m.a == nil || m.resolve_result == nil) {
        ret res[DocumentView, str].err{"project: document analysis unavailable"};
    }
    val fo: opt[*src.SourceFile] = src.get(?root.s.sources, m.file_id);
    if (sel fo.none) { ret res[DocumentView, str].err{"project: document source unavailable"}; }
    var v: DocumentView;
    v.root     = root;
    v.module   = mid;
    v.a        = m.a;
    v.rr       = m.resolve_result;
    v.sr       = m.sema_result;
    v.text     = positions.text_of(fo.some);
    v.interner = ?root.s.interner;
    v.revision = root.snapshot_revision;
    v.file_id  = m.file_id;
    ret res[DocumentView, str].ok{v};
}

# the number of loaded modules in `root`, or 0 when root is nil /
# not loaded. the workspace-wide references / rename walk iterates [0, count)
# ---
# root: the root governing the request, or nil
# ret:  the loaded module count
pub fun module_count(root: *Root) u32 {
    if (root == nil || !root.loaded) { ret 0; }
    ret root.p.module_len;
}

# a borrowed view of loaded module `mid` in `root` for the use-site
# walk, or none when there is no project, the id is out of range, the module did
# not resolve, or its source is missing. the returned pointers are owned by the
# loaded project / session
# ---
# w:    the workspace
# root: the root governing the request, or nil
# mid:  a loaded module id in [0, module_count)
# ret:  some(ModuleView), or none
pub fun module_view(w: *Workspace, root: *Root, mid: sess.ModuleId) opt[ModuleView] {
    val m: *driver.ModuleEntry = module_entry(root, mid);
    if (m == nil || !m.resolved) { ret opt[ModuleView].none{}; }
    val fo: opt[*src.SourceFile] = src.get(?root.s.sources, m.file_id);
    if (sel fo.none) { ret opt[ModuleView].none{}; }
    var v: ModuleView;
    v.a       = m.a;
    v.rr      = m.resolve_result;
    v.sr      = m.sema_result;
    v.text    = positions.text_of(fo.some);
    v.file_id = m.file_id;
    ret opt[ModuleView].some{v};
}

# the semantic type of expression `eid` in SemaResult `sr`, or TYPE_NIL
# when `sr` is nil or `eid` is out of range. the narrow read the feature layer
# makes to learn an expression's type - handed a retained SemaResult, never the
# session. delegates to the pure helper so the rule lives
# in one unit-testable place
# ---
# sr:  a buffer's / module's SemaResult, or nil
# eid: the expression id to type
# ret: the expression's TypeId, or TYPE_NIL
pub fun type_of(sr: *sema.SemaResult, eid: id.ExprId) type.TypeId {
    ret mtypes.type_of(sr, eid);
}

# the declared (or inferred) type of decl `did` in SemaResult `sr`,
# or TYPE_NIL when unavailable. the decl-keyed twin of `type_of`
# ---
# sr:  a buffer's / module's SemaResult, or nil
# did: the declaration id to type
# ret: the declaration's TypeId, or TYPE_NIL
pub fun decl_type_of(sr: *sema.SemaResult, did: id.DeclId) type.TypeId {
    ret mtypes.decl_type_of(sr, did);
}

# the semantic type a written Ast type node denotes, or TYPE_NIL when
# unavailable. the type-position twin of `type_of`, for a cursor sitting on a
# type annotation rather than on a value
# ---
# sr:  a buffer's / module's SemaResult, or nil
# tid: the Ast type id to resolve
# ret: the written type's TypeId, or TYPE_NIL
pub fun type_ref_of(sr: *sema.SemaResult, tid: id.TypeId) type.TypeId {
    ret mtypes.type_ref_of(sr, tid);
}

# the nominal back-link from a record / union TypeId to its declaring
# site - what a field go-to-def / rename follows from a value's type to the `rec` /
# `uni` declaration whose fields it must walk. carries the field range (uniform
# across rec / uni, both being TypedName slices in `a.typed_names`) and the
# module's Ast / source so field spans can be read directly
# ---
# origin:       ModuleId of the declaring module
# decl:         DeclId of the rec / uni declaration in `origin`'s Ast
# a:            the declaring module's parsed Ast (field spans index into it)
# text:         SourceFile backing `a`, paired with its length
# fields_start: start index into `a.typed_names` of the first field
# fields_len:   number of fields (record fields / union variants)
# is_rec:       true for a record, false for a union
pub rec RecordSite {
    origin:       sess.ModuleId;
    decl:         id.DeclId;
    file:         src.FileId;
    name:         intern.StrId;
    name_span:    token.Span;
    a:            *ast.Ast;
    text:         positions.Text;
    fields_start: u32;
    fields_len:   u32;
    is_rec:       bool;
}

# the declaring site a record / union TypeId nominally refers to,
# resolved against the session's type interner and the root's loaded module array -
# the nominal back-link field features follow. peels a pointer to its pointee and
# maps a generic instance to its template. none when `tid` is not a nominal type,
# the declaring module is not a loaded project module, or the declaration is not a
# rec / uni. the returned Ast / file pointers are owned by the loaded project /
# session. a record declared in the active buffer (whose synthetic module id is not
# in the loaded array) is not found here - use `record_decl_in`, which falls back to
# the buffer's live Ast for that case
# ---
# w:    the workspace
# root: the root the type was resolved under, or nil
# tid:  a TypeId, typically read from a SemaResult via `type_of`
# ret:  some(RecordSite), or none
pub fun record_decl(w: *Workspace, root: *Root, tid: type.TypeId) opt[RecordSite] {
    val no: opt[mtypes.Nominal] = nominal_of_tid(w, root, tid);
    if (sel no.none) { ret opt[RecordSite].none{}; }
    val n: mtypes.Nominal = no.some;

    val mid: opt[sess.ModuleId] = module_for_file(root, n.file);
    if (sel mid.none) { ret opt[RecordSite].none{}; }
    val m: *driver.ModuleEntry = module_entry(root, mid.some);
    if (m == nil) { ret opt[RecordSite].none{}; }
    val fo: opt[*src.SourceFile] = src.get(?root.s.sources, m.file_id);
    if (sel fo.none) { ret opt[RecordSite].none{}; }
    val decl: opt[id.DeclId] = mtypes.nominal_decl(m.a, positions.text_of(fo.some), ?root.s.interner, n);
    if (sel decl.none) { ret opt[RecordSite].none{}; }
    ret record_site_from(mid.some, decl.some, m.file_id, n.name, m.a, fo.some);
}

# `record_decl` extended to resolve a record / union declared in
# the active buffer. a buffer's own nominal type is interned under its synthetic
# module id (`own`), which is not in the loaded module array, so `record_decl`
# alone would miss a field access on a record the edited buffer itself declares.
# when the nominal's origin is `own`, the declaration is read from the buffer's
# live Ast / file (`own_a` / `own_file`); otherwise it defers to a loaded module
# ---
# w:        the workspace
# root:     the root the type was resolved under, or nil
# own:      the buffer's own module id
# own_a:    the buffer's live Ast
# own_file: the buffer's SourceFile
# tid:      a TypeId, typically read from a SemaResult via `type_of`
# ret:      some(RecordSite), or none
pub fun record_decl_in(w: *Workspace, root: *Root, own: sess.ModuleId, own_fid: src.FileId, own_a: *ast.Ast, own_file: *src.SourceFile, tid: type.TypeId) opt[RecordSite] {
    val no: opt[mtypes.Nominal] = nominal_of_tid(w, root, tid);
    if (sel no.none) { ret opt[RecordSite].none{}; }
    val n: mtypes.Nominal = no.some;
    if (own_file != nil && n.file == own_fid) {
        val decl: opt[id.DeclId] = mtypes.nominal_decl(own_a, positions.text_of(own_file), interner(w, root), n);
        if (sel decl.none) { ret opt[RecordSite].none{}; }
        ret record_site_from(own, decl.some, own_fid, n.name, own_a, own_file);
    }
    ret record_decl(w, root, tid);
}

# a RecordSite for the rec / uni declaration `decl` in the active
# buffer (`own` / `own_a` / `own_file`), or none when `decl` is not a rec / uni.
# the buffer-side entry point for a cursor sitting on a field's own declaration
# name: the decl is in the buffer being edited, so its Ast / file are the live
# ones. the resulting site carries the declaring file and the interned record
# name, the identity every other module's references are matched against
# ---
# itn:      the interner the session's nominal types name records in
# alloc:    scratch allocator for the name copy handed to the interner
# own:      the buffer's own module id
# own_fid:  the buffer's own FileId
# own_a:    the buffer's live Ast
# own_file: the buffer's SourceFile
# decl:     the rec / uni DeclId in the buffer
# ret:      some(RecordSite), or none
pub fun record_site_at(itn: *intern.Interner, alloc: *Allocator, own: sess.ModuleId, own_fid: src.FileId, own_a: *ast.Ast, own_file: *src.SourceFile, decl: id.DeclId) opt[RecordSite] {
    if (decl == id.DECL_NIL) { ret opt[RecordSite].none{}; }
    val site: opt[RecordSite] = record_site_from(own, decl, own_fid, intern.STR_NIL, own_a, own_file);
    if (sel site.none) { ret site; }
    var rs:   RecordSite = site.some;
    val text: str        = positions.span_text(rs.text, rs.name_span, alloc);
    if (text == nil) { ret opt[RecordSite].none{}; }
    val ir: res[intern.StrId, allocator.Error] = intern.intern(itn, text);
    strutil.str_free(alloc, text);
    if (sel ir.err) { ret opt[RecordSite].none{}; }
    rs.name = ir.ok;
    ret opt[RecordSite].some{rs};
}

# the declaring site of a nominal type, whatever kind declares it
# ---
# origin:    ModuleId of the declaring module
# decl:      DeclId of the rec / uni / tag declaration in `origin`'s Ast
# file:      FileId of the declaring source file
# name_span: byte span of the declared type name in `text`
# a:         the declaring module's parsed Ast
# text:      SourceFile backing `a`, paired with its length
# kind:      the declaration kind that named the type
pub rec TypeSite {
    origin:    sess.ModuleId;
    decl:      id.DeclId;
    file:      src.FileId;
    name_span: token.Span;
    a:         *ast.Ast;
    text:      positions.Text;
    kind:      adecl.DeclKind;
}

# the declaring site of a nominal TypeId, whatever its declaration
# kind - the back-link `textDocument/typeDefinition` follows from a value to the
# declaration that names its type
#
# `RecordSite` answers the narrower question a field feature asks (where are this
# type's fields), so it admits rec / uni only. A type reference carries no such
# restriction, and a `tag` is the type of every `opt` and `res` a cursor can land
# on, so reusing RecordSite here would answer null for the most common types in
# the language. A pointer is peeled and a generic instance maps to its template,
# both through `nominal_of`.
#
# A type declared in the active buffer is interned under the buffer's synthetic
# module id, which is not in the loaded module array, so the buffer's live Ast is
# consulted first - the same split `record_decl_in` makes.
# ---
# w:        the workspace
# root:     the root the type was resolved under, or nil
# own:      the buffer's own module id
# own_fid:  the buffer's own FileId
# own_a:    the buffer's live Ast
# own_file: the buffer's SourceFile
# tid:      a TypeId, typically read from a SemaResult
# ret:      some(TypeSite), or none for a type with no nominal declaration
pub fun type_site_in(w: *Workspace, root: *Root, own: sess.ModuleId, own_fid: src.FileId, own_a: *ast.Ast, own_file: *src.SourceFile, tid: type.TypeId) opt[TypeSite] {
    val no: opt[mtypes.Nominal] = nominal_of_tid(w, root, tid);
    if (sel no.none) { ret opt[TypeSite].none{}; }
    val n: mtypes.Nominal = no.some;

    if (own_file != nil && n.file == own_fid) {
        val own_decl: opt[id.DeclId] = mtypes.nominal_decl(own_a, positions.text_of(own_file), interner(w, root), n);
        if (sel own_decl.none) { ret opt[TypeSite].none{}; }
        ret type_site_from(own, own_decl.some, own_fid, own_a, own_file);
    }

    val mid: opt[sess.ModuleId] = module_for_file(root, n.file);
    if (sel mid.none) { ret opt[TypeSite].none{}; }
    val m: *driver.ModuleEntry = module_entry(root, mid.some);
    if (m == nil) { ret opt[TypeSite].none{}; }
    val fo: opt[*src.SourceFile] = src.get(?root.s.sources, m.file_id);
    if (sel fo.none) { ret opt[TypeSite].none{}; }
    val decl: opt[id.DeclId] = mtypes.nominal_decl(m.a, positions.text_of(fo.some), ?root.s.interner, n);
    if (sel decl.none) { ret opt[TypeSite].none{}; }
    ret type_site_from(mid.some, decl.some, m.file_id, m.a, fo.some);
}

# build a TypeSite for the decl `decl` in `a` (backed by `file`), or
# none when the decl is absent or declares no type name. the one place a new
# type-declaring kind is admitted
fun type_site_from(origin: sess.ModuleId, decl: id.DeclId, fid: src.FileId, a: *ast.Ast, file: *src.SourceFile) opt[TypeSite] {
    val d_opt: opt[*adecl.Decl] = ast.get_decl(a, decl);
    if (sel d_opt.none) { ret opt[TypeSite].none{}; }
    val d: *adecl.Decl = d_opt.some;

    var ts: TypeSite;
    if (d.kind == adecl.DECL_KIND_REC) { ts.name_span = d.data.rec_.name; }
    or (d.kind == adecl.DECL_KIND_UNI) { ts.name_span = d.data.uni_.name; }
    or (d.kind == adecl.DECL_KIND_TAG) { ts.name_span = d.data.tag_.name; }
    or                                 { ret opt[TypeSite].none{}; }

    ts.origin = origin;
    ts.decl   = decl;
    ts.file   = fid;
    ts.a      = a;
    ts.text   = positions.text_of(file);
    ts.kind   = d.kind;
    ret opt[TypeSite].some{ts};
}

# the nominal back-link of `tid` against the session type interner,
# guarded on a loaded root. none when there is no project or `tid` is not nominal
fun nominal_of_tid(w: *Workspace, root: *Root, tid: type.TypeId) opt[mtypes.Nominal] {
    if (root == nil || !root.loaded) { ret opt[mtypes.Nominal].none{}; }
    ret mtypes.nominal_of(?root.s.types, tid);
}

# build a RecordSite for the rec / uni decl `decl` in `a` (backed
# by `file`), or none when the decl is absent or not a rec / uni. the shared core
# of `record_decl` / `record_decl_in` - both having chosen which Ast / file the
# declaration lives in
fun record_site_from(origin: sess.ModuleId, decl: id.DeclId, fid: src.FileId, name: intern.StrId, a: *ast.Ast, file: *src.SourceFile) opt[RecordSite] {
    val d_opt: opt[*adecl.Decl] = ast.get_decl(a, decl);
    if (sel d_opt.none) { ret opt[RecordSite].none{}; }
    val d:      *adecl.Decl = d_opt.some;
    val is_rec: bool        = d.kind == adecl.DECL_KIND_REC;
    if (!is_rec && d.kind != adecl.DECL_KIND_UNI) { ret opt[RecordSite].none{}; }

    var rs: RecordSite;
    rs.origin = origin;
    rs.decl   = decl;
    rs.file   = fid;
    rs.name   = name;
    rs.a      = a;
    rs.text   = positions.text_of(file);
    rs.is_rec = is_rec;
    if (is_rec) {
        rs.name_span    = d.data.rec_.name;
        rs.fields_start = d.data.rec_.fields_start;
        rs.fields_len   = d.data.rec_.fields_len;
    }
    or {
        rs.name_span    = d.data.uni_.name;
        rs.fields_start = d.data.uni_.fields_start;
        rs.fields_len   = d.data.uni_.fields_len;
    }
    ret opt[RecordSite].some{rs};
}

# a freshly built, normalized `file://` URI for loaded module `mid`'s
# source file in `root` (from the root's path snapshot), owned by the caller, or
# nil when there is no project, the id is out of range, or allocation fails
# ---
# w:    the workspace
# root: the root governing the request, or nil
# mid:  a loaded module id
# ret:  an owned URI, or nil
pub fun module_uri(w: *Workspace, root: *Root, mid: sess.ModuleId) str {
    if (root == nil || !root.loaded || mid::u32 >= root.mod_path_count) { ret nil; }
    if (root.mod_paths[mid::u32] == nil)                                { ret nil; }
    ret norm_uri(w.alloc, root.mod_paths[mid::u32]);
}

# the session a root's types and interners belong to
#
# Rendering a type needs the session that interned it; a type id is meaningless
# against any other.
pub fun root_session(r: *Root) *sess.Session {
    if (r == nil) { ret nil; }
    ret r.s;
}

# how many root slots the workspace holds
#
# Slots are stable addresses, so an index is a durable handle across a walk;
# some slots are empty and some hold roots that failed to load.
pub fun root_count(w: *Workspace) u32 {
    ret w.root_cap;
}

# the root in slot `i`, or nil when the slot is empty
pub fun root_at(w: *Workspace, i: u32) *Root {
    if (w.roots == nil || i >= w.root_cap) { ret nil; }
    val r: *Root = ?w.roots[i];
    if (r.path == nil || r.s == nil) { ret nil; }
    ret r;
}

# whether `r` holds a live snapshot that can be queried without rebuilding
pub fun root_is_loaded(r: *Root) bool {
    if (r == nil) { ret false; }
    ret r.loaded;
}

# the interned FQN of a loaded module, or nil
#
# The name a module alias stands for. `module_uri` gives where it lives; this
# gives what it is called, so hover can say `module std.data.json` rather than
# echoing the `use` line the cursor is already on.
# ---
# w:    the workspace
# root: the root owning the module
# mid:  module id within that root
# ret:  borrowed FQN text, or nil when the module is not loaded
pub fun module_fqn(w: *Workspace, root: *Root, mid: sess.ModuleId) str {
    val e: *driver.ModuleEntry = module_entry(root, mid);
    if (e == nil) { ret nil; }
    val o: opt[str] = intern.lookup(?root.s.interner, e.fqn);
    if (sel o.none) { ret nil; }
    ret o.some;
}

# the loaded module in `root` whose source file is the document
# at `uri` (matched on the normalized filesystem path), or none. This is the
# canonical document-to-ModuleEntry identity used for routing and views.
# matching is lexical (`.` / `..` collapse only): the std fs surface exposes
# neither realpath nor inode identity, so a buffer opened through a symlinked or
# differently-cased path does not match its twin and that file is walked as a
# separate module - yielding duplicate locations / a duplicate WorkspaceEdit key
# for the same physical file
# ---
# w:    the workspace
# root: the root governing the request, or nil
# uri:  a document URI
# ret:  some(ModuleId), or none
pub fun module_for_uri(w: *Workspace, root: *Root, uri: str) opt[sess.ModuleId] {
    if (root == nil || !root.loaded || uri == nil) { ret opt[sess.ModuleId].none{}; }
    val norm: str = uri_to_norm(w.alloc, uri);
    if (norm == nil) { ret opt[sess.ModuleId].none{}; }
    val result: opt[sess.ModuleId] = module_for_norm(root, norm);
    strutil.str_free(w.alloc, norm);
    ret result;
}

# the loaded module in `root` whose normalized source path
# equals `norm`, or none. the allocation-free core of module_for_uri, also used
# where one normalized document path is matched against several roots
fun has_module_for_uri(o: opt[sess.ModuleId]) bool {
    ret sel o.some;
}

fun has_module_for_norm(o: opt[sess.ModuleId]) bool {
    ret sel o.some;
}

fun module_for_norm(root: *Root, norm: str) opt[sess.ModuleId] {
    if (root == nil || norm == nil) { ret opt[sess.ModuleId].none{}; }
    var i: u32 = 0;
    for (i < root.mod_path_count) {
        if (root.mod_paths[i] != nil && str_equals(root.mod_paths[i], norm)) {
            ret opt[sess.ModuleId].some{i::sess.ModuleId};
        }
        i = i + 1;
    }
    ret opt[sess.ModuleId].none{};
}

# whether loaded module `mid` in `root` belongs to the user's
# own editable project rather than a vendored dependency. False when the whole
# root is vendored; otherwise true iff the module FQN begins with the project id.
# ---
# w:    the workspace
# root: the root governing the request, or nil
# mid:  a loaded module id
# ret:  true for a project-owned module
pub fun is_project_module(w: *Workspace, root: *Root, mid: sess.ModuleId) bool {
    val m: *driver.ModuleEntry = module_entry(root, mid);
    if (m == nil)      { ret false; }
    if (root.vendored) { ret false; }
    val id_opt:  opt[str] = intern.lookup(?root.s.interner, root.p.config.id);
    val fqn_opt: opt[str] = intern.lookup(?root.s.interner, m.fqn);
    if (sel id_opt.none)  { ret false; }
    if (sel fqn_opt.none) { ret false; }
    val pid:  str   = id_opt.some;
    val fqn:  str   = fqn_opt.some;
    val plen: usize = str_len(pid);
    val flen: usize = str_len(fqn);
    if (flen < plen || !str_starts_with(fqn, pid)) { ret false; }
    if (flen == plen)                              { ret true; }
    ret fqn[plen] == '.';
}

# the project root governing `uri` - the nearest ancestor of its
# decoded filesystem path holding a `mach.toml` - as an owned string, or nil
# for a non-file URI or a document outside any project
# the project root governing `uri`, in the SAME spelling a document path uses
#
# `project_root_for` keeps whatever spelling it is handed, so feeding it the raw
# URI path while documents carry the normalized one gives the same directory two
# names - `C:/x/alpha` against `C:\x\alpha` on windows - and every later
# `str_equals` between a root and a document's own root silently says no. That
# is what decides whether a buffer is mirrored into a root at all, so on windows
# a root's first build captured no open buffer and its snapshot revision never
# left zero. One canonical spelling, produced here, is what keeps those
# comparisons meaning what they read as.
fun document_root(w: *Workspace, uri: str) str {
    val path: str = uri_to_norm(w.alloc, uri);
    if (path == nil) { ret nil; }
    val root: str = project_root_for(w.alloc, path);
    strutil.str_free(w.alloc, path);
    ret root;
}

# whether a file URI has an ancestor mach.toml, without loading a project
# ---
# w:   workspace allocator owner
# uri: document URI
# ret: true when project analysis is required
pub fun has_project(w: *Workspace, uri: str) bool {
    val root: str = document_root(w, uri);
    if (root == nil) { ret false; }
    strutil.str_free(w.alloc, root);
    ret true;
}

# log the loader error and warn the user through
# window/showMessage so a manifest that fails to load (a malformed or
# unparseable mach.toml) is distinguishable from "no project found". the slot
# itself remembers the failure (tracked + !loaded), so the load is only retried
# when the manifest / lockfile changes
# the text to show for a build-layer `Fail`.
#
# `outcome.Fail` carries a message only when the failure was NOT already filed
# as a located diagnostic; a reported failure leaves `message` empty because the
# compiler's own render step would have printed the diagnostics. the lsp has no
# render step for a project load, so an empty message would surface as a blank
# warning - name the channel the detail actually went to instead
fun fail_message(f: *outcome.Fail) str {
    if (sel f.internal)    { ret "internal compiler error while loading the project"; }
    if (sel f.user)        { ret f.user; }
    if (sel f.environment) { ret f.environment; }
    ret "the project does not compile; see the diagnostics on its source files";
}

fun report_load_failure(w: *Workspace, root: str, msg: str) {
    trace.log("project: failed to load project at ");
    trace.log(root);
    trace.log(": ");
    trace.log(msg);
    trace.log("\n");

    val p1:    str                       = "mach-lsp: failed to load project at ";
    val p2:    str                       = ": ";
    val p3:    str                       = " (cross-module features disabled for this project)";
    val total: usize                     = str_len(p1) + str_len(root) + str_len(p2) + str_len(msg) + str_len(p3);
    val r:     res[*u8, allocator.Error] = allocate[u8](w.alloc, total + 1);
    if (sel r.err) { ret; }
    val buf: *u8   = r.ok;
    var off: usize = 0;
    off      = append(buf, off, p1);
    off      = append(buf, off, root);
    off      = append(buf, off, p2);
    off      = append(buf, off, msg);
    off      = append(buf, off, p3);
    buf[off] = 0;
    show_warning(w, buf::str);
    deallocate[u8](w.alloc, buf, total + 1);
}

# send a window/showMessage notification with Warning severity
fun show_warning(w: *Workspace, text: str) {
    val qmsg: str = json.quote(text, w.alloc);
    if (qmsg == nil) { ret; }
    val n1:    str                       = "{\"jsonrpc\":\"2.0\",\"method\":\"window/showMessage\",\"params\":{\"type\":2,\"message\":";
    val n2:    str                       = "}}";
    val total: usize                     = str_len(n1) + str_len(qmsg) + str_len(n2);
    val r:     res[*u8, allocator.Error] = allocate[u8](w.alloc, total + 1);
    if (sel r.err) {
        json.free_str(qmsg, w.alloc);
        ret;
    }
    val buf: *u8   = r.ok;
    var off: usize = 0;
    off      = append(buf, off, n1);
    off      = append(buf, off, qmsg);
    off      = append(buf, off, n2);
    buf[off] = 0;
    transport.send_message(buf::str, w.alloc);
    deallocate[u8](w.alloc, buf, total + 1);
    json.free_str(qmsg, w.alloc);
}

# the percent-decoded filesystem path of a `file://` URI, as an
# owned string, or nil for a non-file URI / malformed escape
fun uri_to_path(alloc: *Allocator, uri: str) str {
    if (uri == nil)                       { ret nil; }
    if (!str_starts_with(uri, "file://")) { ret nil; }
    val n: usize = str_len(uri);
    var i: usize = 7;

    # the authority. A local file URI spells it empty (`file:///path`) or
    # `localhost`; anything else names a host, which on Windows is a UNC share
    # (`file://server/share` -> `\\server\share`). Decoding a host as though it
    # were the leading path segment would silently turn a remote path into a
    # local one, so the two are separated here rather than conflated.
    var auth_start: usize = i;
    for (i < n && uri[i] != '/') { i = i + 1; }
    val auth_len: usize = i - auth_start;
    var unc:      bool  = false;
    if (auth_len > 0) {
        if (!region_equals(uri, auth_start, auth_len, "localhost")) { unc = true; }
    }

    # worst case: every byte kept, plus a UNC prefix and the terminator
    val cap: usize                     = n + 3;
    val r:   res[*u8, allocator.Error] = allocate[u8](alloc, cap);
    if (sel r.err) { ret nil; }
    val buf: *u8   = r.ok;
    var out: usize = 0;

    if (unc) {
        buf[0] = '/';
        buf[1] = '/';
        out    = 2;
        var a: usize = auth_start;
        for (a < auth_start + auth_len) {
            buf[out] = uri[a];
            out      = out + 1;
            a        = a + 1;
        }
    }

    var j: usize = i;
    for (j < n) {
        val c: u8 = uri[j];
        if (c == '%') {
            if (j + 2 >= n) {
                deallocate[u8](alloc, buf, cap);
                ret nil;
            }
            val hi: i64 = hex_val(uri[j + 1]);
            val lo: i64 = hex_val(uri[j + 2]);
            if (hi < 0 || lo < 0) {
                deallocate[u8](alloc, buf, cap);
                ret nil;
            }
            val b: i64 = hi * 16 + lo;
            # an encoded NUL would truncate every path comparison downstream at
            # the point it appears, so a URI carrying one is refused outright
            if (b == 0) {
                deallocate[u8](alloc, buf, cap);
                ret nil;
            }
            buf[out] = b::u8;
            j        = j + 3;
        }
        or {
            if (c == 0) {
                deallocate[u8](alloc, buf, cap);
                ret nil;
            }
            buf[out] = c;
            j        = j + 1;
        }
        out = out + 1;
    }
    buf[out] = 0;

    # `file:///C:/x` decodes to `/C:/x`, whose leading slash is an artefact of
    # the URI form rather than part of the path. Only a drive letter earns the
    # strip; a POSIX path beginning `/c` must keep its root.
    if (!unc && out >= 3 && buf[0] == '/' && is_drive_letter(buf[1]) && buf[2] == ':') {
        var k: usize = 0;
        for (k + 1 <= out) {
            buf[k] = buf[k + 1];
            k      = k + 1;
        }
        out      = out - 1;
        buf[out] = 0;
    }

    if (out == 0) {
        deallocate[u8](alloc, buf, cap);
        ret nil;
    }
    ret buf::str;
}

# whether `len` bytes of `s` at `start` equal `want`, case-insensitively
fun region_equals(s: str, start: usize, len: usize, want: str) bool {
    if (len != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (lower_ascii(s[start + i]) != lower_ascii(want[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun lower_ascii(c: u8) u8 {
    if (c >= 'A' && c <= 'Z') { ret c + 32; }
    ret c;
}

# whether `c` can begin a Windows drive specifier
fun is_drive_letter(c: u8) bool {
    if (c >= 'a' && c <= 'z') { ret true; }
    ret c >= 'A' && c <= 'Z';
}

# the normalized filesystem path of a `file://` URI, as an owned
# string, or nil for a non-file URI / malformed escape / allocation failure
fun uri_to_norm(alloc: *Allocator, uri: str) str {
    val path: str = uri_to_path(alloc, uri);
    if (path == nil) { ret nil; }
    val norm: str = normalize_path(alloc, path);
    strutil.str_free(alloc, path);
    ret norm;
}

# decode and lexically normalize a file URI into an owned absolute compiler
# overlay path.
pub fun path_of_uri(alloc: *Allocator, uri: str) str {
    ret uri_to_norm(alloc, uri);
}

# the value of a hex digit, or -1
fun hex_val(c: u8) i64 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i64; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::i64 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::i64 + 10; }
    ret 0 - 1;
}

# the nearest ancestor directory of `file_path` that holds a
# `mach.toml`, as an owned string, or nil when none exists. walks up to the
# filesystem root with `path.parent` / `path.join`
fun project_root_for(alloc: *Allocator, file_path: str) str {
    val first_r: res[pathlib.Path, allocator.Error] = pathlib.parent(alloc, file_path);
    if (sel first_r.err) { ret nil; }
    var dir: str = first_r.ok;

    for (true) {
        val cand_r: res[pathlib.Path, allocator.Error] = pathlib.join(alloc, dir, "mach.toml");
        if (sel cand_r.err) {
            strutil.str_free(alloc, dir);
            ret nil;
        }
        val cand:    str                       = cand_r.ok;
        val found_r: res[bool, io_error.Error] = fs.is_file(cand);
        var found:   bool                      = false;
        if (sel found_r.ok) { found = found_r.ok; }
        strutil.str_free(alloc, cand);
        if (found) { ret dir; }

        val up_r: res[pathlib.Path, allocator.Error] = pathlib.parent(alloc, dir);
        if (sel up_r.err) {
            strutil.str_free(alloc, dir);
            ret nil;
        }
        val up: str = up_r.ok;
        if (str_equals(up, dir)) {
            strutil.str_free(alloc, up);
            strutil.str_free(alloc, dir);
            ret nil;
        }
        strutil.str_free(alloc, dir);
        dir = up;
    }
    ret nil;
}

# a lexically normalized owned copy of an absolute `path`,
# collapsing `.` segments and `seg/..` pairs (clamped at the root). dependency
# file paths carry literal `..` from the manifest's dir_dep joins; clients
# cannot correlate such locations with open buffers, so every emitted URI is
# normalized here on the LSP side (the vendored driver is not ours to change)
fun normalize_path(alloc: *Allocator, path: str) str {
    if (path == nil) { ret nil; }
    val r: res[pathlib.Path, allocator.Error] = pathlib.clean(alloc, path);
    if (sel r.err) { ret nil; }
    ret r.ok;
}

# a `file://` URI for a SourceFile's `path`, owned by the caller, or
# nil on allocation failure.
# ---
# alloc: allocator backing the returned URI
# path:  a SourceFile path
# ret:   an owned URI, or nil
pub fun uri_of_path(alloc: *Allocator, path: str) str {
    if (path == nil) { ret nil; }
    if (str_starts_with(path, "file://")) {
        val dr: res[str, allocator.Error] = strutil.str_dup(alloc, path);
        if (sel dr.err) { ret nil; }
        ret dr.ok;
    }
    val norm: str = normalize_path(alloc, path);
    if (norm == nil) { ret nil; }
    val u: str = norm_uri(alloc, norm);
    strutil.str_free(alloc, norm);
    ret u;
}

fun norm_uri(alloc: *Allocator, norm: str) str {
    if (norm == nil) { ret nil; }
    val n: usize = str_len(norm);

    var b: json.Buf = json.buf_init(alloc);
    json.buf_push(?b, "file://");

    # A URI path uses `/` whatever the platform writes, and the authority slot
    # must not be filled by accident. On POSIX the path already begins `/`, so
    # concatenation produced `file:///a/b` and looked correct; on Windows
    # `C:\dir` produced `file://C:\dir`, whose `C:` a client reads as the HOST.
    # UNC is the one form that genuinely has an authority: `//server/share`
    # keeps it.
    var i:   usize = 0;
    val unc: bool  = n >= 2 && is_sep(norm[0]) && is_sep(norm[1]);
    if (unc) { i = 2; }
    or {
        json.buf_push_byte(?b, '/');
        if (n > 0 && is_sep(norm[0])) { i = 1; }
    }

    for (i < n) {
        val c: u8 = norm[i];
        if (is_sep(c))         { json.buf_push_byte(?b, '/'); }
        or (uri_unreserved(c)) { json.buf_push_byte(?b, c); }
        or                     { push_percent(?b, c); }
        i = i + 1;
    }

    val view: str = json.buf_str(?b);
    if (view == nil) {
        json.buf_dnit(?b);
        ret nil;
    }
    val out: str = json.dup(view, alloc);
    json.buf_dnit(?b);
    ret out;
}

# whether `c` separates path segments on either platform
#
# A path normalized on Windows carries `\`; one that came from a manifest or a
# URI may still carry `/`. Both end up as `/` in a URI.
fun is_sep(c: u8) bool {
    ret c == '/' || c == '\\';
}

# whether `c` may appear literally in a URI path
#
# The unreserved set, plus `:` so a drive specifier survives as `C:` rather than
# `C%3A`, which is legal but which clients render badly.
fun uri_unreserved(c: u8) bool {
    if (c >= 'a' && c <= 'z')                         { ret true; }
    if (c >= 'A' && c <= 'Z')                         { ret true; }
    if (c >= '0' && c <= '9')                         { ret true; }
    if (c == '-' || c == '.' || c == '_' || c == '~') { ret true; }
    ret c == ':';
}

# append `c` as a percent escape
fun push_percent(b: *json.Buf, c: u8) {
    json.buf_push_byte(b, '%');
    json.buf_push_byte(b, hex_digit((c::i64 / 16) & 15));
    json.buf_push_byte(b, hex_digit(c::i64 & 15));
}

fun hex_digit(v: i64) u8 {
    if (v < 10) { ret ('0'::i64 + v)::u8; }
    ret ('A'::i64 + (v - 10))::u8;
}

# copy `s` into `buf` at `offset`, returning the new offset
fun append(buf: *u8, offset: usize, s: str) usize {
    if (s == nil) { ret offset; }
    val n: usize = str_len(s);
    if (n > 0) { mem.raw_copy((buf::usize + offset)::ptr, s::ptr, n); }
    ret offset + n;
}

# a POSIX-spelled path rewritten with the platform's separator
#
# `normalize_path` follows the native separator now, so a test that hard-codes
# `/` asserts one platform's spelling rather than the behaviour. The segments
# and their order are what matters.
fun native(a: *Allocator, posix: str) str {
    val n: usize                     = str_len(posix);
    val r: res[*u8, allocator.Error] = allocate[u8](a, n + 1);
    if (sel r.err) { ret nil; }
    val out: *u8   = r.ok;
    var i:   usize = 0;
    for (i < n) {
        if (posix[i] == '/') { out[i] = pathlib.separator(); }
        or                   { out[i] = posix[i]; }
        i = i + 1;
    }
    out[n] = 0;
    ret out::str;
}

test "project: file uri paths are decoded and normalized" {
    var pa: Allocator;
    page.make(?pa);
    val got: str = path_of_uri(?pa, "file:///tmp/a%20b/src/../main.mach");
    if (got == nil || !str_equals(got, native(?pa, "/tmp/a b/main.mach"))) { ret 1; }
    ret 0;
}

test "project: non-file uri has no compiler path" {
    var pa: Allocator;
    page.make(?pa);
    if (path_of_uri(?pa, "untitled:buffer") != nil) { ret 1; }
    ret 0;
}

test "project: a local file URI decodes to its path" {
    var pa: Allocator;
    page.make(?pa);
    var fail: bool = false;
    val a:    str  = uri_to_path(?pa, "file:///home/u/a%20b.mach");
    if (a == nil) { fail = true; }
    or {
        if (!str_equals(a, "/home/u/a b.mach")) { fail = true; }
    }
    # localhost is the other spelling of "this machine"
    val b: str = uri_to_path(?pa, "file://localhost/home/u/x.mach");
    if (b == nil) { fail = true; }
    or {
        if (!str_equals(b, "/home/u/x.mach")) { fail = true; }
    }
    if (uri_to_path(?pa, "http://example/x") != nil) { fail = true; }
    if (fail)                                        { ret 1; }
    ret 0;
}

# the leading slash of `/C:/x` belongs to the URI form, not the path; a POSIX
# path starting `/c` must keep its root, so only a real drive spec is stripped
test "project: a windows drive URI loses the URI's leading slash" {
    var pa: Allocator;
    page.make(?pa);
    var fail: bool = false;
    val a:    str  = uri_to_path(?pa, "file:///C:/src/main.mach");
    if (a == nil) { fail = true; }
    or {
        if (!str_equals(a, "C:/src/main.mach")) { fail = true; }
    }
    val b: str = uri_to_path(?pa, "file:///c:/x");
    if (b == nil) { fail = true; }
    or {
        if (!str_equals(b, "c:/x")) { fail = true; }
    }
    val c: str = uri_to_path(?pa, "file:///cat/x");
    if (c == nil) { fail = true; }
    or {
        if (!str_equals(c, "/cat/x")) { fail = true; }
    }
    if (fail) { ret 1; }
    ret 0;
}

# a non-empty authority names a host, which is a UNC share - decoding it as the
# first path segment would silently turn a remote path into a local one
test "project: a UNC authority is kept as a UNC root" {
    var pa: Allocator;
    page.make(?pa);
    var fail: bool = false;
    val a:    str  = uri_to_path(?pa, "file://server/share/x.mach");
    if (a == nil) { fail = true; }
    or {
        if (!str_equals(a, "//server/share/x.mach")) { fail = true; }
    }
    if (fail) { ret 1; }
    ret 0;
}

test "project: a malformed escape or an encoded NUL is refused" {
    var pa: Allocator;
    page.make(?pa);
    var fail: bool = false;
    if (uri_to_path(?pa, "file:///a%zz") != nil) { fail = true; }
    if (uri_to_path(?pa, "file:///a%2") != nil)  { fail = true; }
    # an embedded NUL would truncate every later path comparison
    if (uri_to_path(?pa, "file:///a%00b") != nil) { fail = true; }
    if (uri_to_path(?pa, "file://") != nil)       { fail = true; }
    if (fail)                                     { ret 1; }
    ret 0;
}

test "project: normalization collapses . and .. without escaping the root" {
    var pa: Allocator;
    page.make(?pa);
    var fail: bool = false;
    val a:    str  = normalize_path(?pa, "/a/./b/../c");
    if (a == nil) { fail = true; }
    or {
        if (!str_equals(a, native(?pa, "/a/c"))) { fail = true; }
    }
    val b: str = normalize_path(?pa, "/a//b/");
    if (b == nil) { fail = true; }
    or {
        if (!str_equals(b, native(?pa, "/a/b"))) { fail = true; }
    }
    # `..` at the root stays at the root rather than climbing above it
    val c: str = normalize_path(?pa, "/../x");
    if (c == nil) { fail = true; }
    or {
        if (!str_equals(c, native(?pa, "/x"))) { fail = true; }
    }
    if (fail) { ret 1; }
    ret 0;
}

test "project: a path becomes a file URI a client can parse" {
    var pa: Allocator;
    page.make(?pa);
    var fail: bool = false;

    # a posix path: three slashes, and a space is escaped
    val a: str = norm_uri(?pa, "/home/u/a b.mach");
    if (a == nil) { fail = true; }
    or {
        if (!str_equals(a, "file:///home/u/a%20b.mach")) { fail = true; }
    }

    # a windows drive path must not put `C:` in the authority slot
    val b: str = norm_uri(?pa, "C:\\src\\main.mach");
    if (b == nil) { fail = true; }
    or {
        if (!str_equals(b, "file:///C:/src/main.mach")) { fail = true; }
    }

    # UNC is the one form that genuinely has an authority
    val c: str = norm_uri(?pa, "\\\\server\\share\\x.mach");
    if (c == nil) { fail = true; }
    or {
        if (!str_equals(c, "file://server/share/x.mach")) { fail = true; }
    }

    if (fail) { ret 1; }
    ret 0;
}

# the two directions must compose: a URI that decodes to a path must rebuild to
# the same URI, or a document opened by one spelling is a different document
# from the same file reached by go-to-definition
test "project: uri and path round-trip" {
    var pa: Allocator;
    page.make(?pa);
    var fail: bool = false;
    val p1:   str  = uri_to_path(?pa, "file:///home/u/a%20b.mach");
    if (p1 == nil) { fail = true; }
    or {
        val u1: str = norm_uri(?pa, p1);
        if (u1 == nil) { fail = true; }
        or {
            if (!str_equals(u1, "file:///home/u/a%20b.mach")) { fail = true; }
        }
    }
    val p2: str = uri_to_path(?pa, "file:///C:/src/main.mach");
    if (p2 == nil) { fail = true; }
    or {
        val u2: str = norm_uri(?pa, p2);
        if (u2 == nil) { fail = true; }
        or {
            if (!str_equals(u2, "file:///C:/src/main.mach")) { fail = true; }
        }
    }
    if (fail) { ret 1; }
    ret 0;
}
